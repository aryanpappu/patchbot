package runner

import (
	"context"
	"errors"
	"fmt"
	"sort"
	"time"

	"github.com/aryanpappu/patchbot/internal/github"
	"github.com/aryanpappu/patchbot/internal/store"
)

// SyncWaiting performs one comment/expiry pass, without a background poller.
// A command is eligible only for the current waiting window, so old comments
// cannot approve a later revision or a retry. Dry runs never consume commands.
func (r *Runner) SyncWaiting(ctx context.Context) error {
	runs, err := r.waitingRuns(ctx)
	if err != nil {
		return err
	}
	var errs []error
	for _, run := range runs {
		if err := ctx.Err(); err != nil {
			return errors.Join(append(errs, err)...)
		}
		if r.expired(run) {
			if err := r.expire(ctx, run); err != nil && !errors.Is(err, store.ErrConflict) {
				errs = append(errs, err)
			}
			continue
		}
		if run.DryRun {
			continue
		}
		if err := r.syncRun(ctx, run); err != nil {
			errs = append(errs, err)
		}
	}
	return errors.Join(errs...)
}

func (r *Runner) syncRun(ctx context.Context, run store.Run) error {
	bot := r.opts.BotLogin
	if bot == "" {
		identity, ok := r.gh.(interface {
			CurrentUser(context.Context) (string, error)
		})
		if !ok {
			return errors.New("GitHub bot identity unavailable; comment sync disabled")
		}
		var err error
		bot, err = identity.CurrentUser(ctx)
		if err != nil {
			return err
		}
	}
	spec, err := r.db.LatestSpec(ctx, run.ID)
	if err != nil {
		return err
	}
	since := spec.CreatedAt
	if run.WaitingSince != nil && run.WaitingSince.After(since) {
		since = *run.WaitingSince
	}
	comments, err := r.gh.ListIssueComments(ctx, ref(run.Repo), int(run.IssueNumber), since)
	if err != nil {
		return err
	}
	sort.Slice(comments, func(i, j int) bool {
		if comments[i].CreatedAt.Equal(comments[j].CreatedAt) {
			return comments[i].ID < comments[j].ID
		}
		return comments[i].CreatedAt.Before(comments[j].CreatedAt)
	})
	for _, comment := range comments {
		if !comment.CreatedAt.After(since) || (spec.CommentID != nil && comment.ID <= *spec.CommentID) {
			continue
		}
		command, ok := github.ParseCommand(comment)
		if !ok || (command.Kind != github.CommandApprove && command.Kind != github.CommandRevise) {
			continue
		}
		var collaboratorErr, recordErr error
		if !github.EligibleCommand(comment, r.cfg.Defaults.Approvers, func(login string) bool {
			member, err := r.gh.IsCollaborator(ctx, ref(run.Repo), login)
			collaboratorErr = err
			return err == nil && member
		}, bot, func(id int64) bool {
			// Shared identity: patchbot's own comments never count. A lookup
			// error reports "posted", so the comment fails closed.
			posted, err := r.db.IsPostedComment(ctx, id)
			recordErr = err
			return err != nil || posted
		}) {
			if err := errors.Join(collaboratorErr, recordErr); err != nil {
				return err
			}
			continue
		}
		current, err := r.db.GetRun(ctx, run.ID)
		if err != nil {
			return err
		}
		if !waiting(current.Status) || current.WaitingSince == nil || !sameTime(current.WaitingSince, run.WaitingSince) {
			return nil
		}
		switch command.Kind {
		case github.CommandApprove:
			if current.Status != store.StatusAwaitingApproval {
				continue
			}
			if err := r.approve(ctx, run.ID, comment.Author, "github", &spec, true); err != nil {
				if errors.Is(err, errCommentEdited) {
					return errors.Join(err, r.commentEditAdvice(ctx, run, spec))
				}
				return err
			}
			return nil
		case github.CommandRevise:
			return r.revise(ctx, run.ID, command.Notes, comment.Author, "github", &spec)
		default:
			continue
		}
	}
	return nil
}

func (r *Runner) commentEditAdvice(ctx context.Context, run store.Run, spec store.Spec) error {
	kind := fmt.Sprintf("spec_comment_warning_v%d", spec.Version)
	if _, err := r.db.GetArtifact(ctx, run.ID, kind, 0); !errors.Is(err, store.ErrNotFound) {
		return err
	}
	message := "The specification comment was edited on GitHub. Those edits are not imported. Use `/revise <notes>` or edit the specification in patchbot before approving a new version."
	if _, err := r.comment(ctx, run, "spec_edit_warning", message); err != nil {
		return err
	}
	return r.artifact(ctx, run.ID, kind, message)
}

func sameTime(a, b *time.Time) bool { return a != nil && b != nil && a.Equal(*b) }
package github

import (
	"regexp"
	"strings"
	"unicode"
)

// CommandKind names a comment action. Authorization is checked separately.
type CommandKind string

// Supported comment actions.
const (
	CommandApprove CommandKind = "approve"
	CommandReject  CommandKind = "reject"
	CommandRevise  CommandKind = "revise"
	CommandAnswer  CommandKind = "answer"
)

// Command is a parsed action with optional multiline notes.
type Command struct {
	Kind  CommandKind
	Notes string
}

// ParseCommand recognizes an action only on the first nonempty line. A quoted
// or fenced first line is not a command. Approve and reject take no inline
// arguments; revise and answer require text, which may start on the next line.
func ParseCommand(comment Comment) (Command, bool) {
	body := strings.TrimSpace(strings.ReplaceAll(comment.Body, "\r\n", "\n"))
	first, rest, _ := strings.Cut(body, "\n")
	first = strings.TrimSpace(first)
	name, inline := first, ""
	if index := strings.IndexFunc(first, unicode.IsSpace); index >= 0 {
		name, inline = first[:index], strings.TrimSpace(first[index:])
	}
	var kind CommandKind
	switch strings.ToLower(name) {
	case "/approve":
		kind = CommandApprove
	case "/reject":
		kind = CommandReject
	case "/revise":
		kind = CommandRevise
	case "/answer":
		kind = CommandAnswer
	default:
		return Command{}, false
	}
	if (kind == CommandApprove || kind == CommandReject) && inline != "" {
		return Command{}, false
	}
	notes := strings.TrimSpace(inline + "\n" + rest)
	if (kind == CommandRevise || kind == CommandAnswer) && notes == "" {
		return Command{}, false
	}
	return Command{Kind: kind, Notes: notes}, true
}

// markerPattern matches any patchbot HTML-comment marker, tolerating case and
// whitespace variations, so a near-miss spelling still fails closed.
var markerPattern = regexp.MustCompile(`(?i)<!--\s*patchbot`)

// HasPatchbotMarker reports whether a body carries a hidden patchbot marker.
// Every comment patchbot posts carries one (see Marker).
func HasPatchbotMarker(body string) bool { return markerPattern.MatchString(body) }

// Marker is the hidden marker appended to a patchbot comment of the given kind.
func Marker(kind string) string { return "<!-- patchbot:" + kind + " -->" }

// EligibleCommand checks identity, edit status and live collaborator membership.
// The runner supplies its own login explicitly; an unknown bot identity fails
// closed. The callback can adapt Client.IsCollaborator and must return false on
// error. Run status, spec integrity and comment ordering belong to the runner.
//
// Shared identity: when the token owner is also a configured approver (a
// single-user PAT), a comment authored by botLogin is eligible only if it is
// not one patchbot posted. postedByPatchbot must report recorded patchbot
// comment IDs and return true on error. Such a comment must also carry no
// patchbot marker, be unedited and pass the approver and collaborator checks.
// Every other combination fails closed. Other authors keep the plain rules.
func EligibleCommand(comment Comment, approvers []string, isCollaborator func(string) bool, botLogin string, postedByPatchbot func(int64) bool) bool {
	if botLogin == "" || comment.Author == "" || comment.CreatedAt.IsZero() ||
		!comment.UpdatedAt.Equal(comment.CreatedAt) || isCollaborator == nil {
		return false
	}
	if strings.EqualFold(comment.Author, botLogin) &&
		(comment.ID <= 0 || HasPatchbotMarker(comment.Body) || postedByPatchbot == nil || postedByPatchbot(comment.ID)) {
		return false
	}
	for _, approver := range approvers {
		if strings.EqualFold(approver, comment.Author) {
			return isCollaborator(comment.Author)
		}
	}
	return false
}
package gitx

import (
	"context"
	"encoding/base64"
	"errors"
	"fmt"
	"os/exec"
	"strings"
	"time"

	"github.com/aryanpappu/patchbot/internal/execx"
)

const trustedPath = execx.TrustedPath

// remoteCommands are the only git subcommands that talk to the remote. Each of
// them must use the authenticated path (a private repository refuses anonymous
// reads), and no other subcommand ever receives the credential.
var remoteCommands = map[string]bool{"clone": true, "fetch": true, "ls-remote": true, "push": true}

// command builds the entire environment explicitly. Credentials are deliberately
// absent from argv, including -c arguments, and from all local calls. They reach
// git only as an ephemeral, host-scoped http.extraheader via GIT_CONFIG_*.
func (r *Repo) command(_ context.Context, authenticated bool, args ...string) (*exec.Cmd, error) {
	remote := len(args) > 0 && remoteCommands[args[0]]
	if authenticated && !remote {
		return nil, errors.New("credentials are restricted to remote operations")
	}
	if remote && !authenticated {
		return nil, errors.New("remote operations must use the authenticated path")
	}
	for _, arg := range args {
		if strings.ContainsRune(arg, 0) || (r.token != "" && strings.Contains(arg, r.token)) {
			return nil, errors.New("invalid git argument")
		}
	}
	protocol := "never"
	if r.localRemote != "" {
		protocol = "always"
	}
	argv := []string{
		"--literal-pathspecs",
		"-c", "core.hooksPath=" + r.hooks,
		"-c", "core.fsmonitor=false",
		"-c", "protocol.allow=never",
		"-c", "protocol.https.allow=always",
		"-c", "protocol.file.allow=" + protocol,
		"-c", "submodule.recurse=false",
		"-c", "fetch.recurseSubmodules=false",
		"-c", "credential.helper=",
		"-c", "credential.interactive=false",
		"-c", "http.followRedirects=false",
		"-c", "core.attributesFile=/dev/null",
		"-c", "core.quotePath=false",
		"-c", "core.pager=cat",
		"-c", "core.bigFileThreshold=1m",
		"-c", "commit.gpgSign=false",
		"-c", "tag.gpgSign=false",
	}
	argv = append(argv, args...)
	cmd := exec.Command(r.git, argv...) // #nosec G204 -- executable is resolved from the configured trusted PATH; literal git subcommands, no shell.
	cmd.Dir = r.dir
	cmd.Env = []string{
		"PATH=" + r.path, "HOME=" + r.home, "TMPDIR=" + r.temp,
		"LANG=C", "LC_ALL=C", "GIT_CONFIG_NOSYSTEM=1", "GIT_CONFIG_GLOBAL=/dev/null",
		"GIT_TERMINAL_PROMPT=0", "GIT_ATTR_NOSYSTEM=1", "GIT_NO_REPLACE_OBJECTS=1",
		"GIT_AUTHOR_NAME=" + r.author.Name, "GIT_AUTHOR_EMAIL=" + r.author.Email,
		"GIT_COMMITTER_NAME=" + r.author.Name, "GIT_COMMITTER_EMAIL=" + r.author.Email,
	}
	if r.testInsecureTLS {
		// Test-only: the fake HTTPS remote uses a self-signed certificate.
		cmd.Env = append(cmd.Env, "GIT_SSL_NO_VERIFY=1")
	}
	if authenticated && r.token != "" {
		encoded := base64.StdEncoding.EncodeToString([]byte("x-access-token:" + r.token))
		cmd.Env = append(cmd.Env, "GIT_CONFIG_COUNT=1",
			"GIT_CONFIG_KEY_0=http.https://"+r.host+"/.extraheader",
			"GIT_CONFIG_VALUE_0=AUTHORIZATION: basic "+encoded)
	}
	cmd.WaitDelay = time.Second
	return cmd, nil
}

// run never includes argv, environment, stderr, or OS error strings in errors.
// Even a remote that echoes an encoded/fragmented secret cannot leak it there.
func (r *Repo) run(ctx context.Context, authenticated bool, args ...string) (string, bool, error) {
	return r.runIndex(ctx, authenticated, "", args...)
}

func (r *Repo) runIndex(ctx context.Context, authenticated bool, index string, args ...string) (string, bool, error) {
	return r.runIndexLimit(ctx, authenticated, index, r.outputCap, args...)
}

func (r *Repo) runIndexLimit(ctx context.Context, authenticated bool, index string, limit int, args ...string) (string, bool, error) {
	if r.observeCommand != nil {
		r.observeCommand(args)
	}
	ctx, cancel := context.WithTimeout(ctx, r.timeout)
	defer cancel()
	cmd, err := r.command(ctx, authenticated, args...)
	if err != nil {
		return "", false, err
	}
	if index != "" {
		cmd.Env = append(cmd.Env, "GIT_INDEX_FILE="+index)
	}
	out, diagnostic := &cappedBuffer{limit: limit}, &cappedBuffer{limit: r.outputCap}
	cmd.Stdout, cmd.Stderr = out, diagnostic
	err = execx.RunProcessGroup(ctx, cmd, execx.DefaultGracePeriod)
	if ctx.Err() != nil {
		return "", false, fmt.Errorf("git command: %w", ctx.Err())
	}
	if err != nil {
		var exitErr *exec.ExitError
		if errors.As(err, &exitErr) {
			return "", false, fmt.Errorf("git command failed (exit %d)", exitErr.ExitCode())
		}
		return "", false, errors.New("git command could not complete")
	}
	return string(out.data), out.truncated, nil
}

func (r *Repo) complete(ctx context.Context, authenticated bool, args ...string) (string, error) {
	out, truncated, err := r.run(ctx, authenticated, args...)
	if err == nil && truncated {
		err = ErrOutputLimit
	}
	return out, err
}

// os/exec serializes writes to each buffer. Continue draining after the cap.
type cappedBuffer struct {
	data      []byte
	limit     int
	truncated bool
}

func (b *cappedBuffer) Write(p []byte) (int, error) {
	n := len(p)
	keep := min(n, b.limit-len(b.data))
	b.data = append(b.data, p[:keep]...)
	b.truncated = b.truncated || keep != n
	return n, nil
}
package gitx

import (
	"crypto/sha256"
	"encoding/hex"
	"errors"
	"io"
	"os"
	"strings"
)

// ConfigHash returns SHA-256 of the literal .git/config bytes after checking
// metadata types and ensuring .git/hooks contains only regular *.sample files.
func (r *Repo) ConfigHash() (string, error) {
	r.mu.Lock()
	defer r.mu.Unlock()
	if r.closed {
		return "", errors.New("git repo is closed")
	}
	return r.hashConfig()
}

// VerifyConfig checks the captured hash and the hook directory without invoking
// git, so a modified configuration cannot execute helpers during verification.
func (r *Repo) VerifyConfig(hash string) error {
	r.mu.Lock()
	defer r.mu.Unlock()
	if r.closed {
		return errors.New("git repo is closed")
	}
	actual, err := r.hashConfig()
	if err != nil || actual != hash {
		return ErrTampered
	}
	return nil
}

func (r *Repo) verify() error {
	if r.closed {
		return errors.New("git repo is closed")
	}
	hash, err := r.hashConfig()
	if err != nil || hash != r.configHash {
		return ErrTampered
	}
	return nil
}

func (r *Repo) hashConfig() (string, error) {
	root, err := os.OpenRoot(r.dir)
	if err != nil {
		return "", ErrTampered
	}
	defer func() { _ = root.Close() }()
	info, err := root.Lstat(".git")
	if err != nil || !info.IsDir() {
		return "", ErrTampered
	}
	git, err := root.OpenRoot(".git")
	if err != nil {
		return "", ErrTampered
	}
	defer func() { _ = git.Close() }()
	info, err = git.Lstat("config")
	if err != nil || !info.Mode().IsRegular() || info.Size() > 1<<20 {
		return "", ErrTampered
	}
	file, err := git.Open("config")
	if err != nil {
		return "", ErrTampered
	}
	defer func() { _ = file.Close() }()
	hash := sha256.New()
	n, err := io.Copy(hash, io.LimitReader(file, (1<<20)+1))
	if err != nil || n > 1<<20 {
		return "", ErrTampered
	}
	// A missing hooks directory is fine (clone uses an empty template).
	if info, err := git.Lstat("hooks"); err == nil {
		if !info.IsDir() {
			return "", ErrTampered
		}
		hooks, err := git.Open("hooks")
		if err != nil {
			return "", ErrTampered
		}
		defer func() { _ = hooks.Close() }()
		for {
			entries, readErr := hooks.ReadDir(64)
			for _, entry := range entries {
				info, err := entry.Info()
				if err != nil || !info.Mode().IsRegular() || !strings.HasSuffix(entry.Name(), ".sample") {
					return "", ErrTampered
				}
			}
			if errors.Is(readErr, io.EOF) {
				break
			}
			if readErr != nil {
				return "", ErrTampered
			}
		}
	} else if !errors.Is(err, os.ErrNotExist) {
		return "", ErrTampered
	}
	return hex.EncodeToString(hash.Sum(nil)), nil
}
package runner_test

import (
	"context"
	"strings"
	"testing"
	"time"

	"github.com/aryanpappu/patchbot/internal/github"
	"github.com/aryanpappu/patchbot/internal/llm/fake"
	"github.com/aryanpappu/patchbot/internal/runner"
	"github.com/aryanpappu/patchbot/internal/store"
)

// lossyStore simulates lost provenance writes: the spec's comment ID and/or
// patchbot's posted-comment record silently never reach the database.
type lossyStore struct {
	store.Store
	dropSpecComment, dropPostedRecord bool
}

func (s *lossyStore) SetSpecComment(ctx context.Context, runID, version int64, hash string, id int64) error {
	if s.dropSpecComment {
		return nil
	}
	return s.Store.SetSpecComment(ctx, runID, version, hash, id)
}

func (s *lossyStore) RecordPostedComment(ctx context.Context, c store.PostedComment) error {
	if s.dropPostedRecord {
		return nil
	}
	return s.Store.RecordPostedComment(ctx, c)
}

// sharedFixture makes the token owner "owner" (an approver and collaborator)
// the identity that posts patchbot's comments, as with a single-user PAT.
func sharedFixture(t *testing.T, bot string, db store.Store, steps ...fake.Step) *fixture {
	t.Helper()
	f := newFixture(t, "true", steps...)
	f.botAuthor = bot
	f.opts.BotLogin = bot
	if db == nil {
		db = f.db
	}
	var err error
	f.r, err = runner.New(t.Context(), f.cfg, db, f.opts)
	if err != nil {
		t.Fatal(err)
	}
	return f
}

func TestSharedIdentityOwnerApprovalAccepted(t *testing.T) {
	f := sharedFixture(t, "owner", nil, specStep(), writeStep(), submitStep())
	run := f.start("fix", false)
	f.addCommand("owner", "/approve", false)
	if err := f.r.SyncWaiting(t.Context()); err != nil {
		t.Fatal(err)
	}
	if got := f.get(run.ID).Status; got != store.StatusSucceeded {
		t.Fatalf("owner-as-token-owner /approve: status %s", got)
	}
	approvals, err := f.db.ListApprovals(t.Context(), run.ID)
	if err != nil || len(approvals) != 1 || approvals[0].Actor != "owner" || approvals[0].Channel != "github" {
		t.Fatalf("approvals = %+v, %v", approvals, err)
	}
	// Every comment patchbot posted (spec, PR note) is marked and recorded.
	f.mu.Lock()
	comments := append([]github.Comment(nil), f.comments...)
	f.mu.Unlock()
	var patchbotPosts int
	for _, c := range comments {
		if c.Body == "/approve" {
			continue
		}
		patchbotPosts++
		if !github.HasPatchbotMarker(c.Body) {
			t.Errorf("posted comment %d lacks a patchbot marker: %q", c.ID, c.Body)
		}
		if posted, err := f.db.IsPostedComment(t.Context(), c.ID); err != nil || !posted {
			t.Errorf("posted comment %d not recorded: %v, %v", c.ID, posted, err)
		}
	}
	if patchbotPosts < 2 {
		t.Fatalf("expected spec and PR-note comments, got %d", patchbotPosts)
	}
}

func TestSharedIdentityRejections(t *testing.T) {
	for _, tt := range []struct {
		name   string
		bot    string
		lossy  *lossyStore
		prefix string
		add    func(f *fixture, run store.Run)
	}{
		{
			// The spec's own comment ID was lost, so ordering no longer hides
			// it, and the (model-written) spec body begins with /approve.
			name: "spec comment beginning with /approve", bot: "owner",
			lossy: &lossyStore{dropSpecComment: true}, prefix: "/approve\n\n",
		},
		{
			// Both provenance writes were lost: only the marker remains.
			name: "marker without ID record", bot: "owner",
			lossy: &lossyStore{dropSpecComment: true, dropPostedRecord: true}, prefix: "/approve\n\n",
		},
		{
			name: "recorded ID without marker", bot: "owner",
			add: func(f *fixture, run store.Run) {
				f.addCommand("owner", "/approve", false)
				f.mu.Lock()
				id := f.comments[len(f.comments)-1].ID
				f.mu.Unlock()
				if err := f.db.RecordPostedComment(f.t.Context(), store.PostedComment{CommentID: id, RunID: run.ID,
					Repo: run.Repo, IssueNumber: run.IssueNumber, Kind: "test"}); err != nil {
					f.t.Fatal(err)
				}
			},
		},
		{
			name: "edited owner comment", bot: "owner",
			add: func(f *fixture, _ store.Run) { f.addCommand("owner", "/approve", true) },
		},
		{
			name: "owner comment quoting a marker", bot: "owner",
			add: func(f *fixture, _ store.Run) { f.addCommand("owner", "/approve\n<!-- patchbot:spec -->", false) },
		},
		{
			// "outsider" is a collaborator but not a configured approver.
			name: "non-approver bot login", bot: "outsider",
			add: func(f *fixture, _ store.Run) { f.addCommand("outsider", "/approve", false) },
		},
	} {
		t.Run(tt.name, func(t *testing.T) {
			var f *fixture
			if tt.lossy != nil {
				// Build the base fixture first so the lossy wrapper can wrap its DB.
				base := newFixture(t, "true", specStep())
				tt.lossy.Store = base.db
				base.botAuthor, base.postPrefix, base.opts.BotLogin = tt.bot, tt.prefix, tt.bot
				// GitHub's clock runs ahead of the host, so the spec comment
				// falls inside the waiting window instead of before it.
				base.postSkew = time.Minute
				var err error
				base.r, err = runner.New(t.Context(), base.cfg, tt.lossy, base.opts)
				if err != nil {
					t.Fatal(err)
				}
				f = base
			} else {
				f = sharedFixture(t, tt.bot, nil, specStep())
			}
			run := f.start("fix", false)
			if got := f.get(run.ID).Status; got != store.StatusAwaitingApproval {
				t.Fatalf("status after spec: %s", got)
			}
			if tt.add != nil {
				tt.add(f, run)
			}
			if err := f.r.SyncWaiting(t.Context()); err != nil {
				t.Fatal(err)
			}
			if got := f.get(run.ID).Status; got != store.StatusAwaitingApproval || f.p.Calls() != 1 {
				t.Fatalf("shared-identity comment counted: status %s, calls %d", got, f.p.Calls())
			}
			if approvals, err := f.db.ListApprovals(t.Context(), run.ID); err != nil || len(approvals) != 0 {
				t.Fatalf("approvals recorded: %+v, %v", approvals, err)
			}
			if tt.prefix != "" {
				f.mu.Lock()
				spec := f.comments[0]
				f.mu.Unlock()
				if !strings.HasPrefix(spec.Body, "/approve") || spec.Author != tt.bot {
					t.Fatalf("fixture did not simulate a bot-authored /approve spec: %+v", spec)
				}
			}
		})
	}
}
