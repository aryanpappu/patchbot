package runner

import (
	"context"
	"errors"
	"fmt"
	"sort"
	"time"

	"github.com/aryanpappu/patchbot/internal/github"
	"github.com/aryanpappu/patchbot/internal/store"
)

// SyncWaiting performs one comment/expiry pass, without a background poller.
// A command is eligible only for the current waiting window, so old comments
// cannot approve a later revision or a retry. Dry runs never consume commands.
func (r *Runner) SyncWaiting(ctx context.Context) error {
	runs, err := r.waitingRuns(ctx)
	if err != nil {
		return err
	}
	var errs []error
	for _, run := range runs {
		if err := ctx.Err(); err != nil {
			return errors.Join(append(errs, err)...)
		}
		if r.expired(run) {
			if err := r.expire(ctx, run); err != nil && !errors.Is(err, store.ErrConflict) {
				errs = append(errs, err)
			}
			continue
		}
		if run.DryRun {
			continue
		}
		if err := r.syncRun(ctx, run); err != nil {
			errs = append(errs, err)
		}
	}
	return errors.Join(errs...)
}

func (r *Runner) syncRun(ctx context.Context, run store.Run) error {
	bot := r.opts.BotLogin
	if bot == "" {
		identity, ok := r.gh.(interface {
			CurrentUser(context.Context) (string, error)
		})
		if !ok {
			return errors.New("GitHub bot identity unavailable; comment sync disabled")
		}
		var err error
		bot, err = identity.CurrentUser(ctx)
		if err != nil {
			return err
		}
	}
	spec, err := r.db.LatestSpec(ctx, run.ID)
	if err != nil {
		return err
	}
	since := spec.CreatedAt
	if run.WaitingSince != nil && run.WaitingSince.After(since) {
		since = *run.WaitingSince
	}
	comments, err := r.gh.ListIssueComments(ctx, ref(run.Repo), int(run.IssueNumber), since)
	if err != nil {
		return err
	}
	sort.Slice(comments, func(i, j int) bool {
		if comments[i].CreatedAt.Equal(comments[j].CreatedAt) {
			return comments[i].ID < comments[j].ID
		}
		return comments[i].CreatedAt.Before(comments[j].CreatedAt)
	})
	for _, comment := range comments {
		if !comment.CreatedAt.After(since) || (spec.CommentID != nil && comment.ID <= *spec.CommentID) {
			continue
		}
		command, ok := github.ParseCommand(comment)
		if !ok || (command.Kind != github.CommandApprove && command.Kind != github.CommandRevise) {
			continue
		}
		var collaboratorErr error
		if !github.EligibleCommand(comment, r.cfg.Defaults.Approvers, func(login string) bool {
			member, err := r.gh.IsCollaborator(ctx, ref(run.Repo), login)
			collaboratorErr = err
			return err == nil && member
		}, bot) {
			if collaboratorErr != nil {
				return collaboratorErr
			}
			continue
		}
		current, err := r.db.GetRun(ctx, run.ID)
		if err != nil {
			return err
		}
		if !waiting(current.Status) || current.WaitingSince == nil || !sameTime(current.WaitingSince, run.WaitingSince) {
			return nil
		}
		switch command.Kind {
		case github.CommandApprove:
			if current.Status != store.StatusAwaitingApproval {
				continue
			}
			if err := r.approve(ctx, run.ID, comment.Author, "github", &spec, true); err != nil {
				if errors.Is(err, errCommentEdited) {
					return errors.Join(err, r.commentEditAdvice(ctx, run, spec))
				}
				return err
			}
			return nil
		case github.CommandRevise:
			return r.revise(ctx, run.ID, command.Notes, comment.Author, "github", &spec)
		default:
			continue
		}
	}
	return nil
}

func (r *Runner) commentEditAdvice(ctx context.Context, run store.Run, spec store.Spec) error {
	kind := fmt.Sprintf("spec_comment_warning_v%d", spec.Version)
	if _, err := r.db.GetArtifact(ctx, run.ID, kind, 0); !errors.Is(err, store.ErrNotFound) {
		return err
	}
	message := "The specification comment was edited on GitHub. Those edits are not imported. Use `/revise <notes>` or edit the specification in patchbot before approving a new version."
	if _, err := r.comment(ctx, run, message); err != nil {
		return err
	}
	return r.artifact(ctx, run.ID, kind, message)
}

func sameTime(a, b *time.Time) bool { return a != nil && b != nil && a.Equal(*b) }
package runner

import (
	"context"
	"errors"
	"fmt"
	"os"
	"strings"

	"github.com/aryanpappu/patchbot/internal/agent"
	"github.com/aryanpappu/patchbot/internal/github"
	"github.com/aryanpappu/patchbot/internal/gitx"
	"github.com/aryanpappu/patchbot/internal/store"
	"github.com/aryanpappu/patchbot/internal/tools"
	"github.com/aryanpappu/patchbot/internal/workspace"
)

func (r *Runner) publicationAvailable(ctx context.Context, run store.Run) error {
	branch := fmt.Sprintf("patchbot/issue-%d", run.IssueNumber)
	pr, err := r.gh.FindOpenPR(ctx, ref(run.Repo), branch)
	if err != nil {
		return err
	}
	if pr != nil {
		return errors.New("an open PR already exists for the patchbot branch")
	}
	exists, err := r.gh.BranchExists(ctx, ref(run.Repo), branch)
	if err != nil {
		return err
	}
	if exists {
		return errors.New("patchbot branch already exists; refusing to overwrite it")
	}
	return nil
}

func (r *Runner) validateChanges(ctx context.Context, run store.Run, env *toolEnvironment) error {
	changes, err := env.repo.Status(ctx)
	if err != nil {
		return err
	}
	policy, err := workspace.NewPolicy(r.cfg.Repos[run.Repo].Protected)
	if err != nil {
		return err
	}
	for _, change := range changes {
		for _, path := range []string{change.Path, change.OriginalPath} {
			if path == "" {
				continue
			}
			if _, err := policy.Check(path); err != nil {
				return &agent.Error{Kind: "policy_violations", Message: "patch changes a protected or invalid path"}
			}
			if _, err := env.env.WS.Stat(path); err != nil && !errors.Is(err, os.ErrNotExist) {
				return &agent.Error{Kind: "policy_violations", Message: "patch contains an unsafe path"}
			}
		}
	}
	return nil
}

// publicationApproval checks remote spec freshness first, then the persisted
// decision and worker generation. Call again at each external write boundary:
// neither an earlier snapshot nor a heartbeat is publication authorization.
func (r *Runner) publicationApproval(ctx context.Context, run store.Run, spec store.Spec) (store.Approval, error) {
	current, err := r.checkedSpec(ctx, run)
	if err != nil {
		return store.Approval{}, err
	}
	if current.Version != spec.Version || current.Hash != spec.Hash {
		return store.Approval{}, agent.ErrApprovalDenied
	}
	approval, err := r.db.ValidApproval(ctx, run.ID, spec.Version, spec.Hash)
	if err != nil {
		return store.Approval{}, fmt.Errorf("%w: matching publication approval: %w", agent.ErrApprovalDenied, err)
	}
	persisted, err := r.db.GetRun(ctx, run.ID)
	if err != nil {
		return store.Approval{}, err
	}
	if persisted.Status != store.StatusRunning || persisted.Phase != store.PhasePublish || persisted.Generation != run.Generation {
		return store.Approval{}, store.ErrConflict
	}
	now := r.now()
	if approval.CreatedAt.IsZero() || approval.CreatedAt.After(now) || !now.Before(approval.CreatedAt.Add(r.gateOptions().TTL)) {
		return store.Approval{}, fmt.Errorf("%w: publication approval expired or has an invalid date", agent.ErrApprovalDenied)
	}
	return approval, ctx.Err()
}

func (r *Runner) publish(ctx context.Context, run *store.Run, env *toolEnvironment, meta github.Repo, spec store.Spec, result agent.CodeResult, baseline string, codeErr error, review *reviewState) error {
	var summary *string
	if result.Submission != nil {
		summary = &result.Submission.Summary
	}
	if err := r.transition(ctx, run, store.StatusRunning, store.PhasePublish, store.RunPatch{TestsStatus: &result.TestsStatus, PRDraft: &result.Draft, Summary: summary}); err != nil {
		return err
	}
	approval, err := r.publicationApproval(ctx, *run, spec)
	if err != nil {
		return err
	}
	if err := r.validateChanges(ctx, *run, env); err != nil {
		return err
	}
	diff, err := env.repo.Diff(ctx)
	if err != nil {
		return err
	}
	if err := r.artifact(ctx, run.ID, "diff", diff); err != nil {
		return err
	}
	live, err := r.gh.GetRepo(ctx, ref(run.Repo))
	if err != nil {
		return err
	}
	branch, found, err := r.gh.GetBranch(ctx, ref(run.Repo), live.DefaultBranch)
	if err != nil {
		return err
	}
	if !found {
		return errors.New("default branch no longer exists")
	}
	moved := live.DefaultBranch != meta.DefaultBranch || branch.Commit.SHA != run.BaseSHA
	title, body := r.prText(*run, spec, approval, result, baseline, moved, codeErr, review)
	if err := r.artifact(ctx, run.ID, "pr_title", title); err != nil {
		return err
	}
	if err := r.artifact(ctx, run.ID, "pr_body", body); err != nil {
		return err
	}
	if !run.DryRun {
		if err := r.publicationAvailable(ctx, *run); err != nil {
			return err
		}
	}
	if err := ctx.Err(); err != nil {
		return err
	}
	if err := r.reviewedDiff(ctx, *run, env, review); err != nil {
		return err
	}
	var head string
	if err := r.operation(ctx, *run, "git", "commit", func() error {
		var err error
		head, err = env.repo.CommitAll(ctx, fmt.Sprintf("fix: %s (#%d)", title, run.IssueNumber), gitx.Author{})
		if err == nil && review != nil {
			// The commit must contain exactly the reviewed tree.
			var tree string
			if tree, err = env.repo.HeadTree(ctx); err == nil && tree != review.last.TreeID {
				err = errReviewStale
			}
		}
		return err
	}); err != nil {
		if errors.Is(err, errReviewStale) {
			return &agent.Error{Kind: "review_stale", Message: "committed patch differs from the reviewed diff; refusing to publish"}
		}
		return err
	}
	if err := r.transition(ctx, run, store.StatusRunning, store.PhasePublish, store.RunPatch{HeadSHA: &head}); err != nil {
		return err
	}
	if repo := r.cfg.Repos[run.Repo]; result.LastTest != nil && repo != nil {
		command, _ := repo.TestCommandID()
		r.observe(ctx, *run, command, *result.LastTest, head, fmt.Sprintf("run %d verify test attempt %d", run.ID, result.TestAttempts))
	}
	if run.DryRun {
		outcome := "dry_run"
		return r.transition(ctx, run, store.StatusSucceeded, store.PhasePublish, store.RunPatch{Outcome: &outcome})
	}
	var guardErr error
	if err := r.operation(ctx, *run, "git", "push", func() error {
		if _, guardErr = r.publicationApproval(ctx, *run, spec); guardErr != nil {
			return guardErr
		}
		return env.repo.Push(ctx, run.Branch)
	}); err != nil {
		if guardErr != nil {
			return err
		}
		return &agent.Error{Kind: "push_failed", Message: "could not push guarded patchbot branch"}
	}
	var pr github.PullRequest
	err = r.operation(ctx, *run, "publish", "create_pr", func() error {
		if _, guardErr = r.publicationApproval(ctx, *run, spec); guardErr != nil {
			return guardErr
		}
		var err error
		pr, err = r.gh.CreatePR(ctx, ref(run.Repo), github.NewPR{Title: title, Body: body, Head: run.Branch, Base: live.DefaultBranch, Draft: result.Draft})
		return err
	})
	if err != nil {
		if guardErr != nil {
			return err
		}
		return &agent.Error{Kind: "pr_failed", Message: "branch pushed but pull request creation failed"}
	}
	number, outcome := int64(pr.Number), "pr_opened"
	if result.Draft {
		outcome = "pr_draft"
	}
	if err := r.transition(ctx, run, store.StatusRunning, store.PhasePublish, store.RunPatch{PRNumber: &number, PRURL: &pr.HTMLURL, PRDraft: &result.Draft}); err != nil {
		return err
	}
	note := fmt.Sprintf("patchbot run %d: %s\nHarness tests: %s (%d attempts).", run.ID, pr.HTMLURL, result.TestsStatus, result.TestAttempts)
	if review != nil && review.last != nil {
		note += fmt.Sprintf("\nIndependent review: %s (round %d).", review.last.Verdict, review.last.Round)
	}
	if _, err := r.comment(ctx, *run, note); err != nil {
		if err := r.artifact(ctx, run.ID, "publish_comment_warning", "PR opened, but the issue comment could not be posted."); err != nil {
			return err
		}
	}
	return r.transition(ctx, run, store.StatusSucceeded, store.PhasePublish, store.RunPatch{Outcome: &outcome})
}

var errReviewStale = errors.New("patch differs from reviewed diff")

// reviewedDiff requires the patch about to be committed to hash to the last
// reviewed snapshot. Nothing may change the workspace after a review.
func (r *Runner) reviewedDiff(ctx context.Context, run store.Run, env *toolEnvironment, review *reviewState) error {
	if review == nil {
		return nil
	}
	if review.last == nil {
		return &agent.Error{Kind: "review_failed", Message: "no review was recorded for this patch"}
	}
	snap, err := r.snapshotDiff(ctx, run, env)
	if err != nil {
		return err
	}
	if snap.hash != review.last.DiffHash || snap.tree != review.last.TreeID {
		return &agent.Error{Kind: "review_stale", Message: "workspace diff changed after review; refusing to publish"}
	}
	return nil
}

func (r *Runner) prText(run store.Run, spec store.Spec, approval store.Approval, result agent.CodeResult, baseline string, moved bool, codeErr error, review *reviewState) (string, string) {
	title := fmt.Sprintf("Fix issue #%d", run.IssueNumber)
	var b strings.Builder
	if review != nil && !review.passed() {
		fmt.Fprintf(&b, "**Draft: independent review did not pass** (%s). The reviewer has not approved this patch; treat it as unreviewed work.\n\n", review.failure())
	}
	if result.Salvage {
		fmt.Fprintf(&b, "Draft salvage: coding stopped (%s). Review the incomplete work.\n\n", result.Reason)
	}
	if codeErr != nil {
		b.WriteString("The agent stopped with a provider error; harness verification follows below.\n\n")
	}
	fmt.Fprintf(&b, "Fixes #%d\n\n", run.IssueNumber)
	link := fmt.Sprintf("stored run %d specification", run.ID)
	if spec.CommentID != nil {
		link = fmt.Sprintf("[approved specification](https://github.com/%s/issues/%d#issuecomment-%d)", run.Repo, run.IssueNumber, *spec.CommentID)
	}
	fmt.Fprintf(&b, "Approved spec: %s, version %d, SHA-256 `%s`, approved by %s.\n\n", link, spec.Version, spec.Hash, approval.Actor)
	fmt.Fprintf(&b, "Harness tests: **%s** (%d attempts). Baseline: **%s**.\n\nAcceptance criteria (agent claims; harness result above):\n\n", result.TestsStatus, result.TestAttempts, baseline)
	if result.TestsStatus == "not_run" {
		b.WriteString("Unverified: no test command is configured. This PR requires manual verification.\n\n")
	}
	if result.Submission != nil {
		title = result.Submission.PRTitle
		for index, criterion := range result.Submission.Criteria {
			tick := " "
			if criterion.Met {
				tick = "x"
			}
			fmt.Fprintf(&b, "- [%s] AC%d: %s — harness: %s. %s\n", tick, index+1, criterion.Text, result.TestsStatus, criterion.Note)
		}
		fmt.Fprintf(&b, "\n%s\n\n%s\n", result.Submission.Summary, result.Submission.PRBody)
	}
	if result.LastTest != nil {
		fmt.Fprintf(&b, "\nHarness exit code: %d; timed out: %t.\n\n```text\n%s\n```\n", result.LastTest.ExitCode, result.LastTest.TimedOut, tools.CapOutput(result.LastTest.Output, 8<<10))
	}
	b.WriteString(prReview(review))
	if moved {
		fmt.Fprintf(&b, "\nThe default branch has moved since refinement. This patch is based on `%s`; review for integration changes.\n", run.BaseSHA)
	}
	cost := "unknown"
	if run.CostMicros != nil {
		cost = fmt.Sprintf("%d micro-USD", *run.CostMicros)
	}
	tokens := "unknown"
	if run.InputTokens != nil && run.OutputTokens != nil {
		tokens = fmt.Sprintf("%d input / %d output", *run.InputTokens, *run.OutputTokens)
	}
	fmt.Fprintf(&b, "\nUsage: %s tokens; cost: %s.\n", tokens, cost)
	fmt.Fprintf(&b, "\nProvider: %s; model: %s.\n\nGenerated by patchbot. Human review is required.\n", run.Provider, run.CodeModel)
	title = strings.ReplaceAll(strings.ReplaceAll(title, "\n", " "), "\r", " ")
	if strings.TrimSpace(title) == "" {
		title = fmt.Sprintf("Fix issue #%d", run.IssueNumber)
	}
	return tools.CapOutput(github.NeutralizeMentions(r.redactor.Redact(title)), 200), tools.CapOutput(github.NeutralizeMentions(r.redactor.Redact(b.String())), 60_000)
}
// Package config loads, layers and validates the patchbot configuration.
//
// Values come from four layers, later ones winning: the embedded defaults, a
// TOML file, PATCHBOT_* environment variables and command-line flags. The
// loader records which layer set each value. Secrets never come from a file:
// the file names an environment variable and the loader reads the secret from
// it into a secret.Secret.
package config

import (
	"errors"
	"os"
	"path/filepath"
	"strings"
	"time"

	"github.com/aryanpappu/patchbot/internal/secret"
)

// Provider kinds.
const (
	KindAnthropic = "anthropic"
	KindGemini    = "gemini"
	KindOpenAI    = "openai"
)

// Run modes.
const (
	ModeFix         = "fix"
	ModeRefine      = "refine"
	ModeInvestigate = "investigate"
)

// Config is the effective configuration.
type Config struct {
	Defaults  Defaults             `toml:"defaults"`
	Limits    Limits               `toml:"limits"`
	Approval  Approval             `toml:"approval"`
	Review    Review               `toml:"review"`
	Log       Log                  `toml:"log"`
	Webhook   Webhook              `toml:"webhook"`
	Server    Server               `toml:"server"`
	Data      Data                 `toml:"data"`
	Memory    Memory               `toml:"memory"`
	Executor  Executor             `toml:"executor"`
	Providers map[string]*Provider `toml:"providers"`
	Repos     map[string]*Repo     `toml:"repos"`

	// path is the config file that was read, or "" when none was found.
	path string
	// sources maps a dotted key such as `limits.max_turns` to its Source.
	sources map[string]Source
	// home is the user's home directory, used to expand "~/" in Data.Dir.
	home string
	// rejectedKeyEnvs are the api_key_env names of a file that failed to
	// load. They are used only to redact the load error.
	rejectedKeyEnvs []string
}

// Defaults are the choices a run uses unless it says otherwise.
type Defaults struct {
	// Provider is the name of a [providers.<name>] table.
	Provider string `toml:"provider"`
	// Mode is fix, refine or investigate.
	Mode string `toml:"mode"`
	// RefineModel and CodeModel fall back to the provider's default_model.
	RefineModel string `toml:"refine_model"`
	CodeModel   string `toml:"code_model"`
	// MaxCostUSD is the budget of one run across every stage.
	MaxCostUSD float64 `toml:"max_cost_usd"`
	// Approvers are the GitHub logins whose /approve comments count.
	Approvers []string `toml:"approvers"`
	// CommentOnFailure posts a short diagnostic except for cancellation/auth.
	CommentOnFailure bool `toml:"comment_on_failure"`
}

// Limits bound one run.
type Limits struct {
	MaxTurns        int   `toml:"max_turns"`
	RefineMaxTurns  int   `toml:"refine_max_turns"`
	MaxOutputTokens int   `toml:"max_output_tokens"`
	MaxTotalTokens  int64 `toml:"max_total_tokens"`
	// HardMaxCostUSD is the ceiling for any per-run budget.
	HardMaxCostUSD  float64       `toml:"hard_max_cost_usd"`
	MaxTestAttempts int           `toml:"max_test_attempts"`
	RunTimeout      time.Duration `toml:"run_timeout"`
	CmdTimeout      time.Duration `toml:"cmd_timeout"`
	TestTimeout     time.Duration `toml:"test_timeout"`
	// CmdOutputBytes is sent to the model per command; CmdStoreBytes is kept.
	CmdOutputBytes int  `toml:"cmd_output_bytes"`
	CmdStoreBytes  int  `toml:"cmd_store_bytes"`
	BaselineTests  bool `toml:"baseline_tests"`
	// TrustedPath contains operator-controlled absolute tool directories.
	TrustedPath []string `toml:"trusted_path"`
}

// Approval controls the spec approval gate.
type Approval struct {
	// LocalActor is the name recorded for CLI and UI actions.
	LocalActor   string        `toml:"local_actor"`
	PollInterval time.Duration `toml:"poll_interval"`
	// TTL is how long a run may wait for approval before it expires.
	TTL          time.Duration `toml:"ttl"`
	MaxRevisions int           `toml:"max_revisions"`
}

// Review configures the opt-in sequential reviewer. Approval freezes these
// values on the run; a later config change does not affect approved runs.
type Review struct {
	// Enabled turns on the read-only review stage after harness verification.
	Enabled bool `toml:"enabled"`
	// Model is the reviewer model; empty uses the run's refine model.
	Model string `toml:"model"`
	// MaxRepairs is the number of review-requested coder repair cycles (0 or 1).
	MaxRepairs int `toml:"max_repairs"`
	// MaxTurns bounds each review round.
	MaxTurns int `toml:"max_turns"`
	// ReserveFraction of the run's token, cost and time budget is kept back
	// from coding so the review can still run.
	ReserveFraction float64 `toml:"reserve_fraction"`
	// SalvageDraft publishes a clearly marked draft PR when review does not
	// pass. When false such a run fails without publishing.
	SalvageDraft bool `toml:"salvage_draft"`
}

// Log configures logging.
type Log struct {
	Level  string `toml:"level"`  // debug, info, warn or error
	Format string `toml:"format"` // text or json
}

// Server configures the web interface.
type Server struct {
	Addr              string `toml:"addr"`
	MaxConcurrentRuns int    `toml:"max_concurrent_runs"`
	MaxQueuedRuns     int    `toml:"max_queued_runs"`
	VueSrc            string `toml:"vue_src"` // cdn or local
}

// Memory configures repository memory. Retrieved memory is unverified context
// in the user turn; it never changes policy, scope or the approval gate.
type Memory struct {
	// Enabled turns retrieval, typed observations and lesson proposals on.
	Enabled bool `toml:"enabled"`
	// MaxEntries and MaxBytes bound what one stage receives.
	MaxEntries int `toml:"max_entries"`
	MaxBytes   int `toml:"max_bytes"`
	// MaxPending caps pending model lessons per repository; excess proposals
	// are dropped with an event.
	MaxPending int `toml:"max_pending"`
	// ObservationTTL is how long a typed observation stays retrievable.
	ObservationTTL time.Duration `toml:"observation_ttl"`
}

// Webhook configures authenticated GitHub wake-up hints.
type Webhook struct {
	Enabled       bool              `toml:"enabled"`
	SecretEnv     string            `toml:"secret_env"`
	Path          string            `toml:"path"`
	TriggerLabels map[string]string `toml:"trigger_labels"`
	// LabelPollInterval is how often open issues are swept for trigger labels
	// that a missed delivery did not report.
	LabelPollInterval time.Duration `toml:"label_poll_interval"`
	Secret            secret.Secret `toml:"-"`
}

// Data says where the database and workspaces live.
type Data struct {
	Dir string `toml:"dir"`
}

// Executor kinds.
const (
	ExecutorLocal     = "local"
	ExecutorContainer = "container"
)

// Executor says where repository commands (baseline tests, run_cmd and harness
// verification) run. Git and file tools always stay on the host.
type Executor struct {
	// Kind is local (host process, the default) or container.
	Kind string `toml:"kind"`
	// Runtime is podman or docker, resolved through limits.trusted_path.
	Runtime string `toml:"runtime"`
	// Image is digest-pinned: name[:tag]@sha256:<digest>.
	Image     string `toml:"image"`
	Memory    string `toml:"memory"`
	CPUs      string `toml:"cpus"`
	PidsLimit int    `toml:"pids_limit"`
	TmpfsSize string `toml:"tmpfs_size"`
	// Network must be "none".
	Network string `toml:"network"`
	// User is the non-root numeric uid:gid inside the container.
	User string `toml:"user"`
	// UserNS is "" or "keep-id" (podman: host user appears as User).
	UserNS string `toml:"userns"`
	// Path is PATH inside the container; it resolves bare command names.
	Path []string `toml:"path"`
	// WorkspaceMaxBytes fails a command that grows the workspace beyond it.
	WorkspaceMaxBytes int64 `toml:"workspace_max_bytes"`
}

// Container reports whether repository commands run in a container.
func (e Executor) Container() bool { return e.Kind == ExecutorContainer }

// Provider is one [providers.<name>] table.
type Provider struct {
	Kind    string `toml:"kind"`
	BaseURL string `toml:"base_url"`
	// APIKeyEnv names the environment variable that holds the API key.
	APIKeyEnv    string   `toml:"api_key_env"`
	Models       []string `toml:"models"`
	DefaultModel string   `toml:"default_model"`
	// PriceFree states that every model of this provider costs nothing, as
	// with a local server. It is different from having no prices.
	PriceFree bool              `toml:"price_free"`
	Prices    map[string]*Price `toml:"prices"`

	// APIKey is read from the environment variable named by APIKeyEnv.
	APIKey secret.Secret `toml:"-"`
}

// Price is one [providers.<name>.prices.<model>] table, in US dollars per
// million tokens.
//
// Every rate is a pointer so that a rate left out of the file can be told
// apart from a rate of 0. Input and Output are required: a price table with
// only an input rate must not turn into "output is free", because the budget
// would then stop counting output tokens. Write 0 for a rate that is free.
type Price struct {
	Input  *float64 `toml:"input"`
	Output *float64 `toml:"output"`
	// CacheRead and CacheWrite are optional and fall back to Input when nil.
	CacheRead  *float64 `toml:"cache_read"`
	CacheWrite *float64 `toml:"cache_write"`
	// Checked is the day the price was read from the provider's price page.
	Checked Date `toml:"checked"`
}

// Repo is one [repos."owner/name"] table. Only listed repositories can run.
type Repo struct {
	// Commands maps a command ID such as "test" to the argv it runs.
	Commands map[string][]string `toml:"commands"`
	// Protected lists extra paths the agent may neither read nor write.
	Protected []string `toml:"protected"`
	// TestCommand is the ID of the command that verifies a change.
	TestCommand string `toml:"test_command"`
}

// TestCommandID returns the command that verifies a change: TestCommand, or
// "test" when that is empty and such a command exists.
func (r *Repo) TestCommandID() (string, bool) {
	if r.TestCommand != "" {
		return r.TestCommand, true
	}
	if _, ok := r.Commands["test"]; ok {
		return "test", true
	}
	return "", false
}

// Date is a calendar day. In TOML it is a local date (2026-11-10) or the same
// text as a string.
type Date struct {
	time.Time
}

const dateLayout = "2006-01-02"

// UnmarshalTOML implements toml.Unmarshaler.
func (d *Date) UnmarshalTOML(v any) error {
	switch v := v.(type) {
	case time.Time:
		d.Time = time.Date(v.Year(), v.Month(), v.Day(), 0, 0, 0, 0, time.UTC)
		return nil
	case string:
		t, err := time.Parse(dateLayout, v)
		if err != nil {
			// The value is not quoted back: nothing says it is not a secret
			// pasted into the wrong field.
			return errors.New("want a date like 2026-01-31")
		}
		d.Time = t
		return nil
	default:
		return errors.New("want a date like 2026-01-31")
	}
}

// String returns the date as YYYY-MM-DD, or "" for the zero date.
func (d Date) String() string {
	if d.IsZero() {
		return ""
	}
	return d.Format(dateLayout)
}

// Path returns the config file that was read, or "" when none was found.
func (c *Config) Path() string { return c.path }

// DataDir returns Data.Dir with a leading "~/" expanded.
func (c *Config) DataDir() string {
	dir := c.Data.Dir
	if dir == "~" {
		return c.home
	}
	if rest, ok := strings.CutPrefix(dir, "~/"); ok && c.home != "" {
		return filepath.Join(c.home, rest)
	}
	return dir
}

// DatabasePath returns the SQLite database file inside the data directory.
func (c *Config) DatabasePath() string {
	return filepath.Join(c.DataDir(), "patchbot.sqlite")
}

// Model returns the model a stage uses with the default provider: the stage's
// own setting, else the provider's default_model. Stage is "refine" or "code".
func (c *Config) Model(stage string) string {
	model := c.Defaults.CodeModel
	if stage == "refine" {
		model = c.Defaults.RefineModel
	}
	if model != "" {
		return model
	}
	if p := c.Providers[c.Defaults.Provider]; p != nil {
		return p.DefaultModel
	}
	return ""
}

// Redactor returns a redactor that masks every secret the config holds, as
// well as token-shaped text. Diagnostics about the config pass through it,
// because a secret can turn up in any field: a key exported under the wrong
// variable name becomes a "log level".
func (c *Config) Redactor() *secret.Redactor {
	r := secret.NewRedactor()
	r.AddSecrets(c.Secrets()...)
	return r
}

// Secrets returns every secret the config holds, for registering with a
// secret.Redactor.
func (c *Config) Secrets() []secret.Secret {
	var out []secret.Secret
	if c.Webhook.Secret.IsSet() {
		out = append(out, c.Webhook.Secret)
	}
	for _, name := range sortedKeys(c.Providers) {
		if key := c.Providers[name].APIKey; key.IsSet() {
			out = append(out, key)
		}
	}
	return out
}

// EnsureDataDir creates private storage and refuses an existing public directory
// or symlink. Doctor reports the same policy without changing the filesystem.
func (c *Config) EnsureDataDir() error {
	if err := os.MkdirAll(c.DataDir(), 0o700); err != nil {
		return err
	}
	info, err := os.Lstat(c.DataDir())
	if err != nil {
		return err
	}
	if !info.IsDir() || info.Mode().Perm() != 0o700 {
		return errors.New("data directory must be a real directory with mode 0700")
	}
	return nil
}
package config

import (
	_ "embed" // for defaults.toml
	"errors"
	"fmt"
	"io/fs"
	"os"
	"path/filepath"
	"reflect"
	"regexp"
	"slices"
	"strconv"
	"strings"
	"time"

	"github.com/BurntSushi/toml"

	"github.com/aryanpappu/patchbot/internal/secret"
)

//go:embed defaults.toml
var defaultsTOML string

// EnvConfig names the environment variable that points at a config file.
const EnvConfig = "PATCHBOT_CONFIG"

// SourceKind says which layer set a value.
type SourceKind int

// The layers, lowest precedence first.
const (
	SourceUnset SourceKind = iota // no layer set the value; it is the zero value
	SourceDefault
	SourceFile
	SourceEnv
	SourceFlag
)

// Source says where a config value came from.
type Source struct {
	Kind SourceKind
	// Name is the environment variable or the flag, for those two kinds.
	Name string
}

// String returns a short label such as "file" or "env PATCHBOT_PROVIDER".
func (s Source) String() string {
	switch s.Kind {
	case SourceDefault:
		return "default"
	case SourceFile:
		return "file"
	case SourceEnv:
		return "env " + s.Name
	case SourceFlag:
		return "flag " + s.Name
	default:
		return "unset"
	}
}

// Override is one value set on the command line.
type Override struct {
	// Key is a dotted config key in a fixed table, such as "defaults.provider".
	Key string
	// Value is the flag's text. Lists are comma-separated.
	Value string
	// Flag is the flag as the user typed it, such as "--provider".
	Flag string
}

// Options tell Load where to look. The zero value reads the real environment.
type Options struct {
	// Path is the --config flag. A file named here must exist.
	Path string
	// Dir is where ./patchbot.toml is looked for. Empty means the working directory.
	Dir string
	// Flags are the command-line overrides, the highest layer.
	Flags []Override
	// LookupEnv replaces os.LookupEnv.
	LookupEnv func(string) (string, bool)
	// UserConfigDir replaces os.UserConfigDir.
	UserConfigDir func() (string, error)
	// UserHomeDir replaces os.UserHomeDir.
	UserHomeDir func() (string, error)
}

// envBindings is the complete list of settings an environment variable can
// change. Secrets are not here: they are named by api_key_env.
var envBindings = []struct {
	env  string
	keys []string
}{
	{"PATCHBOT_DATA_DIR", []string{"data.dir"}},
	{"PATCHBOT_PROVIDER", []string{"defaults.provider"}},
	// PATCHBOT_MODEL sets both stages; the two specific variables win over it.
	{"PATCHBOT_MODEL", []string{"defaults.refine_model", "defaults.code_model"}},
	{"PATCHBOT_REFINE_MODEL", []string{"defaults.refine_model"}},
	{"PATCHBOT_CODE_MODEL", []string{"defaults.code_model"}},
	{"PATCHBOT_MAX_COST_USD", []string{"defaults.max_cost_usd"}},
	{"PATCHBOT_MAX_TURNS", []string{"limits.max_turns"}},
	{"PATCHBOT_ADDR", []string{"server.addr"}},
	{"PATCHBOT_LOG_LEVEL", []string{"log.level"}},
	{"PATCHBOT_LOG_FORMAT", []string{"log.format"}},
}

// Default returns the embedded defaults with no file, environment or flags.
func Default() *Config {
	c := &Config{sources: map[string]Source{}}
	var layer Config
	md, err := toml.Decode(defaultsTOML, &layer)
	if err == nil {
		err = checkKeys(md)
	}
	if err == nil {
		err = c.apply(&layer, md, Source{Kind: SourceDefault})
	}
	if err != nil {
		// The file is compiled in, so this is a bug that the tests catch.
		panic("config: embedded defaults.toml is invalid: " + err.Error())
	}
	return c
}

// Load builds the effective configuration: defaults, then the config file,
// then environment variables, then flags. It reports syntax errors, unknown
// keys and keys that look like secrets. It does not judge the values; call
// Validate for that.
//
// An error from Load never quotes a value it could not parse, since nothing
// says the value is not a secret in the wrong place, and it is redacted with
// every API key the loader could find.
func Load(opts Options) (*Config, error) {
	lookupEnv := opts.LookupEnv
	if lookupEnv == nil {
		lookupEnv = os.LookupEnv
	}
	c, err := load(opts, lookupEnv)
	// The keys are read even when loading failed, to redact the error.
	for _, p := range c.Providers {
		if !envNameRE.MatchString(p.APIKeyEnv) {
			continue // Validate reports a bad name; never look it up.
		}
		if value, ok := lookupEnv(p.APIKeyEnv); ok {
			p.APIKey = secret.New(strings.TrimSpace(value))
		}
	}
	if envNameRE.MatchString(c.Webhook.SecretEnv) {
		value, _ := lookupEnv(c.Webhook.SecretEnv)
		c.Webhook.Secret = secret.New(strings.TrimSpace(value))
	}
	if err != nil {
		// A file that was rejected never became part of c, but the variable
		// names it gave still say where its keys are.
		redactor := c.Redactor()
		for _, name := range c.rejectedKeyEnvs {
			if value, ok := lookupEnv(name); ok && envNameRE.MatchString(name) {
				redactor.AddExact(strings.TrimSpace(value))
			}
		}
		return nil, &redactedError{msg: redactor.Redact(err.Error()), err: err}
	}
	return c, nil
}

// redactedError carries a redacted message and keeps the original error
// reachable for errors.Is and errors.As.
type redactedError struct {
	msg string
	err error
}

func (e *redactedError) Error() string { return e.msg }
func (e *redactedError) Unwrap() error { return e.err }

// load applies the layers. It always returns a Config, complete or not.
func load(opts Options, lookupEnv func(string) (string, bool)) (*Config, error) {
	if opts.UserConfigDir == nil {
		opts.UserConfigDir = os.UserConfigDir
	}
	if opts.UserHomeDir == nil {
		opts.UserHomeDir = os.UserHomeDir
	}
	c := Default()
	if home, err := opts.UserHomeDir(); err == nil {
		c.home = home
	}

	path, err := findFile(opts, lookupEnv)
	if err != nil {
		return c, err
	}
	if path != "" {
		if err := c.loadFile(path); err != nil {
			return c, err
		}
	}

	for _, b := range envBindings {
		value, ok := lookupEnv(b.env)
		if !ok || value == "" {
			continue
		}
		for _, key := range b.keys {
			if err := c.set(key, value, Source{Kind: SourceEnv, Name: b.env}); err != nil {
				return c, fmt.Errorf("environment variable %s: %w", b.env, err)
			}
		}
	}
	for _, o := range opts.Flags {
		if err := c.set(o.Key, o.Value, Source{Kind: SourceFlag, Name: o.Flag}); err != nil {
			return c, fmt.Errorf("flag %s: %w", o.Flag, err)
		}
	}
	return c, nil
}

// Source returns where the value of a dotted key came from. Quote a segment
// that is not a bare TOML key: `repos."owner/name".test_command`.
func (c *Config) Source(key string) Source { return c.sources[key] }

// findFile returns the config file to read, or "" when there is none.
func findFile(opts Options, lookupEnv func(string) (string, bool)) (string, error) {
	explicit := opts.Path
	if explicit == "" {
		explicit, _ = lookupEnv(EnvConfig)
	}
	if explicit != "" {
		if _, err := os.Stat(explicit); err != nil {
			return "", fmt.Errorf("config file: %w", err)
		}
		return explicit, nil
	}

	candidates := []string{filepath.Join(opts.Dir, "patchbot.toml")}
	if dir, err := opts.UserConfigDir(); err == nil && dir != "" {
		candidates = append(candidates, filepath.Join(dir, "patchbot", "config.toml"))
	}
	for _, path := range candidates {
		info, err := os.Stat(path)
		switch {
		case errors.Is(err, fs.ErrNotExist):
			continue
		case err != nil:
			return "", fmt.Errorf("config file: %w", err)
		case info.Mode().IsRegular():
			return path, nil
		}
	}
	return "", nil
}

func (c *Config) loadFile(path string) error {
	data, err := os.ReadFile(path) //nolint:gosec // the user chooses the config file
	if err != nil {
		return fmt.Errorf("config file: %w", err)
	}
	var layer Config
	md, err := toml.Decode(string(data), &layer)
	c.rejectedKeyEnvs = append(c.rejectedKeyEnvs, layer.Webhook.SecretEnv)
	for _, p := range layer.Providers {
		if p != nil && p.APIKeyEnv != "" {
			c.rejectedKeyEnvs = append(c.rejectedKeyEnvs, p.APIKeyEnv)
		}
	}
	if err != nil {
		return fmt.Errorf("config file %s: %s", path, describeDecodeError(err))
	}
	if err := checkKeys(md); err != nil {
		return fmt.Errorf("config file %s: %w", path, err)
	}
	if err := c.apply(&layer, md, Source{Kind: SourceFile}); err != nil {
		return fmt.Errorf("config file %s: %w", path, err)
	}
	c.path = path
	return nil
}

// tomlPrefixRE matches the prefix of the library's plain errors. Only the
// line number is retained; the last key can contain a secret.
var tomlPrefixRE = regexp.MustCompile(`^toml: (?:line (\d+) )?(?:\(last key "(?:[^"\\]|\\.)*"\))?:? ?`)

// describeDecodeError turns a TOML library error into a message that says
// where the problem is and what kind it is, without the text that caused it.
// Every diagnostic is a fixed error class, never text copied from the parser:
// its messages can include keys and values in several quoting styles, even
// when parsing failed before any API key environment variables were decoded.
func describeDecodeError(err error) string {
	line, msg := 0, err.Error()
	if pe, ok := errors.AsType[toml.ParseError](err); ok {
		line, msg = pe.Position.Line, pe.Message
	} else if m := tomlPrefixRE.FindStringSubmatch(msg); m != nil {
		line, _ = strconv.Atoi(m[1])
		msg = msg[len(m[0]):]
	}
	kind := "invalid TOML syntax or value"
	switch {
	case strings.HasPrefix(msg, "invalid duration"):
		kind = `want a duration string such as "30m"`
	case msg == "want a date like 2026-01-31":
		kind = "want a date like 2026-01-31"
	case strings.Contains(msg, "is out of range"), strings.Contains(msg, "is out of the safe"):
		kind = "a number is out of range"
	case strings.HasPrefix(msg, "expected value but found"):
		kind = "expected a value; text needs quotes"
	case strings.HasPrefix(msg, "incompatible types:"), strings.HasPrefix(msg, "type mismatch"):
		kind = "incompatible types"
	}
	if line > 0 {
		return fmt.Sprintf("line %d: %s", line, kind)
	}
	return kind
}

// checkKeys rejects keys that look like secrets and keys the schema does not
// have. The secret check comes first because its message says what to do.
func checkKeys(md toml.MetaData) error {
	var errs []error
	seen := map[string]bool{}
	for _, key := range md.Keys() {
		if name, ok := secretLookingSegment(key); ok && !covered(seen, key) {
			seen[key.String()] = true
			errs = append(errs, fmt.Errorf(
				"key %s: %q looks like a secret; secrets are read only from environment variables, "+
					"so name the variable with api_key_env and remove the value from the file", key, name))
		}
	}
	for _, key := range md.Undecoded() {
		if covered(seen, key) {
			continue
		}
		errs = append(errs, fmt.Errorf("unknown key %s", key))
	}
	return errors.Join(errs...)
}

// covered reports whether key or one of its parents is already reported.
func covered(seen map[string]bool, key toml.Key) bool {
	for i := 1; i <= len(key); i++ {
		if seen[key[:i].String()] {
			return true
		}
	}
	return false
}

// secretLookingSegment returns the first segment of key whose name suggests it
// holds a secret. Segments the user names freely (a provider, a repository, a
// model, a command ID) are not checked.
func secretLookingSegment(key toml.Key) (string, bool) {
	for i, seg := range key {
		if freeName(key, i) {
			continue
		}
		if looksSecret(seg) {
			return seg, true
		}
	}
	return "", false
}

func freeName(key toml.Key, i int) bool {
	switch i {
	case 1:
		return key[0] == "providers" || key[0] == "repos"
	case 3:
		return (key[0] == "providers" && key[2] == "prices") || (key[0] == "repos" && key[2] == "commands")
	}
	return false
}

// secretWords mark a key name as holding a secret wherever they appear in it,
// so github_token, apiKey and client-secret are all caught.
var secretWords = []string{
	"apikey", "api_key", "api-key", "password", "passwd", "secret", "credential",
	"private_key", "privatekey", "access_key", "accesskey",
}

// looksSecret reports whether a key name says its value is a secret. A name
// ending in _env holds the name of an environment variable, which is fine.
// "token" counts unless it is the plural counter, as in max_total_tokens.
func looksSecret(name string) bool {
	name = strings.ToLower(name)
	if strings.HasSuffix(name, "_env") {
		return false
	}
	for _, word := range secretWords {
		if strings.Contains(name, word) {
			return true
		}
	}
	for rest := name; ; {
		i := strings.Index(rest, "token")
		if i < 0 {
			return false
		}
		rest = rest[i+len("token"):]
		if !strings.HasPrefix(rest, "s") {
			return true
		}
	}
}

var durationType = reflect.TypeFor[time.Duration]()

// apply copies every value the layer defines into c and records its source.
// Copying key by key, not table by table, lets a file change one field of a
// provider the defaults already define.
func (c *Config) apply(layer *Config, md toml.MetaData, source Source) error {
	dst := reflect.ValueOf(c).Elem()
	src := reflect.ValueOf(layer).Elem()
	// A trigger map is one policy value. Explicit configuration replaces the
	// built-in labels, so custom labels do not silently retain default triggers.
	if source.Kind == SourceFile && md.IsDefined("webhook", "trigger_labels") {
		c.Webhook.TriggerLabels = make(map[string]string)
		for key := range c.sources {
			if strings.HasPrefix(key, "webhook.trigger_labels.") {
				delete(c.sources, key)
			}
		}
	}
	for _, key := range md.Keys() {
		if md.Type(key...) == "Hash" {
			if err := ensureTable(dst, key); err != nil {
				return fmt.Errorf("key %s: %w", key, err)
			}
			continue
		}
		value, ok := lookup(src, key)
		if !ok {
			return fmt.Errorf("key %s: not in the schema", key)
		}
		if value.Type() == durationType && md.Type(key...) != "String" {
			return fmt.Errorf(`key %s: want a duration string such as "30m"`, key)
		}
		if err := assign(dst, key, value); err != nil {
			return fmt.Errorf("key %s: %w", key, err)
		}
		c.sources[key.String()] = source
	}
	return nil
}

// set parses raw for the field at a dotted key and stores it.
func (c *Config) set(dotted, raw string, source Source) error {
	key := toml.Key(strings.Split(dotted, "."))
	field, ok := lookup(reflect.ValueOf(c).Elem(), key)
	if !ok || !field.CanSet() {
		return fmt.Errorf("unknown config key %q", dotted)
	}
	if err := parseInto(field, raw); err != nil {
		return fmt.Errorf("%s: %w", dotted, err)
	}
	c.sources[key.String()] = source
	return nil
}

// parseInto never quotes raw in an error: an override comes from the
// environment, and a value there may be a secret under the wrong name.
func parseInto(field reflect.Value, raw string) error {
	switch field.Interface().(type) {
	case string:
		field.SetString(raw)
	case bool:
		v, err := strconv.ParseBool(raw)
		if err != nil {
			return errors.New("want true or false")
		}
		field.SetBool(v)
	case int, int64:
		v, err := strconv.ParseInt(raw, 10, field.Type().Bits())
		if err != nil {
			return errors.New("want a whole number")
		}
		field.SetInt(v)
	case float64:
		v, err := strconv.ParseFloat(raw, 64)
		if err != nil {
			return errors.New("want a number")
		}
		field.SetFloat(v)
	case time.Duration:
		v, err := time.ParseDuration(raw)
		if err != nil {
			return errors.New(`want a duration such as "30m"`)
		}
		field.SetInt(int64(v))
	case []string:
		var list []string
		for item := range strings.SplitSeq(raw, ",") {
			if item = strings.TrimSpace(item); item != "" {
				list = append(list, item)
			}
		}
		field.Set(reflect.ValueOf(list))
	default:
		return fmt.Errorf("a value of type %s cannot be set this way", field.Type())
	}
	return nil
}

// fieldByTag returns the field of struct v whose toml tag is name.
func fieldByTag(v reflect.Value, name string) (reflect.Value, bool) {
	t := v.Type()
	for i := range t.NumField() {
		if tag, _, _ := strings.Cut(t.Field(i).Tag.Get("toml"), ","); tag == name && tag != "-" {
			return v.Field(i), true
		}
	}
	return reflect.Value{}, false
}

// lookup follows key through structs, pointers and maps.
func lookup(v reflect.Value, key toml.Key) (reflect.Value, bool) {
	for _, seg := range key {
		if v.Kind() == reflect.Pointer {
			if v.IsNil() {
				return reflect.Value{}, false
			}
			v = v.Elem()
		}
		switch v.Kind() {
		case reflect.Struct:
			f, ok := fieldByTag(v, seg)
			if !ok {
				return reflect.Value{}, false
			}
			v = f
		case reflect.Map:
			v = v.MapIndex(reflect.ValueOf(seg))
			if !v.IsValid() {
				return reflect.Value{}, false
			}
		default:
			return reflect.Value{}, false
		}
	}
	return v, true
}

// descend returns the container that holds the last segment of key, creating
// maps and table entries on the way.
func descend(v reflect.Value, key toml.Key) (reflect.Value, error) {
	for _, seg := range key[:len(key)-1] {
		next, err := child(v, seg)
		if err != nil {
			return reflect.Value{}, err
		}
		v = next
	}
	return v, nil
}

// child returns the table named seg inside v, creating it when v is a map.
func child(v reflect.Value, seg string) (reflect.Value, error) {
	switch v.Kind() {
	case reflect.Struct:
		f, ok := fieldByTag(v, seg)
		if !ok {
			return reflect.Value{}, fmt.Errorf("no table %q", seg)
		}
		return f, nil
	case reflect.Map:
		if v.Type().Elem().Kind() != reflect.Pointer {
			return reflect.Value{}, fmt.Errorf("%q is not a table", seg)
		}
		if v.IsNil() {
			v.Set(reflect.MakeMap(v.Type()))
		}
		k := reflect.ValueOf(seg)
		elem := v.MapIndex(k)
		if !elem.IsValid() || elem.IsNil() {
			elem = reflect.New(v.Type().Elem().Elem())
			v.SetMapIndex(k, elem)
		}
		return elem.Elem(), nil
	default:
		return reflect.Value{}, fmt.Errorf("%q is not a table", seg)
	}
}

// ensureTable makes the table at key exist, so an empty [providers.x] still
// creates the provider.
func ensureTable(root reflect.Value, key toml.Key) error {
	parent, err := descend(root, key)
	if err != nil {
		return err
	}
	table, err := child(parent, key[len(key)-1])
	if err != nil {
		return err
	}
	if table.Kind() == reflect.Map && table.IsNil() {
		table.Set(reflect.MakeMap(table.Type()))
	}
	return nil
}

// assign stores value at key.
func assign(root reflect.Value, key toml.Key, value reflect.Value) error {
	parent, err := descend(root, key)
	if err != nil {
		return err
	}
	last := key[len(key)-1]
	switch parent.Kind() {
	case reflect.Struct:
		f, ok := fieldByTag(parent, last)
		if !ok {
			return fmt.Errorf("no key %q", last)
		}
		f.Set(value)
	case reflect.Map:
		if parent.IsNil() {
			parent.Set(reflect.MakeMap(parent.Type()))
		}
		parent.SetMapIndex(reflect.ValueOf(last), value)
	default:
		return fmt.Errorf("%q cannot hold a value", last)
	}
	return nil
}

func sortedKeys[V any](m map[string]V) []string {
	keys := make([]string, 0, len(m))
	for k := range m {
		keys = append(keys, k)
	}
	slices.Sort(keys)
	return keys
}
package config

import (
	"errors"
	"fmt"
	"math"
	"net"
	"net/url"
	"path"
	"regexp"
	"slices"
	"strings"

	"github.com/aryanpappu/patchbot/internal/execx"
	"github.com/aryanpappu/patchbot/internal/secret"
)

var (
	// Upper case only: it is the convention, and it keeps most pasted keys
	// from passing as a variable name and being printed back.
	envNameRE      = regexp.MustCompile(`^[A-Z_][A-Z0-9_]{0,63}$`)
	providerNameRE = regexp.MustCompile(`^[a-z0-9][a-z0-9_-]{0,63}$`)
	loginRE        = regexp.MustCompile(`^[A-Za-z0-9](?:[A-Za-z0-9]|-[A-Za-z0-9]){0,38}$`)
	repoRE         = regexp.MustCompile(`^[A-Za-z0-9](?:[A-Za-z0-9]|-[A-Za-z0-9]){0,38}/[A-Za-z0-9._-]{1,100}$`)
	commandIDRE    = regexp.MustCompile(`^[a-z][a-z0-9_-]{0,31}$`)
)

// shellMeta are the characters a shell gives meaning to. argv is run without
// a shell, so one of these in the program name is a mistake or an attempt to
// smuggle in a shell command line.
const shellMeta = " \t\r\n|&;<>()$`\\\"'*?[]{}~!#=%^"

// Validate checks the values of a loaded configuration and returns every
// problem it finds, joined with errors.Join. Messages never contain a secret.
//
// A message may quote a bad value to help the user find it. Every message is
// therefore redacted with the secrets the config holds: a key exported under
// the wrong variable name would otherwise be printed as, say, a log level.
func (c *Config) Validate() error {
	v := validator{redactor: c.Redactor()}
	c.validateDefaults(&v)
	c.validateLimits(&v)
	c.validateFixed(&v)
	c.validateExecutor(&v)
	w := c.Webhook
	v.check(envNameRE.MatchString(w.SecretEnv), "webhook.secret_env: must name an environment variable")
	v.check(strings.HasPrefix(w.Path, "/") && w.Path != "/" && path.Clean(w.Path) == w.Path && !strings.ContainsAny(w.Path, "{} ?#\\"), "webhook.path: must be a clean literal path starting with /")
	v.check(!w.Enabled || w.Secret.IsSet(), "webhook.secret_env: enabled webhooks require a secret")
	for label, mode := range w.TriggerLabels {
		v.check(strings.TrimSpace(label) != "" && len(label) <= 100, "webhook.trigger_labels: invalid label")
		v.check(slices.Contains([]string{ModeFix, ModeRefine, ModeInvestigate}, mode), "webhook.trigger_labels: invalid mode")
	}
	for _, name := range sortedKeys(c.Providers) {
		c.validateProvider(&v, name, c.Providers[name])
	}
	for _, name := range sortedKeys(c.Repos) {
		validateRepo(&v, name, c.Repos[name])
	}
	return errors.Join(v.errs...)
}

type validator struct {
	errs     []error
	redactor *secret.Redactor
}

func (v *validator) addf(format string, args ...any) {
	v.errs = append(v.errs, errors.New(v.redactor.Redact(fmt.Sprintf(format, args...))))
}

// check adds the message when ok is false.
func (v *validator) check(ok bool, format string, args ...any) {
	if !ok {
		v.addf(format, args...)
	}
}

func (c *Config) validateDefaults(v *validator) {
	d := c.Defaults
	v.check(slices.Contains([]string{ModeFix, ModeRefine, ModeInvestigate}, d.Mode),
		"defaults.mode: %q is not one of fix, refine, investigate", d.Mode)

	if len(d.Approvers) == 0 {
		v.addf("defaults.approvers: list at least one GitHub login; coding starts only after one of them approves the spec")
	}
	for _, login := range d.Approvers {
		v.check(loginRE.MatchString(login), "defaults.approvers: %q is not a GitHub login", login)
	}

	_, ok := c.Providers[d.Provider]
	switch {
	case d.Provider == "":
		v.addf("defaults.provider: not set")
	case !ok:
		v.addf("defaults.provider: no [providers.%s] table; configured providers: %s",
			d.Provider, orNone(sortedKeys(c.Providers)))
	default:
		for _, stage := range []string{"refine", "code"} {
			if c.Model(stage) == "" {
				v.addf("no model for the %s stage: set defaults.%s_model or providers.%s.default_model "+
					"(`patchbot models --provider %s` lists the choices)", stage, stage, d.Provider, d.Provider)
			}
		}
	}

	if !validMoney(d.MaxCostUSD) || d.MaxCostUSD <= 0 {
		v.addf("defaults.max_cost_usd: must be greater than 0")
	} else if validMoney(c.Limits.HardMaxCostUSD) && d.MaxCostUSD > c.Limits.HardMaxCostUSD {
		v.addf("defaults.max_cost_usd (%v) is above limits.hard_max_cost_usd (%v)",
			d.MaxCostUSD, c.Limits.HardMaxCostUSD)
	}
}

func (c *Config) validateLimits(v *validator) {
	l := c.Limits
	if err := execx.ValidateTrustedPath(l.TrustedPath, c.DataDir()); err != nil {
		v.addf("limits.trusted_path: %s", err)
	}
	v.check(validMoney(l.HardMaxCostUSD) && l.HardMaxCostUSD > 0, "limits.hard_max_cost_usd: must be greater than 0")
	for _, f := range []struct {
		key   string
		value int64
	}{
		{"limits.max_turns", int64(l.MaxTurns)},
		{"limits.refine_max_turns", int64(l.RefineMaxTurns)},
		{"limits.max_output_tokens", int64(l.MaxOutputTokens)},
		{"limits.max_total_tokens", l.MaxTotalTokens},
		{"limits.max_test_attempts", int64(l.MaxTestAttempts)},
		{"limits.run_timeout", int64(l.RunTimeout)},
		{"limits.cmd_timeout", int64(l.CmdTimeout)},
		{"limits.test_timeout", int64(l.TestTimeout)},
		{"limits.cmd_output_bytes", int64(l.CmdOutputBytes)},
		{"limits.cmd_store_bytes", int64(l.CmdStoreBytes)},
		{"approval.poll_interval", int64(c.Approval.PollInterval)},
		{"approval.ttl", int64(c.Approval.TTL)},
		{"webhook.label_poll_interval", int64(c.Webhook.LabelPollInterval)},
		{"approval.max_revisions", int64(c.Approval.MaxRevisions)},
		{"server.max_concurrent_runs", int64(c.Server.MaxConcurrentRuns)},
		{"server.max_queued_runs", int64(c.Server.MaxQueuedRuns)},
	} {
		v.check(f.value > 0, "%s: must be greater than 0", f.key)
	}
	rv := c.Review
	v.check(rv.MaxRepairs == 0 || rv.MaxRepairs == 1, "review.max_repairs: must be 0 or 1")
	v.check(rv.MaxTurns > 0, "review.max_turns: must be greater than 0")
	v.check(rv.ReserveFraction >= 0 && rv.ReserveFraction <= 0.5, "review.reserve_fraction: must be between 0 and 0.5")
	v.check(rv.Model == "" || validModelID(rv.Model), "review.model: %q is not a valid model ID", rv.Model)
	v.check(l.CmdOutputBytes <= l.CmdStoreBytes || l.CmdStoreBytes <= 0,
		"limits.cmd_output_bytes (%d) is above limits.cmd_store_bytes (%d)", l.CmdOutputBytes, l.CmdStoreBytes)
}

func (c *Config) validateFixed(v *validator) {
	v.check(strings.TrimSpace(c.Approval.LocalActor) != "", "approval.local_actor: not set")
	v.check(slices.Contains([]string{"debug", "info", "warn", "error"}, c.Log.Level),
		"log.level: %q is not one of debug, info, warn, error", c.Log.Level)
	v.check(slices.Contains([]string{"text", "json"}, c.Log.Format),
		"log.format: %q is not one of text, json", c.Log.Format)
	v.check(slices.Contains([]string{"cdn", "local"}, c.Server.VueSrc),
		"server.vue_src: %q is not one of cdn, local", c.Server.VueSrc)
	if host, port, err := net.SplitHostPort(c.Server.Addr); err != nil || host == "" || port == "" {
		v.addf("server.addr: %q is not host:port", c.Server.Addr)
	}
	v.check(strings.TrimSpace(c.Data.Dir) != "", "data.dir: not set")
	m := c.Memory
	v.check(m.MaxEntries >= 1 && m.MaxEntries <= 100, "memory.max_entries: must be between 1 and 100")
	v.check(m.MaxBytes >= 256 && m.MaxBytes <= 65536, "memory.max_bytes: must be between 256 and 65536")
	v.check(m.MaxPending >= 1 && m.MaxPending <= 1000, "memory.max_pending: must be between 1 and 1000")
	v.check(m.ObservationTTL > 0, "memory.observation_ttl: must be greater than 0")
}

func (c *Config) validateExecutor(v *validator) {
	e := c.Executor
	v.check(slices.Contains([]string{ExecutorLocal, ExecutorContainer}, e.Kind),
		"executor.kind: %q is not one of local, container", e.Kind)
	if !e.Container() {
		return
	}
	v.check(slices.Contains([]string{execx.RuntimePodman, execx.RuntimeDocker}, e.Runtime),
		"executor.runtime: %q is not one of podman, docker", e.Runtime)
	if e.Image == "" {
		v.addf("executor.image: required for kind container; pin it by digest (name@sha256:...)")
	} else if err := execx.ValidateImage(e.Image); err != nil {
		v.addf("executor.image: %s", err)
	}
	if err := execx.ValidateSize(e.Memory); err != nil {
		v.addf("executor.memory: %s", err)
	}
	if err := execx.ValidateSize(e.TmpfsSize); err != nil {
		v.addf("executor.tmpfs_size: %s", err)
	}
	if err := execx.ValidateCPUs(e.CPUs); err != nil {
		v.addf("executor.cpus: %s", err)
	}
	v.check(e.PidsLimit > 0, "executor.pids_limit: must be greater than 0")
	v.check(e.WorkspaceMaxBytes > 0, "executor.workspace_max_bytes: must be greater than 0")
	v.check(e.Network == "none", "executor.network: %q is not allowed; only \"none\" is supported", e.Network)
	if err := execx.ValidateUser(e.User); err != nil {
		v.addf("executor.user: %s", err)
	}
	v.check(e.UserNS == "" || (e.UserNS == "keep-id" && e.Runtime == execx.RuntimePodman),
		"executor.userns: %q must be empty or \"keep-id\" with runtime podman", e.UserNS)
	if err := execx.ValidateContainerPath(e.Path); err != nil {
		v.addf("executor.path: %s", err)
	}
}

func (c *Config) validateProvider(v *validator, name string, p *Provider) {
	at := "providers." + name
	v.check(providerNameRE.MatchString(name),
		"%s: a provider name uses lower-case letters, digits, - and _", at)
	v.check(slices.Contains([]string{KindAnthropic, KindGemini, KindOpenAI}, p.Kind),
		"%s.kind: %q is not one of anthropic, gemini, openai", at, p.Kind)

	if p.APIKeyEnv != "" && !envNameRE.MatchString(p.APIKeyEnv) {
		// The value is not echoed: the usual cause is a key pasted here.
		v.addf("%s.api_key_env: must be the name of an environment variable (upper-case letters, digits "+
			"and _), not the key itself", at)
	}
	if p.BaseURL != "" {
		u, err := url.Parse(p.BaseURL)
		switch {
		case err != nil || (u.Scheme != "http" && u.Scheme != "https") || u.Host == "":
			v.addf("%s.base_url: must be an http or https URL", at)
		case u.User != nil:
			v.addf("%s.base_url: must not contain a user name or password", at)
		case u.RawQuery != "" || u.Fragment != "":
			v.addf("%s.base_url: must not contain a query or fragment", at)
		}
	}
	if p.Kind == KindOpenAI && p.BaseURL == "" {
		v.addf("%s.base_url: required for kind openai (for example https://api.openai.com/v1)", at)
	}

	for _, model := range p.Models {
		v.check(validModelID(model), "%s.models: %q is not a model ID", at, model)
	}
	if p.DefaultModel != "" {
		v.check(validModelID(p.DefaultModel), "%s.default_model: %q is not a model ID", at, p.DefaultModel)
	}
	if p.PriceFree && len(p.Prices) > 0 {
		v.addf("%s: price_free = true and a prices table contradict each other; keep one", at)
	}
	for _, model := range sortedKeys(p.Prices) {
		price := p.Prices[model]
		pat := fmt.Sprintf("%s.prices.%s", at, model)
		v.check(validModelID(model), "%s: %q is not a model ID", pat, model)
		for _, rate := range []struct {
			name  string
			value *float64
		}{{"input", price.Input}, {"output", price.Output}} {
			switch {
			case rate.value == nil:
				v.addf("%s.%s: missing; a price needs both input and output, and a rate that is "+
					"really free must be written as 0", pat, rate.name)
			case !validMoney(*rate.value):
				v.addf("%s.%s: must be 0 or more", pat, rate.name)
			}
		}
		v.check(price.CacheRead == nil || validMoney(*price.CacheRead), "%s.cache_read: must be 0 or more", pat)
		v.check(price.CacheWrite == nil || validMoney(*price.CacheWrite), "%s.cache_write: must be 0 or more", pat)
	}
}

func validateRepo(v *validator, name string, r *Repo) {
	at := fmt.Sprintf("repos.%q", name)
	_, repo, _ := strings.Cut(name, "/")
	if !repoRE.MatchString(name) || repo == "." || repo == ".." {
		v.addf("%s: a repository key looks like \"owner/name\"", at)
	}
	for _, id := range sortedKeys(r.Commands) {
		argv := r.Commands[id]
		cat := fmt.Sprintf("%s.commands.%s", at, id)
		v.check(commandIDRE.MatchString(id),
			"%s: a command ID uses lower-case letters, digits, - and _, and starts with a letter", cat)
		switch {
		case len(argv) == 0:
			v.addf("%s: must be a non-empty argv array such as [\"go\", \"test\", \"./...\"]", cat)
			continue
		case argv[0] == "":
			v.addf("%s: the program name is empty", cat)
		case strings.HasPrefix(argv[0], "-"):
			v.addf("%s: the program name %q starts with a dash", cat, argv[0])
		case strings.ContainsAny(argv[0], shellMeta) || strings.ContainsFunc(argv[0], isControl):
			v.addf("%s: the program name %q contains a shell metacharacter; commands run without a shell, "+
				"so give the program and each argument as separate array items", cat, argv[0])
		}
		for i, arg := range argv {
			v.check(!strings.ContainsRune(arg, 0), "%s: argument %d contains a NUL byte", cat, i)
		}
	}
	if r.TestCommand != "" {
		if _, ok := r.Commands[r.TestCommand]; !ok {
			v.addf("%s.test_command: no command %q in commands (have: %s)",
				at, r.TestCommand, orNone(sortedKeys(r.Commands)))
		}
	}
	for _, path := range r.Protected {
		v.check(validProtectedPath(path),
			"%s.protected: %q must be a relative path inside the repository, with no \"..\"", at, path)
	}
}

// Warnings returns problems that do not stop patchbot from starting: a model
// with no price, an API key variable that is not set, and the like. A warning
// names the environment variable and never its value.
func (c *Config) Warnings() []string {
	var out []string
	redactor := c.Redactor()
	warnf := func(format string, args ...any) {
		out = append(out, redactor.Redact(fmt.Sprintf(format, args...)))
	}

	for _, name := range sortedKeys(c.Providers) {
		p := c.Providers[name]
		switch {
		case p.APIKeyEnv == "" && p.Kind != KindOpenAI:
			warnf("provider %q: api_key_env is not set, so requests carry no API key", name)
		case p.APIKey.IsSet() && len(p.APIKey.Reveal()) < secret.MinValueLen:
			warnf("provider %q: credential in %s is shorter than %d characters and cannot be masked; use a longer credential", name, p.APIKeyEnv, secret.MinValueLen)
		case p.APIKeyEnv != "" && envNameRE.MatchString(p.APIKeyEnv) && !p.APIKey.IsSet():
			warnf("provider %q: environment variable %s is not set; the provider cannot be used until it is",
				name, p.APIKeyEnv)
		}
		if p.PriceFree {
			continue
		}
		for _, model := range c.providerModels(name) {
			price, ok := p.Prices[model]
			switch {
			case !ok:
				warnf("provider %q: model %q has no price, so its cost is unknown and only the token limit applies; "+
					"add [providers.%s.prices.%q] or set price_free = true", name, model, name, model)
			case price.Checked.IsZero():
				warnf("provider %q: the price of model %q has no checked date", name, model)
			}
		}
	}

	if len(c.Repos) == 0 {
		warnf(`no [repos."owner/name"] table: no run can start until a repository is listed`)
	}
	for _, name := range sortedKeys(c.Repos) {
		if _, ok := c.Repos[name].TestCommandID(); !ok {
			warnf("repo %q: no test command, so its pull requests will be drafts marked unverified", name)
		}
	}
	if host, _, err := net.SplitHostPort(c.Server.Addr); err == nil && !isLoopback(host) {
		warnf("server.addr %q is not a loopback address; patchbot serve will require PATCHBOT_UI_TOKEN", c.Server.Addr)
	}
	return out
}

// providerModels returns the models a provider is expected to run: its list,
// its default and, for the default provider, the two stage models.
func (c *Config) providerModels(name string) []string {
	p := c.Providers[name]
	models := slices.Clone(p.Models)
	add := func(model string) {
		if model != "" && !slices.Contains(models, model) {
			models = append(models, model)
		}
	}
	add(p.DefaultModel)
	if name == c.Defaults.Provider {
		add(c.Defaults.RefineModel)
		add(c.Defaults.CodeModel)
	}
	return models
}

func validMoney(f float64) bool {
	return f >= 0 && !math.IsInf(f, 0) && !math.IsNaN(f)
}

func validModelID(id string) bool {
	return id != "" && len(id) <= 200 && !strings.ContainsFunc(id, func(r rune) bool {
		return isControl(r) || r == ' '
	})
}

func validProtectedPath(path string) bool {
	if path == "" || strings.HasPrefix(path, "/") || strings.ContainsRune(path, 0) || strings.Contains(path, `\`) {
		return false
	}
	for seg := range strings.SplitSeq(strings.TrimSuffix(path, "/"), "/") {
		if seg == "" || seg == "." || seg == ".." {
			return false
		}
	}
	return true
}

func isControl(r rune) bool { return r < 0x20 || r == 0x7f }

func isLoopback(host string) bool {
	if host == "localhost" {
		return true
	}
	ip := net.ParseIP(host)
	return ip != nil && ip.IsLoopback()
}

func orNone(items []string) string {
	if len(items) == 0 {
		return "none"
	}
	return strings.Join(items, ", ")
}
// Package gitx owns deterministic git operations for one disposable checkout.
// Calls are serialized. Close removes private git HOME/hooks/temp directories;
// the caller owns removal of the checkout. This is not a sandbox against hostile
// processes running as the same user; callers must stop repository commands
// before inspecting or publishing the checkout.
package gitx

import (
	"context"
	"errors"
	"fmt"
	"net/url"
	"os"
	"path/filepath"
	"regexp"
	"runtime"
	"strings"
	"sync"
	"time"

	"github.com/aryanpappu/patchbot/internal/execx"
)

const (
	// DefaultTimeout bounds every git invocation, including version checks.
	DefaultTimeout = 2 * time.Minute
	// DefaultOutputCap bounds stdout and stderr independently.
	DefaultOutputCap = 256 << 10
	// MinimumGitVersion includes fixes for CVE-2022-23521 and the 2025 clone
	// vulnerabilities, including CVE-2025-48384. Older Git must not clone repos.
	MinimumGitVersion = "2.50.1"
)

var (
	// ErrTampered indicates changed git configuration or unexpected hooks.
	ErrTampered = errors.New("git metadata was tampered with")
	// ErrBranchGuard indicates an unsafe publication branch.
	ErrBranchGuard = errors.New("git branch guard refused publication")
	// ErrSubmodules indicates an unsupported submodule declaration.
	ErrSubmodules = errors.New("repositories with .gitmodules are refused")
	// ErrOutputLimit means structured output could not be read in full.
	ErrOutputLimit = errors.New("git output exceeded its limit")
)

// CloneOptions describes validated repository coordinates, never an arbitrary
// production URL. Branch is the branch to clone; DefaultBranch defaults to it
// and should come from trusted repository metadata when cloning another branch.
type CloneOptions struct {
	Dir           string
	Host          string
	Owner         string
	Name          string
	Branch        string
	DefaultBranch string
	Depth         int
	Token         string
	Timeout       time.Duration
	OutputCap     int
	// TrustedPath is shared with command policies and doctor. Nil selects defaults.
	TrustedPath []string
	// ExcludedRoots includes the application data and workspace roots.
	ExcludedRoots []string
	// TestOnlyLocalRemote explicitly enables file transport. Only tests should
	// set it, to an absolute local bare repository path. No local hard links.
	TestOnlyLocalRemote string
}

// Author is operator-controlled identity, used for both author and committer.
// The zero value selects patchbot <patchbot@users.noreply.github.com>.
type Author struct {
	Name  string
	Email string
}

// Repo is one checkout. Its credentials and remote URL stay private.
type Repo struct {
	mu                                                    sync.Mutex
	dir, git, home, hooks, temp, private                  string
	host, remote, localRemote, token, base, defaultBranch string
	configHash                                            string
	author                                                Author
	timeout                                               time.Duration
	outputCap                                             int
	closed                                                bool
	path                                                  string
	// observeCommand is a per-repository test seam, called under mu.
	observeCommand func([]string)
}

var (
	coordinate = regexp.MustCompile(`^[A-Za-z0-9_][A-Za-z0-9_.-]*$`)
	hostname   = regexp.MustCompile(`^[A-Za-z0-9](?:[A-Za-z0-9.-]*[A-Za-z0-9])?$`)
	objectID   = regexp.MustCompile(`^(?:[0-9a-fA-F]{40}|[0-9a-fA-F]{64})$`)
)

// Clone checks MinimumGitVersion once and clones into a nonexistent Dir.
// On failure it removes only directories it created, including a partial clone.
func Clone(ctx context.Context, opts CloneOptions) (_ *Repo, cloneErr error) {
	if runtime.GOOS == "windows" || runtime.GOOS == "plan9" {
		return nil, errors.New("git process groups require a Unix host")
	}
	if !filepath.IsAbs(opts.Dir) || strings.ContainsRune(opts.Dir, 0) || opts.Depth < 0 ||
		opts.Timeout < 0 || opts.OutputCap < 0 || !validBranch(opts.Branch) {
		return nil, errors.New("invalid clone options")
	}
	if opts.DefaultBranch == "" {
		opts.DefaultBranch = opts.Branch
	}
	if !validBranch(opts.DefaultBranch) || strings.ContainsRune(opts.Token, 0) {
		return nil, errors.New("invalid clone options")
	}
	if _, err := os.Lstat(opts.Dir); !errors.Is(err, os.ErrNotExist) {
		return nil, errors.New("clone destination must not exist")
	}
	r := &Repo{dir: opts.Dir, host: opts.Host, token: opts.Token, defaultBranch: opts.DefaultBranch,
		timeout: opts.Timeout, outputCap: opts.OutputCap, localRemote: opts.TestOnlyLocalRemote,
		author: Author{"patchbot", "patchbot@users.noreply.github.com"}}
	if r.timeout == 0 {
		r.timeout = DefaultTimeout
	}
	if r.outputCap == 0 {
		r.outputCap = DefaultOutputCap
	}
	if r.outputCap < 64 {
		return nil, errors.New("output cap must be at least 64 bytes")
	}
	if r.localRemote != "" {
		if !filepath.IsAbs(r.localRemote) || strings.ContainsRune(r.localRemote, 0) {
			return nil, errors.New("test remote must be an absolute local path")
		}
		r.remote = (&url.URL{Scheme: "file", Path: r.localRemote}).String()
	} else {
		if !hostname.MatchString(opts.Host) || strings.Contains(opts.Host, "..") ||
			!coordinate.MatchString(opts.Owner) || !coordinate.MatchString(opts.Name) ||
			opts.Owner == "." || opts.Owner == ".." || opts.Name == "." || opts.Name == ".." {
			return nil, errors.New("invalid repository coordinates")
		}
		r.remote = "https://" + opts.Host + "/" + opts.Owner + "/" + opts.Name + ".git"
	}
	dirs := opts.TrustedPath
	if dirs == nil {
		dirs = filepath.SplitList(execx.TrustedPath)
	}
	r.path = strings.Join(dirs, string(filepath.ListSeparator))
	var err error
	r.git, err = ResolveGit(dirs, append([]string{opts.Dir}, opts.ExcludedRoots...)...)
	if err != nil {
		return nil, err
	}
	private, err := os.MkdirTemp("", "patchbot-git-")
	if err != nil {
		return nil, errors.New("create private git directories failed")
	}
	r.private = private
	defer func() {
		if cloneErr != nil {
			_ = os.RemoveAll(private)
		}
	}()
	r.home, r.hooks, r.temp = filepath.Join(private, "home"), filepath.Join(private, "hooks"), filepath.Join(private, "tmp")
	for _, dir := range []string{r.home, r.hooks, r.temp} {
		if err := os.Mkdir(dir, 0700); err != nil {
			return nil, errors.New("create private git directory failed")
		}
	}
	// Reserve the destination ourselves so a failed clone never removes a
	// directory another actor created between validation and git clone.
	if err := os.Mkdir(opts.Dir, 0700); err != nil {
		return nil, errors.New("reserve clone destination failed")
	}
	defer func() {
		if cloneErr != nil {
			_ = os.RemoveAll(opts.Dir)
		}
	}()
	r.dir = private
	version, err := r.complete(ctx, false, "--version")
	if err != nil {
		return nil, err
	}
	if err := checkGitVersion(version); err != nil {
		return nil, err
	}
	args := []string{"clone", "--no-local", "--single-branch", "--no-tags", "--no-recurse-submodules", "--template=" + r.hooks, "--branch", opts.Branch}
	if opts.Depth > 0 {
		args = append(args, "--depth", fmt.Sprint(opts.Depth))
	}
	args = append(args, "--", r.remote, opts.Dir)
	if _, err := r.complete(ctx, true, args...); err != nil {
		return nil, err
	}
	r.dir = opts.Dir
	if err := r.noSubmodules(ctx); err != nil {
		return nil, err
	}
	r.base, err = r.head(ctx)
	if err != nil {
		return nil, err
	}
	r.configHash, err = r.hashConfig()
	if err != nil {
		return nil, err
	}
	return r, nil
}

// Dir is the absolute checkout path; it remains valid after Close.
func (r *Repo) Dir() string { return r.dir }

// Close discards credentials and removes the private git execution directories.
// The workspace owner is responsible for removing the checkout itself.
func (r *Repo) Close() error {
	r.mu.Lock()
	defer r.mu.Unlock()
	r.closed, r.token = true, ""
	if err := os.RemoveAll(r.private); err != nil {
		return errors.New("remove private git directories failed")
	}
	return nil
}

func validBranch(name string) bool {
	if name == "" || name == "@" || strings.HasPrefix(name, "-") || strings.HasSuffix(name, ".") ||
		strings.ContainsAny(name, " ~^:?*[\\\x00\t\r\n") || strings.Contains(name, "..") || strings.Contains(name, "@{") {
		return false
	}
	for _, part := range strings.Split(name, "/") {
		if part == "" || strings.HasPrefix(part, ".") || strings.HasSuffix(part, ".lock") {
			return false
		}
		for _, ch := range part {
			if ch < 32 || ch == 127 {
				return false
			}
		}
	}
	return true
}

func (r *Repo) head(ctx context.Context) (string, error) {
	out, err := r.complete(ctx, false, "rev-parse", "--verify", "HEAD^{commit}")
	if err != nil {
		return "", err
	}
	sha := strings.TrimSpace(out)
	if !objectID.MatchString(sha) {
		return "", errors.New("git returned an invalid commit ID")
	}
	return sha, nil
}

// HeadSHA returns the checked-out commit ID.
func (r *Repo) HeadSHA(ctx context.Context) (string, error) {
	r.mu.Lock()
	defer r.mu.Unlock()
	if err := r.verify(); err != nil {
		return "", err
	}
	return r.head(ctx)
}

// CheckoutSHA detaches at a full commit ID and updates the base for future diffs.
// Fetches by ID when shallow history does not contain the approved spec's base.
// As required, fetch gets no token; a private host must permit this fetch without
// credentials, or the caller must initially use a full clone.
func (r *Repo) CheckoutSHA(ctx context.Context, sha string) error {
	r.mu.Lock()
	defer r.mu.Unlock()
	if !objectID.MatchString(sha) {
		return errors.New("checkout requires a full commit ID")
	}
	if err := r.verify(); err != nil {
		return err
	}
	if _, err := r.complete(ctx, false, "cat-file", "-e", sha+"^{commit}"); err != nil {
		if _, err := r.complete(ctx, false, "fetch", "--no-tags", "--recurse-submodules=no", "--depth=1", "--", r.remote, sha); err != nil {
			return err
		}
	}
	if _, err := r.complete(ctx, false, "checkout", "--detach", sha, "--"); err != nil {
		return err
	}
	if err := r.noSubmodules(ctx); err != nil {
		return err
	}
	var err error
	r.base, err = r.head(ctx)
	return err
}

// CreateBranch creates and switches to a new local branch.
func (r *Repo) CreateBranch(ctx context.Context, name string) error {
	r.mu.Lock()
	defer r.mu.Unlock()
	if !validBranch(name) {
		return ErrBranchGuard
	}
	if err := r.verify(); err != nil {
		return err
	}
	_, err := r.complete(ctx, false, "switch", "--no-guess", "-c", name, "--")
	return err
}

func (r *Repo) noSubmodules(ctx context.Context) error {
	// ls-tree also finds .gitmodules hidden by a sparse checkout or deletion.
	out, err := r.complete(ctx, false, "ls-tree", "-r", "-z", "--name-only", "HEAD")
	if err != nil {
		return err
	}
	for _, path := range strings.Split(out, "\x00") {
		for _, part := range strings.Split(path, "/") {
			if strings.EqualFold(part, ".gitmodules") {
				return ErrSubmodules
			}
		}
	}
	return nil
}

// ResolveGit is the single git lookup used by clone/push and doctor.
func ResolveGit(dirs []string, excluded ...string) (string, error) {
	return execx.ResolveExecutable("git", dirs, excluded...)
}
package github

import (
	"encoding/base64"
	"encoding/json"
	"fmt"
	"net/http"
	"net/url"
	"strconv"
	"strings"
	"time"
)

const maxErrorBody = 1024

// APIError is a bounded, credential-redacted GitHub error response.
// Use errors.As to inspect this or one of the specific status error types.
type APIError struct {
	StatusCode int
	Message    string
}

func (e *APIError) Error() string {
	return fmt.Sprintf("GitHub HTTP %d: %s", e.StatusCode, e.Message)
}

// ErrNotFound indicates HTTP 404.
type ErrNotFound struct{ APIError }

// Unwrap exposes the common API error metadata.
func (e *ErrNotFound) Unwrap() error { return &e.APIError }

// ErrUnauthorized indicates HTTP 401.
type ErrUnauthorized struct{ APIError }

// Unwrap exposes the common API error metadata.
func (e *ErrUnauthorized) Unwrap() error { return &e.APIError }

// ErrForbidden indicates HTTP 403 without evidence of a rate limit.
type ErrForbidden struct{ APIError }

// Unwrap exposes the common API error metadata.
func (e *ErrForbidden) Unwrap() error { return &e.APIError }

// ErrRateLimited indicates a primary or secondary rate limit. Reset is zero
// when GitHub provides no valid reset or retry header; the caller chooses backoff.
type ErrRateLimited struct {
	APIError
	Reset time.Time
}

// Unwrap exposes the common API error metadata.
func (e *ErrRateLimited) Unwrap() error { return &e.APIError }

// ErrValidation indicates HTTP 422, including GitHub's validation message.
type ErrValidation struct{ APIError }

// Unwrap exposes the common API error metadata.
func (e *ErrValidation) Unwrap() error { return &e.APIError }

func responseError(status int, header http.Header, body []byte, token string) error {
	message := string(body)
	var wire struct{ Message string }
	if json.Unmarshal(body, &wire) == nil && wire.Message != "" {
		message = wire.Message
	}
	limited := strings.ToLower(message)
	api := APIError{StatusCode: status, Message: redactMessage(message, token)}
	switch {
	case status == http.StatusTooManyRequests || (status == http.StatusForbidden &&
		(header.Get("X-RateLimit-Remaining") == "0" || header.Get("Retry-After") != "" ||
			strings.Contains(limited, "rate limit") || strings.Contains(limited, "abuse detection"))):
		return &ErrRateLimited{APIError: api, Reset: rateReset(header, time.Now())}
	case status == http.StatusNotFound:
		return &ErrNotFound{api}
	case status == http.StatusUnauthorized:
		return &ErrUnauthorized{api}
	case status == http.StatusForbidden:
		return &ErrForbidden{api}
	case status == http.StatusUnprocessableEntity:
		return &ErrValidation{api}
	default:
		return &api
	}
}

func rateReset(header http.Header, now time.Time) time.Time {
	var reset time.Time
	if seconds, err := strconv.ParseInt(header.Get("X-RateLimit-Reset"), 10, 64); err == nil && seconds >= 0 {
		reset = time.Unix(seconds, 0).UTC()
	}
	retry := header.Get("Retry-After")
	// Bound the conversion to time.Duration so a hostile header cannot overflow.
	if seconds, err := strconv.ParseInt(retry, 10, 64); err == nil && seconds >= 0 && seconds <= 1<<32 {
		if after := now.Add(time.Duration(seconds) * time.Second); after.After(reset) {
			reset = after
		}
	} else if after, err := http.ParseTime(retry); err == nil && after.After(reset) {
		reset = after
	}
	return reset
}

func tokenForms(token string) []string {
	if token == "" {
		return nil
	}
	return []string{token, url.QueryEscape(token), url.PathEscape(token),
		base64.StdEncoding.EncodeToString([]byte(token)), base64.RawStdEncoding.EncodeToString([]byte(token))}
}

func redactMessage(message, token string) string {
	for _, secret := range tokenForms(token) {
		message = strings.ReplaceAll(message, secret, "[redacted]")
		// A truncated response may end partway through a credential.
		for n := min(len(secret)-1, len(message)); n > 0; n-- {
			if strings.HasSuffix(message, secret[:n]) {
				message = message[:len(message)-n] + "[redacted]"
				break
			}
		}
	}
	if len(message) > maxErrorBody {
		message = message[:maxErrorBody]
	}
	return message
}
