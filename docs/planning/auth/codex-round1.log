# GitHub auth model for patchbot: Claude's opening position (2026-11-13)

Context: one owner (aryanpappu), self-hosted patchbot on a shared Mumbai server, repos allowlisted in config,
planned M23 (login dashboard via Cloudflare Access JWT) and M24 (add/edit repos from the dashboard).
Today: one fine-grained PAT in GITHUB_TOKEN (env), used for clone/push (GIT_CONFIG_* header, never argv)
and REST (issues, comments, PRs). `github.TokenSource` seam exists. Owner asks: account-wide token or
per-repo token?

## Options
A. One account-wide classic PAT (repo scope). Simple; blast radius = every repo the owner has, incl. private
   and other people's orgs. Never expires unless set. Reject.
B. One fine-grained PAT covering "selected repos". Owner edits repo list on GitHub when adding a repo.
   One secret, least privilege per repo set, max 1 year expiry. Blast radius = the selected set.
C. One fine-grained PAT per repo, stored per repo (encrypted in SQLite, key from env). Smallest blast radius
   per token, but N secrets to create/rotate by hand, and secrets now live in the DB (today: env only).
D. GitHub App installed on chosen repos. Private key in env; patchbot mints 1-hour installation tokens
   scoped per run to exactly ONE repo (`repositories=[name]`) with only contents/issues/pull_requests.
   Commits/PRs show as `patchbot[bot]`, so `/approve` from the owner is clearly distinct from the bot's own
   comments. Adding a repo = tick it in the App installation (or dashboard deep link). No long-lived repo token.

## My recommendation
Now (pilot): B — one fine-grained PAT, selected repos, 90-day expiry. Zero code.
Next milestone (with M24): D — GitHub App behind the existing TokenSource, per-run single-repo
installation tokens, keep PAT as fallback for local/dev. Not C: per-repo PATs multiply manual secrets and
move secrets into the DB for less benefit than D gives automatically.
Dashboard "add repo" (M24) must verify the App installation (or PAT) can actually reach the repo before
saving, and never accept a token through the web UI.
package github

import (
	"bytes"
	"context"
	"encoding/json"
	"errors"
	"fmt"
	"io"
	"net/http"
	"net/url"
	"slices"
	"strings"
	"time"

	"github.com/aryanpappu/patchbot/internal/version"
)

const (
	defaultBaseURL  = "https://api.github.com"
	requestTimeout  = 30 * time.Second
	maxResponseBody = 10 << 20
	maxComments     = 300
)

// HTTPClient implements Client using the versioned GitHub REST API. Its settings
// are immutable after construction, making it safe for concurrent use.
type HTTPClient struct {
	httpClient *http.Client
	baseURL    *url.URL
	tokens     TokenSource
	userAgent  string
}

var _ Client = (*HTTPClient)(nil)

// New constructs a REST client. Empty baseURL selects api.github.com; an
// Enterprise base URL can include /api/v3. A nil httpClient uses http.DefaultClient.
// Each request has a 30 second deadline, including token acquisition and reads.
// The supplied http.Client is copied; redirects are refused to protect credentials.
func New(httpClient *http.Client, baseURL string, tokens TokenSource) (*HTTPClient, error) {
	if tokens == nil {
		return nil, errors.New("New: token source is required")
	}
	if baseURL == "" {
		baseURL = defaultBaseURL
	}
	base, err := url.Parse(baseURL)
	if err != nil || (base.Scheme != "https" && base.Scheme != "http") || base.Host == "" ||
		base.User != nil || base.RawQuery != "" || base.ForceQuery || base.Fragment != "" || base.Opaque != "" {
		return nil, errors.New("New: invalid GitHub API base URL")
	}
	if httpClient == nil {
		httpClient = http.DefaultClient
	}
	transport := *httpClient
	transport.CheckRedirect = func(*http.Request, []*http.Request) error { return http.ErrUseLastResponse }
	return &HTTPClient{
		httpClient: &transport, baseURL: base, tokens: tokens, userAgent: "patchbot/" + version.Version,
	}, nil
}

func (c *HTTPClient) endpoint(repo RepoRef, parts ...string) (*url.URL, error) {
	if !validRepoPart(repo.Owner) || !validRepoPart(repo.Name) {
		return nil, errors.New("invalid repository reference")
	}
	path := strings.TrimRight(c.baseURL.EscapedPath(), "/") + "/repos/" +
		url.PathEscape(repo.Owner) + "/" + url.PathEscape(repo.Name)
	for _, part := range parts {
		if part == "" || part == "." || part == ".." || strings.ContainsRune(part, 0) {
			return nil, errors.New("invalid API path component")
		}
		path += "/" + url.PathEscape(part)
	}
	u := *c.baseURL
	decoded, err := url.PathUnescape(path)
	if err != nil {
		return nil, errors.New("invalid API path")
	}
	u.Path, u.RawPath = decoded, path
	return &u, nil
}

func validRepoPart(part string) bool {
	return part != "" && part != "." && part != ".." && !strings.ContainsAny(part, "/\\\x00")
}

type responseMeta struct {
	header http.Header
	status int
}

func (c *HTTPClient) request(ctx context.Context, method string, target *url.URL, body, out any, statuses ...int) (responseMeta, error) {
	ctx, cancel := context.WithTimeout(ctx, requestTimeout)
	defer cancel()
	token, err := c.tokens.Token(ctx)
	if err != nil {
		if ctx.Err() != nil {
			return responseMeta{}, ctx.Err()
		}
		// A token source's error can itself contain a credential.
		return responseMeta{}, errors.New("authentication token unavailable")
	}
	if token == "" || strings.ContainsAny(token, "\r\n") {
		return responseMeta{}, errors.New("invalid authentication token")
	}
	for _, secret := range tokenForms(token) {
		if strings.Contains(target.String(), secret) {
			return responseMeta{}, errors.New("credential found in request URL")
		}
	}
	var data []byte
	if body != nil {
		data, err = json.Marshal(body)
		if err != nil {
			return responseMeta{}, errors.New("cannot encode request body")
		}
	}
	req, err := http.NewRequestWithContext(ctx, method, target.String(), bytes.NewReader(data))
	if err != nil {
		return responseMeta{}, errors.New("cannot construct API request")
	}
	req.Header.Set("Accept", "application/vnd.github+json")
	req.Header.Set("X-GitHub-Api-Version", "2022-11-28")
	req.Header.Set("User-Agent", c.userAgent)
	req.Header.Set("Authorization", "Bearer "+token)
	if body != nil {
		req.Header.Set("Content-Type", "application/json")
	}
	if etag, ok := ctx.Value(etagKey{}).(string); ok && etag != "" {
		req.Header.Set("If-None-Match", etag)
	}
	resp, err := c.httpClient.Do(req)
	if err != nil {
		return responseMeta{}, safeIOError(ctx, err, "API request failed")
	}
	defer func() { _ = resp.Body.Close() }()
	meta := responseMeta{header: resp.Header, status: resp.StatusCode}
	if !slices.Contains(statuses, resp.StatusCode) {
		data, readErr := io.ReadAll(io.LimitReader(resp.Body, maxErrorBody))
		if readErr != nil {
			return meta, safeIOError(ctx, readErr, "cannot read API error response")
		}
		return meta, responseError(resp.StatusCode, resp.Header, data, token)
	}
	data, err = io.ReadAll(io.LimitReader(resp.Body, maxResponseBody+1))
	if err != nil {
		return meta, safeIOError(ctx, err, "cannot read API response")
	}
	if len(data) > maxResponseBody {
		return meta, errors.New("API response exceeds 10 MB")
	}
	if out != nil && resp.StatusCode != http.StatusNotModified {
		if err := json.Unmarshal(data, out); err != nil {
			// Decoder errors can quote response data, including echoed credentials.
			return meta, errors.New("invalid API JSON response")
		}
	}
	return meta, nil
}

func safeIOError(ctx context.Context, err error, message string) error {
	if ctx.Err() != nil {
		return ctx.Err()
	}
	if errors.Is(err, context.Canceled) {
		return context.Canceled
	}
	if errors.Is(err, context.DeadlineExceeded) {
		return context.DeadlineExceeded
	}
	return errors.New(message)
}

// nextPage accepts only links to the same API endpoint, preventing pagination
// from sending authorization to another host or an unrelated API path.
func nextPage(current *url.URL, header http.Header) (*url.URL, error) {
	for _, line := range header.Values("Link") {
		for _, link := range strings.Split(line, ",") {
			parts := strings.Split(link, ";")
			next := false
			for _, parameter := range parts[1:] {
				key, value, ok := strings.Cut(strings.TrimSpace(parameter), "=")
				if ok && strings.EqualFold(key, "rel") && slices.Contains(strings.Fields(strings.Trim(value, "\"")), "next") {
					next = true
				}
			}
			if !next {
				continue
			}
			ref, err := url.Parse(strings.Trim(strings.TrimSpace(parts[0]), "<>"))
			if err != nil {
				return nil, errors.New("invalid pagination URL")
			}
			u := current.ResolveReference(ref)
			if u.Scheme != current.Scheme || u.Host != current.Host || u.EscapedPath() != current.EscapedPath() ||
				u.User != nil || u.Fragment != "" || u.Opaque != "" {
				return nil, errors.New("unsafe pagination URL")
			}
			return u, nil
		}
	}
	return nil, nil
}

func operationError(operation string, err error) error {
	if err == nil {
		return nil
	}
	return fmt.Errorf("%s: %w", operation, err)
}
package github

import (
	"context"
	"errors"
	"net/http"
	"strings"
)

// CurrentUser obtains the authenticated bot login for fail-closed comment sync.
func (c *HTTPClient) CurrentUser(ctx context.Context) (string, error) {
	target := *c.baseURL
	target.Path = strings.TrimRight(target.Path, "/") + "/user"
	target.RawPath = ""
	var user struct {
		Login string `json:"login"`
	}
	_, err := c.request(ctx, http.MethodGet, &target, nil, &user, http.StatusOK)
	if err != nil {
		return "", operationError("CurrentUser", err)
	}
	if user.Login == "" {
		return "", errors.New("CurrentUser: missing login")
	}
	return user.Login, nil
}
package github

import (
	"context"
	"errors"
	"net/http"
	"net/url"
	"strconv"
	"time"
)

func (c *HTTPClient) call(ctx context.Context, repo RepoRef, parts []string, method string, in, out any, statuses ...int) (responseMeta, error) {
	u, err := c.endpoint(repo, parts...)
	if err != nil {
		return responseMeta{}, err
	}
	return c.request(ctx, method, u, in, out, statuses...)
}

// GetRepo fetches preflight metadata, including push permission and visibility.
func (c *HTTPClient) GetRepo(ctx context.Context, ref RepoRef) (Repo, error) {
	var repo Repo
	_, err := c.call(ctx, ref, nil, http.MethodGet, nil, &repo, http.StatusOK)
	return repo, operationError("GetRepo", err)
}

// GetIssue fetches the issue's current text and metadata.
func (c *HTTPClient) GetIssue(ctx context.Context, repo RepoRef, number int) (Issue, error) {
	var issue Issue
	_, err := c.call(ctx, repo, []string{"issues", strconv.Itoa(number)}, http.MethodGet, nil, &issue, http.StatusOK)
	return issue, operationError("GetIssue", err)
}

// GetIssueComment fetches a spec rendering for the runner's tampering check.
func (c *HTTPClient) GetIssueComment(ctx context.Context, repo RepoRef, id int64) (Comment, error) {
	var comment Comment
	_, err := c.call(ctx, repo, []string{"issues", "comments", strconv.FormatInt(id, 10)}, http.MethodGet, nil, &comment, http.StatusOK)
	return comment, operationError("GetIssueComment", err)
}

// ListIssueComments follows Link pagination, returning at most 300 comments.
// A zero since includes all comments; otherwise GitHub filters by updated time.
func (c *HTTPClient) ListIssueComments(ctx context.Context, repo RepoRef, number int, since time.Time) ([]Comment, error) {
	comments, _, _, err := c.listComments(ctx, repo, number, since, "")
	return comments, operationError("ListIssueComments", err)
}

// ListIssueCommentsSince supports conditional polling. The ETag is returned only
// for a single-page response: caching one page cannot validate later pages.
func (c *HTTPClient) ListIssueCommentsSince(ctx context.Context, repo RepoRef, number int, since time.Time, etag string) ([]Comment, string, bool, error) {
	comments, newETag, unchanged, err := c.listComments(ctx, repo, number, since, etag)
	return comments, newETag, unchanged, operationError("ListIssueCommentsSince", err)
}

type etagKey struct{}

func (c *HTTPClient) listComments(ctx context.Context, repo RepoRef, number int, since time.Time, etag string) ([]Comment, string, bool, error) {
	u, err := c.endpoint(repo, "issues", strconv.Itoa(number), "comments")
	if err != nil {
		return nil, "", false, err
	}
	query := url.Values{"per_page": {"100"}}
	if !since.IsZero() {
		query.Set("since", since.UTC().Format(time.RFC3339Nano))
	}
	u.RawQuery = query.Encode()
	comments := make([]Comment, 0)
	seen := make(map[string]bool)
	var newETag string
	for page := 0; u != nil; page++ {
		if page >= maxComments || seen[u.String()] {
			return nil, "", false, errors.New("pagination cycle or page limit exceeded")
		}
		seen[u.String()] = true
		requestCtx := ctx
		if page == 0 && etag != "" {
			requestCtx = context.WithValue(ctx, etagKey{}, etag)
		}
		var batch []Comment
		meta, err := c.request(requestCtx, http.MethodGet, u, nil, &batch, http.StatusOK, http.StatusNotModified)
		if err != nil {
			return nil, "", false, err
		}
		if meta.status == http.StatusNotModified {
			if page != 0 || etag == "" {
				return nil, "", false, errors.New("unexpected not-modified response")
			}
			if newETag = meta.header.Get("ETag"); newETag == "" {
				newETag = etag
			}
			return nil, newETag, true, nil
		}
		if page == 0 {
			newETag = meta.header.Get("ETag")
		} else {
			newETag = ""
		}
		remaining := maxComments - len(comments)
		comments = append(comments, batch[:min(len(batch), remaining)]...)
		if len(comments) == maxComments {
			return comments, "", false, nil
		}
		u, err = nextPage(u, meta.header)
		if err != nil {
			return nil, "", false, err
		}
	}
	return comments, newETag, false, nil
}

// CreateIssueComment posts text with mentions neutralized.
func (c *HTTPClient) CreateIssueComment(ctx context.Context, repo RepoRef, number int, body string) (Comment, error) {
	var comment Comment
	in := struct {
		Body string `json:"body"`
	}{NeutralizeMentions(body)}
	_, err := c.call(ctx, repo, []string{"issues", strconv.Itoa(number), "comments"}, http.MethodPost, in, &comment, http.StatusCreated)
	return comment, operationError("CreateIssueComment", err)
}

// UpdateIssueComment replaces a comment with mention-neutralized text.
func (c *HTTPClient) UpdateIssueComment(ctx context.Context, repo RepoRef, id int64, body string) error {
	in := struct {
		Body string `json:"body"`
	}{NeutralizeMentions(body)}
	_, err := c.call(ctx, repo, []string{"issues", "comments", strconv.FormatInt(id, 10)}, http.MethodPatch, in, nil, http.StatusOK)
	return operationError("UpdateIssueComment", err)
}

// IsCollaborator checks live repository membership rather than trusting a
// comment's author_association. Missing membership (404) is not an error.
func (c *HTTPClient) IsCollaborator(ctx context.Context, repo RepoRef, user string) (bool, error) {
	_, err := c.call(ctx, repo, []string{"collaborators", user}, http.MethodGet, nil, nil, http.StatusNoContent)
	var missing *ErrNotFound
	if errors.As(err, &missing) {
		return false, nil
	}
	return err == nil, operationError("IsCollaborator", err)
}

// FindOpenPR finds an open pull request whose head belongs to this repository.
// It returns nil when no matching pull request exists.
func (c *HTTPClient) FindOpenPR(ctx context.Context, repo RepoRef, headBranch string) (*PullRequest, error) {
	u, err := c.endpoint(repo, "pulls")
	if err != nil {
		return nil, operationError("FindOpenPR", err)
	}
	u.RawQuery = url.Values{"state": {"open"}, "head": {repo.Owner + ":" + headBranch}, "per_page": {"100"}}.Encode()
	var prs []PullRequest
	_, err = c.request(ctx, http.MethodGet, u, nil, &prs, http.StatusOK)
	if err != nil {
		return nil, operationError("FindOpenPR", err)
	}
	if len(prs) == 0 {
		return nil, nil
	}
	return &prs[0], nil
}

// CreatePR publishes a pull request, preserving the harness's draft decision.
// Both the title and body have mentions neutralized before sending.
func (c *HTTPClient) CreatePR(ctx context.Context, repo RepoRef, in NewPR) (PullRequest, error) {
	in.Title, in.Body = NeutralizeMentions(in.Title), NeutralizeMentions(in.Body)
	var pr PullRequest
	_, err := c.call(ctx, repo, []string{"pulls"}, http.MethodPost, in, &pr, http.StatusCreated)
	return pr, operationError("CreatePR", err)
}

// GetBranch fetches a branch and reports whether it exists.
func (c *HTTPClient) GetBranch(ctx context.Context, repo RepoRef, branch string) (Branch, bool, error) {
	var result Branch
	_, err := c.call(ctx, repo, []string{"branches", branch}, http.MethodGet, nil, &result, http.StatusOK)
	var missing *ErrNotFound
	if errors.As(err, &missing) {
		return Branch{}, false, nil
	}
	return result, err == nil, operationError("GetBranch", err)
}

// BranchExists is a convenience for callers that do not need the branch tip.
func (c *HTTPClient) BranchExists(ctx context.Context, repo RepoRef, branch string) (bool, error) {
	_, exists, err := c.GetBranch(ctx, repo, branch)
	return exists, operationError("BranchExists", err)
}

// AddLabels adds labels without removing existing labels.
func (c *HTTPClient) AddLabels(ctx context.Context, repo RepoRef, number int, labels []string) error {
	if labels == nil {
		labels = []string{}
	}
	in := struct {
		Labels []string `json:"labels"`
	}{labels}
	_, err := c.call(ctx, repo, []string{"issues", strconv.Itoa(number), "labels"}, http.MethodPost, in, nil, http.StatusOK)
	return operationError("AddLabels", err)
}

// RemoveLabel removes one label, encoding slashes and spaces as part of its name.
func (c *HTTPClient) RemoveLabel(ctx context.Context, repo RepoRef, number int, label string) error {
	_, err := c.call(ctx, repo, []string{"issues", strconv.Itoa(number), "labels", label}, http.MethodDelete, nil, nil, http.StatusOK)
	return operationError("RemoveLabel", err)
}

// ListOpenIssues returns one page of current open issues for label polling.
func (c *HTTPClient) ListOpenIssues(ctx context.Context, repo RepoRef, page int) ([]Issue, error) {
	u, err := c.endpoint(repo, "issues")
	if err != nil {
		return nil, err
	}
	q := u.Query()
	q.Set("state", "open")
	q.Set("per_page", "100")
	q.Set("page", strconv.Itoa(page))
	u.RawQuery = q.Encode()
	var issues []Issue
	_, err = c.request(ctx, http.MethodGet, u, nil, &issues, http.StatusOK)
	return issues, operationError("ListOpenIssues", err)
}
// Package github provides the GitHub REST operations needed by the runner.
package github

import (
	"context"
	"encoding/json"
	"time"
)

// TokenSource supplies a PAT today and can supply GitHub App tokens later.
// Implementations must be safe for concurrent calls.
type TokenSource interface {
	Token(context.Context) (string, error)
}

// Client is the runner's GitHub boundary. Missing branches and open PRs return
// false and nil respectively; other missing resources return *ErrNotFound.
type Client interface {
	GetRepo(context.Context, RepoRef) (Repo, error)
	GetIssue(context.Context, RepoRef, int) (Issue, error)
	ListIssueComments(context.Context, RepoRef, int, time.Time) ([]Comment, error)
	ListIssueCommentsSince(context.Context, RepoRef, int, time.Time, string) ([]Comment, string, bool, error)
	GetIssueComment(context.Context, RepoRef, int64) (Comment, error)
	CreateIssueComment(context.Context, RepoRef, int, string) (Comment, error)
	UpdateIssueComment(context.Context, RepoRef, int64, string) error
	IsCollaborator(context.Context, RepoRef, string) (bool, error)
	FindOpenPR(context.Context, RepoRef, string) (*PullRequest, error)
	CreatePR(context.Context, RepoRef, NewPR) (PullRequest, error)
	GetBranch(context.Context, RepoRef, string) (Branch, bool, error)
	BranchExists(context.Context, RepoRef, string) (bool, error)
	AddLabels(context.Context, RepoRef, int, []string) error
	RemoveLabel(context.Context, RepoRef, int, string) error
}

// RepoRef identifies a repository without a URL or credentials.
type RepoRef struct {
	Owner string
	Name  string
}

// Permissions contains the repository capabilities needed for preflight.
type Permissions struct {
	Push bool `json:"push"`
}

// Repo contains repository metadata used for preflight and cloning.
type Repo struct {
	Name          string      `json:"name"`
	FullName      string      `json:"full_name"`
	DefaultBranch string      `json:"default_branch"`
	CloneURL      string      `json:"clone_url"`
	Private       bool        `json:"private"`
	Permissions   Permissions `json:"permissions"`
}

// Label is a GitHub issue label.
type Label struct {
	Name string `json:"name"`
}

// Issue includes the current issue text used to invalidate stale approvals.
type Issue struct {
	Number            int       `json:"number"`
	Title             string    `json:"title"`
	Body              string    `json:"body"`
	State             string    `json:"state"`
	Labels            []Label   `json:"labels"`
	IsPullRequest     bool      `json:"-"`
	Author            string    `json:"-"`
	AuthorAssociation string    `json:"author_association"`
	HTMLURL           string    `json:"html_url"`
	UpdatedAt         time.Time `json:"updated_at"`
}

// UnmarshalJSON normalizes GitHub's nested user and pull_request fields.
func (i *Issue) UnmarshalJSON(data []byte) error {
	type plain Issue
	var wire struct {
		plain
		User        struct{ Login string } `json:"user"`
		PullRequest *json.RawMessage       `json:"pull_request"`
	}
	if err := json.Unmarshal(data, &wire); err != nil {
		return err
	}
	*i = Issue(wire.plain)
	i.Author = wire.User.Login
	i.IsPullRequest = wire.PullRequest != nil
	return nil
}

// Comment retains timestamps so edited commands can be rejected.
type Comment struct {
	ID                int64     `json:"id"`
	Author            string    `json:"-"`
	AuthorAssociation string    `json:"author_association"`
	Body              string    `json:"body"`
	CreatedAt         time.Time `json:"created_at"`
	UpdatedAt         time.Time `json:"updated_at"`
	HTMLURL           string    `json:"html_url"`
}

// UnmarshalJSON normalizes GitHub's nested user field.
func (c *Comment) UnmarshalJSON(data []byte) error {
	type plain Comment
	var wire struct {
		plain
		User struct{ Login string } `json:"user"`
	}
	if err := json.Unmarshal(data, &wire); err != nil {
		return err
	}
	*c = Comment(wire.plain)
	c.Author = wire.User.Login
	return nil
}

// PRBranch identifies the head or base of a pull request.
type PRBranch struct {
	Ref string `json:"ref"`
	SHA string `json:"sha"`
}

// PullRequest is the result of finding or creating a pull request.
type PullRequest struct {
	Number  int      `json:"number"`
	Title   string   `json:"title"`
	Body    string   `json:"body"`
	State   string   `json:"state"`
	HTMLURL string   `json:"html_url"`
	Draft   bool     `json:"draft"`
	Head    PRBranch `json:"head"`
	Base    PRBranch `json:"base"`
}

// NewPR supplies the fields required to publish a pull request.
type NewPR struct {
	Title string `json:"title"`
	Body  string `json:"body"`
	Head  string `json:"head"`
	Base  string `json:"base"`
	Draft bool   `json:"draft"`
}

// Branch contains the branch name and tip commit.
type Branch struct {
	Name   string `json:"name"`
	Commit struct {
		SHA string `json:"sha"`
	} `json:"commit"`
}
package gitx

import (
	"context"
	"encoding/base64"
	"errors"
	"fmt"
	"os/exec"
	"strings"
	"time"

	"github.com/aryanpappu/patchbot/internal/execx"
)

const trustedPath = execx.TrustedPath

// command builds the entire environment explicitly. Credentials are deliberately
// absent from argv, including -c arguments, and from all non-publication calls.
func (r *Repo) command(_ context.Context, authenticated bool, args ...string) (*exec.Cmd, error) {
	if authenticated && (len(args) == 0 || (args[0] != "clone" && args[0] != "push")) {
		return nil, errors.New("credentials are restricted to clone and push")
	}
	for _, arg := range args {
		if strings.ContainsRune(arg, 0) || (r.token != "" && strings.Contains(arg, r.token)) {
			return nil, errors.New("invalid git argument")
		}
	}
	protocol := "never"
	if r.localRemote != "" {
		protocol = "always"
	}
	argv := []string{
		"--literal-pathspecs",
		"-c", "core.hooksPath=" + r.hooks,
		"-c", "core.fsmonitor=false",
		"-c", "protocol.allow=never",
		"-c", "protocol.https.allow=always",
		"-c", "protocol.file.allow=" + protocol,
		"-c", "submodule.recurse=false",
		"-c", "fetch.recurseSubmodules=false",
		"-c", "credential.helper=",
		"-c", "credential.interactive=false",
		"-c", "http.followRedirects=false",
		"-c", "core.attributesFile=/dev/null",
		"-c", "core.quotePath=false",
		"-c", "core.pager=cat",
		"-c", "core.bigFileThreshold=1m",
		"-c", "commit.gpgSign=false",
		"-c", "tag.gpgSign=false",
	}
	argv = append(argv, args...)
	cmd := exec.Command(r.git, argv...) // #nosec G204 -- executable is resolved from the configured trusted PATH; literal git subcommands, no shell.
	cmd.Dir = r.dir
	cmd.Env = []string{
		"PATH=" + r.path, "HOME=" + r.home, "TMPDIR=" + r.temp,
		"LANG=C", "LC_ALL=C", "GIT_CONFIG_NOSYSTEM=1", "GIT_CONFIG_GLOBAL=/dev/null",
		"GIT_TERMINAL_PROMPT=0", "GIT_ATTR_NOSYSTEM=1", "GIT_NO_REPLACE_OBJECTS=1",
		"GIT_AUTHOR_NAME=" + r.author.Name, "GIT_AUTHOR_EMAIL=" + r.author.Email,
		"GIT_COMMITTER_NAME=" + r.author.Name, "GIT_COMMITTER_EMAIL=" + r.author.Email,
	}
	if authenticated && r.token != "" {
		encoded := base64.StdEncoding.EncodeToString([]byte("x-access-token:" + r.token))
		cmd.Env = append(cmd.Env, "GIT_CONFIG_COUNT=1",
			"GIT_CONFIG_KEY_0=http.https://"+r.host+"/.extraheader",
			"GIT_CONFIG_VALUE_0=AUTHORIZATION: basic "+encoded)
	}
	cmd.WaitDelay = time.Second
	return cmd, nil
}

// run never includes argv, environment, stderr, or OS error strings in errors.
// Even a remote that echoes an encoded/fragmented secret cannot leak it there.
func (r *Repo) run(ctx context.Context, authenticated bool, args ...string) (string, bool, error) {
	return r.runIndex(ctx, authenticated, "", args...)
}

func (r *Repo) runIndex(ctx context.Context, authenticated bool, index string, args ...string) (string, bool, error) {
	return r.runIndexLimit(ctx, authenticated, index, r.outputCap, args...)
}

func (r *Repo) runIndexLimit(ctx context.Context, authenticated bool, index string, limit int, args ...string) (string, bool, error) {
	if r.observeCommand != nil {
		r.observeCommand(args)
	}
	ctx, cancel := context.WithTimeout(ctx, r.timeout)
	defer cancel()
	cmd, err := r.command(ctx, authenticated, args...)
	if err != nil {
		return "", false, err
	}
	if index != "" {
		cmd.Env = append(cmd.Env, "GIT_INDEX_FILE="+index)
	}
	out, diagnostic := &cappedBuffer{limit: limit}, &cappedBuffer{limit: r.outputCap}
	cmd.Stdout, cmd.Stderr = out, diagnostic
	err = execx.RunProcessGroup(ctx, cmd, execx.DefaultGracePeriod)
	if ctx.Err() != nil {
		return "", false, fmt.Errorf("git command: %w", ctx.Err())
	}
	if err != nil {
		var exitErr *exec.ExitError
		if errors.As(err, &exitErr) {
			return "", false, fmt.Errorf("git command failed (exit %d)", exitErr.ExitCode())
		}
		return "", false, errors.New("git command could not complete")
	}
	return string(out.data), out.truncated, nil
}

func (r *Repo) complete(ctx context.Context, authenticated bool, args ...string) (string, error) {
	out, truncated, err := r.run(ctx, authenticated, args...)
	if err == nil && truncated {
		err = ErrOutputLimit
	}
	return out, err
}

// os/exec serializes writes to each buffer. Continue draining after the cap.
type cappedBuffer struct {
	data      []byte
	limit     int
	truncated bool
}

func (b *cappedBuffer) Write(p []byte) (int, error) {
	n := len(p)
	keep := min(n, b.limit-len(b.data))
	b.data = append(b.data, p[:keep]...)
	b.truncated = b.truncated || keep != n
	return n, nil
}
package gitx

import (
	"context"
	"errors"
	"strings"
)

// CommitAll stages only enumerated Status paths, then commits with the controlled
// author/committer identity and no hooks or signing. Policy checks for protected
// application files belong to the caller's workspace/orchestration layer.
func (r *Repo) CommitAll(ctx context.Context, msg string, author Author) (string, error) {
	r.mu.Lock()
	defer r.mu.Unlock()
	if err := r.verify(); err != nil {
		return "", err
	}
	if msg == "" || strings.ContainsRune(msg, 0) {
		return "", errors.New("invalid commit message")
	}
	if author == (Author{}) {
		author = Author{"patchbot", "patchbot@users.noreply.github.com"}
	}
	if author.Name == "" || author.Email == "" || strings.ContainsAny(author.Name+author.Email, "\r\n\x00<>") {
		return "", errors.New("invalid commit identity")
	}
	r.author = author
	changes, err := r.status(ctx)
	if err != nil {
		return "", err
	}
	paths, err := changedPaths(changes)
	if err != nil {
		return "", err
	}
	if err := r.noSubmodules(ctx); err != nil {
		return "", err
	}
	if err := r.stage(ctx, "", paths); err != nil {
		return "", err
	}
	if _, err := r.complete(ctx, false, "commit", "--no-verify", "--no-gpg-sign", "-m", msg, "--"); err != nil {
		return "", err
	}
	return r.head(ctx)
}

// Push verifies metadata and branch guards before pushing an explicit refspec to
// the original, constructed URL. It never consults remote.pushurl or push defaults.
// The live remote HEAD check is intentionally unauthenticated: only clone and
// push receive the token. An inaccessible remote fails closed.
func (r *Repo) Push(ctx context.Context, branch string) error {
	r.mu.Lock()
	defer r.mu.Unlock()
	if !validBranch(branch) || !strings.HasPrefix(branch, "patchbot/") || branch == r.defaultBranch {
		return ErrBranchGuard
	}
	if err := r.verify(); err != nil {
		return err
	}
	if err := r.noSubmodules(ctx); err != nil {
		return err
	}
	changes, err := r.status(ctx)
	if err != nil {
		return err
	}
	if _, err := changedPaths(changes); err != nil {
		return err
	}
	head, err := r.complete(ctx, false, "ls-remote", "--symref", "--", r.remote, "HEAD")
	if err != nil {
		return err
	}
	var liveDefault string
	for _, line := range strings.Split(head, "\n") {
		if ref, ok := strings.CutPrefix(line, "ref: refs/heads/"); ok {
			if name, suffix, ok := strings.Cut(ref, "\t"); ok && suffix == "HEAD" {
				liveDefault = name
			}
		}
	}
	if liveDefault == "" || liveDefault == branch {
		return ErrBranchGuard
	}
	_, err = r.complete(ctx, true, "push", "--no-verify", "--recurse-submodules=no", "--", r.remote, "HEAD:refs/heads/"+branch)
	return err
}

// RemoteBranchExists queries exactly one branch without inheriting credentials.
func (r *Repo) RemoteBranchExists(ctx context.Context, branch string) (bool, error) {
	r.mu.Lock()
	defer r.mu.Unlock()
	if !validBranch(branch) {
		return false, ErrBranchGuard
	}
	if err := r.verify(); err != nil {
		return false, err
	}
	out, err := r.complete(ctx, false, "ls-remote", "--heads", "--", r.remote, "refs/heads/"+branch)
	if err != nil {
		return false, err
	}
	for _, line := range strings.Split(out, "\n") {
		sha, ref, ok := strings.Cut(line, "\t")
		if ok && ref == "refs/heads/"+branch && objectID.MatchString(sha) {
			return true, nil
		}
	}
	return false, nil
}

