// Options supplies trusted infrastructure. Clone, Executor and Constructors are
// test seams; production uses gitx, execx and the raw provider constructors.
type Options struct {
	// Dispatch hands durable work to an owning manager. Nil runs synchronously.
	Dispatch func(context.Context, int64, func(context.Context) error) error
	// Admit reserves bounded dispatch capacity before any durable mutation.
	// The returned context carries admission through Dispatch; release is always called.
	Admit func(context.Context) (context.Context, func(), error)
	// ActionChannel is ui for the local web server; otherwise local actions use cli.
	ActionChannel string
	// Redactor adds CLI/server credentials to model and persistence boundaries.
	Redactor *secret.Redactor

	GitHub       github.Client
	Tokens       github.TokenSource
	Constructors llm.Constructors
	Clone        func(context.Context, gitx.CloneOptions) (*gitx.Repo, error)
	Executor     func(string) (execx.Executor, error)
	// ContainerSweep removes containers left by a previous process. Nil uses
	// execx.SweepContainers when [executor] kind is container.
	ContainerSweep    func(context.Context) (int, error)
	Clock             func() time.Time
	BotLogin          string
	HeartbeatInterval time.Duration
	StaleAfter        time.Duration
	// DisableFailureComments suppresses the otherwise enabled failure comment.
	DisableFailureComments bool
}

// Request fixes provider/model and limits for the lifetime of a new run.
type Request struct {
	// IngressKey is supplied only by automatic label reconciliation.
	IngressKey             string
	Repo                   string
	Issue                  int64
	Mode, Provider, Model  string
	RefineModel, CodeModel string
	DryRun                 bool
	MaxCostMicros          int64
}

// Runner is safe for concurrent actions. Long work owns a per-run context;
// Cancel also works from another process through the persisted status.
type Runner struct {
	cfg      *config.Config
	db       store.Store
	gh       github.Client
	opts     Options
	redactor *secret.Redactor
	mu       sync.Mutex
	active   map[int64]context.CancelFunc
	controls map[int64]*sync.Mutex
}

type runLimits struct {
	Agent       agent.Limits
	RefineTurns int
	Timeout     time.Duration
}

// Token is a secret-backed PAT source, shared by GitHub and git clone/push.
type Token struct{ Value secret.Secret }

// Token supplies a credential without embedding it in diagnostics.
func (t Token) Token(context.Context) (string, error) {
	if !t.Value.IsSet() {
		return "", errors.New("set GITHUB_TOKEN")
	}
	return t.Value.Reveal(), nil
}

// New prepares the runner and recovers expired heartbeats on startup.
// The caller owns the store and closes it after runner work has finished.
func New(ctx context.Context, cfg *config.Config, db store.Store, opts Options) (*Runner, error) {
	if cfg == nil || db == nil {
		return nil, errors.New("runner requires configuration and storage")
	}
	if err := cfg.Validate(); err != nil {
		return nil, err
	}
	if opts.Clock == nil {
		opts.Clock = time.Now
	}
	if opts.Clone == nil {
		opts.Clone = gitx.Clone
	}
	if opts.Executor == nil {
		opts.Executor = defaultExecutor(cfg)
	}
	if opts.Constructors == nil {
		opts.Constructors = providers.Constructors(providers.Options{})
	}
	if opts.HeartbeatInterval <= 0 {
		opts.HeartbeatInterval = 10 * time.Second
	}
	if opts.StaleAfter <= 0 {
		opts.StaleAfter = time.Minute
	}
	if opts.Tokens == nil {
		opts.Tokens = Token{Value: secret.New(os.Getenv("GITHUB_TOKEN"))}
	}
	gh := opts.GitHub
	if gh == nil {
		var err error
		gh, err = github.New(nil, "", opts.Tokens)
		if err != nil {
			return nil, err
		}
	}
	r := &Runner{cfg: cfg, db: db, gh: gh, opts: opts, redactor: cfg.Redactor(), active: make(map[int64]context.CancelFunc), controls: make(map[int64]*sync.Mutex)}
	r.redactor.Extend(opts.Redactor)
	if token, err := opts.Tokens.Token(ctx); err == nil {
		r.redactor.AddSecrets(secret.New(token))
	}
	if err := r.RecoverStale(ctx); err != nil {
		return nil, err
	}
	r.sweepContainers(ctx)
	manager, err := workspace.NewManager(cfg.DataDir())
	if err != nil {
		return nil, err
	}
	_, sweepErr := manager.Sweep(ctx, max(24*time.Hour, cfg.Limits.RunTimeout+cfg.Limits.TestTimeout+opts.StaleAfter))
	if err := errors.Join(sweepErr, manager.Close()); err != nil {
		return nil, err
	}
	if err := r.expireWaiting(ctx); err != nil {
		return nil, err
	}
	return r, nil
}

func (r *Runner) now() time.Time { return r.opts.Clock().UTC() }
func (r *Runner) control(id int64) *sync.Mutex {
	r.mu.Lock()
	defer r.mu.Unlock()
	if r.controls[id] == nil {
		r.controls[id] = &sync.Mutex{}
	}
	return r.controls[id]
}

// ErrInvalidRequest identifies a rejected operator input without quoting it.
var ErrInvalidRequest = errors.New("invalid run request")

var repoPattern = regexp.MustCompile(`^[A-Za-z0-9_][A-Za-z0-9_.-]*/[A-Za-z0-9_][A-Za-z0-9_.-]*$`)

	env  *tools.Env
	dir  string
}

func (e *toolEnvironment) close() error {
	if e == nil || e.dir == "" {
		return nil
	}
	dir := e.dir
	e.dir = ""
	err := errors.Join(e.env.WS.Close(false), e.repo.Close())
	root, openErr := os.OpenRoot(filepath.Dir(dir))
	if openErr != nil {
		return errors.Join(err, openErr)
	}
	defer func() { _ = root.Close() }()
	return errors.Join(err, root.RemoveAll(filepath.Base(dir)))
}

func (r *Runner) clone(ctx context.Context, run store.Run, meta github.Repo, sha string) (_ *toolEnvironment, err error) {
	base := filepath.Join(r.cfg.DataDir(), "workspaces")
	if err := os.MkdirAll(base, 0700); err != nil {
		return nil, errors.New("create workspace directory failed")
	}
	dir, err := os.MkdirTemp(base, "run-"+strconv.FormatInt(run.ID, 10)+"-")
	if err != nil {
		return nil, errors.New("create run workspace failed")
	}
	defer func() {
		if err != nil {
			_ = os.RemoveAll(dir)
		}
	}()
	token, err := r.opts.Tokens.Token(ctx)
	if err != nil {
		return nil, errors.New("GitHub token unavailable; set GITHUB_TOKEN")
	}
	var repo *gitx.Repo
	defer func() {
		if err != nil && repo != nil {
			_ = repo.Close()
		}
	}()
	err = r.operation(ctx, run, "git", "clone", func() error {
		var cloneErr error
		repo, cloneErr = r.opts.Clone(ctx, gitx.CloneOptions{Dir: filepath.Join(dir, "repo"), Host: "github.com", Owner: ref(run.Repo).Owner, Name: ref(run.Repo).Name, Branch: meta.DefaultBranch, DefaultBranch: meta.DefaultBranch, Token: token, TrustedPath: r.cfg.Limits.TrustedPath, ExcludedRoots: []string{r.cfg.DataDir()}})
		return cloneErr
	})
	if err != nil {
		return nil, err
	}
	if sha != "" {
		if err := r.operation(ctx, run, "git", "checkout_sha", func() error { return repo.CheckoutSHA(ctx, sha) }); err != nil {
			return nil, err
		}
	}
	ws, err := workspace.Open(repo.Dir(), workspace.Options{Protected: r.cfg.Repos[run.Repo].Protected})
	if err != nil {
		return nil, err
	}
	defer func() {
		if err != nil {
			_ = ws.Close(false)
		}
	}()
	policy, err := execx.NewPolicy(ws.Dir(), r.cfg.Repos[run.Repo].Commands, r.cfg.CommandPolicyOptions())
# patchbot Step 2 plan (merged, owner-approved 2026-11-13)

Sources: claude-position.md, codex-round1.md, claude-round2.md, codex-round2.md (Codex final word; where it
adds stricter acceptance criteria for M17/M18 those criteria win).

Deploy target: Oracle Mumbai CyberPanel box (aarch64, 4 OCPU/24 GB, Ubuntu 24.04). It also hosts the live
site stock.mishra.eu.org, so isolation is mandatory and patchbot is fully separated from CyberPanel users.

## Agreed principles
1. Memory: auto-active memory = typed observations only (command ID, exit status, base/head SHA, policy
   digest, timeout flag, evidence ref). Prose lessons are `pending` until operator approval. All memory is
   delivered as an untrusted data block, never in system instructions. Per-stage selected entry IDs +
   content hashes are frozen and recorded. Memory cannot change command policy, protected paths, repo
   scope or the approved spec. Off switch. No FTS/embeddings in v1; deterministic bounded selection.
2. Orchestration: planner/coder split already exists (RefineModel/CodeModel). Add only an opt-in
   sequential reviewer: read-only tools, structured verdict bound to spec hash + diff hash, one repair
   cycle with re-verification, shared budget/deadline. Timeout/refusal/malformed verdict never approves.
   Off by default.
3. Isolation: every repo command (baseline, agent run_cmd, harness tests) runs in a rootless container:
   `--network none`, read-only rootfs + tmpfs, `--cap-drop ALL`, no-new-privileges, pids/memory/cpu limits,
   non-root UID, only the per-run workspace mounted. The service user is never in the `docker` group and
   never sees a rootful socket. Git with the token stays host-side; file tools stay host-side (os.Root).
4. Webhooks are wake-up hints: HMAC over raw body, durable delivery dedupe, then reconcile against GitHub
   state; polling remains. Labels can start refinement, never approve. Off by default.
5. Deploy: dedicated `patchbot` Unix user (not a CyberPanel/site user), systemd, loopback bind + UI token,
   Cloudflare Tunnel + Access (owner only), host git >= 2.50.1, one active run, cgroup caps leaving the live
   site >= 2 OCPU / 12 GB, SQLite online backup + restore drill.

## Milestones
| # | Milestone | Owner | Done when |
|---|---|---|---|
| M16 | Live baseline on Mac with a demo repo | Claude (needs owner GitHub token + model key) | refine→approve→code→test→PR on demo repo; evidence recorded in docs/M16-REPORT.md |
| M17 | Container executor (podman/docker rootless, `executor = "local"\|"container"`) | Claude agent | adversarial tests: host-file read, net egress, fork bomb, disk fill, descendant kill on cancel all contained; local executor unchanged |
| M18 | Deploy rehearsal on Mumbai | Claude | user/systemd/tunnel/Access up; doctor green; backup+restore and restart/stale-run drills pass |
| M19 | Server pilot + fault drill | Claude | approve, obsolete approval, repair, cancel, restart, PR ambiguity on server; live-site impact measured |
| M20 | Memory v1 | Claude agent | tests: repo separation, pending/revoked never retrieved, zero-exit stdout poison never becomes trusted prose, memory can't alter policy/approval, frozen selection recorded |
| M21 | Opt-in reviewer | Claude agent | verdict bound to spec+diff hash; fail-closed; one repair + re-verify; budget shared; seeded-defect fake tests |
| M22 | Webhook/label ingress (off by default) | Codex | HMAC, bounded body, durable dedupe, reconcile; duplicate/reordered/missed delivery tests; no label approval |

Migration numbers reserved: 0003 memory, 0004 reviewer, 0005 webhooks.
Every milestone: `make ci` green, code-review pass, one conventional commit, merged into `development`.

## Owner requests after the first pilot round (2026-11-13), to build together later
| # | Milestone | Notes |
|---|---|---|
| M23 | Login-based dashboard | Verify the Cloudflare Access JWT (`Cf-Access-Jwt-Assertion`, team JWKS, audience tag) server-side and record the logged-in email as the approval actor; replaces the dropped UI token. Optional local user/password login for non-Cloudflare installs. |
| M24 | Repository management in the dashboard | Add/edit/remove allowlisted repos (commands, test command, protected paths, image) from the UI, stored in SQLite with audit; config file stays the bootstrap. Requires M23 login first. |
| M25 | Per-repo container image | `[repos."x"] image = ...` overriding `[executor] image`, so Go and PHP repos run side by side. |
| M26 | Create issue from the dashboard | Write a feature request in the UI → patchbot opens the GitHub issue and starts refine. |

Interim (2026-11-13): UI token removed on Mumbai at owner request. Port 8080 on loopback is limited by
iptables (owner match) to root (cloudflared) and the patchbot user, so other local users and CyberPanel
sites cannot reach the API; Cloudflare Access (owner only) is the only login.
