package runner

import (
	"context"
	"errors"
	"sort"
	"strconv"
	"strings"

	"github.com/aryanpappu/patchbot/internal/github"
	"github.com/aryanpappu/patchbot/internal/store"
)

// ReconcileIngress reads current GitHub state; webhook content never authorizes
// an action. Comment reconciliation uses the same gate as polling.
func (r *Runner) ReconcileIngress(ctx context.Context, repo string, number int64, labels bool) error {
	if r.cfg.Repos[repo] == nil || number <= 0 {
		return nil
	}
	meta, err := r.gh.GetRepo(ctx, ref(repo))
	if err != nil {
		return err
	}
	if !strings.EqualFold(meta.FullName, repo) {
		return nil
	}
	issue, err := r.gh.GetIssue(ctx, ref(repo), int(number))
	if err != nil {
		return err
	}
	if issue.Number != int(number) || issue.IsPullRequest || issue.State != "open" {
		return nil
	}
	if issue.HTMLURL != "" && !strings.EqualFold(issue.HTMLURL, "https://github.com/"+repo+"/issues/"+strconv.FormatInt(number, 10)) {
		return nil
	}
	page, err := r.db.ListRuns(ctx, store.RunFilter{Repo: repo, IssueNumber: number, Limit: 500})
	if err != nil {
		return err
	}
	if !labels {
		for _, run := range page.Runs {
			if waiting(run.Status) && !run.DryRun {
				if r.expired(run) {
					return r.expire(ctx, run)
				}
				if err := r.syncRun(ctx, run); err != nil && !errors.Is(err, store.ErrConflict) && !errors.Is(err, store.ErrActiveRunExists) {
					return err
				}
			}
		}
		return nil
	}

	names := make([]string, 0, len(issue.Labels))
	for _, label := range issue.Labels {
		if _, ok := r.cfg.Webhook.TriggerLabels[label.Name]; ok {
			names = append(names, label.Name)
		}
	}
	sort.Strings(names)
	label := ""
	if len(names) > 0 {
		label = names[0]
	}
	generation, err := r.db.ObserveTriggerLabel(ctx, repo, number, label)
	if err != nil {
		return err
	}
	if label == "" {
		return nil
	}
	key := "label:" + repo + ":" + strconv.FormatInt(number, 10) + ":" + strconv.FormatInt(generation, 10)
	_, err = r.Start(ctx, Request{Repo: repo, Issue: number, Mode: r.cfg.Webhook.TriggerLabels[label], IngressKey: key})
	if errors.Is(err, store.ErrConflict) || errors.Is(err, store.ErrActiveRunExists) {
		return nil
	}
	return err
}

// SyncLabels recovers missed issue label deliveries. The optional listing seam
// keeps clients that only support the original runner API usable.
func (r *Runner) SyncLabels(ctx context.Context) error {
	if !r.cfg.Webhook.Enabled {
		return nil
	}
	listing, ok := r.gh.(interface {
		ListOpenIssues(context.Context, github.RepoRef, int) ([]github.Issue, error)
	})
	if !ok {
		return nil
	}
	var errs []error
	for repo := range r.cfg.Repos {
		for page := 1; ; page++ {
			issues, err := listing.ListOpenIssues(ctx, ref(repo), page)
			if err != nil {
				errs = append(errs, err)
				break
			}
			for _, issue := range issues {
				if !issue.IsPullRequest {
					if err := r.ReconcileIngress(ctx, repo, int64(issue.Number), true); err != nil {
						errs = append(errs, err)
					}
				}
			}
			if len(issues) < 100 {
				break
			}
		}
	}
	return errors.Join(errs...)
}
package server

import (
	"context"
	"crypto/hmac"
	"crypto/sha256"
	"encoding/hex"
	"encoding/json"
	"errors"
	"io"
	"net/http"
	"strconv"
	"strings"

	"github.com/aryanpappu/patchbot/internal/github"
	"github.com/aryanpappu/patchbot/internal/store"
)

func (s *Server) webhook(w http.ResponseWriter, r *http.Request) {
	if r.Method != http.MethodPost {
		w.WriteHeader(http.StatusMethodNotAllowed)
		return
	}
	s.mu.RLock()
	stopping := s.stopping
	s.mu.RUnlock()
	if stopping {
		w.WriteHeader(http.StatusServiceUnavailable)
		return
	}
	body, err := io.ReadAll(http.MaxBytesReader(w, r.Body, 1<<20))
	if err != nil {
		w.WriteHeader(http.StatusRequestEntityTooLarge)
		return
	}
	signature, ok := strings.CutPrefix(r.Header.Get("X-Hub-Signature-256"), "sha256=")
	received, err := hex.DecodeString(signature)
	mac := hmac.New(sha256.New, []byte(s.cfg.Webhook.Secret.Reveal()))
	_, _ = mac.Write(body)
	if !ok || err != nil || !s.cfg.Webhook.Secret.IsSet() || !hmac.Equal(received, mac.Sum(nil)) {
		w.WriteHeader(http.StatusUnauthorized)
		return
	}
	id := r.Header.Get("X-GitHub-Delivery")
	if id == "" || len(id) > 200 {
		w.WriteHeader(http.StatusBadRequest)
		return
	}
	var payload struct {
		Action     string `json:"action"`
		Repository struct {
			FullName string `json:"full_name"`
		} `json:"repository"`
		Issue github.Issue `json:"issue"`
		Label github.Label `json:"label"`
	}
	if json.Unmarshal(body, &payload) != nil {
		w.WriteHeader(http.StatusBadRequest)
		return
	}
	event := r.Header.Get("X-GitHub-Event")
	repo := strings.ToLower(payload.Repository.FullName)
	eligible := event == "issue_comment" || (event == "issues" && (payload.Action == "unlabeled" || (payload.Action == "labeled" && s.cfg.Webhook.TriggerLabels[payload.Label.Name] != "")))
	if payload.Issue.HTMLURL != "" && !strings.EqualFold(payload.Issue.HTMLURL, "https://github.com/"+repo+"/issues/"+strconv.Itoa(payload.Issue.Number)) {
		w.WriteHeader(http.StatusAccepted)
		return
	}
	if !eligible || payload.Issue.IsPullRequest || payload.Issue.Number <= 0 || s.cfg.Repos[repo] == nil {
		w.WriteHeader(http.StatusAccepted)
		return
	}
	if err := s.db.RecordDelivery(r.Context(), store.Delivery{ID: id, Event: event, Repo: repo, Issue: int64(payload.Issue.Number)}); err != nil {
		w.WriteHeader(http.StatusServiceUnavailable)
		return
	}
	select {
	case s.ingressWake <- struct{}{}:
	default:
	}
	w.WriteHeader(http.StatusAccepted)
}

func (s *Server) reconcileDeliveries(ctx context.Context) error {
	s.ingressMu.Lock()
	defer s.ingressMu.Unlock()
	deliveries, err := s.db.PendingDeliveries(ctx)
	if err != nil {
		return err
	}
	var errs []error
	for _, d := range deliveries {
		if err := s.runner.ReconcileIngress(ctx, d.Repo, d.Issue, d.Event == "issues"); err != nil {
			errs = append(errs, err)
			continue
		}
		if err := s.db.CompleteDelivery(ctx, d.ID); err != nil {
			errs = append(errs, err)
		}
	}
	return errors.Join(errs...)
}
package store

import "context"

// Delivery is a durable wake-up hint, containing no command or approval data.
type Delivery struct {
	ID, Event, Repo string
	Issue           int64
}

// RecordDelivery preserves the original hint when GitHub retries a delivery.
func (s *SQLite) RecordDelivery(ctx context.Context, d Delivery) error {
	_, err := s.db.ExecContext(ctx, `INSERT INTO webhook_deliveries(delivery_id,event,repo,issue) VALUES(?,?,?,?) ON CONFLICT(delivery_id) DO NOTHING`, d.ID, d.Event, d.Repo, d.Issue)
	return err
}

// PendingDeliveries includes receipts left unfinished by a process crash.
func (s *SQLite) PendingDeliveries(ctx context.Context) ([]Delivery, error) {
	rows, err := s.db.QueryContext(ctx, `SELECT delivery_id,event,repo,issue FROM webhook_deliveries WHERE processed=0 ORDER BY delivery_id LIMIT 100`)
	if err != nil {
		return nil, err
	}
	defer func() { _ = rows.Close() }()
	var out []Delivery
	for rows.Next() {
		var d Delivery
		if err := rows.Scan(&d.ID, &d.Event, &d.Repo, &d.Issue); err != nil {
			return nil, err
		}
		out = append(out, d)
	}
	return out, rows.Err()
}

// CompleteDelivery acknowledges a successfully reconciled hint.
func (s *SQLite) CompleteDelivery(ctx context.Context, id string) error {
	_, err := s.db.ExecContext(ctx, `UPDATE webhook_deliveries SET processed=1 WHERE delivery_id=?`, id)
	return err
}

// ObserveTriggerLabel latches the current trigger. Only an observed removal or
// change rearms it, so bot edits and repeated deliveries cannot retrigger work.
func (s *SQLite) ObserveTriggerLabel(ctx context.Context, repo string, issue int64, label string) (int64, error) {
	var generation int64
	err := s.db.QueryRowContext(ctx, `INSERT INTO webhook_labels(repo,issue,label,generation) VALUES(?,?,?,1)
 ON CONFLICT(repo,issue) DO UPDATE SET generation=webhook_labels.generation + CASE WHEN webhook_labels.label != excluded.label THEN 1 ELSE 0 END, label=excluded.label RETURNING generation`, repo, issue, label).Scan(&generation)
	return generation, err
}
