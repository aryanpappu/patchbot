// Package server serves the local JSON API and resumable event streams.
package server

import (
	"context"
	"crypto/sha256"
	"crypto/subtle"
	"errors"
	"io"
	"log"
	"net"
	"net/http"
	"os"
	"path"
	"strconv"
	"strings"
	"sync"
	"time"

	"github.com/aryanpappu/patchbot/internal/config"
	"github.com/aryanpappu/patchbot/internal/llm"
	"github.com/aryanpappu/patchbot/internal/llm/providers"
	"github.com/aryanpappu/patchbot/internal/runner"
	"github.com/aryanpappu/patchbot/internal/secret"
	"github.com/aryanpappu/patchbot/internal/store"
	"github.com/aryanpappu/patchbot/internal/web"
)

// Options supplies trusted infrastructure. Zero values use production defaults.
type Options struct {
	Token           secret.Secret
	Runner          runner.Options
	ShutdownTimeout time.Duration
	// Short intervals are useful to exercise timers without network or live keys.
	HeartbeatInterval  time.Duration
	PollInterval       time.Duration
	StreamWriteTimeout time.Duration
	SyncInterval       time.Duration
}

// Server owns background runs and stream lifetimes. The caller owns the store
// and closes it only after Shutdown and outstanding runner cleanup finish.
type Server struct {
	cfg             *config.Config
	db              store.Store
	runner          *runner.Runner
	models          *llm.ModelLister
	registry        *llm.Registry
	redactor        *secret.Redactor
	manager         *manager
	bus             broadcaster
	handler         http.Handler
	http            *http.Server
	tokenHash       [32]byte
	authenticated   bool
	opts            Options
	mu              sync.RWMutex
	addr            string
	stopping        bool
	stop            context.CancelFunc
	done            chan struct{}
	maintenanceDone chan struct{}
	unsubscribe     func()
	shutdownOnce    sync.Once
}

// ValidateAddress refuses public or wildcard binds without a UI credential.
// Hostnames other than localhost require authentication: no DNS lookup can
// change an unauthenticated listener from loopback to a public interface.
func ValidateAddress(addr string, token secret.Secret) error {
	host, port, err := net.SplitHostPort(addr)
	if err != nil {
		return errors.New("server address must be host:port")
	}
	n, err := strconv.Atoi(port)
	if err != nil || n < 0 || n > 65535 {
		return errors.New("server port must be between 0 and 65535")
	}
	ip := net.ParseIP(host)
	if !token.IsSet() && host != "localhost" && (ip == nil || !ip.IsLoopback()) {
		return errors.New("non-loopback server address requires PATCHBOT_UI_TOKEN")
	}
	return nil
}

// New constructs one runner and starts lifecycle maintenance and ownership heartbeats.
func New(ctx context.Context, cfg *config.Config, db store.Store, opts Options) (*Server, error) {
	if cfg == nil || db == nil {
		return nil, errors.New("server requires configuration and storage")
	}
	if !opts.Token.IsSet() {
		opts.Token = secret.New(os.Getenv("PATCHBOT_UI_TOKEN"))
	}
	if err := ValidateAddress(cfg.Server.Addr, opts.Token); err != nil {
		return nil, err
	}
	if opts.ShutdownTimeout <= 0 {
		opts.ShutdownTimeout = 30 * time.Second
	}
	if opts.HeartbeatInterval <= 0 {
		opts.HeartbeatInterval = 15 * time.Second
	}
	if opts.StreamWriteTimeout <= 0 {
		opts.StreamWriteTimeout = 5 * time.Second
	}
	if opts.PollInterval <= 0 {
		opts.PollInterval = time.Second
	}
	if opts.SyncInterval <= 0 {
		opts.SyncInterval = 60 * time.Second
	}
	if opts.Runner.Constructors == nil {
		opts.Runner.Constructors = providers.Constructors(providers.Options{})
	}
	s := &Server{cfg: cfg, db: db, opts: opts, addr: cfg.Server.Addr, manager: newManager(cfg.Server.MaxConcurrentRuns, cfg.Server.MaxQueuedRuns), redactor: cfg.Redactor(), done: make(chan struct{}), maintenanceDone: make(chan struct{})}
	s.authenticated = opts.Token.IsSet()
	s.tokenHash = sha256.Sum256([]byte(opts.Token.Reveal()))
	s.redactor.AddExact(opts.Token.Reveal())
	s.redactor.AddSecrets(secret.New(os.Getenv("GITHUB_TOKEN")))
	if opts.Runner.Tokens != nil {
		if value, err := opts.Runner.Tokens.Token(ctx); err == nil {
			s.redactor.AddExact(value)
		}
	}
	if source, ok := db.(interface {
		SubscribeEvents(func(store.Event)) func()
	}); ok {
		s.unsubscribe = source.SubscribeEvents(func(event store.Event) { s.bus.publish(event.RunID) })
	}
	opts.Runner.Dispatch = s.manager.submit
	opts.Runner.Admit = s.manager.reserve
	opts.Runner.ActionChannel = "ui"
	s.redactor.Extend(opts.Runner.Redactor)
	opts.Runner.Redactor = s.redactor
	var err error
	s.runner, err = runner.New(ctx, cfg, db, opts.Runner)
	if err != nil {
		if s.unsubscribe != nil {
			s.unsubscribe()
		}
		return nil, errors.New("could not initialize runner")
	}
	configs, err := cfg.LLMProviders()
	if err != nil {
		if s.unsubscribe != nil {
			s.unsubscribe()
		}
		return nil, errors.New("invalid provider configuration")
	}
	s.registry, err = llm.NewRegistry(opts.Runner.Constructors, configs, llm.RegistryOptions{})
	if err != nil {
		if s.unsubscribe != nil {
			s.unsubscribe()
		}
		return nil, errors.New("could not initialize providers")
	}
	s.models = llm.NewModelLister(s.registry, nil)
	s.handler = s.routes()
	s.http = &http.Server{Handler: s, ReadHeaderTimeout: 5 * time.Second, ReadTimeout: 30 * time.Second, IdleTimeout: 60 * time.Second, ErrorLog: log.New(io.Discard, "", 0)}
	maintenanceCtx, stop := context.WithCancel(context.Background())
	s.stop = stop
	interval := opts.Runner.HeartbeatInterval
	if interval <= 0 {
		interval = 10 * time.Second
	}
	s.manager.startHeartbeats(interval, db.Heartbeat)
	go s.maintain(maintenanceCtx)
	return s, nil
}

func (s *Server) maintain(ctx context.Context) {
	defer close(s.maintenanceDone)
	ticker := time.NewTicker(s.opts.SyncInterval)
	defer ticker.Stop()
	for {
		select {
		case <-ctx.Done():
			return
		case <-ticker.C:
			_ = s.runner.RecoverStale(ctx)
			_ = s.runner.SyncWaiting(ctx)
		}
	}
}

// Serve runs HTTP until the caller cancels ctx or Shutdown is called. The
// listener must be bound to the configured address; ListenAndServe binds it.
func (s *Server) Serve(ctx context.Context, listener net.Listener) error {
	if err := ValidateAddress(listener.Addr().String(), s.opts.Token); err != nil {
		_ = listener.Close()
		return err
	}
	s.mu.Lock()
	s.addr = listener.Addr().String()
	s.mu.Unlock()
	finished := make(chan struct{})
	type shutdownResult struct {
		called bool
		err    error
	}
	watcherDone := make(chan shutdownResult, 1)
	go func() {
		select {
		case <-ctx.Done():
			cleanup, stop := context.WithTimeout(context.WithoutCancel(ctx), s.opts.ShutdownTimeout)
			defer stop()
			watcherDone <- shutdownResult{called: true, err: s.Shutdown(cleanup)}
		case <-finished:
			watcherDone <- shutdownResult{}
		}
	}()
	err := s.http.Serve(listener)
	close(finished)
	result := <-watcherDone
	if result.called {
		if result.err != nil {
			return result.err
		}
		if errors.Is(err, http.ErrServerClosed) {
			return nil
		}
		return err
	}
	cleanup, stop := context.WithTimeout(context.WithoutCancel(ctx), s.opts.ShutdownTimeout)
	defer stop()
	shutdownErr := s.Shutdown(cleanup)
	if shutdownErr != nil {
		return shutdownErr
	}
	if errors.Is(err, http.ErrServerClosed) {
		return nil
	}
	return err
}

// ListenAndServe binds the configured address and handles graceful shutdown.
func (s *Server) ListenAndServe(ctx context.Context) error {
	listener, err := net.Listen("tcp", s.cfg.Server.Addr)
	if err != nil {
		cleanup, stop := context.WithTimeout(context.WithoutCancel(ctx), s.opts.ShutdownTimeout)
		defer stop()
		_ = s.Shutdown(cleanup)
		return errors.New("could not bind server address")
	}
	return s.Serve(ctx, listener)
}

// Shutdown rejects new work, stops maintenance and SSE, and drains in-flight
// runs up to ctx's deadline. On timeout it cancels their execution contexts.
func (s *Server) Shutdown(ctx context.Context) error {
	s.shutdownOnce.Do(func() {
		s.mu.Lock()
		s.stopping = true
		s.mu.Unlock()
		s.manager.stopAdmission()
		s.stop()
		close(s.done)
		if s.unsubscribe != nil {
			s.unsubscribe()
		}
	})
	httpErr := s.http.Shutdown(ctx)
	workErr := s.manager.wait(ctx)
	if httpErr != nil {
		_ = s.http.Close()
	}
	select {
	case <-s.maintenanceDone:
	case <-ctx.Done():
		return errors.Join(httpErr, workErr, ctx.Err())
	}
	return errors.Join(httpErr, workErr)
}

// ServeHTTP applies authentication and security to every route and error.
func (s *Server) ServeHTTP(w http.ResponseWriter, r *http.Request) {
	w.Header().Set("Content-Security-Policy", web.CSP(s.cfg.Server.VueSrc == "local"))
	w.Header().Set("X-Content-Type-Options", "nosniff")
	w.Header().Set("Referrer-Policy", "no-referrer")
	w.Header().Set("X-Frame-Options", "DENY")
	w.Header().Set("Cache-Control", "no-store")
	// Only data-free shells and their fixed assets are public. Browser navigation
	// cannot attach a bearer header; every API and SSE request still requires it.
	if s.authenticated && (r.Method != http.MethodGet || !web.PublicPath(r.URL.Path)) {
		value, ok := strings.CutPrefix(r.Header.Get("Authorization"), "Bearer ")
		candidate := sha256.Sum256([]byte(value))
		if !ok || subtle.ConstantTimeCompare(candidate[:], s.tokenHash[:]) != 1 {
			w.Header().Set("WWW-Authenticate", "Bearer")
			s.writeError(w, http.StatusUnauthorized, "unauthorized", "bearer token required")
			return
		}
	}
	if r.Method != http.MethodGet {
		if err := http.NewCrossOriginProtection().Check(r); err != nil {
			s.writeError(w, http.StatusForbidden, "forbidden", "cross-origin request refused")
			return
		}
	}
	if !s.validHost(r) {
		s.writeError(w, http.StatusForbidden, "forbidden", "request host refused")
		return
	}
	s.mu.RLock()
	stopping := s.stopping
	s.mu.RUnlock()
	if stopping {
		s.writeError(w, http.StatusServiceUnavailable, "unavailable", "server is shutting down")
		return
	}
	if r.URL.Path != path.Clean(r.URL.Path) {
		s.writeError(w, 404, "not_found", "resource not found")
		return
	}
	s.handler.ServeHTTP(w, r)
}

func (s *Server) validHost(r *http.Request) bool {
	s.mu.RLock()
	addr := s.addr
	s.mu.RUnlock()
	boundHost, port, err := net.SplitHostPort(addr)
	if err != nil {
		return false
	}
	host, requestPort, err := net.SplitHostPort(r.Host)
	if err != nil {
		// Browsers omit the port when the listener uses HTTP's default port.
		host = r.Host
		if strings.HasPrefix(host, "[") && strings.HasSuffix(host, "]") {
			host = strings.TrimSuffix(strings.TrimPrefix(host, "["), "]")
			if net.ParseIP(host) == nil {
				return false
			}
		} else if strings.Contains(host, ":") {
			return false
		}
		requestPort = "80"
		if r.TLS != nil {
			requestPort = "443"
		}
	}
	if host == "" || requestPort != port {
		return false
	}
	ip := net.ParseIP(boundHost)
	requestIP := net.ParseIP(host)
	if ip != nil && !ip.IsUnspecified() && requestIP != nil && ip.Equal(requestIP) {
		return true
	}
	loopback := (ip != nil && ip.IsLoopback()) || strings.EqualFold(boundHost, "localhost")
	if strings.EqualFold(host, "localhost") || (requestIP != nil && requestIP.IsLoopback()) {
		if loopback {
			return true
		}
		// A wildcard listener can still accept its actual local numeric address
		// below, but it does not acquire the localhost hostname alias.
		if requestIP == nil || ip == nil || !ip.IsUnspecified() {
			return false
		}
	}
	configuredHost, _, err := net.SplitHostPort(s.cfg.Server.Addr)
	if err == nil && net.ParseIP(configuredHost) == nil && configuredHost != "" && strings.EqualFold(host, configuredHost) {
		return true
	}
	if ip == nil || !ip.IsUnspecified() {
		return false
	}
	local, ok := r.Context().Value(http.LocalAddrContextKey).(net.Addr)
	if !ok {
		return false
	}
	localHost, localPort, err := net.SplitHostPort(local.String())
	return err == nil && localPort == port && strings.EqualFold(host, localHost)
}
package server

import (
	"context"
	"errors"
	"sync"
	"time"
)

var (
	errShuttingDown = errors.New("server is shutting down")
	errQueueFull    = errors.New("pending run queue is full; retry when capacity is available")
)

type job struct {
	id     int64
	ctx    context.Context
	cancel context.CancelFunc
	work   func(context.Context) error
}

type reservationKey struct{}

type reservation struct {
	manager *manager
	used    bool // protected by manager.mu
}

// manager owns a bounded queue without allocating goroutines for waiting work.
// Reservations secure admission before the runner commits lifecycle decisions.
type manager struct {
	mu            sync.Mutex
	running       map[int64]*job
	pending       []*job
	limit         int
	queueLimit    int
	reserved      int
	closing       bool
	done          chan struct{}
	drained       bool
	heartbeatDone chan struct{}
}

func newManager(limit, queueLimit int) *manager {
	if limit <= 0 {
		limit = 2
	}
	if queueLimit <= 0 {
		queueLimit = 16
	}
	return &manager{running: make(map[int64]*job), limit: limit, queueLimit: queueLimit, done: make(chan struct{})}
}

func (m *manager) reserve(ctx context.Context) (context.Context, func(), error) {
	m.mu.Lock()
	defer m.mu.Unlock()
	if m.closing {
		return ctx, nil, errShuttingDown
	}
	if len(m.pending)+m.reserved >= m.queueLimit {
		return ctx, nil, errQueueFull
	}
	m.reserved++
	r := &reservation{manager: m}
	release := func() {
		m.mu.Lock()
		defer m.mu.Unlock()
		if !r.used {
			r.used = true
			m.reserved--
			m.checkDrained()
		}
	}
	return context.WithValue(ctx, reservationKey{}, r), release, nil
}

func (m *manager) submit(ctx context.Context, id int64, work func(context.Context) error) error {
	r, ok := ctx.Value(reservationKey{}).(*reservation)
	if !ok || r.manager != m {
		admitted, release, err := m.reserve(ctx)
		if err != nil {
			return err
		}
		defer release()
		return m.submit(admitted, id, work)
	}
	m.mu.Lock()
	defer m.mu.Unlock()
	if r.used {
		return errors.New("work admission already consumed")
	}
	r.used = true
	m.reserved--
	workCtx, cancel := context.WithCancel(context.WithoutCancel(ctx))
	m.pending = append(m.pending, &job{id: id, ctx: workCtx, cancel: cancel, work: work})
	m.schedule()
	return nil
}

// schedule runs under mu and starts only work that can execute immediately.
// Skipping a blocked run lets unrelated jobs use otherwise idle workers.
func (m *manager) schedule() {
	for i := 0; i < len(m.pending) && len(m.running) < m.limit; {
		current := m.pending[i]
		if m.running[current.id] != nil {
			i++
			continue
		}
		copy(m.pending[i:], m.pending[i+1:])
		m.pending[len(m.pending)-1] = nil
		m.pending = m.pending[:len(m.pending)-1]
		m.running[current.id] = current
		go m.run(current)
	}
	m.checkDrained()
}

func (m *manager) run(current *job) {
	defer current.cancel()
	if current.ctx.Err() == nil {
		_ = current.work(current.ctx) // The runner persists failures; raw errors never reach logs.
	}
	m.mu.Lock()
	defer m.mu.Unlock()
	delete(m.running, current.id)
	m.schedule()
}

func (m *manager) cancel(id int64) {
	m.mu.Lock()
	defer m.mu.Unlock()
	if current := m.running[id]; current != nil {
		current.cancel()
	}
	kept := m.pending[:0]
	for _, current := range m.pending {
		if current.id == id {
			current.cancel()
		} else {
			kept = append(kept, current)
		}
	}
	clear(m.pending[len(kept):])
	m.pending = kept
	m.checkDrained()
}

func (m *manager) checkDrained() {
	if m.closing && !m.drained && len(m.running) == 0 && len(m.pending) == 0 && m.reserved == 0 {
		m.drained = true
		close(m.done)
	}
}

func (m *manager) stopAdmission() {
	m.mu.Lock()
	defer m.mu.Unlock()
	m.closing = true
	m.checkDrained()
}

func (m *manager) wait(ctx context.Context) error {
	select {
	case <-m.done:
		if m.heartbeatDone != nil {
			select {
			case <-m.heartbeatDone:
			case <-ctx.Done():
				return ctx.Err()
			}
		}
		return nil
	case <-ctx.Done():
		m.mu.Lock()
		for _, current := range m.running {
			current.cancel()
		}
		for _, current := range m.pending {
			current.cancel()
		}
		clear(m.pending)
		m.pending = nil
		m.checkDrained()
		m.mu.Unlock()
		return ctx.Err()
	}
}

func (m *manager) busy(id int64) bool {
	m.mu.Lock()
	defer m.mu.Unlock()
	if m.running[id] != nil {
		return true
	}
	for _, current := range m.pending {
		if current.id == id {
			return true
		}
	}
	return false
}

// startHeartbeats owns queued and running jobs until shutdown has drained them.
// One ticker covers the entire bounded queue, including same-run follow-ups.
func (m *manager) startHeartbeats(interval time.Duration, beat func(context.Context, int64) error) {
	m.heartbeatDone = make(chan struct{})
	go func() {
		defer close(m.heartbeatDone)
		ticker := time.NewTicker(interval)
		defer ticker.Stop()
		for {
			select {
			case <-m.done:
				return
			case <-ticker.C:
				m.mu.Lock()
				ids := make(map[int64]bool, len(m.running)+len(m.pending))
				for id := range m.running {
					ids[id] = true
				}
				for _, current := range m.pending {
					ids[current.id] = true
				}
				m.mu.Unlock()
				for id := range ids {
					ctx, cancel := context.WithTimeout(context.Background(), 5*time.Second)
					_ = beat(ctx, id) // Waiting/terminal transitions can win the heartbeat CAS.
					cancel()
				}
			}
		}
	}()
}
package server

import (
	"context"
	"encoding/base64"
	"encoding/json"
	"errors"
	"fmt"
	"net/http"
	"net/url"
	"sort"
	"strconv"
	"strings"

	"github.com/aryanpappu/patchbot/internal/config"
	"github.com/aryanpappu/patchbot/internal/llm"
	"github.com/aryanpappu/patchbot/internal/runner"
	"github.com/aryanpappu/patchbot/internal/store"
	"github.com/aryanpappu/patchbot/internal/tools"
)

func (s *Server) routes() http.Handler {
	mux := http.NewServeMux()
	// Register paths without method patterns so method and 404 errors share JSON.
	mux.HandleFunc("/{$}", s.page)
	mux.HandleFunc("/runs", s.page)
	mux.HandleFunc("/runs/new", s.page)
	mux.HandleFunc("/runs/{id}", s.page)
	mux.HandleFunc("/assets/{name}", s.asset)
	mux.HandleFunc("/api/providers", s.providers)
	mux.HandleFunc("/api/providers/{id}/models", s.providerModels)
	mux.HandleFunc("/api/runs", s.runs)
	mux.HandleFunc("/api/runs/{id}", s.runDetail)
	mux.HandleFunc("/api/runs/{id}/spec", s.editSpec)
	mux.HandleFunc("/api/runs/{id}/events", s.events)
	mux.HandleFunc("/api/runs/{id}/artifacts/{name}", s.artifact)
	for _, action := range []string{"approve", "revise", "reject", "cancel", "retry"} {
		mux.HandleFunc("/api/runs/{id}/"+action, s.action)
	}
	mux.HandleFunc("/", func(w http.ResponseWriter, _ *http.Request) { s.writeError(w, 404, "not_found", "resource not found") })
	return mux
}

func (s *Server) method(w http.ResponseWriter, r *http.Request, allowed ...string) bool {
	for _, method := range allowed {
		if r.Method == method {
			return true
		}
	}
	w.Header().Set("Allow", strings.Join(allowed, ", "))
	s.writeError(w, http.StatusMethodNotAllowed, "method_not_allowed", "method not allowed")
	return false
}

func (s *Server) providers(w http.ResponseWriter, r *http.Request) {
	if !s.method(w, r, http.MethodGet) {
		return
	}
	type provider struct {
		ID           string `json:"id"`
		Kind         string `json:"kind"`
		DefaultModel string `json:"default_model"`
		Available    bool   `json:"available"`
	}
	values := make([]provider, 0, len(s.registry.Names()))
	for _, name := range s.registry.Names() {
		cfg, _ := s.registry.Config(name)
		_, err := s.registry.Provider(name)
		values = append(values, provider{name, cfg.Kind, cfg.DefaultModel, err == nil})
	}
	repos := make([]string, 0, len(s.cfg.Repos))
	for name := range s.cfg.Repos {
		repos = append(repos, name)
	}
	sort.Strings(repos)
	s.writeJSON(w, 200, map[string]any{"providers": values, "repos": repos, "defaults": map[string]any{"provider": s.cfg.Defaults.Provider, "mode": s.cfg.Defaults.Mode, "refine_model": s.cfg.Model("refine"), "code_model": s.cfg.Model("code"), "max_cost_usd": s.cfg.Defaults.MaxCostUSD}})
}

func (s *Server) providerModels(w http.ResponseWriter, r *http.Request) {
	if !s.method(w, r, http.MethodGet) {
		return
	}
	if _, ok := s.registry.Config(r.PathValue("id")); !ok {
		s.writeError(w, 404, "not_found", "provider not found")
		return
	}
	list, err := s.models.List(r.Context(), r.PathValue("id"))
	if err != nil {
		s.writeError(w, http.StatusBadGateway, "provider_unavailable", "model listing failed and no configured models are available")
		return
	}
	type model struct {
		ID          string          `json:"id"`
		DisplayName string          `json:"display_name"`
		Source      llm.ModelSource `json:"source"`
	}
	values := make([]model, 0, len(list.Models))
	for _, m := range list.Models {
		values = append(values, model{m.ID, m.DisplayName, m.Source})
	}
	s.writeJSON(w, 200, map[string]any{"models": values, "live": list.Live, "warning": list.Warning, "fetched_at": list.FetchedAt})
}

type startRequest struct {
	Repo          string `json:"repo"`
	Issue         int64  `json:"issue"`
	Mode          string `json:"mode"`
	Provider      string `json:"provider"`
	Model         string `json:"model"`
	RefineModel   string `json:"refine_model"`
	CodeModel     string `json:"code_model"`
	DryRun        bool   `json:"dry_run"`
	MaxCostMicros int64  `json:"max_cost_micros"`
}

func (s *Server) runs(w http.ResponseWriter, r *http.Request) {
	if !s.method(w, r, http.MethodGet, http.MethodPost) {
		return
	}
	if r.Method == http.MethodGet {
		s.listRuns(w, r)
		return
	}
	var input startRequest
	if !s.decode(w, r, &input, false) {
		return
	}
	input.Repo = strings.ToLower(strings.TrimSpace(input.Repo))
	if s.cfg.Repos[input.Repo] == nil || input.Issue <= 0 || (input.Mode != "" && input.Mode != config.ModeFix && input.Mode != config.ModeRefine && input.Mode != config.ModeInvestigate) || input.MaxCostMicros < 0 || !validModels(input.Model, input.RefineModel, input.CodeModel) {
		s.writeError(w, 400, "invalid_request", "require an allowlisted repo, positive issue, valid mode, models and budget")
		return
	}
	if input.Provider != "" && s.cfg.Providers[input.Provider] == nil {
		s.writeError(w, 400, "invalid_request", "unknown provider")
		return
	}
	run, err := s.runner.Start(r.Context(), runner.Request{Repo: input.Repo, Issue: input.Issue, Mode: input.Mode, Provider: input.Provider, Model: input.Model, RefineModel: input.RefineModel, CodeModel: input.CodeModel, DryRun: input.DryRun, MaxCostMicros: input.MaxCostMicros})
	if err != nil {
		s.respondError(w, err)
		return
	}
	w.Header().Set("Location", fmt.Sprintf("/api/runs/%d", run.ID))
	s.writeJSON(w, http.StatusAccepted, map[string]any{"run": publicRun(run)})
}

func validModels(models ...string) bool {
	for _, model := range models {
		if len(model) > 512 || strings.ContainsAny(model, "\r\n\x00") || (model != "" && strings.TrimSpace(model) == "") {
			return false
		}
	}
	return true
}

func validStatus(status store.Status) bool {
	return status.IsActive() || status == store.StatusSucceeded || status == store.StatusFailed || status == store.StatusRejected || status == store.StatusCancelled
}

func parseFilter(query url.Values) (store.RunFilter, error) {
	filter := store.RunFilter{Repo: query.Get("repo"), Cursor: query.Get("cursor")}
	var err error
	if issue := query.Get("issue"); issue != "" {
		filter.IssueNumber, err = strconv.ParseInt(issue, 10, 64)
		if err != nil || filter.IssueNumber <= 0 {
			return filter, errors.New("invalid issue")
		}
	}
	if limit := query.Get("limit"); limit != "" {
		filter.Limit, err = strconv.Atoi(limit)
		if err != nil || filter.Limit <= 0 || filter.Limit > 500 {
			return filter, errors.New("invalid limit")
		}
	}
	for _, value := range query["status"] {
		for _, status := range strings.Split(value, ",") {
			if !validStatus(store.Status(status)) {
				return filter, errors.New("invalid status")
			}
			filter.Statuses = append(filter.Statuses, store.Status(status))
		}
	}
	if filter.Cursor != "" {
		raw, err := base64.RawURLEncoding.DecodeString(filter.Cursor)
		if err != nil {
			return filter, err
		}
		var cursor struct{ CreatedAt, ID int64 }
		if err := json.Unmarshal(raw, &cursor); err != nil || cursor.ID <= 0 || cursor.CreatedAt < 0 {
			return filter, errors.New("invalid cursor")
		}
	}
	return filter, nil
}

func (s *Server) listRuns(w http.ResponseWriter, r *http.Request) {
	filter, err := parseFilter(r.URL.Query())
	if err != nil {
		s.writeError(w, 400, "invalid_request", "invalid run filter or cursor")
		return
	}
	page, err := s.db.ListRuns(r.Context(), filter)
	if err != nil {
		s.respondError(w, err)
		return
	}
	for i := range page.Runs {
		page.Runs[i] = publicRun(page.Runs[i])
	}
	s.writeJSON(w, 200, page)
}

func (s *Server) runID(w http.ResponseWriter, r *http.Request) (int64, bool) {
	id, err := strconv.ParseInt(r.PathValue("id"), 10, 64)
	if err != nil || id <= 0 {
		s.writeError(w, 400, "invalid_request", "run ID must be a positive integer")
		return 0, false
	}
	if _, err := s.db.GetRun(r.Context(), id); err != nil {
		s.respondError(w, err)
		return 0, false
	}
	return id, true
}

func (s *Server) runDetail(w http.ResponseWriter, r *http.Request) {
	if !s.method(w, r, http.MethodGet) {
		return
	}
	id, ok := s.runID(w, r)
	if !ok {
		return
	}
	data, err := s.detailData(r.Context(), id)
	if err != nil {
		s.respondError(w, err)
		return
	}
	s.writeJSON(w, 200, data)
}

// Both the API and the unauthenticated loopback shell use this read model.
// Token-protected shells never load it; their browser must authenticate first.
func (s *Server) detailData(ctx context.Context, id int64) (map[string]any, error) {
	run, err := s.db.GetRun(ctx, id)
	if err != nil {
		return nil, err
	}
	specs, err := s.db.ListSpecs(ctx, id)
	if err != nil {
		return nil, err
	}
	approvals, err := s.db.ListApprovals(ctx, id)
	if err != nil {
		return nil, err
	}
	steps, err := s.db.ListSteps(ctx, id)
	if err != nil {
		return nil, err
	}
	artifacts, err := s.db.ListArtifacts(ctx, id)
	if err != nil {
		return nil, err
	}
	publicArtifacts := []store.ArtifactMetadata{}
	for _, a := range artifacts {
		if publicArtifact(a.Kind) {
			publicArtifacts = append(publicArtifacts, a)
		}
	}
	for _, a := range testArtifacts(steps) {
		publicArtifacts = append(publicArtifacts, store.ArtifactMetadata{Kind: a.Kind, Attempt: a.Attempt, Bytes: int64(len(a.Content)), CreatedAt: a.CreatedAt})
	}
	// The detail endpoint returns step summaries, without transcripts.
	for i := range steps {
		steps[i].InputJSON = ""
		steps[i].OutputText = ""
	}
	var latest *store.Spec
	if len(specs) > 0 {
		latest = &specs[len(specs)-1]
	}
	return map[string]any{"run": publicRun(run), "capabilities": s.runner.ActionCapabilities(run, latest), "latest_spec": latest, "spec_versions": specs, "approvals": approvals, "steps": steps, "artifacts": publicArtifacts}, nil
}

func (s *Server) editSpec(w http.ResponseWriter, r *http.Request) {
	if !s.method(w, r, http.MethodPut) {
		return
	}
	id, ok := s.runID(w, r)
	if !ok {
		return
	}
	var draft tools.SpecDraft
	if !s.decode(w, r, &draft, false) {
		return
	}
	spec, err := s.runner.EditSpec(r.Context(), id, draft)
	if err != nil {
		s.respondError(w, err)
		return
	}
	s.writeJSON(w, 200, map[string]any{"spec": spec})
}

func (s *Server) action(w http.ResponseWriter, r *http.Request) {
	if !s.method(w, r, http.MethodPost) {
		return
	}
	id, ok := s.runID(w, r)
	if !ok {
		return
	}
	action := r.URL.Path[strings.LastIndex(r.URL.Path, "/")+1:]
	var err error
	status := http.StatusOK
	switch action {
	case "revise":
		var input struct {
			Notes string `json:"notes"`
		}
		if !s.decode(w, r, &input, false) {
			return
		}
		if strings.TrimSpace(input.Notes) == "" {
			s.writeError(w, 400, "invalid_request", "revision notes are required")
			return
		}
		err = s.runner.Revise(r.Context(), id, input.Notes)
		status = http.StatusAccepted
	case "retry":
		var input struct {
			Provider string `json:"provider"`
			Model    string `json:"model"`
		}
		if !s.decode(w, r, &input, true) {
			return
		}
		if !validModels(input.Model) || (input.Provider != "" && s.cfg.Providers[input.Provider] == nil) {
			s.writeError(w, 400, "invalid_request", "invalid provider or model")
			return
		}
		var run store.Run
		run, err = s.runner.Retry(r.Context(), id, input.Provider, input.Model)
		if err != nil {
			s.respondError(w, err)
			return
		}
		w.Header().Set("Location", fmt.Sprintf("/api/runs/%d", run.ID))
		s.writeJSON(w, http.StatusAccepted, map[string]any{"run": publicRun(run)})
		return
	default:
		var input struct{}
		if !s.decode(w, r, &input, true) {
			return
		}
		switch action {
		case "approve":
			err = s.runner.ApproveAndExecute(r.Context(), id, s.cfg.Approval.LocalActor)
			status = http.StatusAccepted
		case "reject":
			err = s.runner.Reject(r.Context(), id)
		case "cancel":
			err = s.runner.Cancel(r.Context(), id)
			if err == nil {
				s.manager.cancel(id)
			}
		}
	}
	if err != nil {
		s.respondError(w, err)
		return
	}
	run, err := s.db.GetRun(r.Context(), id)
	if err != nil {
		s.respondError(w, err)
		return
	}
	s.writeJSON(w, status, map[string]any{"run": publicRun(run)})
}

func publicArtifact(name string) bool {
	switch name {
	case "diff", "baseline", "test_output", "pr_title", "pr_body":
		return true
	default:
		return false
	}
}

func (s *Server) artifact(w http.ResponseWriter, r *http.Request) {
	if !s.method(w, r, http.MethodGet) {
		return
	}
	id, ok := s.runID(w, r)
	if !ok {
		return
	}
	name := r.PathValue("name")
	if !publicArtifact(name) {
		s.writeError(w, 404, "not_found", "artifact not found")
		return
	}
	attempt := int64(0)
	if value := r.URL.Query().Get("attempt"); value != "" {
		var err error
		attempt, err = strconv.ParseInt(value, 10, 64)
		if err != nil || attempt < 0 {
			s.writeError(w, 400, "invalid_request", "invalid artifact attempt")
			return
		}
	}
	artifact, err := s.db.GetArtifact(r.Context(), id, name, attempt)
	if errors.Is(err, store.ErrNotFound) && name == "test_output" {
		steps, readErr := s.db.ListSteps(r.Context(), id)
		if readErr != nil {
			s.respondError(w, readErr)
			return
		}
		for _, a := range testArtifacts(steps) {
			if attempt == 0 || a.Attempt == attempt {
				artifact, err = a, nil
			}
		}
	}
	if err != nil {
		s.respondError(w, err)
		return
	}
	w.Header().Set("Content-Type", "text/plain; charset=utf-8")
	_, _ = w.Write([]byte(s.safeText(artifact.Content)))
}

// Error details remain in local records. Public run responses expose a stable
// message rather than a transport or upstream diagnostic.
func publicRun(run store.Run) store.Run {
	if run.ErrorMessage != "" {
		run.ErrorMessage = "run stopped; inspect the local run records for details"
	}
	return run
}
// Package config loads, layers and validates the patchbot configuration.
//
// Values come from four layers, later ones winning: the embedded defaults, a
// TOML file, PATCHBOT_* environment variables and command-line flags. The
// loader records which layer set each value. Secrets never come from a file:
// the file names an environment variable and the loader reads the secret from
// it into a secret.Secret.
package config

import (
	"errors"
	"os"
	"path/filepath"
	"strings"
	"time"

	"github.com/aryanpappu/patchbot/internal/secret"
)

// Provider kinds.
const (
	KindAnthropic = "anthropic"
	KindGemini    = "gemini"
	KindOpenAI    = "openai"
)

// Run modes.
const (
	ModeFix         = "fix"
	ModeRefine      = "refine"
	ModeInvestigate = "investigate"
)

// Config is the effective configuration.
type Config struct {
	Defaults  Defaults             `toml:"defaults"`
	Limits    Limits               `toml:"limits"`
	Approval  Approval             `toml:"approval"`
	Log       Log                  `toml:"log"`
	Server    Server               `toml:"server"`
	Data      Data                 `toml:"data"`
	Providers map[string]*Provider `toml:"providers"`
	Repos     map[string]*Repo     `toml:"repos"`

	// path is the config file that was read, or "" when none was found.
	path string
	// sources maps a dotted key such as `limits.max_turns` to its Source.
	sources map[string]Source
	// home is the user's home directory, used to expand "~/" in Data.Dir.
	home string
	// rejectedKeyEnvs are the api_key_env names of a file that failed to
	// load. They are used only to redact the load error.
	rejectedKeyEnvs []string
}

// Defaults are the choices a run uses unless it says otherwise.
type Defaults struct {
	// Provider is the name of a [providers.<name>] table.
	Provider string `toml:"provider"`
	// Mode is fix, refine or investigate.
	Mode string `toml:"mode"`
	// RefineModel and CodeModel fall back to the provider's default_model.
	RefineModel string `toml:"refine_model"`
	CodeModel   string `toml:"code_model"`
	// MaxCostUSD is the budget of one run across every stage.
	MaxCostUSD float64 `toml:"max_cost_usd"`
	// Approvers are the GitHub logins whose /approve comments count.
	Approvers []string `toml:"approvers"`
	// CommentOnFailure posts a short diagnostic except for cancellation/auth.
	CommentOnFailure bool `toml:"comment_on_failure"`
}

// Limits bound one run.
type Limits struct {
	MaxTurns        int   `toml:"max_turns"`
	RefineMaxTurns  int   `toml:"refine_max_turns"`
	MaxOutputTokens int   `toml:"max_output_tokens"`
	MaxTotalTokens  int64 `toml:"max_total_tokens"`
	// HardMaxCostUSD is the ceiling for any per-run budget.
	HardMaxCostUSD  float64       `toml:"hard_max_cost_usd"`
	MaxTestAttempts int           `toml:"max_test_attempts"`
	RunTimeout      time.Duration `toml:"run_timeout"`
	CmdTimeout      time.Duration `toml:"cmd_timeout"`
	TestTimeout     time.Duration `toml:"test_timeout"`
	// CmdOutputBytes is sent to the model per command; CmdStoreBytes is kept.
	CmdOutputBytes int  `toml:"cmd_output_bytes"`
	CmdStoreBytes  int  `toml:"cmd_store_bytes"`
	BaselineTests  bool `toml:"baseline_tests"`
	// TrustedPath contains operator-controlled absolute tool directories.
	TrustedPath []string `toml:"trusted_path"`
}

// Approval controls the spec approval gate.
type Approval struct {
	// LocalActor is the name recorded for CLI and UI actions.
	LocalActor   string        `toml:"local_actor"`
	PollInterval time.Duration `toml:"poll_interval"`
	// TTL is how long a run may wait for approval before it expires.
	TTL          time.Duration `toml:"ttl"`
	MaxRevisions int           `toml:"max_revisions"`
}

// Log configures logging.
type Log struct {
	Level  string `toml:"level"`  // debug, info, warn or error
	Format string `toml:"format"` // text or json
}

// Server configures the web interface.
type Server struct {
	Addr              string `toml:"addr"`
	MaxConcurrentRuns int    `toml:"max_concurrent_runs"`
	MaxQueuedRuns     int    `toml:"max_queued_runs"`
	VueSrc            string `toml:"vue_src"` // cdn or local
}

// Data says where the database and workspaces live.
type Data struct {
	Dir string `toml:"dir"`
}

// Provider is one [providers.<name>] table.
type Provider struct {
	Kind    string `toml:"kind"`
	BaseURL string `toml:"base_url"`
	// APIKeyEnv names the environment variable that holds the API key.
	APIKeyEnv    string   `toml:"api_key_env"`
	Models       []string `toml:"models"`
	DefaultModel string   `toml:"default_model"`
	// PriceFree states that every model of this provider costs nothing, as
	// with a local server. It is different from having no prices.
	PriceFree bool              `toml:"price_free"`
	Prices    map[string]*Price `toml:"prices"`

	// APIKey is read from the environment variable named by APIKeyEnv.
	APIKey secret.Secret `toml:"-"`
}

// Price is one [providers.<name>.prices.<model>] table, in US dollars per
// million tokens.
//
// Every rate is a pointer so that a rate left out of the file can be told
// apart from a rate of 0. Input and Output are required: a price table with
// only an input rate must not turn into "output is free", because the budget
// would then stop counting output tokens. Write 0 for a rate that is free.
type Price struct {
	Input  *float64 `toml:"input"`
	Output *float64 `toml:"output"`
	// CacheRead and CacheWrite are optional and fall back to Input when nil.
	CacheRead  *float64 `toml:"cache_read"`
	CacheWrite *float64 `toml:"cache_write"`
	// Checked is the day the price was read from the provider's price page.
	Checked Date `toml:"checked"`
}

// Repo is one [repos."owner/name"] table. Only listed repositories can run.
type Repo struct {
	// Commands maps a command ID such as "test" to the argv it runs.
	Commands map[string][]string `toml:"commands"`
	// Protected lists extra paths the agent may neither read nor write.
	Protected []string `toml:"protected"`
	// TestCommand is the ID of the command that verifies a change.
	TestCommand string `toml:"test_command"`
}

// TestCommandID returns the command that verifies a change: TestCommand, or
// "test" when that is empty and such a command exists.
func (r *Repo) TestCommandID() (string, bool) {
	if r.TestCommand != "" {
		return r.TestCommand, true
	}
	if _, ok := r.Commands["test"]; ok {
		return "test", true
	}
	return "", false
}

// Date is a calendar day. In TOML it is a local date (2026-11-10) or the same
// text as a string.
type Date struct {
	time.Time
}

const dateLayout = "2006-01-02"

// UnmarshalTOML implements toml.Unmarshaler.
func (d *Date) UnmarshalTOML(v any) error {
	switch v := v.(type) {
	case time.Time:
		d.Time = time.Date(v.Year(), v.Month(), v.Day(), 0, 0, 0, 0, time.UTC)
		return nil
	case string:
		t, err := time.Parse(dateLayout, v)
		if err != nil {
			// The value is not quoted back: nothing says it is not a secret
			// pasted into the wrong field.
			return errors.New("want a date like 2026-01-31")
		}
		d.Time = t
		return nil
	default:
		return errors.New("want a date like 2026-01-31")
	}
}

// String returns the date as YYYY-MM-DD, or "" for the zero date.
func (d Date) String() string {
	if d.IsZero() {
		return ""
	}
	return d.Format(dateLayout)
}

// Path returns the config file that was read, or "" when none was found.
func (c *Config) Path() string { return c.path }

// DataDir returns Data.Dir with a leading "~/" expanded.
func (c *Config) DataDir() string {
	dir := c.Data.Dir
	if dir == "~" {
		return c.home
	}
	if rest, ok := strings.CutPrefix(dir, "~/"); ok && c.home != "" {
		return filepath.Join(c.home, rest)
	}
	return dir
}

// DatabasePath returns the SQLite database file inside the data directory.
func (c *Config) DatabasePath() string {
	return filepath.Join(c.DataDir(), "patchbot.sqlite")
}

// Model returns the model a stage uses with the default provider: the stage's
// own setting, else the provider's default_model. Stage is "refine" or "code".
func (c *Config) Model(stage string) string {
	model := c.Defaults.CodeModel
	if stage == "refine" {
		model = c.Defaults.RefineModel
	}
	if model != "" {
		return model
	}
	if p := c.Providers[c.Defaults.Provider]; p != nil {
		return p.DefaultModel
	}
	return ""
}

// Redactor returns a redactor that masks every secret the config holds, as
// well as token-shaped text. Diagnostics about the config pass through it,
// because a secret can turn up in any field: a key exported under the wrong
// variable name becomes a "log level".
func (c *Config) Redactor() *secret.Redactor {
	r := secret.NewRedactor()
	r.AddSecrets(c.Secrets()...)
	return r
}

// Secrets returns every secret the config holds, for registering with a
// secret.Redactor.
func (c *Config) Secrets() []secret.Secret {
	var out []secret.Secret
	for _, name := range sortedKeys(c.Providers) {
		if key := c.Providers[name].APIKey; key.IsSet() {
			out = append(out, key)
		}
	}
	return out
}

// EnsureDataDir creates private storage and refuses an existing public directory
// or symlink. Doctor reports the same policy without changing the filesystem.
func (c *Config) EnsureDataDir() error {
	if err := os.MkdirAll(c.DataDir(), 0o700); err != nil {
		return err
	}
	info, err := os.Lstat(c.DataDir())
	if err != nil {
		return err
	}
	if !info.IsDir() || info.Mode().Perm() != 0o700 {
		return errors.New("data directory must be a real directory with mode 0700")
	}
	return nil
}
package config

import (
	_ "embed" // for defaults.toml
	"errors"
	"fmt"
	"io/fs"
	"os"
	"path/filepath"
	"reflect"
	"regexp"
	"slices"
	"strconv"
	"strings"
	"time"

	"github.com/BurntSushi/toml"

	"github.com/aryanpappu/patchbot/internal/secret"
)

//go:embed defaults.toml
var defaultsTOML string

// EnvConfig names the environment variable that points at a config file.
const EnvConfig = "PATCHBOT_CONFIG"

// SourceKind says which layer set a value.
type SourceKind int

// The layers, lowest precedence first.
const (
	SourceUnset SourceKind = iota // no layer set the value; it is the zero value
	SourceDefault
	SourceFile
	SourceEnv
	SourceFlag
)

// Source says where a config value came from.
type Source struct {
	Kind SourceKind
	// Name is the environment variable or the flag, for those two kinds.
	Name string
}

// String returns a short label such as "file" or "env PATCHBOT_PROVIDER".
func (s Source) String() string {
	switch s.Kind {
	case SourceDefault:
		return "default"
	case SourceFile:
		return "file"
	case SourceEnv:
		return "env " + s.Name
	case SourceFlag:
		return "flag " + s.Name
	default:
		return "unset"
	}
}

// Override is one value set on the command line.
type Override struct {
	// Key is a dotted config key in a fixed table, such as "defaults.provider".
	Key string
	// Value is the flag's text. Lists are comma-separated.
	Value string
	// Flag is the flag as the user typed it, such as "--provider".
	Flag string
}

// Options tell Load where to look. The zero value reads the real environment.
type Options struct {
	// Path is the --config flag. A file named here must exist.
	Path string
	// Dir is where ./patchbot.toml is looked for. Empty means the working directory.
	Dir string
	// Flags are the command-line overrides, the highest layer.
	Flags []Override
	// LookupEnv replaces os.LookupEnv.
	LookupEnv func(string) (string, bool)
	// UserConfigDir replaces os.UserConfigDir.
	UserConfigDir func() (string, error)
	// UserHomeDir replaces os.UserHomeDir.
	UserHomeDir func() (string, error)
}

// envBindings is the complete list of settings an environment variable can
// change. Secrets are not here: they are named by api_key_env.
var envBindings = []struct {
	env  string
	keys []string
}{
	{"PATCHBOT_DATA_DIR", []string{"data.dir"}},
	{"PATCHBOT_PROVIDER", []string{"defaults.provider"}},
	// PATCHBOT_MODEL sets both stages; the two specific variables win over it.
	{"PATCHBOT_MODEL", []string{"defaults.refine_model", "defaults.code_model"}},
	{"PATCHBOT_REFINE_MODEL", []string{"defaults.refine_model"}},
	{"PATCHBOT_CODE_MODEL", []string{"defaults.code_model"}},
	{"PATCHBOT_MAX_COST_USD", []string{"defaults.max_cost_usd"}},
	{"PATCHBOT_MAX_TURNS", []string{"limits.max_turns"}},
	{"PATCHBOT_ADDR", []string{"server.addr"}},
	{"PATCHBOT_LOG_LEVEL", []string{"log.level"}},
	{"PATCHBOT_LOG_FORMAT", []string{"log.format"}},
}

// Default returns the embedded defaults with no file, environment or flags.
func Default() *Config {
	c := &Config{sources: map[string]Source{}}
	var layer Config
	md, err := toml.Decode(defaultsTOML, &layer)
	if err == nil {
		err = checkKeys(md)
	}
	if err == nil {
		err = c.apply(&layer, md, Source{Kind: SourceDefault})
	}
	if err != nil {
		// The file is compiled in, so this is a bug that the tests catch.
		panic("config: embedded defaults.toml is invalid: " + err.Error())
	}
	return c
}

// Load builds the effective configuration: defaults, then the config file,
// then environment variables, then flags. It reports syntax errors, unknown
// keys and keys that look like secrets. It does not judge the values; call
// Validate for that.
//
// An error from Load never quotes a value it could not parse, since nothing
// says the value is not a secret in the wrong place, and it is redacted with
// every API key the loader could find.
func Load(opts Options) (*Config, error) {
	lookupEnv := opts.LookupEnv
	if lookupEnv == nil {
		lookupEnv = os.LookupEnv
	}
	c, err := load(opts, lookupEnv)
	// The keys are read even when loading failed, to redact the error.
	for _, p := range c.Providers {
		if !envNameRE.MatchString(p.APIKeyEnv) {
			continue // Validate reports a bad name; never look it up.
		}
		if value, ok := lookupEnv(p.APIKeyEnv); ok {
			p.APIKey = secret.New(strings.TrimSpace(value))
		}
	}
	if err != nil {
		// A file that was rejected never became part of c, but the variable
		// names it gave still say where its keys are.
		redactor := c.Redactor()
		for _, name := range c.rejectedKeyEnvs {
			if value, ok := lookupEnv(name); ok && envNameRE.MatchString(name) {
				redactor.AddExact(strings.TrimSpace(value))
			}
		}
		return nil, &redactedError{msg: redactor.Redact(err.Error()), err: err}
	}
	return c, nil
}

// redactedError carries a redacted message and keeps the original error
// reachable for errors.Is and errors.As.
type redactedError struct {
	msg string
	err error
}

func (e *redactedError) Error() string { return e.msg }
func (e *redactedError) Unwrap() error { return e.err }

// load applies the layers. It always returns a Config, complete or not.
func load(opts Options, lookupEnv func(string) (string, bool)) (*Config, error) {
	if opts.UserConfigDir == nil {
		opts.UserConfigDir = os.UserConfigDir
	}
	if opts.UserHomeDir == nil {
		opts.UserHomeDir = os.UserHomeDir
	}
	c := Default()
	if home, err := opts.UserHomeDir(); err == nil {
		c.home = home
	}

	path, err := findFile(opts, lookupEnv)
	if err != nil {
		return c, err
	}
	if path != "" {
		if err := c.loadFile(path); err != nil {
			return c, err
		}
	}

	for _, b := range envBindings {
		value, ok := lookupEnv(b.env)
		if !ok || value == "" {
			continue
		}
		for _, key := range b.keys {
			if err := c.set(key, value, Source{Kind: SourceEnv, Name: b.env}); err != nil {
				return c, fmt.Errorf("environment variable %s: %w", b.env, err)
			}
		}
	}
	for _, o := range opts.Flags {
		if err := c.set(o.Key, o.Value, Source{Kind: SourceFlag, Name: o.Flag}); err != nil {
			return c, fmt.Errorf("flag %s: %w", o.Flag, err)
		}
	}
	return c, nil
}

// Source returns where the value of a dotted key came from. Quote a segment
// that is not a bare TOML key: `repos."owner/name".test_command`.
func (c *Config) Source(key string) Source { return c.sources[key] }

// findFile returns the config file to read, or "" when there is none.
func findFile(opts Options, lookupEnv func(string) (string, bool)) (string, error) {
	explicit := opts.Path
	if explicit == "" {
		explicit, _ = lookupEnv(EnvConfig)
	}
	if explicit != "" {
		if _, err := os.Stat(explicit); err != nil {
			return "", fmt.Errorf("config file: %w", err)
		}
		return explicit, nil
	}

	candidates := []string{filepath.Join(opts.Dir, "patchbot.toml")}
	if dir, err := opts.UserConfigDir(); err == nil && dir != "" {
		candidates = append(candidates, filepath.Join(dir, "patchbot", "config.toml"))
	}
	for _, path := range candidates {
		info, err := os.Stat(path)
		switch {
		case errors.Is(err, fs.ErrNotExist):
			continue
		case err != nil:
			return "", fmt.Errorf("config file: %w", err)
		case info.Mode().IsRegular():
			return path, nil
		}
	}
	return "", nil
}

func (c *Config) loadFile(path string) error {
	data, err := os.ReadFile(path) //nolint:gosec // the user chooses the config file
	if err != nil {
		return fmt.Errorf("config file: %w", err)
	}
	var layer Config
	md, err := toml.Decode(string(data), &layer)
	for _, p := range layer.Providers {
		if p != nil && p.APIKeyEnv != "" {
			c.rejectedKeyEnvs = append(c.rejectedKeyEnvs, p.APIKeyEnv)
		}
	}
	if err != nil {
		return fmt.Errorf("config file %s: %s", path, describeDecodeError(err))
	}
	if err := checkKeys(md); err != nil {
		return fmt.Errorf("config file %s: %w", path, err)
	}
	if err := c.apply(&layer, md, Source{Kind: SourceFile}); err != nil {
		return fmt.Errorf("config file %s: %w", path, err)
	}
	c.path = path
	return nil
}

// tomlPrefixRE matches the prefix of the library's plain errors. Only the
// line number is retained; the last key can contain a secret.
var tomlPrefixRE = regexp.MustCompile(`^toml: (?:line (\d+) )?(?:\(last key "(?:[^"\\]|\\.)*"\))?:? ?`)

// describeDecodeError turns a TOML library error into a message that says
// where the problem is and what kind it is, without the text that caused it.
// Every diagnostic is a fixed error class, never text copied from the parser:
// its messages can include keys and values in several quoting styles, even
// when parsing failed before any API key environment variables were decoded.
func describeDecodeError(err error) string {
	line, msg := 0, err.Error()
	if pe, ok := errors.AsType[toml.ParseError](err); ok {
		line, msg = pe.Position.Line, pe.Message
	} else if m := tomlPrefixRE.FindStringSubmatch(msg); m != nil {
		line, _ = strconv.Atoi(m[1])
		msg = msg[len(m[0]):]
	}
	kind := "invalid TOML syntax or value"
	switch {
	case strings.HasPrefix(msg, "invalid duration"):
		kind = `want a duration string such as "30m"`
	case msg == "want a date like 2026-01-31":
		kind = "want a date like 2026-01-31"
	case strings.Contains(msg, "is out of range"), strings.Contains(msg, "is out of the safe"):
		kind = "a number is out of range"
	case strings.HasPrefix(msg, "expected value but found"):
		kind = "expected a value; text needs quotes"
	case strings.HasPrefix(msg, "incompatible types:"), strings.HasPrefix(msg, "type mismatch"):
		kind = "incompatible types"
	}
	if line > 0 {
		return fmt.Sprintf("line %d: %s", line, kind)
	}
	return kind
}

// checkKeys rejects keys that look like secrets and keys the schema does not
// have. The secret check comes first because its message says what to do.
func checkKeys(md toml.MetaData) error {
	var errs []error
	seen := map[string]bool{}
	for _, key := range md.Keys() {
		if name, ok := secretLookingSegment(key); ok && !covered(seen, key) {
			seen[key.String()] = true
			errs = append(errs, fmt.Errorf(
				"key %s: %q looks like a secret; secrets are read only from environment variables, "+
					"so name the variable with api_key_env and remove the value from the file", key, name))
		}
	}
	for _, key := range md.Undecoded() {
		if covered(seen, key) {
			continue
		}
		errs = append(errs, fmt.Errorf("unknown key %s", key))
	}
	return errors.Join(errs...)
}

// covered reports whether key or one of its parents is already reported.
func covered(seen map[string]bool, key toml.Key) bool {
	for i := 1; i <= len(key); i++ {
		if seen[key[:i].String()] {
			return true
		}
	}
	return false
}

// secretLookingSegment returns the first segment of key whose name suggests it
// holds a secret. Segments the user names freely (a provider, a repository, a
// model, a command ID) are not checked.
func secretLookingSegment(key toml.Key) (string, bool) {
	for i, seg := range key {
		if freeName(key, i) {
			continue
		}
		if looksSecret(seg) {
			return seg, true
		}
	}
	return "", false
}

func freeName(key toml.Key, i int) bool {
	switch i {
	case 1:
		return key[0] == "providers" || key[0] == "repos"
	case 3:
		return (key[0] == "providers" && key[2] == "prices") || (key[0] == "repos" && key[2] == "commands")
	}
	return false
}

// secretWords mark a key name as holding a secret wherever they appear in it,
// so github_token, apiKey and client-secret are all caught.
var secretWords = []string{
	"apikey", "api_key", "api-key", "password", "passwd", "secret", "credential",
	"private_key", "privatekey", "access_key", "accesskey",
}

// looksSecret reports whether a key name says its value is a secret. A name
// ending in _env holds the name of an environment variable, which is fine.
// "token" counts unless it is the plural counter, as in max_total_tokens.
func looksSecret(name string) bool {
	name = strings.ToLower(name)
	if strings.HasSuffix(name, "_env") {
		return false
	}
	for _, word := range secretWords {
		if strings.Contains(name, word) {
			return true
		}
	}
	for rest := name; ; {
		i := strings.Index(rest, "token")
		if i < 0 {
			return false
		}
		rest = rest[i+len("token"):]
		if !strings.HasPrefix(rest, "s") {
			return true
		}
	}
}

var durationType = reflect.TypeFor[time.Duration]()

// apply copies every value the layer defines into c and records its source.
// Copying key by key, not table by table, lets a file change one field of a
// provider the defaults already define.
func (c *Config) apply(layer *Config, md toml.MetaData, source Source) error {
	dst := reflect.ValueOf(c).Elem()
	src := reflect.ValueOf(layer).Elem()
	for _, key := range md.Keys() {
		if md.Type(key...) == "Hash" {
			if err := ensureTable(dst, key); err != nil {
				return fmt.Errorf("key %s: %w", key, err)
			}
			continue
		}
		value, ok := lookup(src, key)
		if !ok {
			return fmt.Errorf("key %s: not in the schema", key)
		}
		if value.Type() == durationType && md.Type(key...) != "String" {
			return fmt.Errorf(`key %s: want a duration string such as "30m"`, key)
		}
		if err := assign(dst, key, value); err != nil {
			return fmt.Errorf("key %s: %w", key, err)
		}
		c.sources[key.String()] = source
	}
	return nil
}

// set parses raw for the field at a dotted key and stores it.
func (c *Config) set(dotted, raw string, source Source) error {
	key := toml.Key(strings.Split(dotted, "."))
	field, ok := lookup(reflect.ValueOf(c).Elem(), key)
	if !ok || !field.CanSet() {
		return fmt.Errorf("unknown config key %q", dotted)
	}
	if err := parseInto(field, raw); err != nil {
		return fmt.Errorf("%s: %w", dotted, err)
	}
	c.sources[key.String()] = source
	return nil
}

// parseInto never quotes raw in an error: an override comes from the
// environment, and a value there may be a secret under the wrong name.
func parseInto(field reflect.Value, raw string) error {
	switch field.Interface().(type) {
	case string:
		field.SetString(raw)
	case bool:
		v, err := strconv.ParseBool(raw)
		if err != nil {
			return errors.New("want true or false")
		}
		field.SetBool(v)
	case int, int64:
		v, err := strconv.ParseInt(raw, 10, field.Type().Bits())
		if err != nil {
			return errors.New("want a whole number")
		}
		field.SetInt(v)
	case float64:
		v, err := strconv.ParseFloat(raw, 64)
		if err != nil {
			return errors.New("want a number")
		}
		field.SetFloat(v)
	case time.Duration:
		v, err := time.ParseDuration(raw)
		if err != nil {
			return errors.New(`want a duration such as "30m"`)
		}
		field.SetInt(int64(v))
	case []string:
		var list []string
		for item := range strings.SplitSeq(raw, ",") {
			if item = strings.TrimSpace(item); item != "" {
				list = append(list, item)
			}
		}
		field.Set(reflect.ValueOf(list))
	default:
		return fmt.Errorf("a value of type %s cannot be set this way", field.Type())
	}
	return nil
}

// fieldByTag returns the field of struct v whose toml tag is name.
func fieldByTag(v reflect.Value, name string) (reflect.Value, bool) {
	t := v.Type()
	for i := range t.NumField() {
		if tag, _, _ := strings.Cut(t.Field(i).Tag.Get("toml"), ","); tag == name && tag != "-" {
			return v.Field(i), true
		}
	}
	return reflect.Value{}, false
}

// lookup follows key through structs, pointers and maps.
func lookup(v reflect.Value, key toml.Key) (reflect.Value, bool) {
	for _, seg := range key {
		if v.Kind() == reflect.Pointer {
			if v.IsNil() {
				return reflect.Value{}, false
			}
			v = v.Elem()
		}
		switch v.Kind() {
		case reflect.Struct:
			f, ok := fieldByTag(v, seg)
			if !ok {
				return reflect.Value{}, false
			}
			v = f
		case reflect.Map:
			v = v.MapIndex(reflect.ValueOf(seg))
			if !v.IsValid() {
				return reflect.Value{}, false
			}
		default:
			return reflect.Value{}, false
		}
	}
	return v, true
}

// descend returns the container that holds the last segment of key, creating
// maps and table entries on the way.
func descend(v reflect.Value, key toml.Key) (reflect.Value, error) {
	for _, seg := range key[:len(key)-1] {
		next, err := child(v, seg)
		if err != nil {
			return reflect.Value{}, err
		}
		v = next
	}
	return v, nil
}

// child returns the table named seg inside v, creating it when v is a map.
func child(v reflect.Value, seg string) (reflect.Value, error) {
	switch v.Kind() {
	case reflect.Struct:
		f, ok := fieldByTag(v, seg)
		if !ok {
			return reflect.Value{}, fmt.Errorf("no table %q", seg)
		}
		return f, nil
	case reflect.Map:
		if v.Type().Elem().Kind() != reflect.Pointer {
			return reflect.Value{}, fmt.Errorf("%q is not a table", seg)
		}
		if v.IsNil() {
			v.Set(reflect.MakeMap(v.Type()))
		}
		k := reflect.ValueOf(seg)
		elem := v.MapIndex(k)
		if !elem.IsValid() || elem.IsNil() {
			elem = reflect.New(v.Type().Elem().Elem())
			v.SetMapIndex(k, elem)
		}
		return elem.Elem(), nil
	default:
		return reflect.Value{}, fmt.Errorf("%q is not a table", seg)
	}
}

// ensureTable makes the table at key exist, so an empty [providers.x] still
// creates the provider.
func ensureTable(root reflect.Value, key toml.Key) error {
	parent, err := descend(root, key)
	if err != nil {
		return err
	}
	table, err := child(parent, key[len(key)-1])
	if err != nil {
		return err
	}
	if table.Kind() == reflect.Map && table.IsNil() {
		table.Set(reflect.MakeMap(table.Type()))
	}
	return nil
}

// assign stores value at key.
func assign(root reflect.Value, key toml.Key, value reflect.Value) error {
	parent, err := descend(root, key)
	if err != nil {
		return err
	}
	last := key[len(key)-1]
	switch parent.Kind() {
	case reflect.Struct:
		f, ok := fieldByTag(parent, last)
		if !ok {
			return fmt.Errorf("no key %q", last)
		}
		f.Set(value)
	case reflect.Map:
		if parent.IsNil() {
			parent.Set(reflect.MakeMap(parent.Type()))
		}
		parent.SetMapIndex(reflect.ValueOf(last), value)
	default:
		return fmt.Errorf("%q cannot hold a value", last)
	}
	return nil
}

func sortedKeys[V any](m map[string]V) []string {
	keys := make([]string, 0, len(m))
	for k := range m {
		keys = append(keys, k)
	}
	slices.Sort(keys)
	return keys
}
package config

import (
	"errors"
	"fmt"
	"math"
	"net"
	"net/url"
	"regexp"
	"slices"
	"strings"

	"github.com/aryanpappu/patchbot/internal/execx"
	"github.com/aryanpappu/patchbot/internal/secret"
)

var (
	// Upper case only: it is the convention, and it keeps most pasted keys
	// from passing as a variable name and being printed back.
	envNameRE      = regexp.MustCompile(`^[A-Z_][A-Z0-9_]{0,63}$`)
	providerNameRE = regexp.MustCompile(`^[a-z0-9][a-z0-9_-]{0,63}$`)
	loginRE        = regexp.MustCompile(`^[A-Za-z0-9](?:[A-Za-z0-9]|-[A-Za-z0-9]){0,38}$`)
	repoRE         = regexp.MustCompile(`^[A-Za-z0-9](?:[A-Za-z0-9]|-[A-Za-z0-9]){0,38}/[A-Za-z0-9._-]{1,100}$`)
	commandIDRE    = regexp.MustCompile(`^[a-z][a-z0-9_-]{0,31}$`)
)

// shellMeta are the characters a shell gives meaning to. argv is run without
// a shell, so one of these in the program name is a mistake or an attempt to
// smuggle in a shell command line.
const shellMeta = " \t\r\n|&;<>()$`\\\"'*?[]{}~!#=%^"

// Validate checks the values of a loaded configuration and returns every
// problem it finds, joined with errors.Join. Messages never contain a secret.
//
// A message may quote a bad value to help the user find it. Every message is
// therefore redacted with the secrets the config holds: a key exported under
// the wrong variable name would otherwise be printed as, say, a log level.
func (c *Config) Validate() error {
	v := validator{redactor: c.Redactor()}
	c.validateDefaults(&v)
	c.validateLimits(&v)
	c.validateFixed(&v)
	for _, name := range sortedKeys(c.Providers) {
		c.validateProvider(&v, name, c.Providers[name])
	}
	for _, name := range sortedKeys(c.Repos) {
		validateRepo(&v, name, c.Repos[name])
	}
	return errors.Join(v.errs...)
}

type validator struct {
	errs     []error
	redactor *secret.Redactor
}

func (v *validator) addf(format string, args ...any) {
	v.errs = append(v.errs, errors.New(v.redactor.Redact(fmt.Sprintf(format, args...))))
}

// check adds the message when ok is false.
func (v *validator) check(ok bool, format string, args ...any) {
	if !ok {
		v.addf(format, args...)
	}
}

func (c *Config) validateDefaults(v *validator) {
	d := c.Defaults
	v.check(slices.Contains([]string{ModeFix, ModeRefine, ModeInvestigate}, d.Mode),
		"defaults.mode: %q is not one of fix, refine, investigate", d.Mode)

	if len(d.Approvers) == 0 {
		v.addf("defaults.approvers: list at least one GitHub login; coding starts only after one of them approves the spec")
	}
	for _, login := range d.Approvers {
		v.check(loginRE.MatchString(login), "defaults.approvers: %q is not a GitHub login", login)
	}

	_, ok := c.Providers[d.Provider]
	switch {
	case d.Provider == "":
		v.addf("defaults.provider: not set")
	case !ok:
		v.addf("defaults.provider: no [providers.%s] table; configured providers: %s",
			d.Provider, orNone(sortedKeys(c.Providers)))
	default:
		for _, stage := range []string{"refine", "code"} {
			if c.Model(stage) == "" {
				v.addf("no model for the %s stage: set defaults.%s_model or providers.%s.default_model "+
					"(`patchbot models --provider %s` lists the choices)", stage, stage, d.Provider, d.Provider)
			}
		}
	}

	if !validMoney(d.MaxCostUSD) || d.MaxCostUSD <= 0 {
		v.addf("defaults.max_cost_usd: must be greater than 0")
	} else if validMoney(c.Limits.HardMaxCostUSD) && d.MaxCostUSD > c.Limits.HardMaxCostUSD {
		v.addf("defaults.max_cost_usd (%v) is above limits.hard_max_cost_usd (%v)",
			d.MaxCostUSD, c.Limits.HardMaxCostUSD)
	}
}

func (c *Config) validateLimits(v *validator) {
	l := c.Limits
	if err := execx.ValidateTrustedPath(l.TrustedPath, c.DataDir()); err != nil {
		v.addf("limits.trusted_path: %s", err)
	}
	v.check(validMoney(l.HardMaxCostUSD) && l.HardMaxCostUSD > 0, "limits.hard_max_cost_usd: must be greater than 0")
	for _, f := range []struct {
		key   string
		value int64
	}{
		{"limits.max_turns", int64(l.MaxTurns)},
		{"limits.refine_max_turns", int64(l.RefineMaxTurns)},
		{"limits.max_output_tokens", int64(l.MaxOutputTokens)},
		{"limits.max_total_tokens", l.MaxTotalTokens},
		{"limits.max_test_attempts", int64(l.MaxTestAttempts)},
		{"limits.run_timeout", int64(l.RunTimeout)},
		{"limits.cmd_timeout", int64(l.CmdTimeout)},
		{"limits.test_timeout", int64(l.TestTimeout)},
		{"limits.cmd_output_bytes", int64(l.CmdOutputBytes)},
		{"limits.cmd_store_bytes", int64(l.CmdStoreBytes)},
		{"approval.poll_interval", int64(c.Approval.PollInterval)},
		{"approval.ttl", int64(c.Approval.TTL)},
		{"approval.max_revisions", int64(c.Approval.MaxRevisions)},
		{"server.max_concurrent_runs", int64(c.Server.MaxConcurrentRuns)},
		{"server.max_queued_runs", int64(c.Server.MaxQueuedRuns)},
	} {
		v.check(f.value > 0, "%s: must be greater than 0", f.key)
	}
	v.check(l.CmdOutputBytes <= l.CmdStoreBytes || l.CmdStoreBytes <= 0,
		"limits.cmd_output_bytes (%d) is above limits.cmd_store_bytes (%d)", l.CmdOutputBytes, l.CmdStoreBytes)
}

func (c *Config) validateFixed(v *validator) {
	v.check(strings.TrimSpace(c.Approval.LocalActor) != "", "approval.local_actor: not set")
	v.check(slices.Contains([]string{"debug", "info", "warn", "error"}, c.Log.Level),
		"log.level: %q is not one of debug, info, warn, error", c.Log.Level)
	v.check(slices.Contains([]string{"text", "json"}, c.Log.Format),
		"log.format: %q is not one of text, json", c.Log.Format)
	v.check(slices.Contains([]string{"cdn", "local"}, c.Server.VueSrc),
		"server.vue_src: %q is not one of cdn, local", c.Server.VueSrc)
	if host, port, err := net.SplitHostPort(c.Server.Addr); err != nil || host == "" || port == "" {
		v.addf("server.addr: %q is not host:port", c.Server.Addr)
	}
	v.check(strings.TrimSpace(c.Data.Dir) != "", "data.dir: not set")
}

func (c *Config) validateProvider(v *validator, name string, p *Provider) {
	at := "providers." + name
	v.check(providerNameRE.MatchString(name),
		"%s: a provider name uses lower-case letters, digits, - and _", at)
	v.check(slices.Contains([]string{KindAnthropic, KindGemini, KindOpenAI}, p.Kind),
		"%s.kind: %q is not one of anthropic, gemini, openai", at, p.Kind)

	if p.APIKeyEnv != "" && !envNameRE.MatchString(p.APIKeyEnv) {
		// The value is not echoed: the usual cause is a key pasted here.
		v.addf("%s.api_key_env: must be the name of an environment variable (upper-case letters, digits "+
			"and _), not the key itself", at)
	}
	if p.BaseURL != "" {
		u, err := url.Parse(p.BaseURL)
		switch {
		case err != nil || (u.Scheme != "http" && u.Scheme != "https") || u.Host == "":
			v.addf("%s.base_url: must be an http or https URL", at)
		case u.User != nil:
			v.addf("%s.base_url: must not contain a user name or password", at)
		case u.RawQuery != "" || u.Fragment != "":
			v.addf("%s.base_url: must not contain a query or fragment", at)
		}
	}
	if p.Kind == KindOpenAI && p.BaseURL == "" {
		v.addf("%s.base_url: required for kind openai (for example https://api.openai.com/v1)", at)
	}

	for _, model := range p.Models {
		v.check(validModelID(model), "%s.models: %q is not a model ID", at, model)
	}
	if p.DefaultModel != "" {
		v.check(validModelID(p.DefaultModel), "%s.default_model: %q is not a model ID", at, p.DefaultModel)
	}
	if p.PriceFree && len(p.Prices) > 0 {
		v.addf("%s: price_free = true and a prices table contradict each other; keep one", at)
	}
	for _, model := range sortedKeys(p.Prices) {
		price := p.Prices[model]
		pat := fmt.Sprintf("%s.prices.%s", at, model)
		v.check(validModelID(model), "%s: %q is not a model ID", pat, model)
		for _, rate := range []struct {
			name  string
			value *float64
		}{{"input", price.Input}, {"output", price.Output}} {
			switch {
			case rate.value == nil:
				v.addf("%s.%s: missing; a price needs both input and output, and a rate that is "+
					"really free must be written as 0", pat, rate.name)
			case !validMoney(*rate.value):
				v.addf("%s.%s: must be 0 or more", pat, rate.name)
			}
		}
		v.check(price.CacheRead == nil || validMoney(*price.CacheRead), "%s.cache_read: must be 0 or more", pat)
		v.check(price.CacheWrite == nil || validMoney(*price.CacheWrite), "%s.cache_write: must be 0 or more", pat)
	}
}

func validateRepo(v *validator, name string, r *Repo) {
	at := fmt.Sprintf("repos.%q", name)
	_, repo, _ := strings.Cut(name, "/")
	if !repoRE.MatchString(name) || repo == "." || repo == ".." {
		v.addf("%s: a repository key looks like \"owner/name\"", at)
	}
	for _, id := range sortedKeys(r.Commands) {
		argv := r.Commands[id]
		cat := fmt.Sprintf("%s.commands.%s", at, id)
		v.check(commandIDRE.MatchString(id),
			"%s: a command ID uses lower-case letters, digits, - and _, and starts with a letter", cat)
		switch {
		case len(argv) == 0:
			v.addf("%s: must be a non-empty argv array such as [\"go\", \"test\", \"./...\"]", cat)
			continue
		case argv[0] == "":
			v.addf("%s: the program name is empty", cat)
		case strings.HasPrefix(argv[0], "-"):
			v.addf("%s: the program name %q starts with a dash", cat, argv[0])
		case strings.ContainsAny(argv[0], shellMeta) || strings.ContainsFunc(argv[0], isControl):
			v.addf("%s: the program name %q contains a shell metacharacter; commands run without a shell, "+
				"so give the program and each argument as separate array items", cat, argv[0])
		}
		for i, arg := range argv {
			v.check(!strings.ContainsRune(arg, 0), "%s: argument %d contains a NUL byte", cat, i)
		}
	}
	if r.TestCommand != "" {
		if _, ok := r.Commands[r.TestCommand]; !ok {
			v.addf("%s.test_command: no command %q in commands (have: %s)",
				at, r.TestCommand, orNone(sortedKeys(r.Commands)))
		}
	}
	for _, path := range r.Protected {
		v.check(validProtectedPath(path),
			"%s.protected: %q must be a relative path inside the repository, with no \"..\"", at, path)
	}
}

// Warnings returns problems that do not stop patchbot from starting: a model
// with no price, an API key variable that is not set, and the like. A warning
// names the environment variable and never its value.
func (c *Config) Warnings() []string {
	var out []string
	redactor := c.Redactor()
	warnf := func(format string, args ...any) {
		out = append(out, redactor.Redact(fmt.Sprintf(format, args...)))
	}

	for _, name := range sortedKeys(c.Providers) {
		p := c.Providers[name]
		switch {
		case p.APIKeyEnv == "" && p.Kind != KindOpenAI:
			warnf("provider %q: api_key_env is not set, so requests carry no API key", name)
		case p.APIKey.IsSet() && len(p.APIKey.Reveal()) < secret.MinValueLen:
			warnf("provider %q: credential in %s is shorter than %d characters and cannot be masked; use a longer credential", name, p.APIKeyEnv, secret.MinValueLen)
		case p.APIKeyEnv != "" && envNameRE.MatchString(p.APIKeyEnv) && !p.APIKey.IsSet():
			warnf("provider %q: environment variable %s is not set; the provider cannot be used until it is",
				name, p.APIKeyEnv)
		}
		if p.PriceFree {
			continue
		}
		for _, model := range c.providerModels(name) {
			price, ok := p.Prices[model]
			switch {
			case !ok:
				warnf("provider %q: model %q has no price, so its cost is unknown and only the token limit applies; "+
					"add [providers.%s.prices.%q] or set price_free = true", name, model, name, model)
			case price.Checked.IsZero():
				warnf("provider %q: the price of model %q has no checked date", name, model)
			}
		}
	}

	if len(c.Repos) == 0 {
		warnf(`no [repos."owner/name"] table: no run can start until a repository is listed`)
	}
	for _, name := range sortedKeys(c.Repos) {
		if _, ok := c.Repos[name].TestCommandID(); !ok {
			warnf("repo %q: no test command, so its pull requests will be drafts marked unverified", name)
		}
	}
	if host, _, err := net.SplitHostPort(c.Server.Addr); err == nil && !isLoopback(host) {
		warnf("server.addr %q is not a loopback address; patchbot serve will require PATCHBOT_UI_TOKEN", c.Server.Addr)
	}
	return out
}

// providerModels returns the models a provider is expected to run: its list,
// its default and, for the default provider, the two stage models.
func (c *Config) providerModels(name string) []string {
	p := c.Providers[name]
	models := slices.Clone(p.Models)
	add := func(model string) {
		if model != "" && !slices.Contains(models, model) {
			models = append(models, model)
		}
	}
	add(p.DefaultModel)
	if name == c.Defaults.Provider {
		add(c.Defaults.RefineModel)
		add(c.Defaults.CodeModel)
	}
	return models
}

func validMoney(f float64) bool {
	return f >= 0 && !math.IsInf(f, 0) && !math.IsNaN(f)
}

func validModelID(id string) bool {
	return id != "" && len(id) <= 200 && !strings.ContainsFunc(id, func(r rune) bool {
		return isControl(r) || r == ' '
	})
}

func validProtectedPath(path string) bool {
	if path == "" || strings.HasPrefix(path, "/") || strings.ContainsRune(path, 0) || strings.Contains(path, `\`) {
		return false
	}
	for seg := range strings.SplitSeq(strings.TrimSuffix(path, "/"), "/") {
		if seg == "" || seg == "." || seg == ".." {
			return false
		}
	}
	return true
}

func isControl(r rune) bool { return r < 0x20 || r == 0x7f }

func isLoopback(host string) bool {
	if host == "localhost" {
		return true
	}
	ip := net.ParseIP(host)
	return ip != nil && ip.IsLoopback()
}

func orNone(items []string) string {
	if len(items) == 0 {
		return "none"
	}
	return strings.Join(items, ", ")
}
package config

import (
	"fmt"
	"io"
	"net/url"
	"reflect"
	"strconv"
	"strings"
	"time"

	"github.com/BurntSushi/toml"

	"github.com/aryanpappu/patchbot/internal/secret"
)

// WriteEffective prints the effective configuration as TOML, with the source
// of every value in a trailing comment. Secrets are never printed: each API
// key appears as a comment that says only whether it is set.
func (c *Config) WriteEffective(w io.Writer, extra ...*secret.Redactor) error {
	p := &printer{sources: c.sources, redactor: secret.NewRedactor()}
	p.redactor.AddSecrets(c.Secrets()...)
	for _, r := range extra {
		p.redactor.Extend(r)
	}

	if c.path == "" {
		p.linef("# config file: none found (built-in defaults)")
	} else {
		p.linef("# config file: %s", p.redactor.Redact(c.path))
	}
	p.table(nil, reflect.ValueOf(c).Elem())
	_, err := io.WriteString(w, p.b.String())
	return err
}

type printer struct {
	b        strings.Builder
	sources  map[string]Source
	redactor *secret.Redactor
}

func (p *printer) linef(format string, args ...any) {
	fmt.Fprintf(&p.b, format, args...)
	p.b.WriteByte('\n')
}

type entry struct {
	key   toml.Key
	value reflect.Value
}

// table prints one table: its own values first, then its sub-tables.
func (p *printer) table(key toml.Key, v reflect.Value) {
	var leaves, tables []entry
	add := func(name string, value reflect.Value) {
		e := entry{key: append(key[:len(key):len(key)], name), value: value}
		if isTable(value) {
			tables = append(tables, e)
		} else {
			leaves = append(leaves, e)
		}
	}
	switch v.Kind() {
	case reflect.Struct:
		t := v.Type()
		for i := range t.NumField() {
			name, _, _ := strings.Cut(t.Field(i).Tag.Get("toml"), ",")
			if name == "" || name == "-" {
				continue
			}
			add(name, v.Field(i))
		}
	case reflect.Map:
		for _, name := range sortedKeys(mapOfValues(v)) {
			add(p.redactor.Redact(name), v.MapIndex(reflect.ValueOf(name)))
		}
	}

	if v.Kind() == reflect.Map && v.Len() == 0 {
		return
	}
	provider, isProvider := v.Interface().(Provider)
	if len(key) > 0 && (len(leaves) > 0 || len(tables) == 0) {
		p.linef("")
		p.linef("[%s]", key)
	}
	width := 0
	rendered := make([]string, len(leaves))
	for i, leaf := range leaves {
		text, ok := formatValue(leaf.value, p.redactor)
		if !ok {
			continue
		}
		name := leaf.key[len(leaf.key)-1]
		if isProvider && name == "api_key_env" && provider.APIKeyEnv != "" && !envNameRE.MatchString(provider.APIKeyEnv) {
			text = strconv.Quote(secret.Mask) // most likely a key pasted into the wrong field
		}
		if isProvider && name == "base_url" {
			text = strconv.Quote(p.redactor.Redact(displayURL(provider.BaseURL)))
		}
		rendered[i] = fmt.Sprintf("%s = %s", toml.Key{name}, text)
		width = max(width, len(rendered[i]))
	}
	for i, leaf := range leaves {
		if rendered[i] != "" {
			p.linef("%-*s  # %s", width, rendered[i], p.redactor.Redact(p.sources[leaf.key.String()].String()))
		}
	}
	if isProvider {
		p.linef("%s", p.redactor.Redact(apiKeyStatus(provider)))
	}
	for _, t := range tables {
		value := t.value
		if value.Kind() == reflect.Pointer {
			value = value.Elem()
		}
		p.table(t.key, value)
	}
}

// displayURL returns a URL without the parts that can carry credentials: the
// user name and password, the query and the fragment. Validate rejects a
// base_url that has them, but config show prints invalid configs too, and
// that is exactly when such a URL is on screen. A URL that does not parse is
// masked whole.
func displayURL(raw string) string {
	if raw == "" {
		return ""
	}
	u, err := url.Parse(raw)
	if err != nil || u.Host == "" || (u.Scheme != "http" && u.Scheme != "https") {
		return secret.Mask
	}
	clean := url.URL{Scheme: u.Scheme, Host: u.Host, Path: u.Path, RawPath: u.RawPath}
	text := clean.String()
	if u.User != nil {
		text += " (credentials removed)"
	}
	if u.RawQuery != "" || u.Fragment != "" || u.ForceQuery {
		text += " (query removed)"
	}
	return text
}

func apiKeyStatus(p Provider) string {
	switch {
	case p.APIKeyEnv == "":
		return "# api key: none (api_key_env is not set)"
	case !envNameRE.MatchString(p.APIKeyEnv):
		return "# api key: not read (api_key_env is not a variable name)"
	case p.APIKey.IsSet():
		return fmt.Sprintf("# api key: %s (set in $%s)", secret.Mask, p.APIKeyEnv)
	default:
		return fmt.Sprintf("# api key: not set ($%s is empty)", p.APIKeyEnv)
	}
}

func mapOfValues(v reflect.Value) map[string]reflect.Value {
	out := make(map[string]reflect.Value, v.Len())
	for iter := v.MapRange(); iter.Next(); {
		out[iter.Key().String()] = iter.Value()
	}
	return out
}

var dateType = reflect.TypeFor[Date]()

// isTable reports whether v prints as a TOML table and not as a value.
func isTable(v reflect.Value) bool {
	t := v.Type()
	if t.Kind() == reflect.Pointer {
		t = t.Elem()
	}
	switch t.Kind() {
	case reflect.Struct:
		return t != dateType
	case reflect.Map:
		return true
	default:
		return false
	}
}

// formatValue renders a value as TOML. It reports false for an optional value
// that is not set, which has no TOML form.
func formatValue(v reflect.Value, r *secret.Redactor) (string, bool) {
	if v.Kind() == reflect.Pointer {
		if v.IsNil() {
			return "", false
		}
		v = v.Elem()
	}
	switch x := v.Interface().(type) {
	case string:
		return strconv.Quote(r.Redact(x)), true
	case bool:
		return strconv.FormatBool(x), true
	case int:
		return strconv.Itoa(x), true
	case int64:
		return strconv.FormatInt(x, 10), true
	case float64:
		s := strconv.FormatFloat(x, 'f', -1, 64)
		if !strings.ContainsAny(s, ".eEIN") {
			s += ".0"
		}
		return s, true
	case time.Duration:
		return strconv.Quote(x.String()), true
	case Date:
		if x.IsZero() {
			return "", false
		}
		return x.String(), true
	case []string:
		quoted := make([]string, len(x))
		for i, item := range x {
			quoted[i] = strconv.Quote(r.Redact(item))
		}
		return "[" + strings.Join(quoted, ", ") + "]", true
	default:
		return strconv.Quote(r.Redact(fmt.Sprint(x))), true
	}
}

