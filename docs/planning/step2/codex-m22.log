	f.git(t, f.seed, "commit", "--no-verify", "-m", "second")
	f.latest = strings.TrimSpace(f.git(t, f.seed, "rev-parse", "HEAD"))
	f.git(t, f.seed, "push", f.bare, "HEAD:refs/heads/main")
	return f
}

