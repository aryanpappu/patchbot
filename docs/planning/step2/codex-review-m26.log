// Start creates and executes the read-only phase, returning a durable waiting
// run (or a completed investigation). It never bypasses approval, even dry-run.
func (r *Runner) Start(ctx context.Context, req Request) (store.Run, error) {
	run, err := r.prepare(req)
	if err != nil {
		return run, err
	}
	if req.Mode == "" {
		issue, err := r.gh.GetIssue(ctx, ref(run.Repo), int(run.IssueNumber))
		if err != nil {
			return store.Run{}, err
		}
		for _, mode := range []string{config.ModeInvestigate, config.ModeRefine, config.ModeFix} {
			for _, label := range issue.Labels {
				if label.Name == "ai-"+mode {
					run.Mode = mode
					return r.start(ctx, run, nil)
				}
			}
		}
	}
	return r.start(ctx, run, nil)
}

func (r *Runner) start(ctx context.Context, run store.Run, reuse *store.Spec) (store.Run, error) {
	ctx, release, err := r.admit(ctx)
	if err != nil {
		return store.Run{}, err
	}
	defer release()
	run.Trigger = r.actionChannel()
	if r.opts.Dispatch != nil {
		admittedAt := time.Now().UTC()
		run.HeartbeatAt = &admittedAt
	}
	run, err = r.db.CreateRun(ctx, run)
	if err != nil {
		return run, err
	}
	id := run.ID
	initial := run
	if err = r.action(ctx, id, "start", r.actorFor(ctx), r.actionChannel(), nil); err == nil {
		err = r.dispatch(ctx, id, func(work context.Context) error {
			run := initial
			err := r.withWork(work, id, func(work context.Context) error {
				if err := r.transition(work, &run, store.StatusRunning, store.PhasePreflight, store.RunPatch{}); err != nil {
					return err
				}
				return r.refine(work, &run, nil, "", reuse)
			})
			if err != nil {
				return r.fail(work, run, err)
			}
			// A retry may reuse an approved spec. It still enters the ordinary gate.
			if reuse != nil && r.opts.Dispatch != nil {
				return r.execute(work, id)
			}
			return nil
		})
	}
	if err != nil {
		err = r.fail(ctx, initial, err)
	}
	latest, readErr := r.db.GetRun(context.WithoutCancel(ctx), id)
	return latest, errors.Join(err, readErr)
}

func (r *Runner) actionChannel() string {
	if r.opts.ActionChannel == "ui" {
		return "ui"
	}
	return "cli"
}

func (r *Runner) admit(ctx context.Context) (context.Context, func(), error) {
	if r.opts.Admit != nil {
		return r.opts.Admit(ctx)
	}
	return ctx, func() {}, nil
}

// RecoverStale fails orphaned active work and releases its issue lock. Servers
// call this periodically as well as on startup so quick restarts recover later.
func (r *Runner) RecoverStale(ctx context.Context) error {
	_, err := r.db.FailStaleRuns(ctx, r.now().Add(-r.opts.StaleAfter))
	return err
}

func (r *Runner) dispatch(ctx context.Context, id int64, work func(context.Context) error) error {
	if r.opts.Dispatch != nil {
		return r.opts.Dispatch(ctx, id, work)
	}
	return work(ctx)
}

func (r *Runner) transition(ctx context.Context, run *store.Run, status store.Status, phase store.Phase, patch store.RunPatch) error {
	// Free text from provider/GitHub responses must be redacted before SQLite,
	// not only when displayed by the API or CLI.
	for _, field := range []*string{patch.IssueTitle, patch.ErrorMessage, patch.PRURL, patch.Summary} {
		if field != nil {
			*field = r.redactor.Redact(*field)
		}
	}
	patch.Phase = phase
	patch.ExpectedGeneration = &run.Generation
	if err := r.db.SetRunStatus(ctx, run.ID, run.Status, status, patch); err != nil {
		return err
	}
	updated, err := r.db.GetRun(ctx, run.ID)
	if err != nil {
		return err
	}
	if updated.Status != status || updated.Generation != run.Generation+1 {
		return store.ErrConflict
	}
	*run = updated
	return nil
}
package github

import (
	"strings"
	"unicode"
	"unicode/utf8"
)

// NeutralizeMentions inserts a zero-width joiner after @ in user and team
// mentions. Email addresses and Markdown inline code and fenced code are kept.
// Applying it more than once has no additional effect.
func NeutralizeMentions(text string) string {
	var out strings.Builder
	out.Grow(len(text))
	var code byte
	var width int
	fenced := false
	lineStart := true
	indent := 0
	var previous rune
	for index := 0; index < len(text); {
		current := text[index]
		if current == '\n' {
			out.WriteByte(current)
			index++
			lineStart, indent, previous = true, 0, '\n'
			continue
		}
		if current == '`' || (current == '~' && lineStart) {
			end := index + 1
			for end < len(text) && text[end] == current {
				end++
			}
			run := end - index
			fence := lineStart && indent <= 3 && run >= 3
			if current == '`' {
				info, _, _ := strings.Cut(text[end:], "\n")
				fence = fence && !strings.ContainsRune(info, '`')
			}
			switch {
			case code == 0 && current == '`' && (!lineStart || indent <= 3) && !escapedAt(text, index) &&
				(fence || hasClosingTicks(text[end:], run)):
				code, width, fenced = current, run, fence
			case code == 0 && current == '~' && fence:
				code, width, fenced = current, run, true
			case code == current && ((!fenced && run == width) ||
				(fenced && lineStart && indent <= 3 && run >= width && fenceEnd(text[end:]))):
				code, width, fenced = 0, 0, false
			}
			out.WriteString(text[index:end])
			index, lineStart, previous = end, false, rune(current)
			continue
		}
		if current == '@' && code == 0 && index+1 < len(text) && mentionStart(text[index+1]) &&
			!emailAt(text, index, previous) {
			out.WriteString("@\u200d")
			index++
			lineStart, previous = false, '@'
			continue
		}
		character, size := utf8.DecodeRuneInString(text[index:])
		out.WriteString(text[index : index+size])
		index += size
		if current != ' ' && current != '\t' && current != '\r' {
			lineStart = false
		} else if lineStart {
			switch current {
			case '\t':
				indent += 4 - indent%4
			case ' ':
				indent++
			}
		}
		previous = character
	}
	return out.String()
}

func fenceEnd(text string) bool {
	line, _, _ := strings.Cut(text, "\n")
	return strings.Trim(line, " \t\r") == ""
}

func mentionStart(character byte) bool {
	return character >= 'a' && character <= 'z' || character >= 'A' && character <= 'Z' ||
		character >= '0' && character <= '9'
}

func emailAt(text string, index int, previous rune) bool {
	if !unicode.IsLetter(previous) && !unicode.IsDigit(previous) && !strings.ContainsRune("._%+-", previous) {
		return false
	}
	end := index + 1
	for end < len(text) && (mentionStart(text[end]) || text[end] == '.' || text[end] == '-') {
		end++
	}
	domain := strings.TrimRight(text[index+1:end], ".")
	dot := strings.IndexByte(domain, '.')
	return dot > 0 && dot < len(domain)-1 && !strings.Contains(domain, "..")
}

func escapedAt(text string, index int) bool {
	count := 0
	for index > 0 && text[index-1] == '\\' {
		count++
		index--
	}
	return count%2 != 0
}

func hasClosingTicks(text string, width int) bool {
	for index := 0; index < len(text); {
		if text[index] != '`' {
			index++
			continue
		}
		end := index + 1
		for end < len(text) && text[end] == '`' {
			end++
		}
		if end-index == width {
			return true
		}
		index = end
	}
	return false
}
package runner

import (
	"context"
	"encoding/json"
	"errors"
	"fmt"
	"os"
	"path/filepath"
	"slices"
	"strconv"
	"strings"
	"time"

	"github.com/aryanpappu/patchbot/internal/agent"
	"github.com/aryanpappu/patchbot/internal/config"
	"github.com/aryanpappu/patchbot/internal/execx"
	"github.com/aryanpappu/patchbot/internal/github"
	"github.com/aryanpappu/patchbot/internal/gitx"
	"github.com/aryanpappu/patchbot/internal/store"
	"github.com/aryanpappu/patchbot/internal/tools"
	"github.com/aryanpappu/patchbot/internal/workspace"
)

type toolEnvironment struct {
	repo *gitx.Repo
	env  *tools.Env
	dir  string
}

func (e *toolEnvironment) close() error {
	if e == nil || e.dir == "" {
		return nil
	}
	dir := e.dir
	e.dir = ""
	err := errors.Join(e.env.WS.Close(false), e.repo.Close())
	root, openErr := os.OpenRoot(filepath.Dir(dir))
	if openErr != nil {
		return errors.Join(err, openErr)
	}
	defer func() { _ = root.Close() }()
	return errors.Join(err, root.RemoveAll(filepath.Base(dir)))
}

func (r *Runner) clone(ctx context.Context, run store.Run, meta github.Repo, sha string) (_ *toolEnvironment, err error) {
	base := filepath.Join(r.cfg.DataDir(), "workspaces")
	if err := os.MkdirAll(base, 0700); err != nil {
		return nil, errors.New("create workspace directory failed")
	}
	dir, err := os.MkdirTemp(base, "run-"+strconv.FormatInt(run.ID, 10)+"-")
	if err != nil {
		return nil, errors.New("create run workspace failed")
	}
	defer func() {
		if err != nil {
			_ = os.RemoveAll(dir)
		}
	}()
	// git asks for a fresh repository-bound token on every remote operation,
	// so a run longer than an installation token's lifetime still pushes.
	repoRef := ref(run.Repo)
	tokenFunc := func(ctx context.Context) (string, error) { return r.tokens.RepoToken(ctx, repoRef) }
	if _, err := tokenFunc(ctx); err != nil {
		return nil, githubCredentialError(err)
	}
	var repo *gitx.Repo
	defer func() {
		if err != nil && repo != nil {
