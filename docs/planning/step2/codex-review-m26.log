+	if byNumber, ok, err := f.db.DashboardIssueByNumber(t.Context(), "owner/repo", 1); err != nil || !ok || byNumber.IdempotencyKey != goodKey {
+		t.Fatalf("lookup by number: %+v %v %v", byNumber, ok, err)
