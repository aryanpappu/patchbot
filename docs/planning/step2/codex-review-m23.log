+++ b/internal/cfaccess/cfaccess.go
@@ -0,0 +1,279 @@
+// Package cfaccess verifies Cloudflare Access application tokens
+// (Cf-Access-Jwt-Assertion) with the standard library only. It accepts RS256
+// signatures from the team JWKS and nothing else.
+package cfaccess
+
+import (
+	"context"
+	"crypto"
+	"crypto/rsa"
+	"crypto/sha256"
+	"encoding/base64"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"io"
+	"math/big"
+	"net/http"
+	"strings"
+	"sync"
+	"time"
+)
+
+// Header is the request header Cloudflare Access adds after login.
+const Header = "Cf-Access-Jwt-Assertion"
+
+const (
+	skew          = 60 * time.Second
+	refreshEvery  = time.Minute
+	maxTokenBytes = 16 << 10
+	maxJWKSBytes  = 1 << 20
+	minRSABits    = 2048
+)
+
+// Errors are deliberately coarse; callers must not echo token content.
+var (
+	// ErrInvalid covers every malformed, unsigned, expired or mis-scoped token.
+	ErrInvalid = errors.New("invalid access token")
+	// ErrNotAllowed means a valid token names an email that is not allowed.
+	ErrNotAllowed = errors.New("email not allowed")
+)
+
+// Config describes one Access application.
+type Config struct {
+	TeamDomain    string
+	Audience      string
+	AllowedEmails []string
+	// CertsURL overrides https://<team>/cdn-cgi/access/certs (tests).
+	CertsURL string
+	Client   *http.Client
+	Now      func() time.Time
+}
+
+// Verifier checks tokens and caches the team signing keys by kid.
+type Verifier struct {
+	issuer   string
+	audience string
+	allowed  map[string]bool
+	certs    string
+	client   *http.Client
+	now      func() time.Time
+
+	fetchMu   sync.Mutex
+	mu        sync.Mutex
+	keys      map[string]*rsa.PublicKey
+	lastFetch time.Time
+}
+
+// New builds a verifier. It performs no network I/O.
+func New(c Config) (*Verifier, error) {
+	if c.TeamDomain == "" || c.Audience == "" || len(c.AllowedEmails) == 0 {
+		return nil, errors.New("team domain, audience and allowed emails are required")
+	}
+	v := &Verifier{issuer: "https://" + c.TeamDomain, audience: c.Audience, allowed: map[string]bool{}, certs: c.CertsURL, client: c.Client, now: c.Now}
+	if v.certs == "" {
+		v.certs = "https://" + c.TeamDomain + "/cdn-cgi/access/certs"
+	}
+	if v.now == nil {
+		v.now = time.Now
+	}
+	if v.client == nil {
+		v.client = &http.Client{Timeout: 5 * time.Second}
+	}
+	// Redirects could move the key fetch to another origin.
+	client := *v.client
+	client.CheckRedirect = func(*http.Request, []*http.Request) error { return http.ErrUseLastResponse }
+	v.client = &client
+	for _, e := range c.AllowedEmails {
+		v.allowed[strings.ToLower(strings.TrimSpace(e))] = true
+	}
+	return v, nil
+}
+
+type header struct {
+	Alg string `json:"alg"`
+	Kid string `json:"kid"`
+}
+
+type claims struct {
+	Iss   string          `json:"iss"`
+	Aud   json.RawMessage `json:"aud"`
+	Exp   *float64        `json:"exp"`
+	Nbf   *float64        `json:"nbf"`
+	Iat   *float64        `json:"iat"`
+	Email string          `json:"email"`
+}
+
+// Verify returns the lower-cased email of a valid, allowed token.
+func (v *Verifier) Verify(ctx context.Context, token string) (string, error) {
+	if token == "" || len(token) > maxTokenBytes {
+		return "", ErrInvalid
+	}
+	parts := strings.Split(token, ".")
+	if len(parts) != 3 {
+		return "", ErrInvalid
+	}
+	var h header
+	if decodeSegment(parts[0], &h) != nil || h.Alg != "RS256" || h.Kid == "" {
+		return "", ErrInvalid
+	}
+	sig, err := base64.RawURLEncoding.DecodeString(parts[2])
+	if err != nil || len(sig) == 0 {
+		return "", ErrInvalid
+	}
+	key, err := v.key(ctx, h.Kid)
+	if err != nil {
+		return "", ErrInvalid
+	}
+	sum := sha256.Sum256([]byte(parts[0] + "." + parts[1]))
+	if rsa.VerifyPKCS1v15(key, crypto.SHA256, sum[:], sig) != nil {
+		return "", ErrInvalid
+	}
+	var c claims
+	if decodeSegment(parts[1], &c) != nil || c.Iss != v.issuer || !audienceMatches(c.Aud, v.audience) || c.Exp == nil || c.Iat == nil {
+		return "", ErrInvalid
+	}
+	now := v.now()
+	if now.After(unix(*c.Exp).Add(skew)) || now.Add(skew).Before(unix(*c.Iat)) || (c.Nbf != nil && now.Add(skew).Before(unix(*c.Nbf))) {
+		return "", ErrInvalid
+	}
+	email := strings.ToLower(strings.TrimSpace(c.Email))
+	if email == "" || len(email) > 320 || strings.ContainsFunc(email, func(r rune) bool { return r < 0x21 || r == 0x7f }) {
+		return "", ErrInvalid
+	}
+	if !v.allowed[email] {
+		return "", ErrNotAllowed
+	}
+	return email, nil
+}
+
+func unix(f float64) time.Time { return time.Unix(int64(f), 0) }
+
+func decodeSegment(s string, into any) error {
+	raw, err := base64.RawURLEncoding.DecodeString(s)
+	if err != nil {
+		return err
+	}
+	return json.Unmarshal(raw, into)
+}
+
+func audienceMatches(raw json.RawMessage, want string) bool {
+	var one string
+	if json.Unmarshal(raw, &one) == nil {
+		return one == want
+	}
+	var many []string
+	if json.Unmarshal(raw, &many) == nil {
+		for _, a := range many {
+			if a == want {
+				return true
+			}
+		}
+	}
+	return false
+}
+
+// key returns the cached key for kid. An unknown kid triggers at most one
+// refresh per minute, so a flood of forged kids cannot hammer the JWKS URL.
+func (v *Verifier) key(ctx context.Context, kid string) (*rsa.PublicKey, error) {
+	if k := v.cached(kid); k != nil {
+		return k, nil
+	}
+	v.fetchMu.Lock()
+	defer v.fetchMu.Unlock()
+	// Another request may have refreshed while this one waited.
+	if k := v.cached(kid); k != nil {
+		return k, nil
+	}
+	v.mu.Lock()
+	recent := !v.lastFetch.IsZero() && v.now().Sub(v.lastFetch) < refreshEvery
+	if !recent {
+		v.lastFetch = v.now()
+	}
+	v.mu.Unlock()
+	if recent {
+		return nil, errors.New("unknown key")
+	}
+	keys, err := v.fetch(ctx)
+	if err != nil {
+		return nil, err
+	}
+	v.mu.Lock()
+	v.keys = keys
+	k := keys[kid]
+	v.mu.Unlock()
+	if k == nil {
+		return nil, errors.New("unknown key")
+	}
+	return k, nil
+}
+
+func (v *Verifier) cached(kid string) *rsa.PublicKey {
+	v.mu.Lock()
+	defer v.mu.Unlock()
+	return v.keys[kid]
+}
+
+// Check fetches the JWKS once and reports how many RSA keys it holds.
+func (v *Verifier) Check(ctx context.Context) (int, error) {
+	keys, err := v.fetch(ctx)
+	return len(keys), err
+}
+
+type jwks struct {
+	Keys []struct {
+		Kty string `json:"kty"`
+		Kid string `json:"kid"`
+		Use string `json:"use"`
+		Alg string `json:"alg"`
+		N   string `json:"n"`
+		E   string `json:"e"`
+	} `json:"keys"`
+}
+
+func (v *Verifier) fetch(ctx context.Context) (map[string]*rsa.PublicKey, error) {
+	ctx, cancel := context.WithTimeout(ctx, 10*time.Second)
+	defer cancel()
+	req, err := http.NewRequestWithContext(ctx, http.MethodGet, v.certs, nil)
+	if err != nil {
+		return nil, errors.New("invalid JWKS URL")
+	}
+	req.Header.Set("Accept", "application/json")
+	resp, err := v.client.Do(req)
+	if err != nil {
+		return nil, errors.New("JWKS request failed")
+	}
+	defer func() { _ = resp.Body.Close() }()
+	if resp.StatusCode != http.StatusOK {
+		return nil, fmt.Errorf("JWKS request returned status %d", resp.StatusCode)
+	}
+	body, err := io.ReadAll(io.LimitReader(resp.Body, maxJWKSBytes+1))
+	if err != nil || len(body) > maxJWKSBytes {
+		return nil, errors.New("JWKS body unreadable or too large")
+	}
+	var set jwks
+	if json.Unmarshal(body, &set) != nil {
+		return nil, errors.New("JWKS is not valid JSON")
+	}
+	keys := map[string]*rsa.PublicKey{}
+	for _, k := range set.Keys {
+		if k.Kty != "RSA" || k.Kid == "" || (k.Use != "" && k.Use != "sig") || (k.Alg != "" && k.Alg != "RS256") {
+			continue
+		}
+		n, errN := base64.RawURLEncoding.DecodeString(k.N)
+		e, errE := base64.RawURLEncoding.DecodeString(k.E)
+		if errN != nil || errE != nil || len(e) == 0 || len(e) > 4 {
+			continue
+		}
+		exp := new(big.Int).SetBytes(e)
+		mod := new(big.Int).SetBytes(n)
+		if !exp.IsInt64() || exp.Int64() < 3 || exp.Int64()%2 == 0 || mod.BitLen() < minRSABits {
+			continue
+		}
+		keys[k.Kid] = &rsa.PublicKey{N: mod, E: int(exp.Int64())}
+	}
+	if len(keys) == 0 {
+		return nil, errors.New("JWKS has no usable RSA keys")
+	}
+	return keys, nil
+}
diff --git a/internal/cfaccess/cfaccess_test.go b/internal/cfaccess/cfaccess_test.go
new file mode 100644
index 0000000..07108c1
--- /dev/null
+++ b/internal/cfaccess/cfaccess_test.go
@@ -0,0 +1,272 @@
+package cfaccess
+
+import (
+	"context"
+	"crypto"
+	"crypto/hmac"
+	"crypto/rand"
+	"crypto/rsa"
+	"crypto/sha256"
+	"encoding/base64"
+	"encoding/json"
+	"errors"
+	"math/big"
+	"net/http"
+	"net/http/httptest"
+	"strings"
+	"sync"
+	"sync/atomic"
+	"testing"
+	"time"
+)
+
+const (
+	team = "crimson-scene-dba4.cloudflareaccess.com"
+	aud  = "0123456789abcdef0123456789abcdef"
+)
+
+var epoch = time.Date(2026, 11, 14, 12, 0, 0, 0, time.UTC)
+
+func newKey(t *testing.T) *rsa.PrivateKey {
+	t.Helper()
+	k, err := rsa.GenerateKey(rand.Reader, 2048)
+	if err != nil {
+		t.Fatal(err)
+	}
+	return k
+}
+
+type jwksServer struct {
+	*httptest.Server
+	mu    sync.Mutex
+	keys  map[string]*rsa.PrivateKey
+	fetch atomic.Int32
+}
+
+func newJWKS(t *testing.T, keys map[string]*rsa.PrivateKey) *jwksServer {
+	s := &jwksServer{keys: keys}
+	s.Server = httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, _ *http.Request) {
+		s.fetch.Add(1)
+		s.mu.Lock()
+		defer s.mu.Unlock()
+		type jwk struct{ Kty, Kid, Use, Alg, N, E string }
+		var out struct {
+			Keys []jwk `json:"keys"`
+		}
+		for kid, k := range s.keys {
+			out.Keys = append(out.Keys, jwk{"RSA", kid, "sig", "RS256", b64(k.N.Bytes()), b64(big.NewInt(int64(k.E)).Bytes())})
+		}
+		_ = json.NewEncoder(w).Encode(map[string]any{"keys": lowerKeys(out.Keys)})
+	}))
+	t.Cleanup(s.Close)
+	return s
+}
+
+// lowerKeys renders JWK field names in lower case as JWKS requires.
+func lowerKeys[T any](in []T) []map[string]string {
+	var out []map[string]string
+	for _, k := range in {
+		raw, _ := json.Marshal(k)
+		var m map[string]string
+		_ = json.Unmarshal(raw, &m)
+		l := map[string]string{}
+		for key, v := range m {
+			l[strings.ToLower(key)] = v
+		}
+		out = append(out, l)
+	}
+	return out
+}
+
+func (s *jwksServer) set(keys map[string]*rsa.PrivateKey) {
+	s.mu.Lock()
+	s.keys = keys
+	s.mu.Unlock()
+}
+
+func b64(b []byte) string { return base64.RawURLEncoding.EncodeToString(b) }
+
+type clock struct {
+	mu sync.Mutex
+	t  time.Time
+}
+
+func (c *clock) now() time.Time { c.mu.Lock(); defer c.mu.Unlock(); return c.t }
+func (c *clock) add(d time.Duration) {
+	c.mu.Lock()
+	c.t = c.t.Add(d)
+	c.mu.Unlock()
+}
+
+func claimsAt(now time.Time) map[string]any {
+	return map[string]any{"iss": "https://" + team, "aud": []string{aud}, "email": "Owner@Example.com",
+		"iat": now.Unix(), "nbf": now.Unix(), "exp": now.Add(time.Hour).Unix()}
+}
+
+func sign(t *testing.T, key *rsa.PrivateKey, header, claims map[string]any) string {
+	t.Helper()
+	h, _ := json.Marshal(header)
+	c, _ := json.Marshal(claims)
+	input := b64(h) + "." + b64(c)
+	sum := sha256.Sum256([]byte(input))
+	sig, err := rsa.SignPKCS1v15(rand.Reader, key, crypto.SHA256, sum[:])
+	if err != nil {
+		t.Fatal(err)
+	}
+	return input + "." + b64(sig)
+}
+
+func rs(kid string) map[string]any { return map[string]any{"alg": "RS256", "kid": kid, "typ": "JWT"} }
+
+func setup(t *testing.T) (*Verifier, *jwksServer, *clock, *rsa.PrivateKey) {
+	t.Helper()
+	key := newKey(t)
+	srv := newJWKS(t, map[string]*rsa.PrivateKey{"k1": key})
+	clk := &clock{t: epoch}
+	v, err := New(Config{TeamDomain: team, Audience: aud, AllowedEmails: []string{"owner@example.com"}, CertsURL: srv.URL, Now: clk.now})
+	if err != nil {
+		t.Fatal(err)
+	}
+	return v, srv, clk, key
+}
+
+func TestVerifyValid(t *testing.T) {
+	v, _, clk, key := setup(t)
+	email, err := v.Verify(t.Context(), sign(t, key, rs("k1"), claimsAt(clk.now())))
+	if err != nil || email != "owner@example.com" {
+		t.Fatalf("email %q err %v", email, err)
+	}
+	c := claimsAt(clk.now())
+	c["aud"] = aud // string form
+	if _, err := v.Verify(t.Context(), sign(t, key, rs("k1"), c)); err != nil {
+		t.Fatal(err)
+	}
+}
+
+func TestVerifyRejects(t *testing.T) {
+	v, _, clk, key := setup(t)
+	other := newKey(t)
+	now := clk.now()
+	mod := func(f func(map[string]any)) string {
+		c := claimsAt(now)
+		f(c)
+		return sign(t, key, rs("k1"), c)
+	}
+	hmacTok := func() string {
+		h, _ := json.Marshal(map[string]any{"alg": "HS256", "kid": "k1"})
+		c, _ := json.Marshal(claimsAt(now))
+		in := b64(h) + "." + b64(c)
+		m := hmac.New(sha256.New, []byte("secret"))
+		m.Write([]byte(in))
+		return in + "." + b64(m.Sum(nil))
+	}()
+	noneH, _ := json.Marshal(map[string]any{"alg": "none", "kid": "k1"})
+	noneC, _ := json.Marshal(claimsAt(now))
+	cases := map[string]string{
+		"empty":         "",
+		"garbage":       "a.b",
+		"bad signature": sign(t, other, rs("k1"), claimsAt(now)),
+		"wrong aud":     mod(func(c map[string]any) { c["aud"] = []string{"other"} }),
+		"wrong iss":     mod(func(c map[string]any) { c["iss"] = "https://evil.cloudflareaccess.com" }),
+		"expired":       mod(func(c map[string]any) { c["exp"] = now.Add(-2 * time.Minute).Unix() }),
+		"not yet valid": mod(func(c map[string]any) { c["nbf"] = now.Add(5 * time.Minute).Unix() }),
+		"future iat":    mod(func(c map[string]any) { c["iat"] = now.Add(5 * time.Minute).Unix() }),
+		"no exp":        mod(func(c map[string]any) { delete(c, "exp") }),
+		"no email":      mod(func(c map[string]any) { delete(c, "email") }),
+		"alg none":      b64(noneH) + "." + b64(noneC) + ".",
+		"alg HS256":     hmacTok,
+		"unknown kid":   sign(t, key, rs("zzz"), claimsAt(now)),
+		"missing kid":   sign(t, key, map[string]any{"alg": "RS256"}, claimsAt(now)),
+	}
+	for name, token := range cases {
+		if _, err := v.Verify(t.Context(), token); !errors.Is(err, ErrInvalid) {
+			t.Errorf("%s: err %v, want ErrInvalid", name, err)
+		}
+	}
+	if _, err := v.Verify(t.Context(), mod(func(c map[string]any) { c["email"] = "intruder@example.com" })); !errors.Is(err, ErrNotAllowed) {
+		t.Errorf("email not allowed: %v", err)
+	}
+}
+
+func TestSkewAllowsSmallDrift(t *testing.T) {
+	v, _, clk, key := setup(t)
+	c := claimsAt(clk.now())
+	c["nbf"] = clk.now().Add(30 * time.Second).Unix()
+	c["exp"] = clk.now().Add(-30 * time.Second).Unix()
+	if _, err := v.Verify(t.Context(), sign(t, key, rs("k1"), c)); err != nil {
+		t.Fatalf("30s drift must be tolerated: %v", err)
+	}
+}
+
+func TestUnknownKidRefetchesAtMostOncePerMinute(t *testing.T) {
+	v, srv, clk, key := setup(t)
+	if _, err := v.Verify(t.Context(), sign(t, key, rs("k1"), claimsAt(clk.now()))); err != nil {
+		t.Fatal(err)
+	}
+	if srv.fetch.Load() != 1 {
+		t.Fatalf("fetches %d", srv.fetch.Load())
+	}
+	bad := sign(t, key, rs("nope"), claimsAt(clk.now()))
+	clk.add(2 * time.Minute)
+	for range 5 {
+		_, _ = v.Verify(t.Context(), bad)
+	}
+	if srv.fetch.Load() != 2 {
+		t.Fatalf("unknown kid must refetch exactly once within a minute, fetches %d", srv.fetch.Load())
+	}
+	clk.add(61 * time.Second)
+	_, _ = v.Verify(t.Context(), bad)
+	if srv.fetch.Load() != 3 {
+		t.Fatalf("expected a refetch after the minute, fetches %d", srv.fetch.Load())
+	}
+}
+
+func TestKeyRotation(t *testing.T) {
+	v, srv, clk, key := setup(t)
+	if _, err := v.Verify(t.Context(), sign(t, key, rs("k1"), claimsAt(clk.now()))); err != nil {
+		t.Fatal(err)
+	}
+	fresh := newKey(t)
+	srv.set(map[string]*rsa.PrivateKey{"k2": fresh})
+	clk.add(2 * time.Minute)
+	if _, err := v.Verify(t.Context(), sign(t, fresh, rs("k2"), claimsAt(clk.now()))); err != nil {
+		t.Fatalf("rotated key rejected: %v", err)
+	}
+	// The retired key no longer verifies once the cache has been replaced.
+	if _, err := v.Verify(t.Context(), sign(t, key, rs("k1"), claimsAt(clk.now()))); !errors.Is(err, ErrInvalid) {
+		t.Fatalf("retired key accepted: %v", err)
+	}
+}
+
+func TestJWKSFailures(t *testing.T) {
+	for name, handler := range map[string]http.HandlerFunc{
+		"status":   func(w http.ResponseWriter, _ *http.Request) { http.Error(w, "no", 500) },
+		"not json": func(w http.ResponseWriter, _ *http.Request) { _, _ = w.Write([]byte("<html>")) },
+		"no keys": func(w http.ResponseWriter, _ *http.Request) {
+			_, _ = w.Write([]byte(`{"keys":[{"kty":"EC","kid":"x"}]}`))
+		},
+		"too big": func(w http.ResponseWriter, _ *http.Request) {
+			_, _ = w.Write([]byte(strings.Repeat(" ", maxJWKSBytes+10)))
+		},
+		"redirect": func(w http.ResponseWriter, r *http.Request) {
+			http.Redirect(w, r, "http://127.0.0.1:1/", http.StatusFound)
+		},
+	} {
+		srv := httptest.NewServer(handler)
+		v, err := New(Config{TeamDomain: team, Audience: aud, AllowedEmails: []string{"a@b.co"}, CertsURL: srv.URL})
+		if err != nil {
+			t.Fatal(err)
+		}
+		if _, err := v.Check(context.Background()); err == nil {
+			t.Errorf("%s: expected an error", name)
+		}
+		srv.Close()
+	}
+}
+
+func TestCheckCountsKeys(t *testing.T) {
+	v, _, _, _ := setup(t)
+	if n, err := v.Check(t.Context()); err != nil || n != 1 {
+		t.Fatalf("n=%d err=%v", n, err)
+	}
+}
