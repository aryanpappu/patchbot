)

type toolEnvironment struct {
	repo *gitx.Repo
	env  *tools.Env
	dir  string
}

func (e *toolEnvironment) close() error {
	if e == nil || e.dir == "" {
		return nil
	}
	dir := e.dir
	e.dir = ""
	err := errors.Join(e.env.WS.Close(false), e.repo.Close())
	root, openErr := os.OpenRoot(filepath.Dir(dir))
	if openErr != nil {
		return errors.Join(err, openErr)
	}
	defer func() { _ = root.Close() }()
	return errors.Join(err, root.RemoveAll(filepath.Base(dir)))
}

func (r *Runner) clone(ctx context.Context, run store.Run, meta github.Repo, sha string) (_ *toolEnvironment, err error) {
	base := filepath.Join(r.cfg.DataDir(), "workspaces")
	if err := os.MkdirAll(base, 0700); err != nil {
		return nil, errors.New("create workspace directory failed")
	}
	dir, err := os.MkdirTemp(base, "run-"+strconv.FormatInt(run.ID, 10)+"-")
	if err != nil {
		return nil, errors.New("create run workspace failed")
	}
	defer func() {
		if err != nil {
			_ = os.RemoveAll(dir)
		}
	}()
	// git asks for a fresh repository-bound token on every remote operation,
	// so a run longer than an installation token's lifetime still pushes.
	repoRef := ref(run.Repo)
	tokenFunc := func(ctx context.Context) (string, error) { return r.tokens.RepoToken(ctx, repoRef) }
	if _, err := tokenFunc(ctx); err != nil {
		return nil, githubCredentialError(err)
	}
	var repo *gitx.Repo
	defer func() {
		if err != nil && repo != nil {
			_ = repo.Close()
		}
	}()
	err = r.operation(ctx, run, "git", "clone", func() error {
		var cloneErr error
		repo, cloneErr = r.opts.Clone(ctx, gitx.CloneOptions{Dir: filepath.Join(dir, "repo"), Host: "github.com", Owner: ref(run.Repo).Owner, Name: ref(run.Repo).Name, Branch: meta.DefaultBranch, DefaultBranch: meta.DefaultBranch, TokenFunc: tokenFunc, TrustedPath: r.cfg.Limits.TrustedPath, ExcludedRoots: []string{r.cfg.DataDir()}})
		return cloneErr
	})
	if err != nil {
		return nil, err
	}
	if sha != "" {
		if err := r.operation(ctx, run, "git", "checkout_sha", func() error { return repo.CheckoutSHA(ctx, sha) }); err != nil {
			return nil, err
		}
	}
	ws, err := workspace.Open(repo.Dir(), workspace.Options{Protected: r.cfg.Repos[run.Repo].Protected})
	if err != nil {
		return nil, err
	}
	defer func() {
		if err != nil {
			_ = ws.Close(false)
		}
	}()
	frozen, err := r.runExecutor(ctx, run)
	if err != nil {
		return nil, err
	}
	policyOpts := r.cfg.CommandPolicyOptions(run.Repo)
	if r.cfg.Executor.Container() {
		policyOpts.TrustedPath = slices.Clone(frozen.Path)
	}
	policy, err := execx.NewPolicy(ws.Dir(), r.cfg.Repos[run.Repo].Commands, policyOpts)
	if err != nil {
		return nil, err
	}
	executor, err := r.opts.Executor(ws.Dir(), frozen)
	if err != nil {
		return nil, err
	}
	limits := r.cfg.Limits
	return &toolEnvironment{repo: repo, dir: dir, env: &tools.Env{WS: ws, Exec: executor, Policy: policy, RunDir: dir, Redactor: r.redactor, Limits: tools.Limits{CmdTimeout: limits.CmdTimeout, CmdOutputBytes: limits.CmdOutputBytes, CmdStoreBytes: limits.CmdStoreBytes}}}, nil
}

