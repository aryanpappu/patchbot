package runner

import (
	"context"
	"errors"
	"fmt"
	"os"
	"strings"

	"github.com/aryanpappu/patchbot/internal/agent"
	"github.com/aryanpappu/patchbot/internal/github"
	"github.com/aryanpappu/patchbot/internal/gitx"
	"github.com/aryanpappu/patchbot/internal/store"
	"github.com/aryanpappu/patchbot/internal/tools"
	"github.com/aryanpappu/patchbot/internal/workspace"
)

func (r *Runner) publicationAvailable(ctx context.Context, run store.Run) error {
	branch := fmt.Sprintf("patchbot/issue-%d", run.IssueNumber)
	pr, err := r.gh.FindOpenPR(ctx, ref(run.Repo), branch)
	if err != nil {
		return err
	}
	if pr != nil {
		return errors.New("an open PR already exists for the patchbot branch")
	}
	exists, err := r.gh.BranchExists(ctx, ref(run.Repo), branch)
	if err != nil {
		return err
	}
	if exists {
		return errors.New("patchbot branch already exists; refusing to overwrite it")
	}
	return nil
}

func (r *Runner) validateChanges(ctx context.Context, run store.Run, env *toolEnvironment) error {
	changes, err := env.repo.Status(ctx)
	if err != nil {
		return err
	}
	policy, err := workspace.NewPolicy(r.cfg.Repos[run.Repo].Protected)
	if err != nil {
		return err
	}
	for _, change := range changes {
		for _, path := range []string{change.Path, change.OriginalPath} {
			if path == "" {
				continue
			}
			if _, err := policy.Check(path); err != nil {
				return &agent.Error{Kind: "policy_violations", Message: "patch changes a protected or invalid path"}
			}
			if _, err := env.env.WS.Stat(path); err != nil && !errors.Is(err, os.ErrNotExist) {
				return &agent.Error{Kind: "policy_violations", Message: "patch contains an unsafe path"}
			}
		}
	}
	return nil
}

// publicationApproval checks remote spec freshness first, then the persisted
// decision and worker generation. Call again at each external write boundary:
// neither an earlier snapshot nor a heartbeat is publication authorization.
func (r *Runner) publicationApproval(ctx context.Context, run store.Run, spec store.Spec) (store.Approval, error) {
	current, err := r.checkedSpec(ctx, run)
	if err != nil {
		return store.Approval{}, err
	}
	if current.Version != spec.Version || current.Hash != spec.Hash {
		return store.Approval{}, agent.ErrApprovalDenied
	}
	approval, err := r.db.ValidApproval(ctx, run.ID, spec.Version, spec.Hash)
	if err != nil {
		return store.Approval{}, fmt.Errorf("%w: matching publication approval: %w", agent.ErrApprovalDenied, err)
	}
	persisted, err := r.db.GetRun(ctx, run.ID)
	if err != nil {
		return store.Approval{}, err
	}
	if persisted.Status != store.StatusRunning || persisted.Phase != store.PhasePublish || persisted.Generation != run.Generation {
		return store.Approval{}, store.ErrConflict
	}
	now := r.now()
	if approval.CreatedAt.IsZero() || approval.CreatedAt.After(now) || !now.Before(approval.CreatedAt.Add(r.gateOptions().TTL)) {
		return store.Approval{}, fmt.Errorf("%w: publication approval expired or has an invalid date", agent.ErrApprovalDenied)
	}
	return approval, ctx.Err()
}

func (r *Runner) publish(ctx context.Context, run *store.Run, env *toolEnvironment, meta github.Repo, spec store.Spec, result agent.CodeResult, baseline string, codeErr error) error {
	var summary *string
	if result.Submission != nil {
		summary = &result.Submission.Summary
	}
	if err := r.transition(ctx, run, store.StatusRunning, store.PhasePublish, store.RunPatch{TestsStatus: &result.TestsStatus, PRDraft: &result.Draft, Summary: summary}); err != nil {
		return err
	}
	approval, err := r.publicationApproval(ctx, *run, spec)
	if err != nil {
		return err
	}
	if err := r.validateChanges(ctx, *run, env); err != nil {
		return err
	}
	diff, err := env.repo.Diff(ctx)
	if err != nil {
		return err
	}
	if err := r.artifact(ctx, run.ID, "diff", diff); err != nil {
		return err
	}
	live, err := r.gh.GetRepo(ctx, ref(run.Repo))
	if err != nil {
		return err
	}
	branch, found, err := r.gh.GetBranch(ctx, ref(run.Repo), live.DefaultBranch)
	if err != nil {
		return err
	}
	if !found {
		return errors.New("default branch no longer exists")
	}
	moved := live.DefaultBranch != meta.DefaultBranch || branch.Commit.SHA != run.BaseSHA
	title, body := r.prText(*run, spec, approval, result, baseline, moved, codeErr)
	if err := r.artifact(ctx, run.ID, "pr_title", title); err != nil {
		return err
	}
	if err := r.artifact(ctx, run.ID, "pr_body", body); err != nil {
		return err
	}
	if !run.DryRun {
		if err := r.publicationAvailable(ctx, *run); err != nil {
			return err
		}
	}
	if err := ctx.Err(); err != nil {
		return err
	}
	var head string
	if err := r.operation(ctx, *run, "git", "commit", func() error {
		var err error
		head, err = env.repo.CommitAll(ctx, fmt.Sprintf("fix: %s (#%d)", title, run.IssueNumber), gitx.Author{})
		return err
	}); err != nil {
		return err
	}
	if err := r.transition(ctx, run, store.StatusRunning, store.PhasePublish, store.RunPatch{HeadSHA: &head}); err != nil {
		return err
	}
	if run.DryRun {
		outcome := "dry_run"
		return r.transition(ctx, run, store.StatusSucceeded, store.PhasePublish, store.RunPatch{Outcome: &outcome})
	}
	var guardErr error
	if err := r.operation(ctx, *run, "git", "push", func() error {
		if _, guardErr = r.publicationApproval(ctx, *run, spec); guardErr != nil {
			return guardErr
		}
		return env.repo.Push(ctx, run.Branch)
	}); err != nil {
		if guardErr != nil {
			return err
		}
		return &agent.Error{Kind: "push_failed", Message: "could not push guarded patchbot branch"}
	}
	var pr github.PullRequest
	err = r.operation(ctx, *run, "publish", "create_pr", func() error {
		if _, guardErr = r.publicationApproval(ctx, *run, spec); guardErr != nil {
			return guardErr
		}
		var err error
		pr, err = r.gh.CreatePR(ctx, ref(run.Repo), github.NewPR{Title: title, Body: body, Head: run.Branch, Base: live.DefaultBranch, Draft: result.Draft})
		return err
	})
	if err != nil {
		if guardErr != nil {
			return err
		}
		return &agent.Error{Kind: "pr_failed", Message: "branch pushed but pull request creation failed"}
	}
	number, outcome := int64(pr.Number), "pr_opened"
	if result.Draft {
		outcome = "pr_draft"
	}
	if err := r.transition(ctx, run, store.StatusRunning, store.PhasePublish, store.RunPatch{PRNumber: &number, PRURL: &pr.HTMLURL, PRDraft: &result.Draft}); err != nil {
		return err
	}
	if _, err := r.comment(ctx, *run, fmt.Sprintf("patchbot run %d: %s\nHarness tests: %s (%d attempts).", run.ID, pr.HTMLURL, result.TestsStatus, result.TestAttempts)); err != nil {
		if err := r.artifact(ctx, run.ID, "publish_comment_warning", "PR opened, but the issue comment could not be posted."); err != nil {
			return err
		}
	}
	return r.transition(ctx, run, store.StatusSucceeded, store.PhasePublish, store.RunPatch{Outcome: &outcome})
}

func (r *Runner) prText(run store.Run, spec store.Spec, approval store.Approval, result agent.CodeResult, baseline string, moved bool, codeErr error) (string, string) {
	title := fmt.Sprintf("Fix issue #%d", run.IssueNumber)
	var b strings.Builder
	if result.Salvage {
		fmt.Fprintf(&b, "Draft salvage: coding stopped (%s). Review the incomplete work.\n\n", result.Reason)
	}
	if codeErr != nil {
		b.WriteString("The agent stopped with a provider error; harness verification follows below.\n\n")
	}
	fmt.Fprintf(&b, "Fixes #%d\n\n", run.IssueNumber)
	link := fmt.Sprintf("stored run %d specification", run.ID)
	if spec.CommentID != nil {
		link = fmt.Sprintf("[approved specification](https://github.com/%s/issues/%d#issuecomment-%d)", run.Repo, run.IssueNumber, *spec.CommentID)
	}
	fmt.Fprintf(&b, "Approved spec: %s, version %d, SHA-256 `%s`, approved by %s.\n\n", link, spec.Version, spec.Hash, approval.Actor)
	fmt.Fprintf(&b, "Harness tests: **%s** (%d attempts). Baseline: **%s**.\n\nAcceptance criteria (agent claims; harness result above):\n\n", result.TestsStatus, result.TestAttempts, baseline)
	if result.TestsStatus == "not_run" {
		b.WriteString("Unverified: no test command is configured. This PR requires manual verification.\n\n")
	}
	if result.Submission != nil {
		title = result.Submission.PRTitle
		for index, criterion := range result.Submission.Criteria {
			tick := " "
			if criterion.Met {
				tick = "x"
			}
			fmt.Fprintf(&b, "- [%s] AC%d: %s — harness: %s. %s\n", tick, index+1, criterion.Text, result.TestsStatus, criterion.Note)
		}
		fmt.Fprintf(&b, "\n%s\n\n%s\n", result.Submission.Summary, result.Submission.PRBody)
	}
	if result.LastTest != nil {
		fmt.Fprintf(&b, "\nHarness exit code: %d; timed out: %t.\n\n```text\n%s\n```\n", result.LastTest.ExitCode, result.LastTest.TimedOut, tools.CapOutput(result.LastTest.Output, 8<<10))
	}
	if moved {
package execx

import (
	"errors"
	"fmt"
	"os/exec"
	"path/filepath"
	"strings"
)

const (
	defaultMaxExtraArgs  = 64
	defaultMaxArgLength  = 8 << 10
	defaultMaxExtraBytes = 8 << 10
)

// PolicyOptions are operator-owned exceptions and limits, never model input.
// AllowArgs and AllowLeadingDash are indexed by command ID. AllowShells is
// indexed by executable basename, e.g. "bash", and must name an explicit opt-in.
// Zero limits select defaults. Options are copied by NewPolicy.
type PolicyOptions struct {
	AllowArgs        map[string]bool
	AllowLeadingDash map[string]bool
	AllowShells      map[string]bool
	MaxExtraArgs     int
	MaxArgLength     int
	MaxExtraBytes    int
	// TrustedPath defaults to TrustedPath when nil; an empty list is invalid.
	TrustedPath []string
	// ExcludedRoots adds data/workspace roots to the checkout exclusion.
	ExcludedRoots []string
}

type command struct {
	argv      []string
	allowArgs bool
	allowDash bool
}

// Policy holds immutable, resolved command IDs. Construct it from trusted
// per-repo commands = { name = [argv...] } configuration outside the checkout.
type Policy struct {
	commands map[string]command
	maxArgs  int
	maxLen   int
	maxBytes int
	path     []string
}

// NewPolicy resolves executables once using only the configured trusted path. An absolute
// operator-supplied executable is also accepted, but must be outside root.
// At most one options value may be supplied.
func NewPolicy(root string, commands map[string][]string, options ...PolicyOptions) (*Policy, error) {
	root, err := canonicalRoot(root)
	if err != nil {
		return nil, err
	}
	if len(options) > 1 {
		return nil, errors.New("at most one policy options value is allowed")
	}
	var opts PolicyOptions
	if len(options) == 1 {
		opts = options[0]
	}
	if opts.MaxExtraArgs < 0 || opts.MaxArgLength < 0 || opts.MaxExtraBytes < 0 {
		return nil, errors.New("argument limits must not be negative")
	}
	dirs := opts.TrustedPath
	if dirs == nil {
		dirs = filepath.SplitList(TrustedPath)
	}
	roots := append([]string{root}, opts.ExcludedRoots...)
	if err := ValidateTrustedPath(dirs, roots...); err != nil {
		return nil, err
	}
	p := &Policy{path: append([]string(nil), dirs...), commands: make(map[string]command), maxArgs: opts.MaxExtraArgs,
		maxLen: opts.MaxArgLength, maxBytes: opts.MaxExtraBytes}
	if p.maxArgs == 0 {
		p.maxArgs = defaultMaxExtraArgs
	}
	if p.maxLen == 0 {
		p.maxLen = defaultMaxArgLength
	}
	if p.maxBytes == 0 {
		p.maxBytes = defaultMaxExtraBytes
	}
	for name, argv := range commands {
		if name == "" || strings.ContainsRune(name, 0) || len(argv) == 0 || argv[0] == "" {
			return nil, errors.New("command ID and executable must not be empty or contain NUL")
		}
		for _, arg := range argv {
			if strings.ContainsRune(arg, 0) {
				return nil, fmt.Errorf("command %q contains NUL", name)
			}
		}
		binary, resolveErr := resolveExecutable(roots, argv[0], opts.AllowShells, dirs)
		if resolveErr != nil {
			return nil, fmt.Errorf("command %q: %w", name, resolveErr)
		}
		copyArgv := append([]string(nil), argv...)
		copyArgv[0] = binary
		p.commands[name] = command{copyArgv, opts.AllowArgs[name], opts.AllowLeadingDash[name]}
	}
	return p, nil
}

// MinimalEnv uses the same immutable PATH that resolved this policy.
func (p *Policy) MinimalEnv(home, tmp string, extra map[string]string) []string {
	return minimalEnv(home, tmp, extra, strings.Join(p.path, string(filepath.ListSeparator)))
}

// Resolve returns a fresh argv slice. Additional arguments require explicit
// per-command opt-in; flags require another opt-in. Literal metacharacters have
// no shell meaning. The approved program may still interpret their contents.
func (p *Policy) Resolve(name string, extraArgs []string) ([]string, error) {
	cmd, ok := p.commands[name]
	if !ok {
		return nil, fmt.Errorf("unknown command %q", name)
	}
	if len(extraArgs) > 0 && !cmd.allowArgs {
		return nil, errors.New("extra arguments are not allowed")
	}
	if len(extraArgs) > p.maxArgs {
		return nil, errors.New("too many extra arguments")
	}
	total := 0
	for _, arg := range extraArgs {
		if strings.ContainsRune(arg, 0) || (!cmd.allowDash && strings.HasPrefix(arg, "-")) {
			return nil, errors.New("invalid extra argument")
		}
		if len(arg) > p.maxLen || len(arg) > p.maxBytes-total {
			return nil, errors.New("extra arguments exceed length limit")
		}
		total += len(arg)
	}
	argv := make([]string, 0, len(cmd.argv)+len(extraArgs))
	argv = append(argv, cmd.argv...)
	return append(argv, extraArgs...), nil
}

func shellLike(name string) bool {
	switch name {
	case "sh", "bash", "zsh", "fish", "dash", "env", "xargs", "sudo":
		return true
	default:
		return false
	}
}

func resolveExecutable(roots []string, name string, allowShells map[string]bool, dirs []string) (string, error) {
	base := filepath.Base(name)
	explicitShell := shellLike(base) && allowShells[base]
	if shellLike(base) && !explicitShell {
		return "", errors.New("shell or command launcher is not allowed")
	}
	if !filepath.IsAbs(name) && base != name {
		return "", errors.New("relative executable paths are not allowed")
	}
	var path string
	err := errors.New("executable not found in trusted path")
	if filepath.IsAbs(name) {
		path, err = exec.LookPath(name)
	} else {
		// LookPath receives absolute candidates so it never reads ambient PATH.
		for _, dir := range dirs {
			candidate := filepath.Join(dir, name)
			path, err = exec.LookPath(candidate)
			if err == nil {
				break
			}
		}
	}
	if err != nil {
		return "", fmt.Errorf("resolve executable: %w", err)
	}
	if excludedExecutable(roots, path) {
		return "", errors.New("executable is inside the workspace")
	}
	resolved, err := filepath.EvalSymlinks(path)
	if err != nil {
		return "", fmt.Errorf("resolve executable symlink: %w", err)
	}
	if !filepath.IsAbs(resolved) || excludedExecutable(roots, resolved) {
		return "", errors.New("executable must be absolute and outside the workspace")
	}
	if target := filepath.Base(resolved); shellLike(target) && !explicitShell && !allowShells[target] {
		return "", errors.New("executable resolves to a disallowed shell or launcher")
	}
	return resolved, nil
}

// ResolveExecutable uses the same trusted-path and exclusion rules as Policy.
// It never consults the ambient PATH. A nil path selects the secure defaults.
func ResolveExecutable(name string, dirs []string, excluded ...string) (string, error) {
	if dirs == nil {
		dirs = filepath.SplitList(TrustedPath)
	}
	if err := ValidateTrustedPath(dirs, excluded...); err != nil {
		return "", err
	}
	return resolveExecutable(excluded, name, nil, dirs)
}
func excludedExecutable(roots []string, path string) bool {
	for _, root := range roots {
		if root == "" {
			continue
		}
		resolved, err := resolveFuturePath(root)
		if err != nil || inside(filepath.Clean(root), path) || inside(resolved, path) {
			return true
		}
	}
	return false
}
package execx

import (
	"errors"
	"path/filepath"
	"sort"
	"strings"
)

// TrustedPath is independent of the caller's PATH and excludes the checkout.
// These directories must be controlled by the operator, as must their binaries.
const TrustedPath = "/usr/bin:/bin"

var errInvalidEnv = errors.New("invalid explicit environment entry")

// MinimalEnv constructs a child environment without reading os.Environ. home and
// tmp should be private absolute per-run directories, created by the caller.
// Extras can override ordinary variables, but cannot replace the fixed base
// settings or introduce secret-like names. Dependency downloads remain allowed;
// automatic toolchain downloads and ambient Go configuration are disabled.
func MinimalEnv(home, tmp string, extra map[string]string) []string {
	return minimalEnv(home, tmp, extra, TrustedPath)
}

func minimalEnv(home, tmp string, extra map[string]string, path string) []string {
	values := map[string]string{
		"PATH": path, "HOME": home, "TMPDIR": tmp, "LANG": "C.UTF-8",
		"GOTOOLCHAIN": "local", "GOENV": "off", "GOFLAGS": "", "GOWORK": "off",
		"GOCACHE": filepath.Join(home, "go-cache"), "GOPATH": filepath.Join(home, "go"), "CI": "1",
	}
	for name, value := range extra {
		if _, fixed := values[name]; !fixed && validEnv(name, value) {
			values[name] = value
		}
	}
	names := make([]string, 0, len(values))
	for name := range values {
		names = append(names, name)
	}
	sort.Strings(names)
	env := make([]string, 0, len(names))
	for _, name := range names {
		if validEnv(name, values[name]) {
			env = append(env, name+"="+values[name])
		}
	}
	return env
}

func validEnv(name, value string) bool {
	if name == "" || strings.ContainsAny(name, "=\x00") || strings.ContainsRune(value, 0) {
		return false
	}
	upper := strings.ToUpper(name)
	for _, word := range []string{"TOKEN", "KEY", "SECRET", "PASSWORD"} {
		if strings.Contains(upper, word) {
			return false
		}
	}
	for _, prefix := range []string{"AWS_", "GH_", "GITHUB_", "ANTHROPIC_", "OPENAI_", "GEMINI_", "GOOGLE_"} {
		if strings.HasPrefix(upper, prefix) {
			return false
		}
	}
	return true
}

func scrubEnv(env []string) ([]string, error) {
	clean := make([]string, 0, len(env))
	for _, entry := range env {
		name, value, ok := strings.Cut(entry, "=")
		if !ok || name == "" || strings.ContainsRune(entry, 0) {
			return nil, errInvalidEnv
		}
		if validEnv(name, value) {
			clean = append(clean, entry)
		}
	}
	return clean, nil
}

