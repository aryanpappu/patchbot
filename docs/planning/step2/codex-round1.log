		if err := r.syncRun(ctx, run); err != nil {
			errs = append(errs, err)
		}
	}
	return errors.Join(errs...)
}

func (r *Runner) syncRun(ctx context.Context, run store.Run) error {
	bot := r.opts.BotLogin
	if bot == "" {
		identity, ok := r.gh.(interface {
			CurrentUser(context.Context) (string, error)
		})
		if !ok {
			return errors.New("GitHub bot identity unavailable; comment sync disabled")
		}
		var err error
		bot, err = identity.CurrentUser(ctx)
		if err != nil {
			return err
		}
	}
	spec, err := r.db.LatestSpec(ctx, run.ID)
	if err != nil {
		return err
	}
	since := spec.CreatedAt
	if run.WaitingSince != nil && run.WaitingSince.After(since) {
		since = *run.WaitingSince
	}
	comments, err := r.gh.ListIssueComments(ctx, ref(run.Repo), int(run.IssueNumber), since)
	if err != nil {
		return err
	}
	sort.Slice(comments, func(i, j int) bool {
		if comments[i].CreatedAt.Equal(comments[j].CreatedAt) {
			return comments[i].ID < comments[j].ID
		}
		return comments[i].CreatedAt.Before(comments[j].CreatedAt)
	})
	for _, comment := range comments {
		if !comment.CreatedAt.After(since) || (spec.CommentID != nil && comment.ID <= *spec.CommentID) {
			continue
		}
		command, ok := github.ParseCommand(comment)
		if !ok || (command.Kind != github.CommandApprove && command.Kind != github.CommandRevise) {
			continue
		}
		var collaboratorErr error
		if !github.EligibleCommand(comment, r.cfg.Defaults.Approvers, func(login string) bool {
			member, err := r.gh.IsCollaborator(ctx, ref(run.Repo), login)
			collaboratorErr = err
			return err == nil && member
		}, bot) {
			if collaboratorErr != nil {
				return collaboratorErr
			}
			continue
		}
		current, err := r.db.GetRun(ctx, run.ID)
		if err != nil {
			return err
		}
		if !waiting(current.Status) || current.WaitingSince == nil || !sameTime(current.WaitingSince, run.WaitingSince) {
			return nil
		}
		switch command.Kind {
		case github.CommandApprove:
			if current.Status != store.StatusAwaitingApproval {
				continue
			}
			if err := r.approve(ctx, run.ID, comment.Author, "github", &spec, true); err != nil {
				if errors.Is(err, errCommentEdited) {
					return errors.Join(err, r.commentEditAdvice(ctx, run, spec))
				}
				return err
			}
			return nil
		case github.CommandRevise:
			return r.revise(ctx, run.ID, command.Notes, comment.Author, "github", &spec)
		default:
			continue
		}
	}
	return nil
}

func (r *Runner) commentEditAdvice(ctx context.Context, run store.Run, spec store.Spec) error {
	kind := fmt.Sprintf("spec_comment_warning_v%d", spec.Version)
	if _, err := r.db.GetArtifact(ctx, run.ID, kind, 0); !errors.Is(err, store.ErrNotFound) {
	if err != nil {
		return err
	}
	if err := r.validateChanges(ctx, *run, env); err != nil {
		return err
	}
	diff, err := env.repo.Diff(ctx)
	if err != nil {
		return err
	}
	if err := r.artifact(ctx, run.ID, "diff", diff); err != nil {
		return err
	}
	live, err := r.gh.GetRepo(ctx, ref(run.Repo))
	if err != nil {
		return err
	}
	branch, found, err := r.gh.GetBranch(ctx, ref(run.Repo), live.DefaultBranch)
	if err != nil {
		return err
	}
	if !found {
		return errors.New("default branch no longer exists")
	}
	moved := live.DefaultBranch != meta.DefaultBranch || branch.Commit.SHA != run.BaseSHA
	title, body := r.prText(*run, spec, approval, result, baseline, moved, codeErr)
	if err := r.artifact(ctx, run.ID, "pr_title", title); err != nil {
		return err
	}
	if err := r.artifact(ctx, run.ID, "pr_body", body); err != nil {
		return err
	}
	if !run.DryRun {
		if err := r.publicationAvailable(ctx, *run); err != nil {
			return err
		}
	}
	if err := ctx.Err(); err != nil {
		return err
	}
	var head string
	if err := r.operation(ctx, *run, "git", "commit", func() error {
		var err error
		head, err = env.repo.CommitAll(ctx, fmt.Sprintf("fix: %s (#%d)", title, run.IssueNumber), gitx.Author{})
		return err
	}); err != nil {
		return err
	}
	if err := r.transition(ctx, run, store.StatusRunning, store.PhasePublish, store.RunPatch{HeadSHA: &head}); err != nil {
		return err
	}
	if run.DryRun {
		outcome := "dry_run"
		return r.transition(ctx, run, store.StatusSucceeded, store.PhasePublish, store.RunPatch{Outcome: &outcome})
	}
	var guardErr error
	if err := r.operation(ctx, *run, "git", "push", func() error {
		if _, guardErr = r.publicationApproval(ctx, *run, spec); guardErr != nil {
			return guardErr
		}
		return env.repo.Push(ctx, run.Branch)
	}); err != nil {
		if guardErr != nil {
			return err
		}
		return &agent.Error{Kind: "push_failed", Message: "could not push guarded patchbot branch"}
	}
	var pr github.PullRequest
	err = r.operation(ctx, *run, "publish", "create_pr", func() error {
		if _, guardErr = r.publicationApproval(ctx, *run, spec); guardErr != nil {
			return guardErr
		}
		var err error
		pr, err = r.gh.CreatePR(ctx, ref(run.Repo), github.NewPR{Title: title, Body: body, Head: run.Branch, Base: live.DefaultBranch, Draft: result.Draft})
		return err
	})
	if err != nil {
		if guardErr != nil {
			return err
		}
		return &agent.Error{Kind: "pr_failed", Message: "branch pushed but pull request creation failed"}
	}
	number, outcome := int64(pr.Number), "pr_opened"
	if result.Draft {
		outcome = "pr_draft"
	}
	if err := r.transition(ctx, run, store.StatusRunning, store.PhasePublish, store.RunPatch{PRNumber: &number, PRURL: &pr.HTMLURL, PRDraft: &result.Draft}); err != nil {
		return err
	}
	if _, err := r.comment(ctx, *run, fmt.Sprintf("patchbot run %d: %s\nHarness tests: %s (%d attempts).", run.ID, pr.HTMLURL, result.TestsStatus, result.TestAttempts)); err != nil {
		if err := r.artifact(ctx, run.ID, "publish_comment_warning", "PR opened, but the issue comment could not be posted."); err != nil {
			return err
		}
	}
	return r.transition(ctx, run, store.StatusSucceeded, store.PhasePublish, store.RunPatch{Outcome: &outcome})
}

func (r *Runner) prText(run store.Run, spec store.Spec, approval store.Approval, result agent.CodeResult, baseline string, moved bool, codeErr error) (string, string) {
	title := fmt.Sprintf("Fix issue #%d", run.IssueNumber)
	var b strings.Builder
	if result.Salvage {
		fmt.Fprintf(&b, "Draft salvage: coding stopped (%s). Review the incomplete work.\n\n", result.Reason)
	}
	if codeErr != nil {
		b.WriteString("The agent stopped with a provider error; harness verification follows below.\n\n")
	}
	s.Messages = append(s.Messages, msg)
	if resp.StopReason == llm.StopRefusal {
		return Outcome{Reason: EndRefusal}, true, nil
	}
	calls := msg.ToolCalls()
	if len(calls) > 0 {
		s.endTurns, s.malformed = 0, 0
		return l.dispatch(ctx, s, calls)
	}
	switch resp.StopReason {
	case llm.StopMaxTokens:
		s.endTurns, s.malformed = 0, 0
		feedback(s, "Your reply reached the output limit. No tool calls from it were executed. Use smaller edits and try again.")
	case llm.StopEndTurn:
		s.malformed = 0
		s.endTurns++
		if s.endTurns >= 2 {
			submission := (&tools.Submission{Summary: msg.Text(), PRTitle: "Proposed change", Report: msg.Text()}).Redacted(l.redactor())
			return Outcome{Reason: EndSubmitted, Synthesized: true, Submission: submission}, true, nil
		}
		feedback(s, "Call the stage's terminal tool to finish, or continue working.")
	default:
		s.endTurns = 0
		s.malformed++
		if s.malformed >= 2 {
			return Outcome{}, false, &Error{Kind: "provider_malformed", Message: "two consecutive unusable model replies"}
		}
		feedback(s, "Your reply could not be processed. Try again using the available tools.")
	}
	return Outcome{}, false, nil
}

func (l *Loop) dispatch(ctx context.Context, s *Session, calls []llm.ToolCall) (Outcome, bool, error) {
	results := llm.Message{Role: llm.RoleTool}
	var submission *tools.Submission
	var stop bool
	var dispatchErr error
	warn := false
	for _, call := range calls {
		call.ID = redactIdentifier(call.ID, l.redactor())
		start := l.now()
		eventArgs, argsErr := jsonValue(call.Args)
		if argsErr != nil {
			eventArgs = string(call.Args)
		}
		if err := l.event(ctx, "tool.call", map[string]any{"turn": s.Turns, "call_id": call.ID, "name": call.Name, "args": eventArgs}); err != nil {
			return Outcome{}, false, err
		}
		var detail tools.Result
		var result llm.ToolResult
		var err error
		// Finish the call/result group even when a terminal call appears before its
		// siblings. Calls after completion or a stop receive an explicit skipped result.
		if submission != nil || stop || dispatchErr != nil {
			result = llm.ToolResult{CallID: call.ID, Name: call.Name, Content: "Skipped: the stage has already ended.", IsError: true}
			detail = tools.Result{Content: result.Content, RecordOutput: result.Content, IsError: true}
		} else {
			result, detail, err = l.tools.DispatchDetailed(ctx, call)
			if err != nil {
				result = llm.ToolResult{CallID: call.ID, Name: call.Name, Content: "Tool execution failed in the harness.", IsError: true}
				detail = tools.Result{IsError: true, RecordOutput: result.Content}
				dispatchErr = &Error{Kind: "internal", Message: "tool execution failed"}
			}
			if detail.Submission != nil {
				submission = detail.Submission
			}
			if detail.SecurityDenied {
				s.denials++
				if eventErr := l.event(ctx, "security.denied", map[string]any{"tool": call.Name, "reason": detail.Content}); eventErr != nil {
					return Outcome{}, false, eventErr
				}
				if s.denials >= 5 {
					dispatchErr = &Error{Kind: "policy_violations", Message: "five tool policy denials"}
				}
			}
			hash := callHash(call)
			if hash == s.stuckHash {
				s.stuckCount++
			} else {
				s.stuckHash, s.stuckCount = hash, 1
			}
			if s.stuckCount == 3 {
				warn = true
			}
			if s.stuckCount >= 4 {
				stop = true
			}
		}
		finish, turn := l.now(), int64(s.Turns)
		duration := finish.Sub(start).Milliseconds()
		status := "ok"
		if result.IsError || err != nil {
			status = "error"
		}
		var exit *int64
		if detail.ExitCode != nil {
			value := int64(*detail.ExitCode)
			exit = &value
		}
		step := store.Step{Kind: "tool", Tool: call.Name, Status: status, Turn: &turn, InputJSON: string(call.Args), OutputText: detail.RecordOutput, ExitCode: exit, StartedAt: start, FinishedAt: &finish, DurationMS: &duration}
		if e := l.record(ctx, step); e != nil {
			return Outcome{}, false, e
		}
		if e := l.event(ctx, "tool.result", map[string]any{"turn": s.Turns, "result": result, "timed_out": detail.TimedOut, "exit_code": exit}); e != nil {
			return Outcome{}, false, e
		}
		// Tool payloads may contain malicious instructions. JSON string encoding
		// keeps fake closing delimiters inside the untrusted payload.
		if call.Name == "run_cmd" {
			result.Content = boundedUntrusted("command output", result.Content, 8<<10)
		} else {
			result.Content = untrusted("tool output", result.Content)
		}
		results.Parts = append(results.Parts, llm.Result(result.CallID, result.Name, result.Content, result.IsError))
	}
	s.Messages = append(s.Messages, results)
	if dispatchErr != nil {
		return Outcome{}, false, dispatchErr
	}
	if submission != nil {
		return Outcome{Reason: EndSubmitted, Submission: submission}, true, nil
	}
	if stop {
		return Outcome{Reason: EndStuck}, true, nil
	}
	if warn {
		feedback(s, "The same tool call has repeated three times. Change your approach; another identical call will stop this stage.")
	}
	return Outcome{}, false, nil
}

package store

import (
	"context"
	"crypto/sha256"
	"database/sql"
	"embed"
	"errors"
	"fmt"
	"io/fs"
	"strconv"
	"strings"
	"time"
)

//go:embed migrations/*.sql
var migrationFiles embed.FS

type migration struct {
	version             int64
	name, checksum, sql string
}

func (s *SQLite) migrate(ctx context.Context) error {
	entries, err := fs.ReadDir(migrationFiles, "migrations")
	if err != nil {
		return err
	}
	migrations := make([]migration, 0, len(entries))
	for _, entry := range entries {
		name := entry.Name()
		prefix, _, ok := strings.Cut(name, "_")
		version, parseErr := strconv.ParseInt(prefix, 10, 64)
		if !ok || parseErr != nil || version != int64(len(migrations)+1) {
			return fmt.Errorf("invalid migration filename %q", name)
		}
		body, readErr := migrationFiles.ReadFile("migrations/" + name)
		if readErr != nil {
			return readErr
		}
		migrations = append(migrations, migration{version, name, fmt.Sprintf("%x", sha256.Sum256(body)), string(body)})
	}
	_, err = s.db.ExecContext(ctx, `CREATE TABLE IF NOT EXISTS schema_migrations (
		version INTEGER PRIMARY KEY CHECK (version > 0), name TEXT NOT NULL,
		checksum TEXT NOT NULL, applied_at INTEGER NOT NULL CHECK (applied_at >= 0)
	) STRICT`)
	if err != nil {
		return fmt.Errorf("create migration ledger: %w", err)
	}
	// Each transaction re-reads the ledger while holding the immediate write
	// lock, so separate processes can safely open the same fresh database.
	for _, m := range migrations {
		if err := s.applyMigration(ctx, m, int64(len(migrations))); err != nil {
			return err
		}
	}
	return nil
}

func (s *SQLite) applyMigration(ctx context.Context, m migration, latest int64) error {
	return s.withTx(ctx, func(tx *eventTx) error {
		var maxVersion int64
		if err := tx.QueryRowContext(ctx, `SELECT COALESCE(MAX(version),0) FROM schema_migrations`).Scan(&maxVersion); err != nil {
			return err
		}
		if maxVersion > latest {
			return fmt.Errorf("database migration %d is newer than supported version %d", maxVersion, latest)
		}
		var name, checksum string
		err := tx.QueryRowContext(ctx, `SELECT name, checksum FROM schema_migrations WHERE version=?`, m.version).Scan(&name, &checksum)
		if err == nil {
			if name != m.name || checksum != m.checksum {
				return fmt.Errorf("migration %d (%s) name or checksum changed", m.version, m.name)
			}
			return nil
		}
		if !errors.Is(err, sql.ErrNoRows) {
			return err
		}
		if maxVersion != m.version-1 {
			return fmt.Errorf("migration ledger has a gap before version %d", m.version)
		}
		if _, err := tx.ExecContext(ctx, m.sql); err != nil {
			return fmt.Errorf("apply migration %s: %w", m.name, err)
		}
		_, err = tx.ExecContext(ctx, `INSERT INTO schema_migrations(version,name,checksum,applied_at) VALUES(?,?,?,?)`,
			m.version, m.name, m.checksum, time.Now().UTC().UnixMilli())
		return err
	})
}

