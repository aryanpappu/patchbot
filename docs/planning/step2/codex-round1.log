type toolEnvironment struct {
	repo *gitx.Repo
	env  *tools.Env
	dir  string
}

func (e *toolEnvironment) close() error {
	if e == nil || e.dir == "" {
		return nil
	}
	dir := e.dir
	e.dir = ""
	err := errors.Join(e.env.WS.Close(false), e.repo.Close())
	root, openErr := os.OpenRoot(filepath.Dir(dir))
	if openErr != nil {
		return errors.Join(err, openErr)
	}
	defer func() { _ = root.Close() }()
	return errors.Join(err, root.RemoveAll(filepath.Base(dir)))
}

func (r *Runner) clone(ctx context.Context, run store.Run, meta github.Repo, sha string) (_ *toolEnvironment, err error) {
	base := filepath.Join(r.cfg.DataDir(), "workspaces")
	if err := os.MkdirAll(base, 0700); err != nil {
		return nil, errors.New("create workspace directory failed")
	}
	dir, err := os.MkdirTemp(base, "run-"+strconv.FormatInt(run.ID, 10)+"-")
	if err != nil {
		return nil, errors.New("create run workspace failed")
	}
	defer func() {
		if err != nil {
			_ = os.RemoveAll(dir)
		}
	}()
	token, err := r.opts.Tokens.Token(ctx)
	if err != nil {
		return nil, errors.New("GitHub token unavailable; set GITHUB_TOKEN")
	}
	var repo *gitx.Repo
	defer func() {
		if err != nil && repo != nil {
			_ = repo.Close()
		}
	}()
	err = r.operation(ctx, run, "git", "clone", func() error {
		var cloneErr error
		repo, cloneErr = r.opts.Clone(ctx, gitx.CloneOptions{Dir: filepath.Join(dir, "repo"), Host: "github.com", Owner: ref(run.Repo).Owner, Name: ref(run.Repo).Name, Branch: meta.DefaultBranch, DefaultBranch: meta.DefaultBranch, Token: token, TrustedPath: r.cfg.Limits.TrustedPath, ExcludedRoots: []string{r.cfg.DataDir()}})
		return cloneErr
	})
	if err != nil {
		return nil, err
	}
	if sha != "" {
		if err := r.operation(ctx, run, "git", "checkout_sha", func() error { return repo.CheckoutSHA(ctx, sha) }); err != nil {
			return nil, err
		}
	}
	ws, err := workspace.Open(repo.Dir(), workspace.Options{Protected: r.cfg.Repos[run.Repo].Protected})
	if err != nil {
		return nil, err
	}
	defer func() {
		if err != nil {
			_ = ws.Close(false)
		}
	}()
	policy, err := execx.NewPolicy(ws.Dir(), r.cfg.Repos[run.Repo].Commands, execx.PolicyOptions{TrustedPath: r.cfg.Limits.TrustedPath, ExcludedRoots: []string{r.cfg.DataDir()}})
	if err != nil {
		return nil, err
	}
	executor, err := r.opts.Executor(ws.Dir())
	if err != nil {
		return nil, err
	}
	limits := r.cfg.Limits
	return &toolEnvironment{repo: repo, dir: dir, env: &tools.Env{WS: ws, Exec: executor, Policy: policy, RunDir: dir, Redactor: r.redactor, Limits: tools.Limits{CmdTimeout: limits.CmdTimeout, CmdOutputBytes: limits.CmdOutputBytes, CmdStoreBytes: limits.CmdStoreBytes}}}, nil
}

func (r *Runner) preflight(ctx context.Context, run store.Run) (github.Repo, github.Issue, error) {
	if r.cfg.Repos[run.Repo] == nil {
		return github.Repo{}, github.Issue{}, errors.New("repository is not in configuration allowlist")
	}
	meta, err := r.gh.GetRepo(ctx, ref(run.Repo))
	if err != nil {
		return meta, github.Issue{}, err
	}
	issue, err := r.gh.GetIssue(ctx, ref(run.Repo), int(run.IssueNumber))
	if err != nil {
		return meta, issue, err
	}
	if issue.State != "open" || issue.IsPullRequest {
		return meta, issue, errors.New("issue must be open and must not be a pull request")
	}
	if meta.DefaultBranch == "" {
		return meta, issue, errors.New("repository has no default branch")
	}
	if run.Mode == config.ModeFix && !meta.Permissions.Push {
		return meta, issue, errors.New("fix mode requires repository push permission")
	}
	return meta, issue, nil
}

func (r *Runner) refine(ctx context.Context, run *store.Run, prior *store.Spec, notes string, reuse *store.Spec) (err error) {
	session, limits, totals, err := r.session(ctx, *run)
	if err != nil {
		return err
	}
	ctx, cancel := context.WithTimeout(ctx, max(limits.Agent.Deadline.Sub(r.now()), 0))
	defer cancel()
	started := time.Now()
	defer func() { err = errors.Join(err, r.saveAccounting(ctx, *run, session, totals, started)) }()
	if totals.Active >= limits.Timeout || session.Tokens >= limits.Agent.MaxTotalTokens || session.Cost >= limits.Agent.MaxCostMicros {
		return budgetError(agent.EndBudget)
	}
	meta, issue, err := r.preflight(ctx, *run)
	if err != nil {
		return err
	}
	title := r.redactor.Redact(issue.Title)
	if err := r.transition(ctx, run, store.StatusRunning, store.PhasePreflight, store.RunPatch{IssueTitle: &title}); err != nil {
		return err
	}
	if reuse != nil {
		return r.reuseSpec(ctx, run, *reuse)
	}
	if err := r.transition(ctx, run, store.StatusRunning, store.PhaseClone, store.RunPatch{}); err != nil {
		return err
	}
	env, err := r.clone(ctx, *run, meta, "")
	if err != nil {
		return err
	}
	defer func() { err = errors.Join(err, env.close()) }()
	sha, err := env.repo.HeadSHA(ctx)
	if err != nil {
		return err
	}
	run.BaseSHA = sha
	if err := r.transition(ctx, run, store.StatusRunning, store.PhaseRefine, store.RunPatch{BaseSHA: &sha}); err != nil {
		return err
	}
	loop, err := r.loop(*run, env, run.RefineModel)
	if err != nil {
		return err
	}
	limits.Agent.MaxTurns = limits.RefineTurns
	if run.Mode == config.ModeInvestigate {
		report, err := loop.Investigate(ctx, agent.InvestigateRequest{Title: issue.Title, Body: issue.Body, Session: session, Limits: limits.Agent})
		if err != nil {
			return err
		}
		if report.Reason != agent.EndSubmitted || report.ReportMD == "" {
			return budgetError(report.Reason)
		}
		if err := r.artifact(ctx, run.ID, "report", report.ReportMD); err != nil {
			return err
		}
		if !run.DryRun {
			if _, err := r.comment(ctx, *run, report.ReportMD); err != nil {
				return err
			}
		}
		outcome := "investigated"
		if run.DryRun {
			outcome = "dry_run"
		}
		if err := env.close(); err != nil {
			return err
		}
		return r.transition(ctx, run, store.StatusSucceeded, store.PhaseRefine, store.RunPatch{Outcome: &outcome, Summary: &report.ReportMD})
	}
	result, err := loop.Refine(ctx, agent.RefineRequest{RunID: run.ID, Title: issue.Title, Body: issue.Body, Prior: prior, Notes: notes, Store: r.db, Session: session, Limits: limits.Agent})
	if err != nil {
		if result.Reason != "" && result.Reason != agent.EndSubmitted {
			return budgetError(result.Reason)
		}
		return err
	}
	if err := r.postSpec(ctx, *run, &result.Spec, result.Questions); err != nil {
		return err
	}
	if err := env.close(); err != nil {
		return err
	}
	return r.transition(ctx, run, result.Status, store.PhaseRefine, store.RunPatch{})
}

func (r *Runner) specComment(run store.Run, spec store.Spec) string {
	return github.NeutralizeMentions(fmt.Sprintf("%s\n\npatchbot run %d, specification v%d, SHA-256 `%s`.\nUse `/approve` to approve or `/revise <notes>` to request a new version. GitHub edits are not imported.\n<!-- patchbot:spec run=%d v=%d sha=%s -->", spec.BodyMD, run.ID, spec.Version, spec.Hash, run.ID, spec.Version, spec.Hash))
}

func (r *Runner) postSpec(ctx context.Context, run store.Run, spec *store.Spec, questions []string) error {
	if err := r.artifact(ctx, run.ID, "spec", spec.BodyMD); err != nil {
		return err
	}
	if !run.DryRun {
		comment, err := r.comment(ctx, run, r.specComment(run, *spec))
		if err != nil {
			return err
		}
		if err := r.db.SetSpecComment(ctx, run.ID, spec.Version, spec.Hash, comment.ID); err != nil {
			return err
		}
		spec.CommentID = &comment.ID
	}
	for _, body := range questions {
		if _, err := r.db.SaveQuestion(ctx, store.Question{RunID: run.ID, Body: body, CommentID: spec.CommentID}); err != nil {
			return err
		}
	}
	return nil
}

func (r *Runner) reuseSpec(ctx context.Context, run *store.Run, old store.Spec) error {
	oldRun, err := r.db.GetRun(ctx, old.RunID)
	if err != nil {
		return err
	}
	approval, err := r.db.ValidApproval(ctx, old.RunID, old.Version, old.Hash)
	if err != nil {
		return err
	}
	spec := old
	spec.RunID, spec.Version, spec.CommentID, spec.CreatedAt = run.ID, 1, nil, time.Time{}
	spec.Source, spec.Notes = "agent", fmt.Sprintf("Reused approved spec from run %d version %d", old.RunID, old.Version)
	spec, err = r.db.SaveSpec(ctx, spec)
	if err != nil {
		return err
	}
	if err := r.postSpec(ctx, *run, &spec, nil); err != nil {
		return err
	}
	run.BaseSHA = oldRun.BaseSHA
	if err := r.transition(ctx, run, store.StatusAwaitingApproval, store.PhaseRefine, store.RunPatch{BaseSHA: &run.BaseSHA}); err != nil {
		return err
	}
	approval.RunID, approval.SpecVersion, approval.SpecHash = run.ID, spec.Version, spec.Hash
	if err := r.db.DecideRun(ctx, run.Status, store.StatusApproved, approval, run.Generation); err != nil {
		return err
	}
	run.Status = store.StatusApproved
	run.Generation++
	return nil
}

// Execute runs the approved code phase synchronously. Refine mode completes
// approval without ever installing code tools or cloning for coding.
func (r *Runner) Execute(ctx context.Context, id int64) error {
	ctx, release, err := r.admit(ctx)
	if err != nil {
		return err
	}
	defer release()
	if r.opts.Dispatch != nil {
		// Mark queued approved execution as heartbeat-owned so a process death
		// before its worker acquires a slot is covered by ordinary stale recovery.
		lock := r.control(id)
		lock.Lock()
		run, err := r.db.GetRun(ctx, id)
		if err == nil && (run.Status != store.StatusApproved || run.Phase == store.PhaseClone || run.Phase == store.PhaseBaseline) {
			err = store.ErrConflict
		}
		if err == nil {
			err = r.transition(ctx, &run, store.StatusApproved, store.PhaseClone, store.RunPatch{})
		}
		lock.Unlock()
		if err != nil {
			return err
		}
	}
	return r.dispatch(ctx, id, func(work context.Context) error { return r.execute(work, id) })
}

func (r *Runner) execute(ctx context.Context, id int64) error {
	lock := r.control(id)
	lock.Lock()
	defer lock.Unlock()
	run, err := r.db.GetRun(ctx, id)
	if err != nil {
		return err
	}
	if run.Status != store.StatusApproved {
		return store.ErrConflict
	}
	if run.Mode == config.ModeRefine {
		spec, err := r.checkedSpec(ctx, run)
		if err == nil {
			_, err = agent.Check(ctx, r.db, id, spec.IssueHash, r.gateOptions())
		}
		if err != nil {
			return errors.Join(err, r.transition(ctx, &run, store.StatusAwaitingApproval, store.PhaseRefine, store.RunPatch{}))
		}
		outcome := "spec_approved"
		return r.transition(ctx, &run, store.StatusSucceeded, run.Phase, store.RunPatch{Outcome: &outcome})
	}
	if run.Mode != config.ModeFix {
		return store.ErrConflict
	}
	err = r.withWork(ctx, id, func(work context.Context) error { return r.code(work, &run) })
	if errors.Is(err, store.ErrConflict) {
		return err
	}
	if errors.Is(err, agent.ErrApprovalDenied) {
		return errors.Join(err, r.transition(context.WithoutCancel(ctx), &run, store.StatusAwaitingApproval, store.PhaseRefine, store.RunPatch{}))
	}
	if err != nil {
		return r.fail(ctx, run, err)
	}
	return nil
}

func (r *Runner) code(ctx context.Context, run *store.Run) (err error) {
	session, limits, totals, err := r.session(ctx, *run)
	if err != nil {
		return err
	}
	ctx, cancel := context.WithTimeout(ctx, max(limits.Agent.Deadline.Sub(r.now()), 0))
	defer cancel()
	started := time.Now()
	defer func() { err = errors.Join(err, r.saveAccounting(ctx, *run, session, totals, started)) }()
	spec, err := r.checkedSpec(ctx, *run)
	if err != nil {
		return err
	}
	if _, err := agent.Check(ctx, r.db, run.ID, spec.IssueHash, r.gateOptions()); err != nil {
		return err
	}
	meta, issue, err := r.preflight(ctx, *run)
	if err != nil {
		return err
	}
	if err := r.publicationAvailable(ctx, *run); err != nil {
		return err
	}
	if err := r.transition(ctx, run, store.StatusApproved, store.PhaseClone, store.RunPatch{}); err != nil {
		return err
	}
	env, err := r.clone(ctx, *run, meta, run.BaseSHA)
	if err != nil {
		return err
	}
	defer func() { err = errors.Join(err, env.close()) }()
	branch := fmt.Sprintf("patchbot/issue-%d", run.IssueNumber)
	if err := r.operation(ctx, *run, "git", "create_branch", func() error { return env.repo.CreateBranch(ctx, branch) }); err != nil {
		return err
	}
	if err := r.transition(ctx, run, store.StatusApproved, store.PhaseBaseline, store.RunPatch{Branch: &branch}); err != nil {
		return err
	}
	baseline := "not_run"
	baselineInfo := baseline
	command, _ := r.cfg.Repos[run.Repo].TestCommandID()
	if command != "" && r.cfg.Limits.BaselineTests {
		test, err := r.baseline(ctx, *run, env, command, limits.Agent.TestTimeout)
		if err != nil {
			return err
		}
		baseline = "failed"
		baselineInfo = fmt.Sprintf("exit_code: %d; timed_out: %t\n%s", test.ExitCode, test.TimedOut, tools.CapOutput(test.Output, 8<<10))
		if test.ExitCode == 0 && !test.TimedOut {
			baseline = "passed"
		}
		changed, err := env.repo.HasChanges(ctx)
		if err != nil {
			return err
		}
		if changed {
			// Discard only this disposable baseline checkout. Re-clone the pinned
			// commit so generated baseline files cannot become agent changes.
			if err := env.close(); err != nil {
				return err
			}
			env, err = r.clone(ctx, *run, meta, run.BaseSHA)
			if err != nil {
				return err
			}
			if err := r.operation(ctx, *run, "git", "create_branch", func() error { return env.repo.CreateBranch(ctx, branch) }); err != nil {
				return err
			}
		}
	}
	// Fetch again after clone/baseline: waiting or repository execution must not
	// turn an earlier issue snapshot into permission to write.
	issue, err = r.gh.GetIssue(ctx, ref(run.Repo), int(run.IssueNumber))
	if err != nil {
		return err
	}
	token, err := agent.Check(ctx, r.db, run.ID, agent.IssueHash(issue.Title, issue.Body), r.gateOptions())
	if err != nil {
		return err
	}
	codeRun := *run
	codeRun.Phase = store.PhaseCode
	loop, err := r.loop(codeRun, env, run.CodeModel)
	if err != nil {
		return err
	}
	result, codeErr := loop.Code(ctx, token, agent.CodeRequest{RunID: run.ID, Title: issue.Title, Body: issue.Body, Changes: env.repo, Baseline: baselineInfo, TestCommand: command, Session: session, Limits: limits.Agent, OnPhase: func(c context.Context, phase store.Phase) error {
		if run.Status == store.StatusApproved {
			if err := r.db.StartCode(c, run.ID, spec.Version, spec.Hash, run.Generation); err != nil {
				return err
			}
			run.Status, run.Phase = store.StatusRunning, store.PhaseCode
			run.Generation++
			return nil
		}
		return r.transition(c, run, store.StatusRunning, phase, store.RunPatch{})
	}})
	if ctx.Err() != nil {
		return ctx.Err()
	}
	if codeErr != nil && !result.Salvage {
		return codeErr
	}
	if result.Reason == agent.EndRefusal {
		return budgetError(result.Reason)
	}
	if result.NoChanges {
		if result.Reason != agent.EndSubmitted {
			return budgetError(result.Reason)
		}
		explanation := "The agent finished without changes."
		if result.Submission != nil {
			explanation = result.Submission.Summary
		}
		if !run.DryRun {
			if _, err := r.comment(ctx, *run, explanation); err != nil {
				return err
			}
		}
		outcome := "no_changes"
		return r.transition(ctx, run, store.StatusSucceeded, run.Phase, store.RunPatch{Outcome: &outcome, Summary: &explanation})
	}
	if !result.CanPublish {
		return budgetError(result.Reason)
	}
	return r.publish(ctx, run, env, meta, spec, result, baseline, codeErr)
}

func (r *Runner) baseline(ctx context.Context, run store.Run, env *toolEnvironment, command string, timeout time.Duration) (execx.Result, error) {
	start := r.now()
	test, err := tools.ExecuteCommand(ctx, env.env, command, nil, timeout)
	finish := r.now()
	duration, exit := finish.Sub(start).Milliseconds(), int64(test.ExitCode)
	status := "ok"
	if err != nil || test.ExitCode != 0 || test.TimedOut {
		status = "error"
	}
	record := &agent.StoreRecorder{Store: r.db, RunID: run.ID, Phase: store.PhaseBaseline, Redactor: r.redactor}
	recordCtx, cancel := context.WithTimeout(context.WithoutCancel(ctx), 5*time.Second)
	defer cancel()
	recordErr := record.Record(recordCtx, store.Step{Kind: "test", Tool: command, Status: status, OutputText: test.Output, ExitCode: &exit, DurationMS: &duration, StartedAt: start, FinishedAt: &finish})
	return test, errors.Join(err, recordErr, r.artifact(recordCtx, run.ID, "baseline", fmt.Sprintf("exit_code: %d; timed_out: %t\n%s", test.ExitCode, test.TimedOut, test.Output)))
}

func validateDraft(ctx context.Context, run store.Run, repo *config.Repo, draft tools.SpecDraft) error {
	if err := ctx.Err(); err != nil {
		return err
	}
	if repo == nil || run.ID <= 0 {
		return store.ErrConflict
	}
	if strings.TrimSpace(draft.Summary) == "" || len(draft.AcceptanceCriteria) > 12 || len(draft.AcceptanceCriteria)+len(draft.OpenQuestions) == 0 || len(draft.Canonical()) > 64<<10 {
		return errors.New("invalid specification content")
	}
	seen := map[string]bool{}
	for _, criterion := range draft.AcceptanceCriteria {
		if strings.TrimSpace(criterion) == "" || seen[criterion] {
			return errors.New("criteria must be nonempty and distinct")
		}
		seen[criterion] = true
	}
	for _, list := range [][]string{draft.OpenQuestions, draft.TestPlan, draft.Risks} {
		for _, item := range list {
			if strings.TrimSpace(item) == "" {
				return errors.New("specification entries must not be empty")
			}
		}
	}
	policy, err := workspace.NewPolicy(repo.Protected)
	if err != nil {
		return err
	}
	for _, file := range draft.Files {
		if strings.TrimSpace(file.Change) == "" {
			return errors.New("file change description required")
		}
		if _, err := policy.Check(file.Path); err != nil {
			return err
		}
	}
	return nil
}
package runner

import (
	"context"
	"encoding/json"
	"errors"
	"time"

	"github.com/aryanpappu/patchbot/internal/agent"
	"github.com/aryanpappu/patchbot/internal/store"
)

type accounting struct {
	Cost, Tokens        int64
	Turns               int
	Uncertain, Unpriced bool
	Active              time.Duration
}

func (r *Runner) session(ctx context.Context, run store.Run) (*agent.Session, runLimits, accounting, error) {
	var limits runLimits
	if err := json.Unmarshal(run.LimitsJSON, &limits); err != nil {
		return nil, limits, accounting{}, errors.New("invalid stored run limits")
	}
	_, hard, err := r.cfg.MaxCostMicro()
	if err != nil {
		return nil, limits, accounting{}, err
	}
	if limits.Agent.MaxCostMicros <= 0 || hard <= 0 || limits.Agent.MaxTotalTokens <= 0 || limits.Timeout <= 0 {
		return nil, limits, accounting{}, errors.New("invalid stored run budget")
	}
	limits.Agent.MaxCostMicros = min(limits.Agent.MaxCostMicros, hard)
	limits.Agent.MaxTestAttempts = min(max(limits.Agent.MaxTestAttempts, 1), 3)
	var totals accounting
	saved, err := r.db.GetArtifact(ctx, run.ID, "accounting", 0)
	if err == nil {
		err = json.Unmarshal([]byte(saved.Content), &totals)
	}
	if err != nil && !errors.Is(err, store.ErrNotFound) {
		return nil, limits, totals, err
	}
	// Usage events are written after every call, including retries and unknown
	// usage reservations. They survive a new CLI process and never reset budget.
	var after int64
	for {
		events, err := r.db.EventsAfter(ctx, run.ID, after, 500)
		if err != nil {
			return nil, limits, totals, err
		}
		for _, event := range events {
			after = event.Seq
			if event.Type != "usage" {
				continue
			}
			var usage struct {
				Cost      int64 `json:"total_cost_micros"`
				Tokens    int64 `json:"total_tokens"`
				Turns     int   `json:"turn"`
				Uncertain bool  `json:"accounting_uncertain"`
				Unpriced  bool  `json:"unpriced"`
			}
			if err := json.Unmarshal(event.PayloadJSON, &usage); err != nil {
				return nil, limits, totals, errors.New("invalid persisted accounting event")
			}
			totals.Cost, totals.Tokens, totals.Turns = max(totals.Cost, usage.Cost), max(totals.Tokens, usage.Tokens), max(totals.Turns, usage.Turns)
			totals.Uncertain, totals.Unpriced = totals.Uncertain || usage.Uncertain, totals.Unpriced || usage.Unpriced
		}
		if len(events) < 500 {
			break
		}
	}
	limits.Agent.Deadline = r.now().Add(max(limits.Timeout-totals.Active, 0))
	return &agent.Session{Cost: totals.Cost, Tokens: totals.Tokens, Turns: totals.Turns, AccountingUncertain: totals.Uncertain, Unpriced: totals.Unpriced}, limits, totals, nil
}

func (r *Runner) saveAccounting(ctx context.Context, run store.Run, session *agent.Session, prior accounting, start time.Time) error {
	totals := accounting{Cost: session.Cost, Tokens: session.Tokens, Turns: session.Turns, Uncertain: session.AccountingUncertain, Unpriced: session.Unpriced, Active: prior.Active + time.Since(start)}
	raw, err := json.Marshal(totals)
	if err != nil {
		return err
	}
	recordCtx, cancel := context.WithTimeout(context.WithoutCancel(ctx), 5*time.Second)
	defer cancel()
	return r.db.SaveArtifact(recordCtx, store.Artifact{RunID: run.ID, Kind: "accounting", Content: string(raw)})
}

func (r *Runner) loop(run store.Run, env *toolEnvironment, model string) (*agent.Loop, error) {
	p, pricing, err := r.provider(run.Provider)
	if err != nil {
		return nil, err
	}
	return &agent.Loop{Provider: p, Model: model, Env: env.env, Pricing: pricing, Clock: r.now, Recorder: &agent.StoreRecorder{Store: r.db, RunID: run.ID, Phase: run.Phase, Redactor: r.redactor}}, nil
}

func budgetError(reason agent.EndReason) error {
	kind := string(reason)
	if reason == agent.EndBudget {
		kind = "budget_exhausted"
	}
	return &agent.Error{Kind: kind, Message: "agent stopped: " + string(reason)}
}
package runner

import (
	"context"
	"errors"
	"fmt"
	"strings"

	"github.com/aryanpappu/patchbot/internal/agent"
	"github.com/aryanpappu/patchbot/internal/store"
	"github.com/aryanpappu/patchbot/internal/tools"
)

// Capabilities describes actions allowed by the persisted lifecycle and spec.
// Actions still validate their input, external issue/comment freshness, dispatch
// capacity and concurrent changes when executed.
type Capabilities struct {
	CanApprove bool `json:"can_approve"`
	CanEdit    bool `json:"can_edit"`
	CanRevise  bool `json:"can_revise"`
	CanReject  bool `json:"can_reject"`
	CanCancel  bool `json:"can_cancel"`
	CanRetry   bool `json:"can_retry"`
}

var errRunExpired = errors.New("run expired")

func (r *Runner) requireActionState(ctx context.Context, run store.Run, action string) error {
	err := r.checkActionState(run, action)
	if errors.Is(err, errRunExpired) {
		return errors.Join(err, r.expire(ctx, run))
	}
	return err
}

// ActionCapabilities uses the same guards as the mutating runner methods, on
// the run and latest spec snapshot returned in the detail response.
func (r *Runner) ActionCapabilities(run store.Run, spec *store.Spec) Capabilities {
	allowed := func(action string) bool {
		if r.checkActionState(run, action) != nil {
			return false
		}
		if action == "cancel" || action == "retry" {
			return true
		}
		if spec == nil || r.checkActionSpec(*spec, action) != nil {
			return false
		}
		return action != "approve" || strings.TrimSpace(r.cfg.Approval.LocalActor) != ""
	}
	return Capabilities{
		CanApprove: allowed("approve"), CanEdit: allowed("edit"),
		CanRevise: allowed("revise"), CanReject: allowed("reject"),
		CanCancel: allowed("cancel"), CanRetry: allowed("retry"),
	}
}

func (r *Runner) checkActionState(run store.Run, action string) error {
	var allowed bool
	switch action {
	case "approve":
		allowed = run.Status == store.StatusAwaitingApproval
	case "edit", "revise", "reject":
		allowed = waiting(run.Status) || run.Status == store.StatusApproved
	case "cancel":
		allowed = run.Status.IsActive() || run.Status == store.StatusCancelled
	case "retry":
		allowed = run.Status == store.StatusFailed || run.Status == store.StatusCancelled || run.Status == store.StatusRejected
	}
	if !allowed {
		return store.ErrConflict
	}
	if action != "cancel" && action != "retry" && r.expired(run) {
		return errRunExpired
	}
	return nil
}

func (r *Runner) checkActionSpec(spec store.Spec, action string) error {
	switch action {
	case "edit", "revise":
		if spec.Version-1 >= int64(r.gateOptions().MaxRevisions) {
			return fmt.Errorf("maximum %d spec revisions reached", r.gateOptions().MaxRevisions)
		}
	case "approve":
		if err := r.checkStoredSpec(spec); err != nil {
			return err
		}
		draft, _ := tools.ParseSpec(spec.BodyMD)
		if len(draft.OpenQuestions) != 0 {
			return fmt.Errorf("%w: specification still has open questions", agent.ErrApprovalDenied)
		}
	}
	return nil
}

func (r *Runner) checkStoredSpec(spec store.Spec) error {
	if spec.Version-1 > int64(r.gateOptions().MaxRevisions) {
		return fmt.Errorf("%w: revision limit exceeded", agent.ErrApprovalDenied)
	}
	draft, err := tools.ParseSpec(spec.BodyMD)
	if err != nil || draft.Hash() != spec.Hash {
		return fmt.Errorf("%w: specification content or hash changed", agent.ErrApprovalDenied)
	}
	return nil
}
package runner

import (
	"context"
	"errors"
	"fmt"
	"os"
	"strings"

	"github.com/aryanpappu/patchbot/internal/agent"
	"github.com/aryanpappu/patchbot/internal/github"
	"github.com/aryanpappu/patchbot/internal/gitx"
	"github.com/aryanpappu/patchbot/internal/store"
	"github.com/aryanpappu/patchbot/internal/tools"
	"github.com/aryanpappu/patchbot/internal/workspace"
)

func (r *Runner) publicationAvailable(ctx context.Context, run store.Run) error {
	branch := fmt.Sprintf("patchbot/issue-%d", run.IssueNumber)
	pr, err := r.gh.FindOpenPR(ctx, ref(run.Repo), branch)
	if err != nil {
		return err
	}
	if pr != nil {
		return errors.New("an open PR already exists for the patchbot branch")
	}
	exists, err := r.gh.BranchExists(ctx, ref(run.Repo), branch)
	if err != nil {
		return err
	}
	if exists {
		return errors.New("patchbot branch already exists; refusing to overwrite it")
	}
	return nil
}

func (r *Runner) validateChanges(ctx context.Context, run store.Run, env *toolEnvironment) error {
	changes, err := env.repo.Status(ctx)
	if err != nil {
		return err
	}
	policy, err := workspace.NewPolicy(r.cfg.Repos[run.Repo].Protected)
	if err != nil {
		return err
	}
	for _, change := range changes {
		for _, path := range []string{change.Path, change.OriginalPath} {
			if path == "" {
				continue
			}
			if _, err := policy.Check(path); err != nil {
				return &agent.Error{Kind: "policy_violations", Message: "patch changes a protected or invalid path"}
			}
			if _, err := env.env.WS.Stat(path); err != nil && !errors.Is(err, os.ErrNotExist) {
				return &agent.Error{Kind: "policy_violations", Message: "patch contains an unsafe path"}
			}
		}
	}
	return nil
}

// publicationApproval checks remote spec freshness first, then the persisted
// decision and worker generation. Call again at each external write boundary:
// neither an earlier snapshot nor a heartbeat is publication authorization.
func (r *Runner) publicationApproval(ctx context.Context, run store.Run, spec store.Spec) (store.Approval, error) {
	current, err := r.checkedSpec(ctx, run)
	if err != nil {
		return store.Approval{}, err
	}
	if current.Version != spec.Version || current.Hash != spec.Hash {
		return store.Approval{}, agent.ErrApprovalDenied
	}
	approval, err := r.db.ValidApproval(ctx, run.ID, spec.Version, spec.Hash)
	if err != nil {
		return store.Approval{}, fmt.Errorf("%w: matching publication approval: %w", agent.ErrApprovalDenied, err)
	}
	persisted, err := r.db.GetRun(ctx, run.ID)
	if err != nil {
		return store.Approval{}, err
	}
	if persisted.Status != store.StatusRunning || persisted.Phase != store.PhasePublish || persisted.Generation != run.Generation {
		return store.Approval{}, store.ErrConflict
	}
	now := r.now()
	if approval.CreatedAt.IsZero() || approval.CreatedAt.After(now) || !now.Before(approval.CreatedAt.Add(r.gateOptions().TTL)) {
		return store.Approval{}, fmt.Errorf("%w: publication approval expired or has an invalid date", agent.ErrApprovalDenied)
	}
	return approval, ctx.Err()
}

func (r *Runner) publish(ctx context.Context, run *store.Run, env *toolEnvironment, meta github.Repo, spec store.Spec, result agent.CodeResult, baseline string, codeErr error) error {
	var summary *string
	if result.Submission != nil {
		summary = &result.Submission.Summary
	}
	if err := r.transition(ctx, run, store.StatusRunning, store.PhasePublish, store.RunPatch{TestsStatus: &result.TestsStatus, PRDraft: &result.Draft, Summary: summary}); err != nil {
		return err
	}
	approval, err := r.publicationApproval(ctx, *run, spec)
	if err != nil {
		return err
	}
	if err := r.validateChanges(ctx, *run, env); err != nil {
		return err
	}
	diff, err := env.repo.Diff(ctx)
	if err != nil {
		return err
	}
	if err := r.artifact(ctx, run.ID, "diff", diff); err != nil {
		return err
	}
	live, err := r.gh.GetRepo(ctx, ref(run.Repo))
	if err != nil {
		return err
	}
	branch, found, err := r.gh.GetBranch(ctx, ref(run.Repo), live.DefaultBranch)
	if err != nil {
		return err
	}
	if !found {
		return errors.New("default branch no longer exists")
	}
	moved := live.DefaultBranch != meta.DefaultBranch || branch.Commit.SHA != run.BaseSHA
	title, body := r.prText(*run, spec, approval, result, baseline, moved, codeErr)
	if err := r.artifact(ctx, run.ID, "pr_title", title); err != nil {
		return err
	}
	if err := r.artifact(ctx, run.ID, "pr_body", body); err != nil {
		return err
	}
	if !run.DryRun {
		if err := r.publicationAvailable(ctx, *run); err != nil {
			return err
		}
	}
	if err := ctx.Err(); err != nil {
		return err
	}
	var head string
	if err := r.operation(ctx, *run, "git", "commit", func() error {
		var err error
		head, err = env.repo.CommitAll(ctx, fmt.Sprintf("fix: %s (#%d)", title, run.IssueNumber), gitx.Author{})
		return err
	}); err != nil {
		return err
	}
	if err := r.transition(ctx, run, store.StatusRunning, store.PhasePublish, store.RunPatch{HeadSHA: &head}); err != nil {
		return err
	}
	if run.DryRun {
		outcome := "dry_run"
		return r.transition(ctx, run, store.StatusSucceeded, store.PhasePublish, store.RunPatch{Outcome: &outcome})
	}
	var guardErr error
	if err := r.operation(ctx, *run, "git", "push", func() error {
		if _, guardErr = r.publicationApproval(ctx, *run, spec); guardErr != nil {
			return guardErr
		}
		return env.repo.Push(ctx, run.Branch)
	}); err != nil {
		if guardErr != nil {
			return err
		}
		return &agent.Error{Kind: "push_failed", Message: "could not push guarded patchbot branch"}
	}
	var pr github.PullRequest
	err = r.operation(ctx, *run, "publish", "create_pr", func() error {
		if _, guardErr = r.publicationApproval(ctx, *run, spec); guardErr != nil {
			return guardErr
		}
		var err error
		pr, err = r.gh.CreatePR(ctx, ref(run.Repo), github.NewPR{Title: title, Body: body, Head: run.Branch, Base: live.DefaultBranch, Draft: result.Draft})
		return err
	})
	if err != nil {
		if guardErr != nil {
			return err
		}
		return &agent.Error{Kind: "pr_failed", Message: "branch pushed but pull request creation failed"}
	}
	number, outcome := int64(pr.Number), "pr_opened"
	if result.Draft {
		outcome = "pr_draft"
	}
	if err := r.transition(ctx, run, store.StatusRunning, store.PhasePublish, store.RunPatch{PRNumber: &number, PRURL: &pr.HTMLURL, PRDraft: &result.Draft}); err != nil {
		return err
	}
	if _, err := r.comment(ctx, *run, fmt.Sprintf("patchbot run %d: %s\nHarness tests: %s (%d attempts).", run.ID, pr.HTMLURL, result.TestsStatus, result.TestAttempts)); err != nil {
		if err := r.artifact(ctx, run.ID, "publish_comment_warning", "PR opened, but the issue comment could not be posted."); err != nil {
			return err
		}
	}
	return r.transition(ctx, run, store.StatusSucceeded, store.PhasePublish, store.RunPatch{Outcome: &outcome})
}

func (r *Runner) prText(run store.Run, spec store.Spec, approval store.Approval, result agent.CodeResult, baseline string, moved bool, codeErr error) (string, string) {
	title := fmt.Sprintf("Fix issue #%d", run.IssueNumber)
	var b strings.Builder
	if result.Salvage {
		fmt.Fprintf(&b, "Draft salvage: coding stopped (%s). Review the incomplete work.\n\n", result.Reason)
	}
	if codeErr != nil {
		b.WriteString("The agent stopped with a provider error; harness verification follows below.\n\n")
	}
	fmt.Fprintf(&b, "Fixes #%d\n\n", run.IssueNumber)
	link := fmt.Sprintf("stored run %d specification", run.ID)
	if spec.CommentID != nil {
		link = fmt.Sprintf("[approved specification](https://github.com/%s/issues/%d#issuecomment-%d)", run.Repo, run.IssueNumber, *spec.CommentID)
	}
	fmt.Fprintf(&b, "Approved spec: %s, version %d, SHA-256 `%s`, approved by %s.\n\n", link, spec.Version, spec.Hash, approval.Actor)
	fmt.Fprintf(&b, "Harness tests: **%s** (%d attempts). Baseline: **%s**.\n\nAcceptance criteria (agent claims; harness result above):\n\n", result.TestsStatus, result.TestAttempts, baseline)
	if result.TestsStatus == "not_run" {
		b.WriteString("Unverified: no test command is configured. This PR requires manual verification.\n\n")
	}
	if result.Submission != nil {
		title = result.Submission.PRTitle
		for index, criterion := range result.Submission.Criteria {
			tick := " "
			if criterion.Met {
				tick = "x"
			}
			fmt.Fprintf(&b, "- [%s] AC%d: %s — harness: %s. %s\n", tick, index+1, criterion.Text, result.TestsStatus, criterion.Note)
		}
		fmt.Fprintf(&b, "\n%s\n\n%s\n", result.Submission.Summary, result.Submission.PRBody)
	}
	if result.LastTest != nil {
		fmt.Fprintf(&b, "\nHarness exit code: %d; timed out: %t.\n\n```text\n%s\n```\n", result.LastTest.ExitCode, result.LastTest.TimedOut, tools.CapOutput(result.LastTest.Output, 8<<10))
	}
	if moved {
		fmt.Fprintf(&b, "\nThe default branch has moved since refinement. This patch is based on `%s`; review for integration changes.\n", run.BaseSHA)
	}
	cost := "unknown"
	if run.CostMicros != nil {
		cost = fmt.Sprintf("%d micro-USD", *run.CostMicros)
	}
	tokens := "unknown"
	if run.InputTokens != nil && run.OutputTokens != nil {
		tokens = fmt.Sprintf("%d input / %d output", *run.InputTokens, *run.OutputTokens)
	}
	fmt.Fprintf(&b, "\nUsage: %s tokens; cost: %s.\n", tokens, cost)
	fmt.Fprintf(&b, "\nProvider: %s; model: %s.\n\nGenerated by patchbot. Human review is required.\n", run.Provider, run.CodeModel)
	title = strings.ReplaceAll(strings.ReplaceAll(title, "\n", " "), "\r", " ")
	if strings.TrimSpace(title) == "" {
		title = fmt.Sprintf("Fix issue #%d", run.IssueNumber)
	}
	return tools.CapOutput(github.NeutralizeMentions(r.redactor.Redact(title)), 200), tools.CapOutput(github.NeutralizeMentions(r.redactor.Redact(b.String())), 60_000)
}
// Package store persists runs, approval history, and replayable events.
// Callers must redact secrets before passing text or JSON to the store.
package store

import (
	"context"
	"encoding/json"
	"errors"
	"time"
)

// Status describes a run's lifecycle, independently of its current phase.
type Status string

// Run statuses. Every active status holds the unique slot for its issue.
const (
	StatusQueued           Status = "queued"
	StatusRunning          Status = "running"
	StatusNeedsInfo        Status = "needs_info"
	StatusAwaitingApproval Status = "awaiting_approval"
	StatusApproved         Status = "approved"
	StatusSucceeded        Status = "succeeded"
	StatusFailed           Status = "failed"
	StatusCancelled        Status = "cancelled"
	StatusRejected         Status = "rejected"
)

// IsActive reports whether the run holds its issue's active-run slot.
func (s Status) IsActive() bool {
	switch s {
	case StatusQueued, StatusRunning, StatusNeedsInfo, StatusAwaitingApproval, StatusApproved:
		return true
	default:
		return false
	}
}

// Phase identifies the work being performed within a run.
type Phase string

// Run phases, as defined by the merged plan.
const (
	PhasePreflight Phase = "preflight"
	PhaseRefine    Phase = "refine"
	PhaseClone     Phase = "clone"
	PhaseBaseline  Phase = "baseline"
	PhaseCode      Phase = "code"
	PhaseVerify    Phase = "verify"
	PhasePublish   Phase = "publish"
)

// Store errors are suitable for errors.Is, including when wrapped with context.
var (
	ErrNotFound        = errors.New("not found")
	ErrActiveRunExists = errors.New("an active run already exists for this issue")
	ErrConflict        = errors.New("run or spec is not in the expected state")
)

// Run is a durable run row. IDs are generated by the store. Optional numeric
// values and times use pointers: nil means unknown, including unpriced cost.
// All times round-trip at UTC millisecond precision; all money is micro-USD.
// Generation advances on lifecycle changes and operator spec edits. Workers
// retain their own generation to prevent stale transitions, including ABA.
type Run struct {
	ID               int64           `json:"id"`
	Generation       int64           `json:"generation"`
	Repo             string          `json:"repo"`
	IssueNumber      int64           `json:"issue_number"`
	IssueTitle       string          `json:"issue_title"`
	Mode             string          `json:"mode"`
	RetryOf          *int64          `json:"retry_of"`
	Trigger          string          `json:"trigger"`
	Provider         string          `json:"provider"`
	RefineModel      string          `json:"refine_model"`
	CodeModel        string          `json:"code_model"`
	DryRun           bool            `json:"dry_run"`
	Status           Status          `json:"status"`
	Phase            Phase           `json:"phase"`
	Outcome          string          `json:"outcome"`
	BaseSHA          string          `json:"base_sha"`
	HeadSHA          string          `json:"head_sha"`
	Branch           string          `json:"branch"`
	PRNumber         *int64          `json:"pr_number"`
	PRURL            string          `json:"prurl"`
	PRDraft          bool            `json:"pr_draft"`
	Summary          string          `json:"summary"`
	TestsStatus      string          `json:"tests_status"`
	TestAttempts     int64           `json:"test_attempts"`
	Turns            int64           `json:"turns"`
	InputTokens      *int64          `json:"input_tokens"`
	OutputTokens     *int64          `json:"output_tokens"`
	CacheReadTokens  *int64          `json:"cache_read_tokens"`
	CacheWriteTokens *int64          `json:"cache_write_tokens"`
	CostMicros       *int64          `json:"cost_micros"`
	LimitsJSON       json.RawMessage `json:"limits_json"`
	ErrorKind        string          `json:"error_kind"`
	ErrorMessage     string          `json:"error_message"`
	CreatedAt        time.Time       `json:"created_at"`
	UpdatedAt        time.Time       `json:"updated_at"`
	StartedAt        *time.Time      `json:"started_at"`
	FinishedAt       *time.Time      `json:"finished_at"`
	HeartbeatAt      *time.Time      `json:"heartbeat_at"`
	WaitingSince     *time.Time      `json:"waiting_since"`
}

// RunFilter selects runs in descending (created_at, id) order. Limit defaults
// to 50 and is capped at 500. Cursor is an opaque NextCursor from a prior page;
// use the same filters throughout pagination.
type RunFilter struct {
	Repo        string
	IssueNumber int64
	Statuses    []Status
	Limit       int
	Cursor      string
}

// RunPage contains runs and a continuation cursor, empty on the final page.
type RunPage struct {
	Runs       []Run  `json:"runs"`
	NextCursor string `json:"next_cursor"`
}

// RunPatch changes status-related metadata along with the phase. Nil fields
// leave existing values alone. The store manages lifecycle timestamps and emits
// run.status in the same transaction. Same-status transitions can change phase.
// ExpectedGeneration, when set, also guards ownership of the source snapshot.
type RunPatch struct {
	ExpectedGeneration       *int64
	Phase                    Phase
	IssueTitle               *string
	Outcome                  *string
	ErrorKind, ErrorMessage  *string
	BaseSHA, HeadSHA, Branch *string
	PRNumber                 *int64
	PRURL                    *string
	PRDraft                  *bool
	Summary, TestsStatus     *string
}

// Spec is an immutable version. Hash is the SHA-256 of the caller's canonical
// spec representation (which may contain structured fields beyond BodyMD).
// SaveSpec assigns Version when zero, otherwise requires the next version.
type Spec struct {
	RunID     int64     `json:"run_id"`
	Version   int64     `json:"version"`
	BodyMD    string    `json:"body_md"`
	Hash      string    `json:"hash"`
	IssueHash string    `json:"issue_hash"`
	Source    string    `json:"source"`
	Notes     string    `json:"notes"`
	CommentID *int64    `json:"comment_id"`
	CreatedAt time.Time `json:"created_at"`
}

// SpecEdit guards both the source lifecycle snapshot and the prior spec. The
// new spec, waiting status, status event and edit action are one transaction.
type SpecEdit struct {
	Spec                     Spec
	From, To                 Status
	Generation, PriorVersion int64
	PriorHash, Actor         string
}

// Approval binds a decision (approve/revise/reject) to an exact spec version
// and hash. Channel is ui/cli/github. The newest decision for a spec wins.
type Approval struct {
	ID          int64     `json:"id"`
	RunID       int64     `json:"run_id"`
	SpecVersion int64     `json:"spec_version"`
	SpecHash    string    `json:"spec_hash"`
	Decision    string    `json:"decision"`
	Actor       string    `json:"actor"`
	Channel     string    `json:"channel"`
	CreatedAt   time.Time `json:"created_at"`
}

// Question stores a question and, optionally, its answer and provenance.
type Question struct {
	ID, RunID                         int64
	Body                              string
	Answer, AnsweredBy, AnswerChannel *string
	CommentID                         *int64
	CreatedAt                         time.Time
	AnsweredAt                        *time.Time
}

// Step is a structured execution record, separate from the SSE event log.
// Seq is allocated per run when zero; a nonzero value updates that step.
// A completed llm step's usage is included in the run totals atomically.
type Step struct {
	RunID            int64      `json:"run_id"`
	Seq              int64      `json:"seq"`
	Phase            Phase      `json:"phase"`
	Kind             string     `json:"kind"`
	Tool             string     `json:"tool"`
	Status           string     `json:"status"`
	Turn             *int64     `json:"turn"`
	InputJSON        string     `json:"input_json"`
	OutputText       string     `json:"output_text"`
	StopReason       string     `json:"stop_reason"`
	InputTokens      *int64     `json:"input_tokens"`
	OutputTokens     *int64     `json:"output_tokens"`
	CacheReadTokens  *int64     `json:"cache_read_tokens"`
	CacheWriteTokens *int64     `json:"cache_write_tokens"`
	CostMicros       *int64     `json:"cost_micros"`
	ExitCode         *int64     `json:"exit_code"`
	DurationMS       *int64     `json:"duration_ms"`
	StartedAt        time.Time  `json:"started_at"`
	FinishedAt       *time.Time `json:"finished_at"`
}

// Event is a replayable event. AppendEvent assigns Seq and defaults CreatedAt.
type Event struct {
	RunID       int64           `json:"run_id"`
	Seq         int64           `json:"seq"`
	Type        string          `json:"type"`
	PayloadJSON json.RawMessage `json:"payload_json"`
	CreatedAt   time.Time       `json:"created_at"`
}

// Artifact stores a redacted artifact for one kind and test attempt.
// Callers cap content at its source before saving it.
type Artifact struct {
	RunID     int64
	Kind      string
	Attempt   int64
	Content   string
	CreatedAt time.Time
}

// Action audits a UI, CLI, or GitHub action. Kind is start/edit_spec/approve/
// revise/reject/cancel/retry/answer; details are redacted JSON.
type Action struct {
	ID, RunID   int64
	Kind, Actor string
	Channel     string
	PayloadJSON json.RawMessage
	CreatedAt   time.Time
}

// Store is the persistence boundary used by the runner and server. Each method
// is atomic and never executes a caller-controlled callback in a transaction.
// Policy (allowed transitions, actor authorization, issue freshness, expiry,
// and revision limits) belongs to the runner; this layer enforces CAS and the
// latest-spec approval binding. Missing reads return ErrNotFound.
type Store interface {
	CreateRun(context.Context, Run) (Run, error)
	GetRun(context.Context, int64) (Run, error)
	ListRuns(context.Context, RunFilter) (RunPage, error)
	SetRunStatus(ctx context.Context, id int64, from, to Status, patch RunPatch) error
	Heartbeat(context.Context, int64) error
	FailStaleRuns(ctx context.Context, olderThan time.Time) (int64, error)

	RecordStep(context.Context, Step) (Step, error)
	ListSteps(ctx context.Context, runID int64) ([]Step, error)
	AppendEvent(context.Context, Event) (int64, error)
	EventsAfter(ctx context.Context, runID, afterSeq int64, limit int) ([]Event, error)

	SaveSpec(context.Context, Spec) (Spec, error)
	EditSpec(context.Context, SpecEdit) (Spec, error)
	LatestSpec(ctx context.Context, runID int64) (Spec, error)
	ListSpecs(context.Context, int64) ([]Spec, error)
	ListApprovals(context.Context, int64) ([]Approval, error)
	ListArtifacts(context.Context, int64) ([]ArtifactMetadata, error)
	RecordApproval(context.Context, Approval) (Approval, error)
	// DecideRun atomically binds a decision to the expected latest version/hash,
	// CASes status and generation, and appends its status event and action audit.
	// An optional phase atomically claims approved asynchronous execution.
	DecideRun(context.Context, Status, Status, Approval, int64, ...Phase) error
	// StartCode claims approved work only while the exact latest approval still
	// matches and the worker still owns generation. SaveSpec refuses edits after
	// this atomic claim.
	StartCode(ctx context.Context, runID, version int64, hash string, generation int64) error
	// SetSpecComment attaches publication provenance without editing spec content.
	SetSpecComment(ctx context.Context, runID, version int64, hash string, commentID int64) error
	ValidApproval(ctx context.Context, runID, specVersion int64, specHash string) (Approval, error)
	SaveQuestion(context.Context, Question) (Question, error)
	ListQuestions(ctx context.Context, runID int64) ([]Question, error)

	RecordAction(context.Context, Action) (Action, error)
	ListActions(ctx context.Context, runID int64) ([]Action, error)
	SaveArtifact(context.Context, Artifact) error
	GetArtifact(ctx context.Context, runID int64, kind string, attempt int64) (Artifact, error)
	Close() error
}

// IsSchemaIdentifier reports fixed phase/status values owned by the harness.
// Redaction boundaries preserve these enums while still masking arbitrary text.
func IsSchemaIdentifier(key, value string) bool {
	switch key {
	case "phase":
		switch Phase(value) {
		case PhasePreflight, PhaseRefine, PhaseClone, PhaseBaseline, PhaseCode, PhaseVerify, PhasePublish:
			return true
		}
	case "status":
		switch Status(value) {
		case StatusQueued, StatusRunning, StatusNeedsInfo, StatusAwaitingApproval, StatusApproved, StatusSucceeded, StatusFailed, StatusCancelled, StatusRejected:
			return true
		}
		return value == "ok" || value == "error"
	}
	return false
}
package store

import (
	"context"
	"crypto/sha256"
	"database/sql"
	"embed"
	"errors"
	"fmt"
	"io/fs"
	"strconv"
	"strings"
	"time"
)

//go:embed migrations/*.sql
var migrationFiles embed.FS

type migration struct {
	version             int64
	name, checksum, sql string
}

func (s *SQLite) migrate(ctx context.Context) error {
	entries, err := fs.ReadDir(migrationFiles, "migrations")
	if err != nil {
		return err
	}
	migrations := make([]migration, 0, len(entries))
	for _, entry := range entries {
		name := entry.Name()
		prefix, _, ok := strings.Cut(name, "_")
		version, parseErr := strconv.ParseInt(prefix, 10, 64)
		if !ok || parseErr != nil || version != int64(len(migrations)+1) {
			return fmt.Errorf("invalid migration filename %q", name)
		}
		body, readErr := migrationFiles.ReadFile("migrations/" + name)
		if readErr != nil {
			return readErr
		}
		migrations = append(migrations, migration{version, name, fmt.Sprintf("%x", sha256.Sum256(body)), string(body)})
	}
	_, err = s.db.ExecContext(ctx, `CREATE TABLE IF NOT EXISTS schema_migrations (
		version INTEGER PRIMARY KEY CHECK (version > 0), name TEXT NOT NULL,
		checksum TEXT NOT NULL, applied_at INTEGER NOT NULL CHECK (applied_at >= 0)
	) STRICT`)
	if err != nil {
		return fmt.Errorf("create migration ledger: %w", err)
	}
	// Each transaction re-reads the ledger while holding the immediate write
	// lock, so separate processes can safely open the same fresh database.
	for _, m := range migrations {
		if err := s.applyMigration(ctx, m, int64(len(migrations))); err != nil {
			return err
		}
	}
	return nil
}

func (s *SQLite) applyMigration(ctx context.Context, m migration, latest int64) error {
	return s.withTx(ctx, func(tx *eventTx) error {
		var maxVersion int64
		if err := tx.QueryRowContext(ctx, `SELECT COALESCE(MAX(version),0) FROM schema_migrations`).Scan(&maxVersion); err != nil {
			return err
		}
		if maxVersion > latest {
			return fmt.Errorf("database migration %d is newer than supported version %d", maxVersion, latest)
		}
		var name, checksum string
		err := tx.QueryRowContext(ctx, `SELECT name, checksum FROM schema_migrations WHERE version=?`, m.version).Scan(&name, &checksum)
		if err == nil {
			if name != m.name || checksum != m.checksum {
				return fmt.Errorf("migration %d (%s) name or checksum changed", m.version, m.name)
			}
			return nil
		}
		if !errors.Is(err, sql.ErrNoRows) {
			return err
		}
		if maxVersion != m.version-1 {
			return fmt.Errorf("migration ledger has a gap before version %d", m.version)
		}
		if _, err := tx.ExecContext(ctx, m.sql); err != nil {
			return fmt.Errorf("apply migration %s: %w", m.name, err)
		}
		_, err = tx.ExecContext(ctx, `INSERT INTO schema_migrations(version,name,checksum,applied_at) VALUES(?,?,?,?)`,
			m.version, m.name, m.checksum, time.Now().UTC().UnixMilli())
		return err
	})
}
package store

import (
	"context"
	"database/sql"
	"encoding/json"
	"errors"
	"time"
)

const specColumns = `run_id,version,body_md,hash,issue_hash,source,notes,comment_id,created_at`

func scanSpec(row scanner) (Spec, error) {
	var spec Spec
	var created int64
	err := row.Scan(&spec.RunID, &spec.Version, &spec.BodyMD, &spec.Hash, &spec.IssueHash,
		&spec.Source, &spec.Notes, &spec.CommentID, &created)
	spec.CreatedAt = time.UnixMilli(created).UTC()
	return spec, mapError(err)
}

// SaveSpec appends an immutable version. Any older approval immediately stops
// matching LatestSpec; an approved run returns to awaiting_approval with an
// event in this same transaction. Explicit stale version numbers conflict.
func (s *SQLite) SaveSpec(ctx context.Context, spec Spec) (Spec, error) {
	var saved Spec
	err := s.withTx(ctx, func(tx *eventTx) error {
		var status Status
		var phase Phase
		if err := tx.QueryRowContext(ctx, `SELECT status,phase FROM runs WHERE id=?`, spec.RunID).Scan(&status, &phase); err != nil {
			return err
		}
		if !status.IsActive() || (status == StatusRunning && (phase == PhaseCode || phase == PhaseVerify || phase == PhasePublish)) {
			return ErrConflict
		}
		var next int64
		if err := tx.QueryRowContext(ctx, `SELECT COALESCE(MAX(version),0)+1 FROM specs WHERE run_id=?`, spec.RunID).Scan(&next); err != nil {
			return err
		}
		if spec.Version != 0 && spec.Version != next {
			return ErrConflict
		}
		spec.Version = next
		spec.CreatedAt = timestamp(spec.CreatedAt)
		var err error
		saved, err = scanSpec(tx.QueryRowContext(ctx, `INSERT INTO specs(`+specColumns+`) VALUES(?,?,?,?,?,?,?,?,?) RETURNING `+specColumns,
			spec.RunID, spec.Version, spec.BodyMD, spec.Hash, spec.IssueHash, spec.Source, spec.Notes, spec.CommentID, spec.CreatedAt.UnixMilli()))
		if err != nil {
			return err
		}
		now := time.Now().UTC().UnixMilli()
		result, err := tx.ExecContext(ctx, `UPDATE runs SET generation=generation+1,status='awaiting_approval',waiting_since=?,updated_at=?
			WHERE id=? AND status='approved'`, now, now, spec.RunID)
		if err != nil {
			return err
		}
		n, err := result.RowsAffected()
		if err != nil {
			return err
		}
		if n != 0 {
			_, err = appendEvent(ctx, tx, Event{RunID: spec.RunID, Type: "run.status",
				PayloadJSON: []byte(`{"from":"approved","status":"awaiting_approval","reason":"spec_changed"}`)})
		}
		return err
	})
	if err != nil {
		return Spec{}, err
	}
	return saved, nil
}

// LatestSpec returns the highest spec version for a run.
func (s *SQLite) LatestSpec(ctx context.Context, runID int64) (Spec, error) {
	return scanSpec(s.db.QueryRowContext(ctx, "SELECT "+specColumns+" FROM specs WHERE run_id=? ORDER BY version DESC LIMIT 1", runID))
}

const approvalColumns = `id,run_id,spec_version,spec_hash,decision,actor,channel,created_at`

func scanApproval(row scanner) (Approval, error) {
	var a Approval
	var created int64
	err := row.Scan(&a.ID, &a.RunID, &a.SpecVersion, &a.SpecHash, &a.Decision, &a.Actor, &a.Channel, &created)
	a.CreatedAt = time.UnixMilli(created).UTC()
	return a, mapError(err)
}

// RecordApproval records a decision only for the current version and hash.
// Status transitions and actor authorization remain the runner's responsibility.
func (s *SQLite) RecordApproval(ctx context.Context, a Approval) (Approval, error) {
	var saved Approval
	err := s.withTx(ctx, func(tx *eventTx) error {
		var version int64
		var hash string
		err := tx.QueryRowContext(ctx, `SELECT version,hash FROM specs WHERE run_id=? ORDER BY version DESC LIMIT 1`, a.RunID).Scan(&version, &hash)
		if err != nil {
			return err
		}
		if version != a.SpecVersion || hash != a.SpecHash {
			return ErrConflict
		}
		saved, err = scanApproval(tx.QueryRowContext(ctx, `INSERT INTO approvals(run_id,spec_version,spec_hash,decision,actor,channel,created_at)
			VALUES(?,?,?,?,?,?,?) RETURNING `+approvalColumns,
			a.RunID, a.SpecVersion, a.SpecHash, a.Decision, a.Actor, a.Channel, timestamp(a.CreatedAt).UnixMilli()))
		return err
	})
	if err != nil {
		return Approval{}, err
	}
	return saved, nil
}

// ValidApproval requires both the requested version/hash and the latest spec
// to match the newest decision. Revisions, edits, and subsequent revise/reject
// decisions invalidate earlier approvals without deleting audit history.
func (s *SQLite) ValidApproval(ctx context.Context, runID, specVersion int64, specHash string) (Approval, error) {
	return scanApproval(s.db.QueryRowContext(ctx, `SELECT `+approvalColumns+` FROM approvals
		WHERE run_id=? AND spec_version=? AND spec_hash=? AND decision='approve'
		AND spec_version=(SELECT MAX(version) FROM specs WHERE run_id=?)
		AND spec_hash=(SELECT hash FROM specs WHERE run_id=? AND version=?)
		AND id=(SELECT MAX(id) FROM approvals WHERE run_id=? AND spec_version=?)`,
		runID, specVersion, specHash, runID, runID, specVersion, runID, specVersion))
}

const questionColumns = `id,run_id,body,answer,answered_by,answer_channel,comment_id,created_at,answered_at`

func scanQuestion(row scanner) (Question, error) {
	var q Question
	var created int64
	var answered sql.NullInt64
	err := row.Scan(&q.ID, &q.RunID, &q.Body, &q.Answer, &q.AnsweredBy, &q.AnswerChannel, &q.CommentID, &created, &answered)
	q.CreatedAt, q.AnsweredAt = time.UnixMilli(created).UTC(), optionalTime(answered)
	return q, mapError(err)
}

// SaveQuestion inserts a question, or updates the answer of an existing question
// owned by the same run. Existing question bodies and provenance are immutable.
func (s *SQLite) SaveQuestion(ctx context.Context, q Question) (Question, error) {
	if q.ID != 0 {
		return scanQuestion(s.db.QueryRowContext(ctx, `UPDATE questions SET answer=?,answered_by=?,answer_channel=?,answered_at=?
			WHERE id=? AND run_id=? RETURNING `+questionColumns, q.Answer, q.AnsweredBy, q.AnswerChannel, optionalMillis(q.AnsweredAt), q.ID, q.RunID))
	}
	return scanQuestion(s.db.QueryRowContext(ctx, `INSERT INTO questions(run_id,body,answer,answered_by,answer_channel,comment_id,created_at,answered_at)
		VALUES(?,?,?,?,?,?,?,?) RETURNING `+questionColumns,
		q.RunID, q.Body, q.Answer, q.AnsweredBy, q.AnswerChannel, q.CommentID, timestamp(q.CreatedAt).UnixMilli(), optionalMillis(q.AnsweredAt)))
}

// ListQuestions returns questions in insertion order.
func (s *SQLite) ListQuestions(ctx context.Context, runID int64) ([]Question, error) {
	rows, err := s.db.QueryContext(ctx, "SELECT "+questionColumns+" FROM questions WHERE run_id=? ORDER BY id", runID)
	if err != nil {
		return nil, err
	}
	defer func() { _ = rows.Close() }()
	questions := []Question{}
	for rows.Next() {
		q, err := scanQuestion(rows)
		if err != nil {
			return nil, err
		}
		questions = append(questions, q)
	}
	return questions, rows.Err()
}

const actionColumns = `id,run_id,kind,actor,channel,payload_json,created_at`

func scanAction(row scanner) (Action, error) {
	var a Action
	var created int64
	var payload string
	err := row.Scan(&a.ID, &a.RunID, &a.Kind, &a.Actor, &a.Channel, &payload, &created)
	a.PayloadJSON = json.RawMessage(payload)
	a.CreatedAt = time.UnixMilli(created).UTC()
	return a, mapError(err)
}

// RecordAction appends a redacted action to the audit log.
func (s *SQLite) RecordAction(ctx context.Context, a Action) (Action, error) {
	return scanAction(s.db.QueryRowContext(ctx, `INSERT INTO actions(run_id,kind,actor,channel,payload_json,created_at)
		VALUES(?,?,?,?,?,?) RETURNING `+actionColumns,
		a.RunID, a.Kind, a.Actor, a.Channel, jsonText(a.PayloadJSON), timestamp(a.CreatedAt).UnixMilli()))
}

// ListActions returns the run's audit log in insertion order.
func (s *SQLite) ListActions(ctx context.Context, runID int64) ([]Action, error) {
	rows, err := s.db.QueryContext(ctx, "SELECT "+actionColumns+" FROM actions WHERE run_id=? ORDER BY id", runID)
	if err != nil {
		return nil, err
	}
	defer func() { _ = rows.Close() }()
	actions := []Action{}
	for rows.Next() {
		a, err := scanAction(rows)
		if err != nil {
			return nil, err
		}
		actions = append(actions, a)
	}
	return actions, rows.Err()
}

// SaveArtifact inserts or replaces an artifact with the same run/kind/attempt.
func (s *SQLite) SaveArtifact(ctx context.Context, a Artifact) error {
	_, err := s.db.ExecContext(ctx, `INSERT INTO run_artifacts(run_id,kind,attempt,content,created_at)
		VALUES(?,?,?,?,?) ON CONFLICT(run_id,kind,attempt) DO UPDATE SET content=excluded.content,created_at=excluded.created_at`,
		a.RunID, a.Kind, a.Attempt, a.Content, timestamp(a.CreatedAt).UnixMilli())
	return mapError(err)
}

// GetArtifact retrieves a particular run artifact.
func (s *SQLite) GetArtifact(ctx context.Context, runID int64, kind string, attempt int64) (Artifact, error) {
	var a Artifact
	var created int64
	err := s.db.QueryRowContext(ctx, `SELECT run_id,kind,attempt,content,created_at FROM run_artifacts WHERE run_id=? AND kind=? AND attempt=?`,
		runID, kind, attempt).Scan(&a.RunID, &a.Kind, &a.Attempt, &a.Content, &created)
	a.CreatedAt = time.UnixMilli(created).UTC()
	return a, mapError(err)
}

const stepColumns = `run_id,seq,phase,kind,tool,status,turn,input_json,output_text,stop_reason,input_tokens,output_tokens,
cache_read_tokens,cache_write_tokens,cost_micros,exit_code,duration_ms,started_at,finished_at`

func scanStep(row scanner) (Step, error) {
	var step Step
	var started int64
	var finished sql.NullInt64
	err := row.Scan(&step.RunID, &step.Seq, &step.Phase, &step.Kind, &step.Tool, &step.Status, &step.Turn,
		&step.InputJSON, &step.OutputText, &step.StopReason, &step.InputTokens, &step.OutputTokens,
		&step.CacheReadTokens, &step.CacheWriteTokens, &step.CostMicros, &step.ExitCode, &step.DurationMS, &started, &finished)
	step.StartedAt, step.FinishedAt = time.UnixMilli(started).UTC(), optionalTime(finished)
	return step, mapError(err)
}

// RecordStep inserts a new step or replaces an existing step's data, updating
// run totals in the same transaction. Re-recording cannot double-count usage.
func (s *SQLite) RecordStep(ctx context.Context, step Step) (Step, error) {
	if step.Seq < 0 {
		return Step{}, errors.New("step sequence must be non-negative")
	}
	step.InputJSON = cappedText(step.InputJSON, 16*1024)
	outputCap := 64 * 1024
	if step.Kind == "test" || (step.Kind == "tool" && step.Tool == "run_cmd") {
		outputCap = 256 * 1024
	}
	step.OutputText = cappedText(step.OutputText, outputCap)
	var saved Step
	err := s.withTx(ctx, func(tx *eventTx) error {
		args := []any{step.Phase, step.Kind, step.Tool, step.Status, step.Turn, step.InputJSON, step.OutputText,
			step.StopReason, step.InputTokens, step.OutputTokens, step.CacheReadTokens, step.CacheWriteTokens,
			step.CostMicros, step.ExitCode, step.DurationMS, timestamp(step.StartedAt).UnixMilli(), optionalMillis(step.FinishedAt)}
		var query string
		if step.Seq == 0 {
			query = `INSERT INTO steps(` + stepColumns + `) SELECT ?,COALESCE(MAX(seq),0)+1,` + placeholders(len(args)) + ` FROM steps WHERE run_id=? RETURNING ` + stepColumns
			args = append([]any{step.RunID}, args...)
			args = append(args, step.RunID)
		} else {
			query = `UPDATE steps SET phase=?,kind=?,tool=?,status=?,turn=?,input_json=?,output_text=?,stop_reason=?,
				input_tokens=?,output_tokens=?,cache_read_tokens=?,cache_write_tokens=?,cost_micros=?,exit_code=?,duration_ms=?,started_at=?,finished_at=?
				WHERE run_id=? AND seq=? RETURNING ` + stepColumns
			args = append(args, step.RunID, step.Seq)
		}
		var err error
		saved, err = scanStep(tx.QueryRowContext(ctx, query, args...))
		if err != nil {
			return err
		}
		// NULL propagates if any completed llm call lacks a token count or price.
		// SUM alone would silently ignore unknown values and under-report usage.
		_, err = tx.ExecContext(ctx, `UPDATE runs SET
			(input_tokens,output_tokens,cache_read_tokens,cache_write_tokens,cost_micros,turns)=(
			SELECT CASE WHEN COUNT(input_tokens)=COUNT(*) THEN SUM(input_tokens) END,
			CASE WHEN COUNT(output_tokens)=COUNT(*) THEN SUM(output_tokens) END,
			CASE WHEN COUNT(cache_read_tokens)=COUNT(*) THEN SUM(cache_read_tokens) END,
			CASE WHEN COUNT(cache_write_tokens)=COUNT(*) THEN SUM(cache_write_tokens) END,
			CASE WHEN COUNT(cost_micros)=COUNT(*) THEN SUM(cost_micros) END,COUNT(*)
			FROM steps WHERE run_id=? AND kind='llm' AND status!='running'),
			test_attempts=(SELECT COUNT(*) FROM steps WHERE run_id=? AND kind='test' AND phase='verify' AND status!='running'),updated_at=?
			WHERE id=?`, step.RunID, step.RunID, time.Now().UTC().UnixMilli(), step.RunID)
		return err
	})
	if err != nil {
		return Step{}, err
	}
	return saved, nil
}

// ListSteps returns execution records in ascending per-run sequence order.
func (s *SQLite) ListSteps(ctx context.Context, runID int64) ([]Step, error) {
	rows, err := s.db.QueryContext(ctx, "SELECT "+stepColumns+" FROM steps WHERE run_id=? ORDER BY seq", runID)
	if err != nil {
		return nil, err
	}
	defer func() { _ = rows.Close() }()
	steps := []Step{}
	for rows.Next() {
		step, err := scanStep(rows)
		if err != nil {
			return nil, err
		}
		steps = append(steps, step)
	}
	return steps, rows.Err()
}
package store

import (
	"context"
	"encoding/json"
	"errors"
	"time"
)

// EditSpec appends an operator edit only if both snapshots still match. A
// cancellation, code claim, revision, or competing edit rolls everything back.
func (s *SQLite) EditSpec(ctx context.Context, edit SpecEdit) (Spec, error) {
	if (edit.From != StatusAwaitingApproval && edit.From != StatusNeedsInfo && edit.From != StatusApproved) ||
		(edit.To != StatusAwaitingApproval && edit.To != StatusNeedsInfo) {
		return Spec{}, ErrConflict
	}
	spec := edit.Spec
	spec.Version = edit.PriorVersion + 1
	spec.CreatedAt = timestamp(spec.CreatedAt)
	var saved Spec
	err := s.withTx(ctx, func(tx *eventTx) error {
		now := time.Now().UTC().UnixMilli()
		result, err := tx.ExecContext(ctx, `UPDATE runs SET generation=generation+1,status=?,phase='refine',updated_at=?,
   waiting_since=?,heartbeat_at=NULL,finished_at=NULL WHERE id=? AND status=? AND generation=?
   AND EXISTS(SELECT 1 FROM specs WHERE run_id=? AND version=? AND hash=?
     AND version=(SELECT MAX(version) FROM specs WHERE run_id=?))`,
			edit.To, now, now, spec.RunID, edit.From, edit.Generation, spec.RunID, edit.PriorVersion, edit.PriorHash, spec.RunID)
		if err != nil {
			return err
		}
		if err := requireAffected(result, ErrConflict); err != nil {
			return err
		}
		saved, err = scanSpec(tx.QueryRowContext(ctx, `INSERT INTO specs(`+specColumns+`) VALUES(?,?,?,?,?,?,?,?,?) RETURNING `+specColumns,
			spec.RunID, spec.Version, spec.BodyMD, spec.Hash, spec.IssueHash, spec.Source, spec.Notes, spec.CommentID, spec.CreatedAt.UnixMilli()))
		if err != nil {
			return err
		}
		payload, err := json.Marshal(map[string]any{"from": edit.From, "status": edit.To, "phase": PhaseRefine,
			"spec_version": spec.Version, "spec_hash": spec.Hash, "reason": "spec_changed"})
		if err != nil {
			return err
		}
		if _, err := appendEvent(ctx, tx, Event{RunID: spec.RunID, Type: "run.status", PayloadJSON: payload}); err != nil {
			return err
		}
		_, err = tx.ExecContext(ctx, `INSERT INTO actions(run_id,kind,actor,channel,payload_json,created_at) VALUES(?,'edit_spec',?,'ui',?,?)`,
			spec.RunID, edit.Actor, string(payload), now)
		return err
	})
	if err != nil {
		return Spec{}, err
	}
	return saved, nil
}

// DecideRun persists an exact-spec decision and lifecycle change together.
// An optional phase claims asynchronous execution in the same approval commit.
func (s *SQLite) DecideRun(ctx context.Context, from, to Status, a Approval, generation int64, phases ...Phase) error {
	return s.withTx(ctx, func(tx *eventTx) error {
		var version int64
		var hash string
		var phase Phase
		if err := tx.QueryRowContext(ctx, `SELECT specs.version,specs.hash,runs.phase FROM specs JOIN runs ON specs.run_id=runs.id
 WHERE specs.run_id=? ORDER BY specs.version DESC LIMIT 1`, a.RunID).Scan(&version, &hash, &phase); err != nil {
			return err
		}
		if version != a.SpecVersion || hash != a.SpecHash {
			return ErrConflict
		}
		now := time.Now().UTC().UnixMilli()
		decisionAt := timestamp(a.CreatedAt).UnixMilli()
		var finished, heartbeat any
		if !to.IsActive() {
			finished = now
		}
		if to == StatusApproved {
			phase = PhaseRefine
		}
		if to == StatusRunning {
			phase = PhasePreflight
		}
		if len(phases) > 0 {
			phase = phases[0]
		}
		if to == StatusRunning || (to == StatusApproved && (phase == PhaseClone || phase == PhaseBaseline)) {
			heartbeat = now
		}
		result, err := tx.ExecContext(ctx, `UPDATE runs SET generation=generation+1,status=?,updated_at=?,finished_at=?,heartbeat_at=?,waiting_since=NULL,
   phase=?,
   started_at=CASE WHEN ?='running' THEN COALESCE(started_at,?) ELSE started_at END,
   outcome=CASE WHEN ?='rejected' THEN 'rejected' ELSE outcome END
   WHERE id=? AND status=? AND generation=?`, to, now, finished, heartbeat, phase, to, now, to, a.RunID, from, generation)
		if err != nil {
			return err
		}
		if err := requireAffected(result, ErrConflict); err != nil {
			return err
		}
		if _, err := tx.ExecContext(ctx, `INSERT INTO approvals(run_id,spec_version,spec_hash,decision,actor,channel,created_at) VALUES(?,?,?,?,?,?,?)`, a.RunID, a.SpecVersion, a.SpecHash, a.Decision, a.Actor, a.Channel, decisionAt); err != nil {
			return err
		}
		payload, err := json.Marshal(map[string]any{"from": from, "status": to, "phase": phase, "spec_version": version, "spec_hash": hash})
		if err != nil {
			return err
		}
		if _, err := appendEvent(ctx, tx, Event{RunID: a.RunID, Type: "run.status", PayloadJSON: payload, CreatedAt: time.UnixMilli(now)}); err != nil {
			return err
		}
		_, err = tx.ExecContext(ctx, `INSERT INTO actions(run_id,kind,actor,channel,payload_json,created_at) VALUES(?,?,?,?,?,?)`, a.RunID, a.Decision, a.Actor, a.Channel, string(payload), now)
		return err
	})
}

// SetSpecComment records the immutable spec's GitHub rendering exactly once.
func (s *SQLite) SetSpecComment(ctx context.Context, runID, version int64, hash string, commentID int64) error {
	if commentID <= 0 {
		return errors.New("invalid spec comment ID")
	}
	result, err := s.db.ExecContext(ctx, `UPDATE specs SET comment_id=? WHERE run_id=? AND version=? AND hash=? AND comment_id IS NULL`, commentID, runID, version, hash)
	if err != nil {
		return mapError(err)
	}
	return requireAffected(result, ErrConflict)
}

// StartCode atomically closes the edit/approval race before any model writes.
func (s *SQLite) StartCode(ctx context.Context, runID, version int64, hash string, generation int64) error {
	return s.withTx(ctx, func(tx *eventTx) error {
		now := time.Now().UTC().UnixMilli()
		result, err := tx.ExecContext(ctx, `UPDATE runs SET generation=generation+1,status='running',phase='code',updated_at=?,heartbeat_at=?,waiting_since=NULL,
   started_at=COALESCE(started_at,?) WHERE id=? AND status='approved' AND generation=?
   AND EXISTS(SELECT 1 FROM specs WHERE run_id=? AND version=? AND hash=? AND version=(SELECT MAX(version) FROM specs WHERE run_id=?))
   AND EXISTS(SELECT 1 FROM approvals WHERE run_id=? AND spec_version=? AND spec_hash=? AND decision='approve'
     AND id=(SELECT MAX(id) FROM approvals WHERE run_id=? AND spec_version=?))`, now, now, now, runID, generation, runID, version, hash, runID, runID, version, hash, runID, version)
		if err != nil {
			return err
		}
		if err := requireAffected(result, ErrConflict); err != nil {
			return err
		}
		_, err = appendEvent(ctx, tx, Event{RunID: runID, Type: "run.status", PayloadJSON: []byte(`{"from":"approved","status":"running","phase":"code"}`)})
		return err
	})
}

