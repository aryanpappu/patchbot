// Package agent drives bounded, provider-neutral refine, code and investigate
// conversations. Publication and run lifecycle transitions belong to the runner.
package agent

import (
	"context"
	"time"

	"github.com/aryanpappu/patchbot/internal/llm"
	"github.com/aryanpappu/patchbot/internal/secret"
	"github.com/aryanpappu/patchbot/internal/tools"
)

// Limits bound a stage. Test repair reuses the same session and limits.
// Zero token/turn fields select defaults; zero MaxCostMicros disables the cost cap.
type Limits struct {
	MaxTurns        int
	MaxOutputTokens int
	MaxTotalTokens  int64
	MaxCostMicros   int64
	ContextWindow   int
	Deadline        time.Time
	MaxTestAttempts int
	TestTimeout     time.Duration
}

func (l Limits) defaults() Limits {
	if l.MaxTurns <= 0 {
		l.MaxTurns = 40
	}
	if l.MaxOutputTokens <= 0 {
		l.MaxOutputTokens = 8192
	}
	if l.MaxTotalTokens <= 0 {
		l.MaxTotalTokens = 2_000_000
	}
	if l.MaxTestAttempts <= 0 {
		l.MaxTestAttempts = 3
	}
	if l.TestTimeout <= 0 {
		l.TestTimeout = 10 * time.Minute
	}
	return l
}

// Session belongs to one goroutine. Usage is nil after any unknown usage. Cost
// and Tokens include retained worst-case reservations for calls without usage;
// they are conservative budget charges, not claims about a provider's invoice.
// Seed these totals from the run when starting a new stage or revision.
type Session struct {
	System              string
	Messages            []llm.Message
	Usage               *llm.Usage
	Cost                int64
	Tokens              int64
	Turns               int
	LastInputTokens     int64
	AccountingUncertain bool
	Unpriced            bool

	deadline         time.Time
	initialized      bool
	priceWarningKey  string
	turnBase         int
	contextCompacted bool
	endTurns         int
	malformed        int
	stuckHash        [32]byte
	stuckCount       int
	denials          int
}

// EndReason is a normal loop ending.
type EndReason string

// Loop endings.
const (
	EndSubmitted EndReason = "submitted"
	EndMaxTurns  EndReason = "max_turns"
	EndBudget    EndReason = "budget"
	EndDeadline  EndReason = "deadline"
	EndStuck     EndReason = "stuck"
	EndRefusal   EndReason = "refusal"
)

// Outcome contains a validated terminal submission or a bounded stop reason.
type Outcome struct {
	Reason      EndReason
	Submission  *tools.Submission
	Synthesized bool
}

// Engine lets a runner replace Loop without depending on its implementation.
type Engine interface {
	Run(context.Context, *Session, Limits) (Outcome, error)
}

// Loop is immutable during Run. A provider supplied here must have its own
// retries disabled: Loop applies llm.WithRetry and records every attempt.
// Only the stage methods can install tools; callers cannot inject a registry.
type Loop struct {
	Provider    llm.Provider
	Model       string
	tools       *stageRegistry
	Env         *tools.Env
	Pricing     llm.Pricing
	Recorder    Recorder
	Clock       func() time.Time
	RetryPolicy llm.RetryPolicy
	RetryClock  llm.Clock
}

func (l *Loop) now() time.Time {
	if l.Clock != nil {
		return l.Clock()
	}
	return time.Now()
}
func (l *Loop) redactor() *secret.Redactor {
	if l.Env != nil {
		return l.Env.Redactor
	}
	return nil
}

// Error is a classified harness or provider failure. Message is redacted;
// raw causes are deliberately not retained where a caller might print them.
type Error struct {
	Kind    string
	Message string
}

func (e *Error) Error() string { return e.Kind + ": " + e.Message }
package agent

import (
	"context"
	"crypto/sha256"
	_ "embed"
	"encoding/hex"
	"encoding/json"
	"time"

	"github.com/aryanpappu/patchbot/internal/llm"
)

//go:embed prompts/refine.txt
var refinePrompt string

//go:embed prompts/code.txt
var codePrompt string

//go:embed prompts/investigate.txt
var investigatePrompt string

// IssueHash binds an approval to the exact title and body, including whitespace.
// JSON array encoding makes the boundary between the two fields unambiguous.
func IssueHash(title, body string) string {
	raw, _ := json.Marshal([2]string{title, body})
	sum := sha256.Sum256(raw)
	return hex.EncodeToString(sum[:])
}

func stageContext(ctx context.Context, deadline, now time.Time) (context.Context, context.CancelFunc) {
	if deadline.IsZero() {
		return context.WithCancel(ctx)
	}
	return context.WithTimeout(ctx, max(time.Duration(0), deadline.Sub(now)))
}

func startStage(s *Session, system, task string) *Session {
	if s == nil {
		s = &Session{}
	}
	s.System, s.Messages = system, []llm.Message{llm.UserText(task)}
	// Limits and budget charges survive stage transitions; conversation heuristics
	// belong to the stage. Test repair does not call startStage.
	s.endTurns, s.malformed, s.stuckCount, s.denials = 0, 0, 0, 0
	s.contextCompacted = false
	s.turnBase = s.Turns
	s.deadline = time.Time{}
	s.LastInputTokens = 0
	return s
}

func issueData(title, body string) string {
	return untrusted("issue title", title) + "\n" + untrusted("issue body", body)
}
package agent

import (
	"context"
	"encoding/json"
	"errors"
	"fmt"

	"github.com/aryanpappu/patchbot/internal/execx"
	"github.com/aryanpappu/patchbot/internal/store"
	"github.com/aryanpappu/patchbot/internal/tools"
)

// stageRegistry cannot be supplied by a caller or replaced by a raw tools
// registry. Its constructors fix the stage's capabilities.
type stageRegistry struct{ *tools.Registry }

func newRefineRegistry(env *tools.Env) (*stageRegistry, error) {
	r, err := tools.NewReadOnlyRegistry(env, tools.SubmitSpec{})
	if err != nil {
		return nil, err
	}
	return &stageRegistry{r}, nil
}

func newInvestigateRegistry(env *tools.Env) (*stageRegistry, error) {
	r, err := tools.NewReadOnlyRegistry(env, tools.SubmitReport{})
	if err != nil {
		return nil, err
	}
	return &stageRegistry{r}, nil
}

// No write-capable stage registry can be constructed without Check's private
// token. Revalidate it immediately before registering writes and commands.
func newCodeRegistry(ctx context.Context, approval approvalToken, env *tools.Env, runID int64, issueHash string, criteria []string) (*stageRegistry, error) {
	if _, err := validateApproval(ctx, approval, runID, issueHash); err != nil {
		return nil, err
	}
	r, err := tools.NewCodeRegistry(env, tools.RunCmd{}, tools.Submit{Criteria: criteria})
	if err != nil {
		return nil, &Error{Kind: "internal", Message: "build code tools failed"}
	}
	return &stageRegistry{r}, nil
}

// SpecStore appends an immutable spec version. store.Store implements it.
type SpecStore interface {
	SaveSpec(context.Context, store.Spec) (store.Spec, error)
}

// RefineRequest supplies the issue snapshot and optional previous spec/notes.
// Session carries run-wide accounting across revisions and stages. Run lifecycle
// transitions and posting comments remain the runner's responsibility.
type RefineRequest struct {
	RunID       int64
	Title, Body string
	Prior       *store.Spec
	Notes       string
	Store       SpecStore
	Session     *Session
	Limits      Limits
}

// SpecResult is either an approval-ready spec or questions requiring an answer.
// The draft spec is saved in both cases, preserving its version and audit trail.
type SpecResult struct {
	Outcome
	Spec      store.Spec
	Questions []string
	Status    store.Status
}

// Refine explores read-only and saves a new version, including unresolved questions.
func (l *Loop) Refine(ctx context.Context, req RefineRequest) (SpecResult, error) {
	if req.Store == nil || req.RunID <= 0 {
		return SpecResult{}, &Error{Kind: "internal", Message: "refine requires spec storage and a run ID"}
	}
	stage := *l
	var err error
	stage.tools, err = newRefineRegistry(stage.Env)
	if err != nil {
		return SpecResult{}, &Error{Kind: "internal", Message: "build refine tools failed"}
	}
	task := issueData(stage.redactor().Redact(req.Title), stage.redactor().Redact(req.Body))
	version := int64(1)
	source := "agent"
	if req.Prior != nil {
		if req.Prior.RunID != req.RunID {
			return SpecResult{}, &Error{Kind: "internal", Message: "previous spec belongs to another run"}
		}
		version, source = req.Prior.Version+1, "revise"
		task += fmt.Sprintf("\nPrevious specification version: %d\n", req.Prior.Version) + untrusted("previous specification", stage.redactor().Redact(req.Prior.BodyMD))
	}
	if req.Notes != "" {
		task += "\n" + untrusted("revision notes or answers", stage.redactor().Redact(req.Notes))
	}
	session := startStage(req.Session, refinePrompt, task)
	lim := req.Limits
	if lim.MaxTurns <= 0 {
		lim.MaxTurns = 20
	}
	outcome, err := stage.Run(ctx, session, lim)
	result := SpecResult{Outcome: outcome}
	if err != nil {
		return result, err
	}
	if outcome.Reason != EndSubmitted || outcome.Submission == nil || outcome.Submission.Spec == nil {
		return result, &Error{Kind: "refine_incomplete", Message: "refinement ended without a validated specification"}
	}
	draft := outcome.Submission.Spec
	spec := store.Spec{RunID: req.RunID, Version: version, BodyMD: draft.Markdown(), Hash: draft.Hash(), IssueHash: IssueHash(req.Title, req.Body), Source: source, Notes: stage.redactor().Redact(req.Notes)}
	saved, err := req.Store.SaveSpec(ctx, spec)
	if err != nil {
		return result, &Error{Kind: "internal", Message: "saving specification failed"}
	}
	result.Spec, result.Status = saved, store.StatusAwaitingApproval
	if len(draft.OpenQuestions) > 0 {
		result.Questions = append([]string(nil), draft.OpenQuestions...)
		result.Status = store.StatusNeedsInfo
	}
	return result, nil
}

// InvestigateRequest supplies an issue and run-wide accounting, if any.
type InvestigateRequest struct {
	Title, Body string
	Session     *Session
	Limits      Limits
}

// ReportResult contains the investigation outcome and a redacted report.
type ReportResult struct {
	Outcome
	ReportMD string
}

// Investigate explores read-only and returns a report for the runner to publish.
func (l *Loop) Investigate(ctx context.Context, req InvestigateRequest) (ReportResult, error) {
	stage := *l
	var err error
	stage.tools, err = newInvestigateRegistry(stage.Env)
	if err != nil {
		return ReportResult{}, &Error{Kind: "internal", Message: "build investigation tools failed"}
	}
	session := startStage(req.Session, investigatePrompt, issueData(stage.redactor().Redact(req.Title), stage.redactor().Redact(req.Body)))
	outcome, err := stage.Run(ctx, session, req.Limits)
	result := ReportResult{Outcome: outcome}
	if outcome.Submission != nil {
		result.ReportMD = outcome.Submission.Report
	}
	return result, err
}

// ChangeSource is implemented by gitx.Repo. Diff detection is a trusted harness
// operation; write-tool calls and the model's claims cannot establish changes.
type ChangeSource interface {
	HasChanges(context.Context) (bool, error)
}

// CodeRequest supplies trusted harness configuration. TestCommand is a policy
// command ID from repo configuration, never a command chosen by the model.
type CodeRequest struct {
	RunID       int64
	Title, Body string
	Changes     ChangeSource
	Baseline    string
	TestCommand string
	Session     *Session
	Limits      Limits
	// OnPhase runs after the approval checks and write registry construction,
	// before code or harness tests execute. A failed lifecycle write stops work.
	OnPhase func(context.Context, store.Phase) error
}

// CodeResult tells the runner whether there is anything to publish and whether
// it must be a draft. Only CanPublish permits publication. A non-nil error is
// retained even when salvage is allowed;
// the runner can publish only when Salvage explicitly permits it.
type CodeResult struct {
	Outcome
	NoChanges    bool
	CanPublish   bool
	Draft        bool
	Salvage      bool
	TestsStatus  string
	TestAttempts int
	LastTest     *execx.Result
}

// Code requires a private concrete capability produced by Check. It revalidates the
// capability before constructing any write tools. There is deliberately no
// overload accepting only a CodeRequest, and no approval boolean in that request.
func (l *Loop) Code(ctx context.Context, approval approvalToken, req CodeRequest) (CodeResult, error) {
	spec, err := validateApproval(ctx, approval, req.RunID, IssueHash(req.Title, req.Body))
	if err != nil {
		return CodeResult{}, err
	}
	draft, err := tools.ParseSpec(spec.BodyMD)
	if err != nil || draft.Hash() != spec.Hash || len(draft.OpenQuestions) != 0 {
		return CodeResult{}, fmt.Errorf("%w: approved spec content is invalid or has open questions", ErrApprovalDenied)
	}
	if req.Changes == nil {
		return CodeResult{}, &Error{Kind: "internal", Message: "code requires harness change detection"}
	}
	stage := *l
	stage.tools, err = newCodeRegistry(ctx, approval, stage.Env, req.RunID, IssueHash(req.Title, req.Body), draft.AcceptanceCriteria)
	if err != nil {
		return CodeResult{}, err
	}
	session := startStage(req.Session, codePrompt, issueData(stage.redactor().Redact(req.Title), stage.redactor().Redact(req.Body))+"\nApproved specification:\n"+untrusted("approved specification", stage.redactor().Redact(spec.BodyMD)))
	if req.Baseline != "" {
		feedback(session, untrusted("harness baseline tests", stage.redactor().Redact(req.Baseline)))
	}
	lim := req.Limits.defaults()
	result := CodeResult{TestsStatus: "not_run"}
	for {
		if req.OnPhase != nil {
			if err := req.OnPhase(ctx, store.PhaseCode); err != nil {
				return result, err
			}
		}
		result.CanPublish, result.Salvage, result.Draft = false, false, false
		outcome, loopErr := stage.Run(ctx, session, lim)
		if outcome.Synthesized && outcome.Submission != nil {
			for _, text := range draft.AcceptanceCriteria {
				outcome.Submission.Criteria = append(outcome.Submission.Criteria, tools.CriterionResult{Text: text, Note: "No structured assessment was submitted."})
			}
			outcome.Submission = outcome.Submission.Redacted(stage.redactor())
		}
		result.Outcome = outcome
		if ctx.Err() != nil {
			return result, ctx.Err()
		}
		if !salvageable(outcome, loopErr) {
			return result, loopErr
		}
		changed, err := req.Changes.HasChanges(ctx)
		if err != nil {
			return result, &Error{Kind: "internal", Message: "inspect working tree failed"}
		}
		if !changed {
			result.NoChanges = true
			return result, loopErr
		}
		hardStop := loopErr != nil || outcome.Reason != EndSubmitted
		result.Draft = hardStop || outcome.Synthesized
		if outcome.Submission != nil {
			for _, criterion := range outcome.Submission.Criteria {
				if !criterion.Met {
					result.Draft = true
				}
			}
		}
		if req.TestCommand == "" {
			result.CanPublish, result.Salvage = true, hardStop
			result.Draft = true
			return result, loopErr
		}
		if req.OnPhase != nil {
			if err := req.OnPhase(ctx, store.PhaseVerify); err != nil {
				return result, err
			}
		}
		test, err := stage.verify(ctx, req.TestCommand, lim, result.TestAttempts+1)
		if err != nil {
			return result, err
		}
		result.TestAttempts++
		result.LastTest = &test
		// Test commands can modify or revert files, so re-inspect even on success.
		changed, err = req.Changes.HasChanges(ctx)
		if err != nil {
			return result, &Error{Kind: "internal", Message: "inspect tested working tree failed"}
		}
		if !changed {
			result.NoChanges = true
			result.Draft, result.Salvage = false, false
			return result, loopErr
		}
		if test.ExitCode == 0 && !test.TimedOut {
			result.CanPublish, result.Salvage = true, hardStop
			result.TestsStatus = "passed"
			return result, loopErr
		}
		result.TestsStatus, result.Draft = "failed", true
		if hardStop || result.TestAttempts >= lim.MaxTestAttempts {
			result.CanPublish, result.Salvage = true, hardStop
			return result, loopErr
		}
		feedback(session, fmt.Sprintf("Harness tests failed (attempt %d of %d; exit code %d; timed out: %t). Repair the patch, then submit again.\n%s", result.TestAttempts, lim.MaxTestAttempts, test.ExitCode, test.TimedOut, boundedUntrusted("test output", tools.CapOutput(test.Output, 8<<10), 8<<10)))
	}
}

func salvageable(outcome Outcome, err error) bool {
	if errors.Is(err, context.Canceled) || errors.Is(err, context.DeadlineExceeded) || outcome.Reason == EndRefusal {
		return false
	}
	if err == nil {
		return true
	}
	var classified *Error
	if !errors.As(err, &classified) {
		return false
	}
	// Safety/integrity and harness failures require local diagnostics, not a patch.
	return classified.Kind == "provider_unavailable" || classified.Kind == "context_overflow" || classified.Kind == "provider_malformed" || classified.Kind == "provider_bad_request"
}

func (l *Loop) verify(ctx context.Context, command string, lim Limits, attempt int) (execx.Result, error) {
	start := l.now()
	result, err := tools.ExecuteCommand(ctx, l.Env, command, nil, lim.TestTimeout)
	finish := l.now()
	duration, exit := finish.Sub(start).Milliseconds(), int64(result.ExitCode)
	input, _ := json.Marshal(map[string]any{"command": command, "attempt": attempt})
	status := "ok"
	if err != nil || result.ExitCode != 0 || result.TimedOut {
		status = "error"
	}
	step := store.Step{Kind: "test", Phase: store.PhaseVerify, Tool: command, Status: status, InputJSON: string(input), OutputText: result.Output, ExitCode: &exit, StartedAt: start, FinishedAt: &finish, DurationMS: &duration}
	if e := l.record(ctx, step); e != nil {
		return result, e
	}
	if e := l.event(ctx, "test.result", map[string]any{"attempt": attempt, "passed": status == "ok", "exit_code": exit, "timed_out": result.TimedOut, "output": tools.CapOutput(result.Output, 8<<10)}); e != nil {
		return result, e
	}
	if ctx.Err() != nil {
		return result, ctx.Err()
	}
	if err != nil {
		return result, &Error{Kind: "internal", Message: "harness test execution failed"}
	}
	return result, nil
}
package agent

import (
	"context"
	"crypto/sha256"
	"encoding/json"
	"errors"
	"fmt"
	"math"
	"time"

	"github.com/aryanpappu/patchbot/internal/llm"
	"github.com/aryanpappu/patchbot/internal/store"
	"github.com/aryanpappu/patchbot/internal/tools"
)

const compactedOutput = "[output removed to save context; call the tool again if needed]"

type limitError struct{ reason EndReason }

func (e *limitError) Error() string { return string(e.reason) }

type attemptProvider struct {
	llm.Provider
	chat func(context.Context, llm.ChatRequest) (*llm.ChatResponse, error)
}

func (p attemptProvider) Chat(ctx context.Context, req llm.ChatRequest) (*llm.ChatResponse, error) {
	return p.chat(ctx, req)
}

// Run drives a session until submission or a bounded stop. Re-entry after test
// failure retains accounting, turn counts, overflow recovery and stuck state.
// The caller supplies a raw provider; this is the sole retry layer.
func (l *Loop) Run(ctx context.Context, s *Session, lim Limits) (Outcome, error) {
	if err := ctx.Err(); err != nil {
		return Outcome{}, err
	}
	if s == nil || l.Provider == nil || l.tools == nil || l.Model == "" {
		return Outcome{}, &Error{Kind: "internal", Message: "loop requires a session, provider, model and tools"}
	}
	lim = lim.defaults()
	if lim.Deadline.IsZero() {
		if s.deadline.IsZero() {
			s.deadline = l.now().Add(30 * time.Minute)
		}
		lim.Deadline = s.deadline
	}
	l.initialize(s)
	priceKey := l.Provider.Name() + "\x00" + l.Model
	if s.priceWarningKey != priceKey {
		s.priceWarningKey = priceKey
		if _, known := l.Pricing.Price(l.Model); !known {
			s.Unpriced = true
			if err := l.event(ctx, "log", map[string]any{"level": "warn", "message": "Model price is unknown; only the token budget applies."}); err != nil {
				return Outcome{}, err
			}
		}
	}
	if reason := l.bounds(ctx, s, lim); reason != "" {
		return Outcome{Reason: reason}, nil
	}
	callCtx, cancel := stageContext(ctx, lim.Deadline, l.now())
	defer cancel()
	provider := llm.WithRetry(attemptProvider{Provider: l.Provider, chat: func(c context.Context, _ llm.ChatRequest) (*llm.ChatResponse, error) {
		return l.attempt(c, s, lim)
	}}, l.RetryPolicy, l.RetryClock)
	malformedErrors := 0
	for {
		resp, err := provider.Chat(callCtx, llm.ChatRequest{})
		if ctx.Err() != nil {
			return Outcome{}, ctx.Err()
		}
		if err != nil {
			var limit *limitError
			if errors.As(err, &limit) {
				return Outcome{Reason: limit.reason}, nil
			}
			if callCtx.Err() != nil {
				return Outcome{Reason: EndDeadline}, nil
			}
			kind, _ := llm.KindOf(err)
			switch {
			case kind == llm.ErrContextTooLong && !s.contextCompacted:
				s.contextCompacted = true
				compact(s.Messages, 3)
				if e := l.event(ctx, "log", map[string]string{"level": "warn", "message": "Context overflow: compacting history and retrying once."}); e != nil {
					return Outcome{}, e
				}
				continue
			case kind == llm.ErrMalformed && malformedErrors == 0:
				malformedErrors++
				continue
			default:
				return Outcome{}, l.classify(err)
			}
		}
		malformedErrors = 0
		outcome, done, err := l.consume(callCtx, s, resp)
		if ctx.Err() != nil {
			return Outcome{}, ctx.Err()
		}
		if callCtx.Err() != nil {
			return Outcome{Reason: EndDeadline}, nil
		}
		if err != nil || done {
			return outcome, err
		}
	}
}

func (l *Loop) initialize(s *Session) {
	if !s.initialized {
		if s.Usage == nil && !s.AccountingUncertain {
			s.Usage = &llm.Usage{}
		}
		s.Tokens = max(s.Tokens, s.Usage.Total())
		s.Cost = max(s.Cost, 0)
		s.initialized = true
	}
	s.System = l.redactor().Redact(s.System)
	redactConversation(s.Messages, l.redactor())
}

func (l *Loop) bounds(ctx context.Context, s *Session, lim Limits) EndReason {
	if ctx.Err() != nil {
		return EndDeadline
	}
	if !lim.Deadline.IsZero() && !l.now().Before(lim.Deadline) {
		return EndDeadline
	}
	if s.Turns-s.turnBase >= lim.MaxTurns {
		return EndMaxTurns
	}
	return ""
}

func (l *Loop) attempt(ctx context.Context, s *Session, lim Limits) (*llm.ChatResponse, error) {
	if reason := l.bounds(ctx, s, lim); reason != "" {
		return nil, &limitError{reason}
	}
	redactConversation(s.Messages, l.redactor())
	req := llm.ChatRequest{Model: l.Model, System: s.System, Messages: s.Messages, Tools: l.tools.Specs(), MaxTokens: lim.MaxOutputTokens}
	// One token per serialized byte, plus envelope overhead, is a conservative
	// first-call estimate without depending on any provider's tokenizer. Never
	// reserve less than the last reported input, including cached input.
	raw, err := json.Marshal(req)
	if err != nil {
		return nil, &Error{Kind: "internal", Message: "request encoding failed"}
	}
	input := max(s.LastInputTokens, int64(len(raw))+256)
	tokens := add(input, int64(lim.MaxOutputTokens))
	reserve, priced := l.Pricing.Reserve(l.Model, input, int64(lim.MaxOutputTokens))
	if exceeds(s.Tokens, tokens, lim.MaxTotalTokens) || (priced && lim.MaxCostMicros > 0 && exceeds(s.Cost, reserve, lim.MaxCostMicros)) {
		return nil, &limitError{EndBudget}
	}
	if lim.ContextWindow > 0 && s.LastInputTokens > int64(lim.ContextWindow)*7/10 {
		compact(s.Messages, 6)
	}
	req.Messages = s.Messages
	if err := req.Validate(); err != nil {
		return nil, &Error{Kind: "internal", Message: "invalid conversation or tool definitions"}
	}
	start := l.now()
	// Clone so neither a provider nor later compaction can mutate past requests.
	resp, callErr := l.Provider.Chat(ctx, req.Clone())
	s.Turns++
	var usage *llm.Usage
	if resp != nil {
		usage = resp.Usage
	}
	cost, known := l.Pricing.Cost(l.Model, usage)
	if usage == nil {
		s.AccountingUncertain = true
		s.Usage = nil
		s.Tokens = add(s.Tokens, tokens)
		if priced {
			s.Cost = add(s.Cost, reserve)
		}
	} else {
		s.Usage = s.Usage.Add(usage)
		s.Tokens = add(s.Tokens, usage.Total())
		s.LastInputTokens = add(add(usage.InputTokens, usage.CacheReadTokens), usage.CacheWriteTokens)
		if known {
			s.Cost = add(s.Cost, cost)
		}
	}
	if callErr == nil {
		callErr = l.validateResponse(s, resp)
	}
	finish := l.now()
	duration, turn := finish.Sub(start).Milliseconds(), int64(s.Turns)
	inputJSON, _ := json.Marshal(map[string]any{"model": l.Model, "messages": recordedMessages(req.Messages, l.redactor()), "reserved_tokens": tokens, "reserved_cost_micros": reserve, "usage_missing": usage == nil})
	step := store.Step{Kind: "llm", Tool: "chat", Status: "ok", Turn: &turn, InputJSON: string(inputJSON), StartedAt: start, FinishedAt: &finish, DurationMS: &duration}
	if known {
		step.CostMicros = &cost
	}
	if usage != nil {
		step.InputTokens, step.OutputTokens = &usage.InputTokens, &usage.OutputTokens
		step.CacheReadTokens, step.CacheWriteTokens = &usage.CacheReadTokens, &usage.CacheWriteTokens
	}
	if resp != nil {
		step.StopReason = string(resp.StopReason)
		out, _ := json.Marshal(recordedMessages([]llm.Message{resp.Message}, l.redactor()))
		step.OutputText = redactJSON(out, l.redactor())
	}
	if callErr != nil {
		step.Status = "error"
		step.OutputText = llm.SafeText(callErr)
	}
	if err := l.record(ctx, step); err != nil {
		return nil, err
	}
	if err := l.event(ctx, "llm.response", map[string]any{"turn": s.Turns, "stop_reason": step.StopReason, "response": step.OutputText, "error": callErr != nil}); err != nil {
		return nil, err
	}
	if err := l.event(ctx, "usage", map[string]any{"turn": s.Turns, "usage": usage, "cost_micros": step.CostMicros, "total_cost_micros": s.Cost, "total_tokens": s.Tokens, "accounting_uncertain": s.AccountingUncertain, "unpriced": s.Unpriced}); err != nil {
		return nil, err
	}
	if callErr != nil {
		return nil, callErr
	}
	return resp, nil
}

func (l *Loop) validateResponse(s *Session, resp *llm.ChatResponse) error {
	if resp == nil {
		return &llm.Error{Kind: llm.ErrMalformed, Message: "empty provider response"}
	}
	msg := replyMessage(resp)
	for _, call := range msg.ToolCalls() {
		if err := tools.ValidateToolIdentifiers(call); err != nil || l.redactor().Redact(call.Name) != call.Name {
			return &llm.Error{Kind: llm.ErrMalformed, Message: "unsafe tool identifiers"}
		}
	}
	candidate := append(llm.CloneMessages(s.Messages), msg)
	redactConversation(candidate, l.redactor())
	if msg.Role != llm.RoleAssistant || llm.Validate(candidate) != nil {
		return &llm.Error{Kind: llm.ErrMalformed, Message: "invalid assistant response"}
	}
	return nil
}

func replyMessage(resp *llm.ChatResponse) llm.Message {
	msg := resp.Message.Clone()
	// A truncated or refused action is never executable, even when its JSON
	// happens to parse. Keep text and provider metadata unchanged.
	if resp.StopReason == llm.StopMaxTokens || resp.StopReason == llm.StopRefusal {
		msg = withoutCalls(msg)
	}
	if len(msg.Parts) == 0 {
		msg.Parts = []llm.Part{llm.Text("[empty model reply]")}
	}
	return msg
}

func (l *Loop) consume(ctx context.Context, s *Session, resp *llm.ChatResponse) (Outcome, bool, error) {
	defer func() { redactConversation(s.Messages, l.redactor()) }()
	msg := replyMessage(resp)
	s.Messages = append(s.Messages, msg)
	if resp.StopReason == llm.StopRefusal {
		return Outcome{Reason: EndRefusal}, true, nil
	}
	calls := msg.ToolCalls()
	if len(calls) > 0 {
		s.endTurns, s.malformed = 0, 0
		return l.dispatch(ctx, s, calls)
	}
	switch resp.StopReason {
	case llm.StopMaxTokens:
		s.endTurns, s.malformed = 0, 0
		feedback(s, "Your reply reached the output limit. No tool calls from it were executed. Use smaller edits and try again.")
	case llm.StopEndTurn:
		s.malformed = 0
		s.endTurns++
		if s.endTurns >= 2 {
			submission := (&tools.Submission{Summary: msg.Text(), PRTitle: "Proposed change", Report: msg.Text()}).Redacted(l.redactor())
			return Outcome{Reason: EndSubmitted, Synthesized: true, Submission: submission}, true, nil
		}
		feedback(s, "Call the stage's terminal tool to finish, or continue working.")
	default:
		s.endTurns = 0
		s.malformed++
		if s.malformed >= 2 {
			return Outcome{}, false, &Error{Kind: "provider_malformed", Message: "two consecutive unusable model replies"}
		}
		feedback(s, "Your reply could not be processed. Try again using the available tools.")
	}
	return Outcome{}, false, nil
}

func (l *Loop) dispatch(ctx context.Context, s *Session, calls []llm.ToolCall) (Outcome, bool, error) {
	results := llm.Message{Role: llm.RoleTool}
	var submission *tools.Submission
	var stop bool
	var dispatchErr error
	warn := false
	for _, call := range calls {
		call.ID = redactIdentifier(call.ID, l.redactor())
		start := l.now()
		eventArgs, argsErr := jsonValue(call.Args)
		if argsErr != nil {
			eventArgs = string(call.Args)
		}
		if err := l.event(ctx, "tool.call", map[string]any{"turn": s.Turns, "call_id": call.ID, "name": call.Name, "args": eventArgs}); err != nil {
			return Outcome{}, false, err
		}
		var detail tools.Result
		var result llm.ToolResult
		var err error
		// Finish the call/result group even when a terminal call appears before its
		// siblings. Calls after completion or a stop receive an explicit skipped result.
		if submission != nil || stop || dispatchErr != nil {
			result = llm.ToolResult{CallID: call.ID, Name: call.Name, Content: "Skipped: the stage has already ended.", IsError: true}
			detail = tools.Result{Content: result.Content, RecordOutput: result.Content, IsError: true}
		} else {
			result, detail, err = l.tools.DispatchDetailed(ctx, call)
			if err != nil {
				result = llm.ToolResult{CallID: call.ID, Name: call.Name, Content: "Tool execution failed in the harness.", IsError: true}
				detail = tools.Result{IsError: true, RecordOutput: result.Content}
				dispatchErr = &Error{Kind: "internal", Message: "tool execution failed"}
			}
			if detail.Submission != nil {
				submission = detail.Submission
			}
			if detail.SecurityDenied {
				s.denials++
				if eventErr := l.event(ctx, "security.denied", map[string]any{"tool": call.Name, "reason": detail.Content}); eventErr != nil {
					return Outcome{}, false, eventErr
				}
				if s.denials >= 5 {
					dispatchErr = &Error{Kind: "policy_violations", Message: "five tool policy denials"}
				}
			}
			hash := callHash(call)
			if hash == s.stuckHash {
				s.stuckCount++
			} else {
				s.stuckHash, s.stuckCount = hash, 1
			}
			if s.stuckCount == 3 {
				warn = true
			}
			if s.stuckCount >= 4 {
				stop = true
			}
		}
		finish, turn := l.now(), int64(s.Turns)
		duration := finish.Sub(start).Milliseconds()
		status := "ok"
		if result.IsError || err != nil {
			status = "error"
		}
		var exit *int64
		if detail.ExitCode != nil {
			value := int64(*detail.ExitCode)
			exit = &value
		}
		step := store.Step{Kind: "tool", Tool: call.Name, Status: status, Turn: &turn, InputJSON: string(call.Args), OutputText: detail.RecordOutput, ExitCode: exit, StartedAt: start, FinishedAt: &finish, DurationMS: &duration}
		if e := l.record(ctx, step); e != nil {
			return Outcome{}, false, e
		}
		if e := l.event(ctx, "tool.result", map[string]any{"turn": s.Turns, "result": result, "timed_out": detail.TimedOut, "exit_code": exit}); e != nil {
			return Outcome{}, false, e
		}
		// Tool payloads may contain malicious instructions. JSON string encoding
		// keeps fake closing delimiters inside the untrusted payload.
		if call.Name == "run_cmd" {
			result.Content = boundedUntrusted("command output", result.Content, 8<<10)
		} else {
			result.Content = untrusted("tool output", result.Content)
		}
		results.Parts = append(results.Parts, llm.Result(result.CallID, result.Name, result.Content, result.IsError))
	}
	s.Messages = append(s.Messages, results)
	if dispatchErr != nil {
		return Outcome{}, false, dispatchErr
	}
	if submission != nil {
		return Outcome{Reason: EndSubmitted, Submission: submission}, true, nil
	}
	if stop {
		return Outcome{Reason: EndStuck}, true, nil
	}
	if warn {
		feedback(s, "The same tool call has repeated three times. Change your approach; another identical call will stop this stage.")
	}
	return Outcome{}, false, nil
}

func compact(messages []llm.Message, keepTurns int) {
	cutoff := len(messages)
	for i := len(messages) - 1; i >= 0; i-- {
		if messages[i].Role == llm.RoleAssistant {
			keepTurns--
			if keepTurns < 0 {
				cutoff = i + 1
				break
			}
			cutoff = i
		}
	}
	if keepTurns >= 0 {
		return
	}
	for i := 0; i <= cutoff && i < len(messages); i++ {
		for j := range messages[i].Parts {
			part := &messages[i].Parts[j]
			if part.Type == llm.PartToolResult && part.ToolResult != nil {
				part.ToolResult.Content = compactedOutput
			}
		}
	}
}

func withoutCalls(msg llm.Message) llm.Message {
	parts := msg.Parts[:0]
	for _, part := range msg.Parts {
		if part.Type == llm.PartToolCall {
			continue
		}
		if part.Type == llm.PartOpaque {
			// Adapters may preserve an incomplete action as an opaque block.
			// Inspect only its discriminator, retaining thinking and signatures.
			var block struct {
				Type string `json:"type"`
			}
			if json.Unmarshal(part.ProviderMeta, &block) == nil && block.Type == "tool_use" {
				continue
			}
		}
		parts = append(parts, part)
	}
	msg.Parts = parts
	return msg
}

func feedback(s *Session, text string) {
	if len(s.Messages) > 0 && s.Messages[len(s.Messages)-1].Role == llm.RoleUser {
		last := &s.Messages[len(s.Messages)-1]
		last.Parts = append(last.Parts, llm.Text(text))
	} else {
		s.Messages = append(s.Messages, llm.UserText(text))
	}
}

func callHash(call llm.ToolCall) [32]byte {
	raw := call.Args
	if args, err := jsonValue(raw); err == nil {
		raw, _ = json.Marshal(args)
	}
	return sha256.Sum256(append([]byte(call.Name+"\x00"), raw...))
}

func add(a, b int64) int64 {
	if b > 0 && a > math.MaxInt64-b {
		return math.MaxInt64
	}
	return a + b
}
func exceeds(spent, reserve, capValue int64) bool {
	return spent > capValue || reserve > capValue-spent
}

func (l *Loop) classify(err error) error {
	var internal *Error
	if errors.As(err, &internal) {
		return internal
	}
	kind, _ := llm.KindOf(err)
	name := "provider_unavailable"
	switch kind {
	case llm.ErrAuth:
		name = "provider_auth"
	case llm.ErrContextTooLong:
		name = "context_overflow"
	case llm.ErrBadRequest:
		name = "provider_bad_request"
	case llm.ErrMalformed:
		name = "provider_malformed"
	}
	return &Error{Kind: name, Message: l.redactor().Redact(llm.SafeText(err))}
}

// untrusted uses a JSON string so delimiter-like source text remains escaped.
func untrusted(kind, data string) string {
	raw, _ := json.Marshal(data)
	return fmt.Sprintf("<untrusted_data kind=%q encoding=\"json-string\">\n%s\n</untrusted_data>", kind, raw)
}

// Keep the encoded command payload, including its framing, within the model
// output cap. Escaped control characters can be larger than their source bytes.
func boundedUntrusted(kind, data string, limit int) string {
	encoded := untrusted(kind, data)
	for len(encoded) > limit && len(data) > 0 {
		next := max(0, len(data)-max(1, (len(encoded)-limit)*len(data)/len(encoded)))
		data = tools.CapOutput(data, next)
		encoded = untrusted(kind, data)
	}
	return encoded
}

func redactConversation(messages []llm.Message, redactor interface{ Redact(string) string }) {
	for i := range messages {
		for j := range messages[i].Parts {
			part := &messages[i].Parts[j]
			switch part.Type {
			case llm.PartText:
				part.Text = redactor.Redact(part.Text)
			case llm.PartToolCall:
				if part.ToolCall != nil {
					part.ToolCall.ID = redactIdentifier(part.ToolCall.ID, redactor)
					part.ToolCall.Name = redactIdentifier(part.ToolCall.Name, redactor)
					value, err := jsonValue(part.ToolCall.Args)
					if _, object := value.(map[string]any); err == nil && object {
						// Redact string leaves without changing JSON numbers.
						part.ToolCall.Args, _ = json.Marshal(redactWith(value, redactor))
					} else {
						// Dispatch sees the original bad arguments and returns
						// an error. Later requests still require object Args.
						part.ToolCall.Args = json.RawMessage(`{}`)
					}
				}
			case llm.PartToolResult:
				if part.ToolResult != nil {
					part.ToolResult.CallID = redactIdentifier(part.ToolResult.CallID, redactor)
					part.ToolResult.Name = redactIdentifier(part.ToolResult.Name, redactor)
					part.ToolResult.Content = redactor.Redact(part.ToolResult.Content)
				}
			}
		}
	}
}

// A shared deterministic alias keeps call/result pairs and distinct sensitive
// identifiers intact. A plain redaction mask would collapse different call IDs.
func redactIdentifier(value string, redactor interface{ Redact(string) string }) string {
	if redactor.Redact(value) == value {
		return value
	}
	hash := sha256.Sum256([]byte(value))
	return fmt.Sprintf("redacted_%x", hash[:24])
}

func redactWith(value any, r interface{ Redact(string) string }) any {
	switch v := value.(type) {
	case string:
		return r.Redact(v)
	case []any:
		for i := range v {
			v[i] = redactWith(v[i], r)
		}
	case map[string]any:
		for k := range v {
			v[k] = redactWith(v[k], r)
		}
	}
	return value
}
package agent

import (
	"bytes"
	"context"
	"encoding/json"
	"errors"
	"time"

	"github.com/aryanpappu/patchbot/internal/llm"
	"github.com/aryanpappu/patchbot/internal/secret"
	"github.com/aryanpappu/patchbot/internal/store"
	"github.com/aryanpappu/patchbot/internal/tools"
)

// Recorder receives bounded, redacted records only. A failed write stops the
// harness rather than letting paid or mutating work proceed without an audit.
type Recorder interface {
	Record(context.Context, store.Step) error
	Event(context.Context, string, json.RawMessage) error
}

// EventEmitter publishes an event after StoreRecorder has persisted its Seq.
// A live event bus should not block; SQLite remains the replay source.
type EventEmitter interface {
	Emit(context.Context, store.Event)
}

// RecordStore is the persistence subset used by StoreRecorder.
type RecordStore interface {
	RecordStep(context.Context, store.Step) (store.Step, error)
	AppendEvent(context.Context, store.Event) (int64, error)
}

// StoreRecorder adapts the store and an optional live emitter to Recorder.
type StoreRecorder struct {
	Store    RecordStore
	RunID    int64
	Phase    store.Phase
	Emitter  EventEmitter
	Redactor *secret.Redactor
}

// Record persists a step. The store also applies its own defense-in-depth caps.
func (r *StoreRecorder) Record(ctx context.Context, step store.Step) error {
	if r.Store == nil {
		return errors.New("recorder store is missing")
	}
	step.RunID = r.RunID
	if step.Phase == "" {
		step.Phase = r.Phase
	}
	redactStepMetadata(&step, r.Redactor)
	step.InputJSON = redactJSON([]byte(step.InputJSON), r.Redactor)
	step.OutputText = redactJSON([]byte(step.OutputText), r.Redactor)
	_, err := r.Store.RecordStep(ctx, step)
	return err
}

// Event persists a replayable event before notifying the live emitter.
func (r *StoreRecorder) Event(ctx context.Context, kind string, data json.RawMessage) error {
	if r.Store == nil {
		return errors.New("recorder store is missing")
	}
	event := store.Event{RunID: r.RunID, Type: tools.CapOutput(kind, 256), PayloadJSON: json.RawMessage(redactJSON(data, r.Redactor)), CreatedAt: time.Now().UTC()}
	seq, err := r.Store.AppendEvent(ctx, event)
	if err != nil {
		return err
	}
	event.Seq = seq
	if r.Emitter != nil {
		r.Emitter.Emit(ctx, event)
	}
	return nil
}

func (l *Loop) record(ctx context.Context, step store.Step) error {
	if l.Recorder == nil {
		return nil
	}
	step.InputJSON = tools.CapOutput(redactJSON([]byte(step.InputJSON), l.redactor()), 16<<10)
	capBytes := 64 << 10
	if step.Kind == "test" || step.Tool == "run_cmd" {
		capBytes = 256 << 10
	}
	redactStepMetadata(&step, l.redactor())
	step.OutputText = tools.CapOutput(redactJSON([]byte(step.OutputText), l.redactor()), capBytes)
	recordCtx, cancel := context.WithTimeout(context.WithoutCancel(ctx), 5*time.Second)
	defer cancel()
	if err := l.Recorder.Record(recordCtx, step); err != nil {
		return &Error{Kind: "internal", Message: "recording step failed"}
	}
	return nil
}

func (l *Loop) event(ctx context.Context, kind string, data any) error {
	if l.Recorder == nil {
		return nil
	}
	raw, err := json.Marshal(data)
	if err != nil {
		return &Error{Kind: "internal", Message: "encoding event failed"}
	}
	safe := redactJSON(raw, l.redactor())
	// Keep a valid JSON payload when capping large response events.
	if len(safe) > 16<<10 {
		raw, _ = json.Marshal(tools.CapOutput(safe, 16<<10))
		safe = string(raw)
	}
	recordCtx, cancel := context.WithTimeout(context.WithoutCancel(ctx), 5*time.Second)
	defer cancel()
	if err := l.Recorder.Event(recordCtx, tools.CapOutput(kind, 256), json.RawMessage(safe)); err != nil {
		return &Error{Kind: "internal", Message: "recording event failed"}
	}
	return nil
}

// Phase, Kind, Status and event types are harness schema identifiers.
// Tool and StopReason can originate in provider responses.
func redactStepMetadata(step *store.Step, redactor *secret.Redactor) {
	step.Tool = tools.CapOutput(redactor.Redact(step.Tool), 256)
	step.StopReason = tools.CapOutput(redactor.Redact(step.StopReason), 256)
}

func redactJSON(raw []byte, redactor *secret.Redactor) string {
	value, err := jsonValue(raw)
	if err != nil {
		return redactor.Redact(string(raw))
	}
	value = redactStrings(value, redactor)
	safe, _ := json.Marshal(value)
	return string(safe)
}

func redactStrings(value any, redactor *secret.Redactor) any {
	switch x := value.(type) {
	case string:
		return redactor.Redact(x)
	case []any:
		for i := range x {
			x[i] = redactStrings(x[i], redactor)
		}
	case map[string]any:
		out := make(map[string]any, len(x))
		for key, v := range x {
			text, isString := v.(string)
			if isString && store.IsSchemaIdentifier(key, text) {
				out[key] = v
			} else {
				out[key] = redactStrings(v, redactor)
			}
		}
		return out
	}
	return value
}

// recordedMessages omits opaque provider data from records. It remains intact
// in the live conversation for provider signatures and thinking round trips.
func recordedMessages(messages []llm.Message, redactor *secret.Redactor) []llm.Message {
	out := llm.CloneMessages(messages)
	for i := range out {
		parts := out[i].Parts[:0]
		for _, part := range out[i].Parts {
			if part.Type == llm.PartOpaque {
				continue
			}
			part.ProviderMeta = nil
			if part.ToolCall != nil {
				part.ToolCall.ID = redactIdentifier(part.ToolCall.ID, redactor)
				part.ToolCall.Name = redactIdentifier(part.ToolCall.Name, redactor)
			}
			if part.ToolResult != nil {
				part.ToolResult.CallID = redactIdentifier(part.ToolResult.CallID, redactor)
				part.ToolResult.Name = redactIdentifier(part.ToolResult.Name, redactor)
			}
			if part.ToolCall != nil && !json.Valid(part.ToolCall.Args) {
				part.ToolCall.Args, _ = json.Marshal(string(part.ToolCall.Args))
			}
			parts = append(parts, part)
		}
		out[i].Parts = parts
	}
	return out
}

// Keep JSON numbers exact when redacting or hashing provider-controlled data.
func jsonValue(raw []byte) (any, error) {
	if !json.Valid(raw) {
		return nil, errors.New("invalid JSON")
	}
	decoder := json.NewDecoder(bytes.NewReader(raw))
	decoder.UseNumber()
	var value any
	err := decoder.Decode(&value)
	return value, err
}

