export function icon(name, size = 16) {
  return h("svg", {
    class: "icon", width: size, height: size, viewBox: "0 0 24 24", fill: "none", stroke: "currentColor",
    "stroke-width": 2, "stroke-linecap": "round", "stroke-linejoin": "round", "aria-hidden": "true", focusable: "false"
  }, (paths[name] || paths.dots).map(d => h("path", { d })));
}

export const chip = status => {
  const meta = statusMeta[status];
  return h("span", { class: "chip s-" + (meta ? status : "unknown") }, [icon(meta ? meta.icon : "dots", 14), meta ? meta.label : human(status)]);
};

export function button(label, click, options = {}) {
  const { disabled = false, kind = "", icon: iconName = "", type = "button", title, ariaLabel, pressed } = options;
  return h("button", {
    type, class: "btn" + (kind ? " " + kind : ""), onClick: click, disabled, title, "aria-label": ariaLabel,
    "aria-pressed": pressed == null ? undefined : String(pressed)
  }, [iconName ? icon(iconName, 16) : null, label]);
}

export const field = (label, control, hint) => h("label", { class: "field" }, [h("span", label), control, hint ? h("small", hint) : null]);
export const input = (object, key, attributes = {}) => h("input", {
  ...attributes, value: object[key], onInput: event => { object[key] = event.target.value; }
});
export const area = (object, key, attributes = {}) => h("textarea", {
  rows: 4, ...attributes, value: object[key], onInput: event => { object[key] = event.target.value; }
});
export const select = (object, key, options, change) => h("select", {
  value: object[key], onChange: event => { object[key] = event.target.value; if (change) change(); }
}, options.map(([value, label]) => h("option", { value, selected: value === object[key] }, label)));
export const checkbox = (object, key, label) => h("label", { class: "check" }, [
  h("input", { type: "checkbox", checked: !!object[key], onChange: event => { object[key] = event.target.checked; } }), label]);

export const panel = (title, children, attributes = {}) => h("section", { class: "panel", ...attributes }, [title ? h("h2", title) : null, ...children]);

// block renders untrusted text in a keyboard-scrollable monospace panel.
export const block = (value, label) => h("pre", { class: "output", tabindex: 0, "aria-label": label }, text(value));

// link makes an anchor only for validated http(s) URLs; anything else is text.
export const link = (url, label) => {
  const href = linkHref(url);
  return href ? h("a", { href, target: "_blank", rel: "noopener noreferrer" }, [label, icon("external", 12)]) : h("span", label);
};

export const loading = (label = "Loading…") => h("p", { class: "state", role: "status" }, [icon("spinner", 16), label]);
export const empty = (title, next, action) => h("div", { class: "state empty" }, [h("p", h("strong", title)), next ? h("p", { class: "muted" }, next) : null, action || null]);
export const errorPanel = (message, retry) => h("div", { class: "alert", role: "alert" }, [
  icon("warn", 16), h("div", [h("p", message), retry ? button("Try again", retry) : null])]);

// meter shows used/limit as text and a bar; unknown values stay "unknown".
export function meter(label, used, limit, show) {
  const known = used != null && limit != null;
  const pct = known ? Math.min(100, Math.round(used / limit * 100)) : 0;
  return h("div", { class: "meter" }, [
    h("div", { class: "meter-head" }, [h("span", label), h("strong", show(used) + (limit != null ? " of " + show(limit) : " (limit unknown)"))]),
    known ? h("progress", { class: pct >= 90 ? "hot" : "", max: 100, value: pct, "aria-label": label + " used" }, pct + "%") : null
  ]);
}
// Entry point, loaded as <script type="module"> from this origin after the
// pinned Vue global build. Shared services are created once here and handed to
// components with provide-free props (ctx), so there are no mutable globals.
import { useApi } from "./composables/useApi.js";
import { useBadges } from "./composables/useBadges.js";
import { useConfirm } from "./composables/useConfirm.js";
import { useProviders } from "./composables/useProviders.js";
import { useSession } from "./composables/useSession.js";
import { useTheme } from "./composables/useTheme.js";
import { useToast } from "./composables/useToast.js";
import { App } from "./components/App.js";

const { createApp } = window.Vue;
const initial = JSON.parse(document.getElementById("state").textContent);
const api = useApi(!!initial.auth_required);
const ctx = {
  initial, api, shortcuts: {}, openHelp: () => {},
  session: useSession(api, initial.email), toast: useToast(), theme: useTheme(), confirm: useConfirm(),
  badges: useBadges(api), providers: useProviders(api)
};
createApp(App, { ctx }).mount("#app");
// The single fetch helper. In token mode the bearer token lives only in
// sessionStorage and a closure; in Access mode there is no credential at all.
const { reactive } = window.Vue;
const storageKey = "patchbot.ui-token";

export function useApi(authRequired) {
  let token = "";
  try { token = sessionStorage.getItem(storageKey) || ""; } catch { /* The unlock form explains storage failures. */ }
  const state = reactive({ authRequired, locked: authRequired && !token });
  const listeners = [];

  const headers = (extra = {}) => token ? { ...extra, Authorization: "Bearer " + token } : extra;

  function forget() {
    token = "";
    try { sessionStorage.removeItem(storageKey); } catch { /* No persistent fallback. */ }
    state.locked = true;
    for (const listener of listeners) listener();
  }

  // unlock stores a token for this tab only. It throws when storage is blocked.
  function unlock(value) {
    const candidate = value.trim();
    if (!candidate) throw new Error("Enter the UI token.");
    try { sessionStorage.setItem(storageKey, candidate); }
    catch { throw new Error("Enable session storage to use token authentication in this tab."); }
    token = candidate;
    state.locked = false;
  }

  async function request(path, options = {}, plain = false) {
    const response = await fetch(path, { ...options, credentials: "same-origin", headers: headers(options.headers) });
    if (response.status === 401) {
      if (state.authRequired) forget();
      throw new Error(state.authRequired ? "Enter the UI token to continue." : "Sign in through Cloudflare Access to continue.");
    }
    if (!response.ok) {
      let message = `Request failed (${response.status}).`;
      let failure = null;
      try { failure = await response.json(); message = failure.error?.message || message; } catch { /* Use the status if the body is not JSON. */ }
      throw Object.assign(new Error(message), { body: failure, status: response.status });
    }
    return plain ? response.text() : response.json();
  }

  const send = (path, body, method = "POST") => request(path, {
    method, headers: { "Content-Type": "application/json" }, body: JSON.stringify(body)
  });

  return { state, request, send, headers, forget, unlock, onForget: listener => { listeners.push(listener); } };
}
// Sidebar badge counts and the `(n) patchbot` tab title. Counts come from the
// existing list API (all pages), never from the current list filter.
const { reactive } = window.Vue;

export function useBadges(api) {
  const state = reactive({ inbox: null, running: null, memory: null });

  async function countStatus(status) {
    let cursor = "", total = 0;
    do {
      const q = new URLSearchParams({ status, limit: "500" });
      if (cursor) q.set("cursor", cursor);
      const page = await api.request("/api/runs?" + q);
      total += page.runs.length;
      cursor = page.next_cursor;
    } while (cursor && !api.state.locked);
    return total;
  }

  function title() {
    document.title = state.inbox ? `(${state.inbox}) patchbot` : "patchbot";
  }

  async function refresh() {
    if (api.state.locked) return;
    try {
      const [waiting, info, running, memory] = await Promise.all([
        countStatus("awaiting_approval"), countStatus("needs_info"), countStatus("running"),
        api.request("/api/memory?status=pending").catch(() => null)
      ]);
      state.inbox = waiting + info;
      state.running = running;
      state.memory = memory ? (memory.entries || []).length : null;
    } catch { /* Badges are best effort; the page shows its own errors. */ }
    title();
  }
  function clear() { state.inbox = state.running = state.memory = null; title(); }
  return { state, refresh, clear };
}
// Promise-based confirmation. ConfirmDialog renders `state`; callers await ask().
const { reactive } = window.Vue;

export function useConfirm() {
  const state = reactive({ open: false, title: "", message: "", confirmLabel: "Confirm", danger: false, details: [] });
  let resolve = null;

  function ask(options) {
    if (resolve) resolve(false);
    Object.assign(state, { title: "", message: "", confirmLabel: "Confirm", danger: false, details: [] }, options, { open: true });
    return new Promise(done => { resolve = done; });
  }
  function answer(value) {
    state.open = false;
    const done = resolve;
    resolve = null;
    if (done) done(value);
  }
  return { state, ask, answer };
}
