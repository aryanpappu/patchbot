// Runs one async task at a time and keeps a visible error for it. Failures are
// never swallowed: they land in state.error, rendered as a role="alert" panel.
const { reactive } = window.Vue;

export function useTask() {
  const state = reactive({ busy: false, error: "" });
  async function run(task) {
    state.error = ""; state.busy = true;
    try { return await task(); } catch (error) { state.error = error.message; return undefined; }
    finally { state.busy = false; }
  }
  return { state, run };
}
// Theme toggle. It only sets data-theme on <html>; the choice is a per-viewer
// convenience kept in localStorage, and the page works without it.
const { reactive } = window.Vue;
const key = "patchbot.theme";

export function useTheme() {
  const state = reactive({ theme: "" });
  const root = document.documentElement;
  try {
    const saved = localStorage.getItem(key);
    if (saved === "light" || saved === "dark") state.theme = saved;
  } catch { /* Storage may be blocked; follow the system theme. */ }
  if (state.theme) root.dataset.theme = state.theme;

  const effective = () => state.theme || (window.matchMedia?.("(prefers-color-scheme: dark)").matches ? "dark" : "light");
  function toggle() {
    state.theme = effective() === "dark" ? "light" : "dark";
    root.dataset.theme = state.theme;
    try { localStorage.setItem(key, state.theme); } catch { /* Not persisted. */ }
  }
  return { state, toggle, effective };
}
// Toasts: role="status" messages that dismiss themselves after 6 seconds.
const { reactive } = window.Vue;

export function useToast() {
  const state = reactive({ items: [] });
  const timers = new Map();
  let next = 1;

  function dismiss(id) {
    clearTimeout(timers.get(id));
    timers.delete(id);
    const index = state.items.findIndex(item => item.id === id);
    if (index >= 0) state.items.splice(index, 1);
  }
  function push(message, kind = "ok") {
    const id = next++;
    state.items.push({ id, message: String(message), kind });
    if (state.items.length > 4) dismiss(state.items[0].id);
    timers.set(id, setTimeout(() => dismiss(id), 6000));
  }
  function dispose() { for (const timer of timers.values()) clearTimeout(timer); timers.clear(); }
  return { state, push, dismiss, dispose };
}

