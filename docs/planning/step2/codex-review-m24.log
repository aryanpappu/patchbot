package server

import (
	"errors"
	"net/http"
	"strconv"
	"strings"

	"github.com/aryanpappu/patchbot/internal/repos"
	"github.com/aryanpappu/patchbot/internal/store"
)

// Repository management routes share the server's authentication (Access JWT
// or bearer token), host check, cross-origin protection and 1 MiB body limit.
// The actor is the verified Access email (else approval.local_actor), channel ui.
// Config-file repositories are listed but read-only.
func (s *Server) repoRoutes(mux *http.ServeMux) {
	mux.HandleFunc("/api/repos", s.reposCollection)
	mux.HandleFunc("/api/repos/{owner}/{name}", s.repoItem)
	mux.HandleFunc("/api/repos/{owner}/{name}/audit", s.repoAudit)
}

type repoBody struct {
	Name     string         `json:"name"`
	Version  int64          `json:"version"`
	Settings repos.Settings `json:"settings"`
}

func (s *Server) reposCollection(w http.ResponseWriter, r *http.Request) {
	if !s.method(w, r, http.MethodGet, http.MethodPost) {
		return
	}
	if r.Method == http.MethodGet {
		s.writeJSON(w, http.StatusOK, map[string]any{"repos": s.repos.List(), "container": s.cfg.Executor.Container()})
		return
	}
	var input repoBody
	if !s.decode(w, r, &input, false) {
		return
	}
	entry, err := s.repos.Add(r.Context(), input.Name, input.Settings, s.actor(r), "ui")
	if err != nil {
		s.repoError(w, err)
		return
	}
	w.Header().Set("Location", "/api/repos/"+entry.Name)
	s.writeJSON(w, http.StatusCreated, map[string]any{"repo": entry, "github": s.runner.CheckRepo(r.Context(), entry.Name)})
}

func (s *Server) repoItem(w http.ResponseWriter, r *http.Request) {
	if !s.method(w, r, http.MethodGet, http.MethodPut, http.MethodDelete) {
		return
	}
	name := r.PathValue("owner") + "/" + r.PathValue("name")
	switch r.Method {
	case http.MethodGet:
		entry, ok := s.repos.Get(name)
		if !ok {
			s.writeError(w, http.StatusNotFound, "not_found", "repository not found")
			return
		}
		s.writeJSON(w, http.StatusOK, map[string]any{"repo": entry})
	case http.MethodPut:
		var input repoBody
		if !s.decode(w, r, &input, false) {
			return
		}
		version, ok := ifMatch(r, input.Version)
		if !ok {
			s.writeError(w, http.StatusPreconditionRequired, "version_required", "send the version you edited (If-Match header or version field)")
			return
		}
		entry, err := s.repos.Update(r.Context(), name, input.Settings, version, s.actor(r), "ui")
		if err != nil {
			s.repoError(w, err)
			return
		}
		s.writeJSON(w, http.StatusOK, map[string]any{"repo": entry})
	default:
		version, _ := ifMatch(r, 0)
		if err := s.repos.Remove(r.Context(), name, version, s.actor(r), "ui"); err != nil {
			s.repoError(w, err)
			return
		}
		s.writeJSON(w, http.StatusOK, map[string]any{"removed": repos.Normalize(name)})
	}
}

// ifMatch reads the expected version from the If-Match header (an integer,
// optionally quoted) or, failing that, from fallback. ok is false when neither
// is a positive version.
func ifMatch(r *http.Request, fallback int64) (int64, bool) {
	if h := strings.Trim(strings.TrimSpace(r.Header.Get("If-Match")), `"`); h != "" {
		v, err := strconv.ParseInt(h, 10, 64)
		return v, err == nil && v > 0
	}
	return fallback, fallback > 0
}

func (s *Server) repoAudit(w http.ResponseWriter, r *http.Request) {
	if !s.method(w, r, http.MethodGet) {
		return
	}
	name := r.PathValue("owner") + "/" + r.PathValue("name")
	rows, err := s.repos.Audit(r.Context(), name)
	if err != nil {
		s.respondError(w, err)
		return
	}
	if len(rows) == 0 && !s.repos.Has(name) {
		s.writeError(w, http.StatusNotFound, "not_found", "repository not found")
		return
	}
	s.writeJSON(w, http.StatusOK, map[string]any{"audit": rows})
}

func (s *Server) repoError(w http.ResponseWriter, err error) {
	switch {
	case errors.Is(err, repos.ErrInvalid):
		s.writeError(w, http.StatusBadRequest, "invalid_request", err.Error())
	case errors.Is(err, repos.ErrCollision):
		s.writeError(w, http.StatusConflict, "name_in_config", err.Error())
	case errors.Is(err, repos.ErrReadOnly):
		s.writeError(w, http.StatusForbidden, "read_only", err.Error())
	case errors.Is(err, store.ErrRepoExists):
		s.writeError(w, http.StatusConflict, "exists", err.Error())
	case errors.Is(err, store.ErrVersionConflict):
		s.writeError(w, http.StatusConflict, "version_conflict", "the repository changed since you loaded it; reload and retry")
	case errors.Is(err, store.ErrRepoBusy):
		s.writeError(w, http.StatusConflict, "repo_busy", "the repository has active runs; finish or cancel them first")
	case errors.Is(err, store.ErrNotFound):
		s.writeError(w, http.StatusNotFound, "not_found", "repository not found")
	default:
		s.respondError(w, err)
	}
}
// Package runner orchestrates durable issue runs and their approval boundary.
package runner

import (
	"context"
	"encoding/json"
	"errors"
	"fmt"
	"log/slog"
	"net/http"
	"os"
	"regexp"
	"strings"
	"sync"
	"time"

	"github.com/aryanpappu/patchbot/internal/agent"
	"github.com/aryanpappu/patchbot/internal/config"
	"github.com/aryanpappu/patchbot/internal/execx"
	"github.com/aryanpappu/patchbot/internal/github"
	"github.com/aryanpappu/patchbot/internal/gitx"
	"github.com/aryanpappu/patchbot/internal/llm"
	"github.com/aryanpappu/patchbot/internal/llm/providers"
	"github.com/aryanpappu/patchbot/internal/repos"
	"github.com/aryanpappu/patchbot/internal/secret"
	"github.com/aryanpappu/patchbot/internal/store"
	"github.com/aryanpappu/patchbot/internal/tools"
	"github.com/aryanpappu/patchbot/internal/workspace"
)

// Options supplies trusted infrastructure. Clone, Executor and Constructors are
// test seams; production uses gitx, execx and the raw provider constructors.
type Options struct {
	// Dispatch hands durable work to an owning manager. Nil runs synchronously.
	Dispatch func(context.Context, int64, func(context.Context) error) error
	// Admit reserves bounded dispatch capacity before any durable mutation.
	// The returned context carries admission through Dispatch; release is always called.
	Admit func(context.Context) (context.Context, func(), error)
	// ActionChannel is ui for the local web server; otherwise local actions use cli.
	ActionChannel string
	// Redactor adds CLI/server credentials to model and persistence boundaries.
	Redactor *secret.Redactor

	GitHub github.Client
	// Tokens is the PAT used in [github] auth = "pat" mode. It is ignored in
	// app mode, so an App failure never falls back to a broader PAT.
	Tokens github.TokenSource
	// RepoTokens supplies a credential per repository for REST and git. Nil
	// selects the configured mode: the PAT for every repository, or a GitHub
	// App source built from [github].
	RepoTokens github.RepoTokenSource
	// CommitAuthor is the git identity of patchbot commits. Zero selects
	// patchbot <patchbot@users.noreply.github.com>; app mode sets the bot.
	CommitAuthor gitx.Author
	// GitHubAPI and GitHubHTTP are test seams for the App API endpoint.
	GitHubAPI    string
	GitHubHTTP   *http.Client
	Constructors llm.Constructors
	// Repos is the effective repository allowlist. Nil builds one from the
	// configuration and the dashboard repositories in the database.
	Repos    *repos.Registry
	Clone    func(context.Context, gitx.CloneOptions) (*gitx.Repo, error)
	Executor func(dir string, repo config.RepoExecutor) (execx.Executor, error)
	// ContainerSweep removes containers left by a previous process. Nil uses
	// execx.SweepContainers when [executor] kind is container.
	ContainerSweep    func(context.Context) (int, error)
	Clock             func() time.Time
	BotLogin          string
	HeartbeatInterval time.Duration
	StaleAfter        time.Duration
	// DisableFailureComments suppresses the otherwise enabled failure comment.
	DisableFailureComments bool
}

// Request fixes provider/model and limits for the lifetime of a new run.
type Request struct {
	// IngressKey is supplied only by automatic label reconciliation.
	IngressKey             string
	Repo                   string
	Issue                  int64
	Mode, Provider, Model  string
	RefineModel, CodeModel string
	DryRun                 bool
	MaxCostMicros          int64
}

// Runner is safe for concurrent actions. Long work owns a per-run context;
// Cancel also works from another process through the persisted status.
type Runner struct {
	cfg      *config.Config
	db       store.Store
	gh       github.Client
	tokens   github.RepoTokenSource
	opts     Options
	redactor *secret.Redactor
	repos    *repos.Registry
	// freezeMu makes the first freeze of a run's repository settings win.
	freezeMu sync.Mutex
	mu       sync.Mutex
	active   map[int64]context.CancelFunc
	controls map[int64]*sync.Mutex
	// notConnected is set at startup in app mode when no App exists yet.
	notConnected bool
}

type runLimits struct {
	Agent       agent.Limits
	RefineTurns int
	Timeout     time.Duration
}

// Token is a secret-backed PAT source, shared by GitHub and git clone/push.
type Token struct{ Value secret.Secret }

// Token supplies a credential without embedding it in diagnostics.
func (t Token) Token(context.Context) (string, error) {
	if !t.Value.IsSet() {
		return "", errors.New("set GITHUB_TOKEN")
	}
	return t.Value.Reveal(), nil
}

// New prepares the runner and recovers expired heartbeats on startup.
// The caller owns the store and closes it after runner work has finished.
func New(ctx context.Context, cfg *config.Config, db store.Store, opts Options) (*Runner, error) {
	if cfg == nil || db == nil {
		return nil, errors.New("runner requires configuration and storage")
	}
	if err := cfg.Validate(); err != nil {
		return nil, err
	}
	if opts.Clock == nil {
		opts.Clock = time.Now
	}
	if opts.Clone == nil {
		opts.Clone = gitx.Clone
	}
	if opts.Executor == nil {
		opts.Executor = defaultExecutor(cfg)
	}
	if opts.Constructors == nil {
		opts.Constructors = providers.Constructors(providers.Options{})
	}
	if opts.HeartbeatInterval <= 0 {
		opts.HeartbeatInterval = 10 * time.Second
	}
	if opts.StaleAfter <= 0 {
		opts.StaleAfter = time.Minute
	}
	r := &Runner{cfg: cfg, db: db, opts: opts, redactor: cfg.Redactor(), active: make(map[int64]context.CancelFunc), controls: make(map[int64]*sync.Mutex)}
	r.redactor.Extend(opts.Redactor)
	r.repos = opts.Repos
	if r.repos == nil {
		var err error
		if r.repos, err = repos.New(ctx, cfg, db, r.redactor.Redact); err != nil {
			return nil, err
		}
	}
	if err := r.setupGitHub(ctx); err != nil {
		return nil, err
	}
	if err := r.RecoverStale(ctx); err != nil {
		return nil, err
	}
	r.sweepContainers(ctx)
	manager, err := workspace.NewManager(cfg.DataDir())
	if err != nil {
		return nil, err
	}
	_, sweepErr := manager.Sweep(ctx, max(24*time.Hour, cfg.Limits.RunTimeout+cfg.Limits.TestTimeout+opts.StaleAfter))
	if err := errors.Join(sweepErr, manager.Close()); err != nil {
		return nil, err
	}
	if err := r.expireWaiting(ctx); err != nil {
		return nil, err
	}
	return r, nil
}

func (r *Runner) now() time.Time { return r.opts.Clock().UTC() }
func (r *Runner) control(id int64) *sync.Mutex {
	r.mu.Lock()
	defer r.mu.Unlock()
	if r.controls[id] == nil {
		r.controls[id] = &sync.Mutex{}
	}
	return r.controls[id]
}

// ErrInvalidRequest identifies a rejected operator input without quoting it.
var ErrInvalidRequest = errors.New("invalid run request")

var repoPattern = regexp.MustCompile(`^[A-Za-z0-9_][A-Za-z0-9_.-]*/[A-Za-z0-9_][A-Za-z0-9_.-]*$`)

func ref(repo string) github.RepoRef {
	owner, name, _ := strings.Cut(repo, "/")
	return github.RepoRef{Owner: owner, Name: name}
}

func (r *Runner) limits(req Request) (runLimits, error) {
	budget, hard, err := r.cfg.MaxCostMicro()
	if err != nil {
		return runLimits{}, err
	}
	if req.MaxCostMicros < 0 {
		return runLimits{}, errors.New("budget must be positive")
	}
	if req.MaxCostMicros > 0 {
		budget = req.MaxCostMicros
	}
	if budget <= 0 || hard <= 0 {
		return runLimits{}, errors.New("budget and hard maximum must be positive")
	}
	budget = min(budget, hard)
	c := r.cfg.Limits
	return runLimits{Agent: agent.Limits{MaxTurns: c.MaxTurns, MaxOutputTokens: c.MaxOutputTokens, MaxTotalTokens: c.MaxTotalTokens, MaxCostMicros: budget, MaxTestAttempts: min(c.MaxTestAttempts, 3), TestTimeout: c.TestTimeout}, RefineTurns: c.RefineMaxTurns, Timeout: c.RunTimeout}, nil
}

func (r *Runner) provider(name string) (llm.Provider, llm.Pricing, error) {
	configs, err := r.cfg.LLMProviders()
	if err != nil {
		return nil, llm.Pricing{}, err
	}
	for _, cfg := range configs {
		if cfg.Name != name {
			continue
		}
		ctor := r.opts.Constructors[cfg.Kind]
		if ctor == nil {
			return nil, llm.Pricing{}, llm.ErrNoAdapter
		}
		if cfg.APIKeyEnv != "" && !cfg.APIKey.IsSet() {
			return nil, llm.Pricing{}, fmt.Errorf("provider %s: set %s", name, cfg.APIKeyEnv)
		}
		p, err := ctor(cfg)
		if err != nil {
			return nil, llm.Pricing{}, errors.New("could not construct provider")
		}
		if p == nil || p.Name() != name {
			return nil, llm.Pricing{}, errors.New("provider identity mismatch")
		}
		return p, cfg.Pricing, nil
	}
	return nil, llm.Pricing{}, llm.ErrUnknownProvider
}

func (r *Runner) prepare(req Request) (store.Run, error) {
	if r.notConnected {
		return store.Run{}, ErrGitHubNotConnected
	}
	req.Repo = strings.ToLower(strings.TrimSpace(req.Repo))
	if !repoPattern.MatchString(req.Repo) || req.Issue <= 0 {
		return store.Run{}, errors.New("require --repo owner/name and a positive --issue")
	}
	if !r.repos.Has(req.Repo) {
		return store.Run{}, errors.New("repository is not in configuration allowlist")
	}
	if req.Mode == "" {
		req.Mode = r.cfg.Defaults.Mode
	}
	if req.Mode != config.ModeFix && req.Mode != config.ModeRefine && req.Mode != config.ModeInvestigate {
		return store.Run{}, errors.New("mode must be fix, refine or investigate")
	}
	if req.Provider == "" {
		req.Provider = r.cfg.Defaults.Provider
	}
	p := r.cfg.Providers[req.Provider]
	if p == nil {
		return store.Run{}, llm.ErrUnknownProvider
	}
	refine, code := r.cfg.Defaults.RefineModel, r.cfg.Defaults.CodeModel
	if req.Provider != r.cfg.Defaults.Provider {
		refine, code = "", ""
	}
	if req.Model != "" {
		refine, code = req.Model, req.Model
	}
	if req.RefineModel != "" {
		refine = req.RefineModel
	}
	if req.CodeModel != "" {
		code = req.CodeModel
	}
	if refine == "" {
		refine = p.DefaultModel
	}
	if code == "" {
		code = p.DefaultModel
	}
	if refine == "" || code == "" || strings.ContainsAny(refine+code, "\r\n\x00") {
		return store.Run{}, errors.New("set a valid model for both stages")
	}
	if _, _, err := r.provider(req.Provider); err != nil {
		return store.Run{}, err
	}
	limits, err := r.limits(req)
	if err != nil {
		return store.Run{}, err
	}
	raw, err := json.Marshal(limits)
	if err != nil {
		return store.Run{}, err
	}
	return store.Run{IngressKey: req.IngressKey, Repo: req.Repo, IssueNumber: req.Issue, Mode: req.Mode, Provider: req.Provider, RefineModel: refine, CodeModel: code, DryRun: req.DryRun, Status: store.StatusQueued, Phase: store.PhasePreflight, LimitsJSON: raw}, nil
}

// Start creates and executes the read-only phase, returning a durable waiting
// run (or a completed investigation). It never bypasses approval, even dry-run.
func (r *Runner) Start(ctx context.Context, req Request) (store.Run, error) {
	run, err := r.prepare(req)
	if err != nil {
		return run, err
	}
	if req.Mode == "" {
		issue, err := r.gh.GetIssue(ctx, ref(run.Repo), int(run.IssueNumber))
		if err != nil {
			return store.Run{}, err
		}
		for _, mode := range []string{config.ModeInvestigate, config.ModeRefine, config.ModeFix} {
			for _, label := range issue.Labels {
				if label.Name == "ai-"+mode {
					run.Mode = mode
					return r.start(ctx, run, nil)
				}
			}
		}
	}
	return r.start(ctx, run, nil)
}

func (r *Runner) start(ctx context.Context, run store.Run, reuse *store.Spec) (store.Run, error) {
	ctx, release, err := r.admit(ctx)
	if err != nil {
		return store.Run{}, err
	}
	defer release()
	run.Trigger = r.actionChannel()
	if r.opts.Dispatch != nil {
		admittedAt := time.Now().UTC()
		run.HeartbeatAt = &admittedAt
	}
	run, err = r.db.CreateRun(ctx, run)
	if err != nil {
		return run, err
	}
	// The run keeps the repository settings it starts with, whatever the
	// dashboard changes while it is in flight.
	if _, ferr := r.runRepo(ctx, run); ferr != nil {
		return run, errors.Join(ferr, r.fail(ctx, run, ferr))
	}
	id := run.ID
	initial := run
	if err = r.action(ctx, id, "start", r.actorFor(ctx), r.actionChannel(), nil); err == nil {
		err = r.dispatch(ctx, id, func(work context.Context) error {
			run := initial
			err := r.withWork(work, id, func(work context.Context) error {
				if err := r.transition(work, &run, store.StatusRunning, store.PhasePreflight, store.RunPatch{}); err != nil {
					return err
				}
				return r.refine(work, &run, nil, "", reuse)
			})
			if err != nil {
				return r.fail(work, run, err)
			}
			// A retry may reuse an approved spec. It still enters the ordinary gate.
			if reuse != nil && r.opts.Dispatch != nil {
				return r.execute(work, id)
			}
			return nil
		})
	}
	if err != nil {
		err = r.fail(ctx, initial, err)
	}
	latest, readErr := r.db.GetRun(context.WithoutCancel(ctx), id)
	return latest, errors.Join(err, readErr)
}

func (r *Runner) actionChannel() string {
	if r.opts.ActionChannel == "ui" {
		return "ui"
	}
	return "cli"
}

func (r *Runner) admit(ctx context.Context) (context.Context, func(), error) {
	if r.opts.Admit != nil {
		return r.opts.Admit(ctx)
	}
	return ctx, func() {}, nil
}

// RecoverStale fails orphaned active work and releases its issue lock. Servers
// call this periodically as well as on startup so quick restarts recover later.
func (r *Runner) RecoverStale(ctx context.Context) error {
	_, err := r.db.FailStaleRuns(ctx, r.now().Add(-r.opts.StaleAfter))
	return err
}

func (r *Runner) dispatch(ctx context.Context, id int64, work func(context.Context) error) error {
	if r.opts.Dispatch != nil {
		return r.opts.Dispatch(ctx, id, work)
	}
	return work(ctx)
}

func (r *Runner) transition(ctx context.Context, run *store.Run, status store.Status, phase store.Phase, patch store.RunPatch) error {
	// Free text from provider/GitHub responses must be redacted before SQLite,
	// not only when displayed by the API or CLI.
	for _, field := range []*string{patch.IssueTitle, patch.ErrorMessage, patch.PRURL, patch.Summary} {
		if field != nil {
			*field = r.redactor.Redact(*field)
		}
	}
	patch.Phase = phase
	patch.ExpectedGeneration = &run.Generation
	if err := r.db.SetRunStatus(ctx, run.ID, run.Status, status, patch); err != nil {
		return err
	}
	updated, err := r.db.GetRun(ctx, run.ID)
	if err != nil {
		return err
	}
	if updated.Status != status || updated.Generation != run.Generation+1 {
		return store.ErrConflict
	}
	*run = updated
	return nil
}

func (r *Runner) action(ctx context.Context, id int64, kind, actor, channel string, data any) error {
	raw, err := json.Marshal(data)
	if err != nil {
		return err
	}
	// Data is harness-owned; all user text is redacted before encoding.
	_, err = r.db.RecordAction(ctx, store.Action{RunID: id, Kind: kind, Actor: r.redactor.Redact(actor), Channel: channel, PayloadJSON: raw})
	return err
}

func (r *Runner) artifact(ctx context.Context, id int64, kind, content string) error {
	return r.db.SaveArtifact(ctx, store.Artifact{RunID: id, Kind: kind, Content: tools.CapOutput(r.redactor.Redact(content), 256<<10)})
}

// defaultExecutor selects host or container execution from [executor]. The
// runtime binary is resolved per run so the workspace is excluded as well.
func defaultExecutor(cfg *config.Config) func(string, config.RepoExecutor) (execx.Executor, error) {
	if !cfg.Executor.Container() {
		return func(dir string, _ config.RepoExecutor) (execx.Executor, error) { return execx.NewLocalExecutor(dir) }
	}
	return func(dir string, re config.RepoExecutor) (execx.Executor, error) {
		containerCfg, err := cfg.ContainerConfigFor(re, os.LookupEnv, dir)
		if err != nil {
			return nil, err
		}
		return execx.NewContainerExecutor(dir, containerCfg)
	}
}

// sweepContainers removes patchbot-labelled containers left by a crashed
// process. It runs only when no run is queued or running in the shared store,
// so it cannot remove a live run's container from another patchbot process.
// Failure is logged, not fatal: each command still reconciles its own container.
func (r *Runner) sweepContainers(ctx context.Context) {
	sweep := r.opts.ContainerSweep
	if sweep == nil && r.cfg.Executor.Container() {
		sweep = func(ctx context.Context) (int, error) {
			containerCfg, err := r.cfg.ContainerConfig("", os.LookupEnv)
			if err != nil {
				return 0, err
			}
			if containerCfg.Flavor == execx.RuntimeDocker {
				if err := execx.PrepareDockerConfig(r.cfg.DockerConfigDir()); err != nil {
					return 0, err
				}
			}
			return execx.SweepContainers(ctx, containerCfg)
		}
	}
	if sweep == nil {
		return
	}
	page, err := r.db.ListRuns(ctx, store.RunFilter{Statuses: []store.Status{store.StatusQueued, store.StatusRunning}, Limit: 1})
	if err != nil || len(page.Runs) > 0 {
		slog.Info("container sweep skipped", "active_runs", len(page.Runs) > 0, "store_error", err != nil)
		return
	}
	removed, err := sweep(ctx)
	if err != nil {
		slog.Warn("container sweep failed", "error", r.redactor.Redact(err.Error()))
		return
	}
	if removed > 0 {
		slog.Warn("removed containers left by a previous patchbot process", "count", removed)
	}
}
	}
	if p.PriceFree && len(p.Prices) > 0 {
		v.addf("%s: price_free = true and a prices table contradict each other; keep one", at)
	}
	for _, model := range sortedKeys(p.Prices) {
		price := p.Prices[model]
		pat := fmt.Sprintf("%s.prices.%s", at, model)
		v.check(validModelID(model), "%s: %q is not a model ID", pat, model)
		for _, rate := range []struct {
			name  string
			value *float64
		}{{"input", price.Input}, {"output", price.Output}} {
			switch {
			case rate.value == nil:
				v.addf("%s.%s: missing; a price needs both input and output, and a rate that is "+
					"really free must be written as 0", pat, rate.name)
			case !validMoney(*rate.value):
				v.addf("%s.%s: must be 0 or more", pat, rate.name)
			}
		}
		v.check(price.CacheRead == nil || validMoney(*price.CacheRead), "%s.cache_read: must be 0 or more", pat)
		v.check(price.CacheWrite == nil || validMoney(*price.CacheWrite), "%s.cache_write: must be 0 or more", pat)
	}
}

func validateRepo(v *validator, name string, r *Repo) {
	at := fmt.Sprintf("repos.%q", name)
	_, repo, _ := strings.Cut(name, "/")
	if !repoRE.MatchString(name) || repo == "." || repo == ".." {
		v.addf("%s: a repository key looks like \"owner/name\"", at)
	}
	for _, id := range sortedKeys(r.Commands) {
		argv := r.Commands[id]
		cat := fmt.Sprintf("%s.commands.%s", at, id)
		v.check(commandIDRE.MatchString(id),
			"%s: a command ID uses lower-case letters, digits, - and _, and starts with a letter", cat)
		switch {
		case len(argv) == 0:
			v.addf("%s: must be a non-empty argv array such as [\"go\", \"test\", \"./...\"]", cat)
			continue
		case argv[0] == "":
			v.addf("%s: the program name is empty", cat)
		case strings.HasPrefix(argv[0], "-"):
			v.addf("%s: the program name %q starts with a dash", cat, argv[0])
		case strings.ContainsAny(argv[0], shellMeta) || strings.ContainsFunc(argv[0], isControl):
			v.addf("%s: the program name %q contains a shell metacharacter; commands run without a shell, "+
				"so give the program and each argument as separate array items", cat, argv[0])
		}
		for i, arg := range argv {
			v.check(!strings.ContainsRune(arg, 0), "%s: argument %d contains a NUL byte", cat, i)
		}
	}
	if r.TestCommand != "" {
		if _, ok := r.Commands[r.TestCommand]; !ok {
			v.addf("%s.test_command: no command %q in commands (have: %s)",
				at, r.TestCommand, orNone(sortedKeys(r.Commands)))
		}
	}
	for _, path := range r.Protected {
		v.check(validProtectedPath(path),
			"%s.protected: %q must be a relative path inside the repository, with no \"..\"", at, path)
	}
}

// Warnings returns problems that do not stop patchbot from starting: a model
// with no price, an API key variable that is not set, and the like. A warning
// names the environment variable and never its value.
func (c *Config) Warnings() []string {
	var out []string
	redactor := c.Redactor()
	warnf := func(format string, args ...any) {
		out = append(out, redactor.Redact(fmt.Sprintf(format, args...)))
	}

	for _, name := range sortedKeys(c.Providers) {
		p := c.Providers[name]
		switch {
		case p.APIKeyEnv == "" && p.Kind != KindOpenAI:
			warnf("provider %q: api_key_env is not set, so requests carry no API key", name)
		case p.APIKey.IsSet() && len(p.APIKey.Reveal()) < secret.MinValueLen:
			warnf("provider %q: credential in %s is shorter than %d characters and cannot be masked; use a longer credential", name, p.APIKeyEnv, secret.MinValueLen)
		case p.APIKeyEnv != "" && envNameRE.MatchString(p.APIKeyEnv) && !p.APIKey.IsSet():
			warnf("provider %q: environment variable %s is not set; the provider cannot be used until it is",
				name, p.APIKeyEnv)
		}
		if p.PriceFree {
			continue
		}
		for _, model := range c.providerModels(name) {
			price, ok := p.Prices[model]
			switch {
			case !ok:
				warnf("provider %q: model %q has no price, so its cost is unknown and only the token limit applies; "+
					"add [providers.%s.prices.%q] or set price_free = true", name, model, name, model)
			case price.Checked.IsZero():
				warnf("provider %q: the price of model %q has no checked date", name, model)
			}
		}
	}

	if len(c.Repos) == 0 {
		warnf(`no [repos."owner/name"] table: no run can start until a repository is listed`)
	}
	for _, name := range sortedKeys(c.Repos) {
		if _, ok := c.Repos[name].TestCommandID(); !ok {
			warnf("repo %q: no test command, so its pull requests will be drafts marked unverified", name)
		}
	}
	if host, _, err := net.SplitHostPort(c.Server.Addr); err == nil && !isLoopback(host) && c.Server.Auth.Mode != AuthCloudflareAccess {
		warnf("server.addr %q is not a loopback address; patchbot serve will require PATCHBOT_UI_TOKEN", c.Server.Addr)
	}
	return out
}

// providerModels returns the models a provider is expected to run: its list,
// its default and, for the default provider, the two stage models.
func (c *Config) providerModels(name string) []string {
	p := c.Providers[name]
	models := slices.Clone(p.Models)
	add := func(model string) {
		if model != "" && !slices.Contains(models, model) {
			models = append(models, model)
		}
	}
	add(p.DefaultModel)
	if name == c.Defaults.Provider {
		add(c.Defaults.RefineModel)
		add(c.Defaults.CodeModel)
	}
	return models
}

func validMoney(f float64) bool {
	return f >= 0 && !math.IsInf(f, 0) && !math.IsNaN(f)
}

func validModelID(id string) bool {
	return id != "" && len(id) <= 200 && !strings.ContainsFunc(id, func(r rune) bool {
		return isControl(r) || r == ' '
	})
}

func validProtectedPath(path string) bool {
	if path == "" || strings.HasPrefix(path, "/") || strings.ContainsRune(path, 0) || strings.Contains(path, `\`) {
		return false
	}
	for seg := range strings.SplitSeq(strings.TrimSuffix(path, "/"), "/") {
		if seg == "" || seg == "." || seg == ".." {
			return false
		}
	}
	return true
}

func isControl(r rune) bool { return r < 0x20 || r == 0x7f }

func isLoopback(host string) bool {
	if host == "localhost" {
		return true
	}
	ip := net.ParseIP(host)
	return ip != nil && ip.IsLoopback()
}

func orNone(items []string) string {
	if len(items) == 0 {
		return "none"
	}
	return strings.Join(items, ", ")
}
package execx

import (
	"errors"
	"fmt"
	"os/exec"
	"path"
	"path/filepath"
	"strings"
)

const (
	defaultMaxExtraArgs  = 64
	defaultMaxArgLength  = 8 << 10
	defaultMaxExtraBytes = 8 << 10
)

// PolicyOptions are operator-owned exceptions and limits, never model input.
// AllowArgs and AllowLeadingDash are indexed by command ID. AllowShells is
// indexed by executable basename, e.g. "bash", and must name an explicit opt-in.
// Zero limits select defaults. Options are copied by NewPolicy.
type PolicyOptions struct {
	AllowArgs        map[string]bool
	AllowLeadingDash map[string]bool
	AllowShells      map[string]bool
	MaxExtraArgs     int
	MaxArgLength     int
	MaxExtraBytes    int
	// TrustedPath defaults to TrustedPath when nil; an empty list is invalid.
	TrustedPath []string
	// ExcludedRoots adds data/workspace roots to the checkout exclusion.
	ExcludedRoots []string
	// InContainer keeps executables unresolved on the host: commands run in a
	// container image, whose PATH (TrustedPath here, container paths) resolves
	// bare names. Shell/launcher and relative-path rules still apply.
	InContainer bool
}

type command struct {
	argv      []string
	allowArgs bool
	allowDash bool
}

// Policy holds immutable, resolved command IDs. Construct it from trusted
// per-repo commands = { name = [argv...] } configuration outside the checkout.
type Policy struct {
	commands map[string]command
	maxArgs  int
	maxLen   int
	maxBytes int
	path     []string
}

// NewPolicy resolves executables once using only the configured trusted path. An absolute
// operator-supplied executable is also accepted, but must be outside root.
// At most one options value may be supplied.
func NewPolicy(root string, commands map[string][]string, options ...PolicyOptions) (*Policy, error) {
	root, err := canonicalRoot(root)
	if err != nil {
		return nil, err
	}
	if len(options) > 1 {
		return nil, errors.New("at most one policy options value is allowed")
	}
	var opts PolicyOptions
	if len(options) == 1 {
		opts = options[0]
	}
	if opts.MaxExtraArgs < 0 || opts.MaxArgLength < 0 || opts.MaxExtraBytes < 0 {
		return nil, errors.New("argument limits must not be negative")
	}
	dirs := opts.TrustedPath
	if dirs == nil {
		dirs = filepath.SplitList(TrustedPath)
	}
	roots := append([]string{root}, opts.ExcludedRoots...)
	if opts.InContainer {
		if err := ValidateContainerPath(dirs); err != nil {
			return nil, err
		}
	} else if err := ValidateTrustedPath(dirs, roots...); err != nil {
		return nil, err
	}
	p := &Policy{path: append([]string(nil), dirs...), commands: make(map[string]command), maxArgs: opts.MaxExtraArgs,
		maxLen: opts.MaxArgLength, maxBytes: opts.MaxExtraBytes}
	if p.maxArgs == 0 {
		p.maxArgs = defaultMaxExtraArgs
	}
	if p.maxLen == 0 {
		p.maxLen = defaultMaxArgLength
	}
	if p.maxBytes == 0 {
		p.maxBytes = defaultMaxExtraBytes
	}
	for name, argv := range commands {
		if name == "" || strings.ContainsRune(name, 0) || len(argv) == 0 || argv[0] == "" {
			return nil, errors.New("command ID and executable must not be empty or contain NUL")
		}
		for _, arg := range argv {
			if strings.ContainsRune(arg, 0) {
				return nil, fmt.Errorf("command %q contains NUL", name)
			}
		}
		resolve := resolveExecutable
		if opts.InContainer {
			resolve = containerExecutable
		}
		binary, resolveErr := resolve(roots, argv[0], opts.AllowShells, dirs)
		if resolveErr != nil {
			return nil, fmt.Errorf("command %q: %w", name, resolveErr)
		}
		copyArgv := append([]string(nil), argv...)
		copyArgv[0] = binary
		p.commands[name] = command{copyArgv, opts.AllowArgs[name], opts.AllowLeadingDash[name]}
	}
	return p, nil
}

// MinimalEnv uses the same immutable PATH that resolved this policy.
func (p *Policy) MinimalEnv(home, tmp string, extra map[string]string) []string {
	return minimalEnv(home, tmp, extra, strings.Join(p.path, string(filepath.ListSeparator)))
}

// Resolve returns a fresh argv slice. Additional arguments require explicit
// per-command opt-in; flags require another opt-in. Literal metacharacters have
// no shell meaning. The approved program may still interpret their contents.
func (p *Policy) Resolve(name string, extraArgs []string) ([]string, error) {
	cmd, ok := p.commands[name]
	if !ok {
		return nil, fmt.Errorf("unknown command %q", name)
	}
	if len(extraArgs) > 0 && !cmd.allowArgs {
		return nil, errors.New("extra arguments are not allowed")
	}
	if len(extraArgs) > p.maxArgs {
		return nil, errors.New("too many extra arguments")
	}
	total := 0
	for _, arg := range extraArgs {
		if strings.ContainsRune(arg, 0) || (!cmd.allowDash && strings.HasPrefix(arg, "-")) {
			return nil, errors.New("invalid extra argument")
		}
		if len(arg) > p.maxLen || len(arg) > p.maxBytes-total {
			return nil, errors.New("extra arguments exceed length limit")
		}
		total += len(arg)
	}
	argv := make([]string, 0, len(cmd.argv)+len(extraArgs))
	argv = append(argv, cmd.argv...)
	return append(argv, extraArgs...), nil
}

func shellLike(name string) bool {
	switch name {
	case "sh", "bash", "zsh", "fish", "dash", "env", "xargs", "sudo":
		return true
	default:
		return false
	}
}

func resolveExecutable(roots []string, name string, allowShells map[string]bool, dirs []string) (string, error) {
	base := filepath.Base(name)
	explicitShell := shellLike(base) && allowShells[base]
	if shellLike(base) && !explicitShell {
		return "", errors.New("shell or command launcher is not allowed")
	}
	if !filepath.IsAbs(name) && base != name {
		return "", errors.New("relative executable paths are not allowed")
	}
	var path string
	err := errors.New("executable not found in trusted path")
	if filepath.IsAbs(name) {
		path, err = exec.LookPath(name)
	} else {
		// LookPath receives absolute candidates so it never reads ambient PATH.
		for _, dir := range dirs {
			candidate := filepath.Join(dir, name)
			path, err = exec.LookPath(candidate)
			if err == nil {
				break
			}
		}
	}
	if err != nil {
		return "", fmt.Errorf("resolve executable: %w", err)
	}
	if excludedExecutable(roots, path) {
		return "", errors.New("executable is inside the workspace")
	}
	resolved, err := filepath.EvalSymlinks(path)
	if err != nil {
		return "", fmt.Errorf("resolve executable symlink: %w", err)
	}
	if !filepath.IsAbs(resolved) || excludedExecutable(roots, resolved) {
		return "", errors.New("executable must be absolute and outside the workspace")
	}
	if target := filepath.Base(resolved); shellLike(target) && !explicitShell && !allowShells[target] {
		return "", errors.New("executable resolves to a disallowed shell or launcher")
	}
	return resolved, nil
}

// containerExecutable applies the name rules without consulting the host: the
// image's filesystem is what the command will see.
func containerExecutable(_ []string, name string, allowShells map[string]bool, _ []string) (string, error) {
	base := path.Base(name)
	if shellLike(base) && !allowShells[base] {
		return "", errors.New("shell or command launcher is not allowed")
	}
	if strings.Contains(name, "/") && (!path.IsAbs(name) || path.Clean(name) != name) {
		return "", errors.New("container executables must be bare names or clean absolute paths")
	}
	return name, nil
}

// ResolveExecutable uses the same trusted-path and exclusion rules as Policy.
// It never consults the ambient PATH. A nil path selects the secure defaults.
func ResolveExecutable(name string, dirs []string, excluded ...string) (string, error) {
	if dirs == nil {
		dirs = filepath.SplitList(TrustedPath)
	}
	if err := ValidateTrustedPath(dirs, excluded...); err != nil {
		return "", err
	}
	return resolveExecutable(excluded, name, nil, dirs)
}
func excludedExecutable(roots []string, path string) bool {
	for _, root := range roots {
		if root == "" {
			continue
		}
		resolved, err := resolveFuturePath(root)
		if err != nil || inside(filepath.Clean(root), path) || inside(resolved, path) {
			return true
		}
	}
	return false
}

