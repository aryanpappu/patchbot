-- Dashboard-managed repositories (M24). The config file stays the bootstrap
-- allowlist and is never written; these rows are added to it. settings_json is
-- the redacted repository settings (commands argv map, test_command, protected
-- paths, optional digest-pinned image and container PATH), validated by the
-- same rules as a [repos."owner/name"] table before it is stored. Edits bump
-- version (optimistic concurrency). History stays when a row is removed.
CREATE TABLE dashboard_repos (
    name TEXT PRIMARY KEY CHECK (length(name) BETWEEN 3 AND 140 AND name = lower(name)),
    settings_json TEXT NOT NULL CHECK (json_valid(settings_json)),
    version INTEGER NOT NULL CHECK (version >= 1),
    created_at INTEGER NOT NULL CHECK (created_at >= 0),
    created_by TEXT NOT NULL,
    updated_at INTEGER NOT NULL CHECK (updated_at >= 0),
    updated_by TEXT NOT NULL
) STRICT;

-- Append-only audit of every add, edit and remove with the acting identity.
-- before_json and after_json are redacted settings snapshots ('' when absent).
CREATE TABLE repo_audit (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    repo TEXT NOT NULL,
    action TEXT NOT NULL CHECK (action IN ('add', 'edit', 'remove')),
    actor TEXT NOT NULL,
    channel TEXT NOT NULL,
    before_json TEXT NOT NULL DEFAULT '',
    after_json TEXT NOT NULL DEFAULT '',
    at INTEGER NOT NULL CHECK (at >= 0)
) STRICT;

CREATE INDEX repo_audit_repo ON repo_audit (repo, id);

CREATE TRIGGER repo_audit_no_update BEFORE UPDATE ON repo_audit
BEGIN SELECT RAISE(ABORT, 'repo_audit is append-only'); END;

CREATE TRIGGER repo_audit_no_delete BEFORE DELETE ON repo_audit
BEGIN SELECT RAISE(ABORT, 'repo_audit is append-only'); END;
// Package server serves the local JSON API and resumable event streams.
package server

import (
	"context"
	"crypto/sha256"
	"crypto/subtle"
	"errors"
	"io"
	"log"
	"net"
	"net/http"
	"os"
	"path"
	"strconv"
	"strings"
	"sync"
	"time"

	"github.com/aryanpappu/patchbot/internal/cfaccess"
	"github.com/aryanpappu/patchbot/internal/config"
	"github.com/aryanpappu/patchbot/internal/github"
	"github.com/aryanpappu/patchbot/internal/llm"
	"github.com/aryanpappu/patchbot/internal/llm/providers"
	"github.com/aryanpappu/patchbot/internal/repos"
	"github.com/aryanpappu/patchbot/internal/runner"
	"github.com/aryanpappu/patchbot/internal/secret"
	"github.com/aryanpappu/patchbot/internal/store"
	"github.com/aryanpappu/patchbot/internal/web"
)

// Options supplies trusted infrastructure. Zero values use production defaults.
type Options struct {
	Token secret.Secret
	// Access overrides the Cloudflare Access verifier built from the
	// configuration (tests point it at a local JWKS server).
	Access          *cfaccess.Verifier
	Runner          runner.Options
	ShutdownTimeout time.Duration
	// Short intervals are useful to exercise timers without network or live keys.
	HeartbeatInterval  time.Duration
	PollInterval       time.Duration
	StreamWriteTimeout time.Duration
	SyncInterval       time.Duration
}

// Server owns background runs and stream lifetimes. The caller owns the store
// and closes it only after Shutdown and outstanding runner cleanup finish.
type Server struct {
	cfg             *config.Config
	db              store.Store
	runner          *runner.Runner
	repos           *repos.Registry
	models          *llm.ModelLister
	registry        *llm.Registry
	redactor        *secret.Redactor
	manager         *manager
	bus             broadcaster
	handler         http.Handler
	http            *http.Server
	tokenHash       [32]byte
	authenticated   bool
	access          *cfaccess.Verifier
	opts            Options
	mu              sync.RWMutex
	addr            string
	stopping        bool
	stop            context.CancelFunc
	done            chan struct{}
	maintenanceDone chan struct{}
	unsubscribe     func()
	shutdownOnce    sync.Once
	ingressMu       sync.Mutex
	ingressWake     chan struct{}
	// maxPending overrides maxPendingDeliveries in tests when positive.
	maxPending int
	// setup holds Connect GitHub states; setupMu serializes the callback.
	setup   setupStates
	setupMu sync.Mutex
}

// ValidateAddress refuses public or wildcard binds without a UI credential.
// Hostnames other than localhost require authentication: no DNS lookup can
// change an unauthenticated listener from loopback to a public interface.
func ValidateAddress(addr string, token secret.Secret) error {
	host, port, err := net.SplitHostPort(addr)
	if err != nil {
		return errors.New("server address must be host:port")
	}
	n, err := strconv.Atoi(port)
	if err != nil || n < 0 || n > 65535 {
		return errors.New("server port must be between 0 and 65535")
	}
	ip := net.ParseIP(host)
	if !token.IsSet() && host != "localhost" && (ip == nil || !ip.IsLoopback()) {
		return errors.New("non-loopback server address requires PATCHBOT_UI_TOKEN")
	}
	return nil
}

// s0 is the credential ValidateAddress sees: Access JWT verification stands in
// for the UI token on non-loopback binds.
func s0(opts Options, cfg *config.Config) secret.Secret {
	if cfg.Server.Auth.Mode == config.AuthCloudflareAccess {
		return secret.New("cloudflare-access")
	}
	return opts.Token
}

// New constructs one runner and starts lifecycle maintenance and ownership heartbeats.
func New(ctx context.Context, cfg *config.Config, db store.Store, opts Options) (*Server, error) {
	if cfg == nil || db == nil {
		return nil, errors.New("server requires configuration and storage")
	}
	if !opts.Token.IsSet() {
		opts.Token = secret.New(os.Getenv("PATCHBOT_UI_TOKEN"))
	}
	if cfg.Server.Auth.Mode == config.AuthCloudflareAccess {
		// Access replaces the bearer token; the token is ignored in this mode.
		opts.Token = secret.Secret{}
		if opts.Access == nil {
			a := cfg.Server.Auth
			var err error
			opts.Access, err = cfaccess.New(cfaccess.Config{TeamDomain: a.TeamDomain, Audience: a.Audience, AllowedEmails: a.AllowedEmails})
			if err != nil {
				return nil, errors.New("invalid cloudflare_access configuration")
			}
		}
	}
	if err := ValidateAddress(cfg.Server.Addr, s0(opts, cfg)); err != nil {
		return nil, err
	}
	if opts.ShutdownTimeout <= 0 {
		opts.ShutdownTimeout = 30 * time.Second
	}
	if opts.HeartbeatInterval <= 0 {
		opts.HeartbeatInterval = 15 * time.Second
	}
	if opts.StreamWriteTimeout <= 0 {
		opts.StreamWriteTimeout = 5 * time.Second
	}
	if opts.PollInterval <= 0 {
		opts.PollInterval = time.Second
	}
	if opts.SyncInterval <= 0 {
		opts.SyncInterval = 60 * time.Second
	}
	if opts.Runner.Constructors == nil {
		opts.Runner.Constructors = providers.Constructors(providers.Options{})
	}
	s := &Server{cfg: cfg, db: db, opts: opts, addr: cfg.Server.Addr, manager: newManager(cfg.Server.MaxConcurrentRuns, cfg.Server.MaxQueuedRuns), redactor: cfg.Redactor(), done: make(chan struct{}), maintenanceDone: make(chan struct{})}
	s.authenticated = opts.Token.IsSet()
	s.access = opts.Access
	s.tokenHash = sha256.Sum256([]byte(opts.Token.Reveal()))
	s.redactor.AddExact(opts.Token.Reveal())
	s.redactor.AddSecrets(secret.New(os.Getenv("GITHUB_TOKEN")))
	if opts.Runner.Tokens != nil {
		if value, err := opts.Runner.Tokens.Token(ctx); err == nil {
			s.redactor.AddExact(value)
		}
	}
	if source, ok := db.(interface {
		SubscribeEvents(func(store.Event)) func()
	}); ok {
		s.unsubscribe = source.SubscribeEvents(func(event store.Event) { s.bus.publish(event.RunID) })
	}
	opts.Runner.Dispatch = s.manager.submit
	opts.Runner.Admit = s.manager.reserve
	opts.Runner.ActionChannel = "ui"
	s.redactor.Extend(opts.Runner.Redactor)
	opts.Runner.Redactor = s.redactor
	var err error
	s.runner, err = runner.New(ctx, cfg, db, opts.Runner)
	if err != nil {
		if s.unsubscribe != nil {
			s.unsubscribe()
		}
		return nil, errors.New("could not initialize runner")
	}
	s.repos = s.runner.Repos()
	configs, err := cfg.LLMProviders()
	if err != nil {
		if s.unsubscribe != nil {
			s.unsubscribe()
		}
		return nil, errors.New("invalid provider configuration")
	}
	s.registry, err = llm.NewRegistry(opts.Runner.Constructors, configs, llm.RegistryOptions{})
	if err != nil {
		if s.unsubscribe != nil {
			s.unsubscribe()
		}
		return nil, errors.New("could not initialize providers")
	}
	s.models = llm.NewModelLister(s.registry, nil)
	s.handler = s.routes()
	s.http = &http.Server{Handler: s, ReadHeaderTimeout: 5 * time.Second, ReadTimeout: 30 * time.Second, IdleTimeout: 60 * time.Second, ErrorLog: log.New(io.Discard, "", 0)}
	s.ingressWake = make(chan struct{}, 1)
	maintenanceCtx, stop := context.WithCancel(context.Background())
	s.stop = stop
	interval := opts.Runner.HeartbeatInterval
	if interval <= 0 {
		interval = 10 * time.Second
	}
	s.manager.startHeartbeats(interval, db.Heartbeat)
	go s.maintain(maintenanceCtx)
	return s, nil
}

func (s *Server) maintain(ctx context.Context) {
	defer close(s.maintenanceDone)
	ticker := time.NewTicker(s.opts.SyncInterval)
	defer ticker.Stop()
	var labelTick <-chan time.Time
	if s.cfg.Webhook.Enabled {
		interval := s.cfg.Webhook.LabelPollInterval
		if interval <= 0 {
			interval = 5 * time.Minute
		}
		labels := time.NewTicker(interval)
		defer labels.Stop()
		labelTick = labels.C
		s.logMaintenance("webhook deliveries", s.reconcileDeliveries(ctx))
		s.syncLabels(ctx, interval)
	}
	for {
		select {
		case <-ctx.Done():
			return
		case <-s.ingressWake:
			s.logMaintenance("webhook deliveries", s.reconcileDeliveries(ctx))
		case <-labelTick:
			s.syncLabels(ctx, s.cfg.Webhook.LabelPollInterval)
		case <-ticker.C:
			s.logMaintenance("recover stale runs", s.runner.RecoverStale(ctx))
			s.logMaintenance("sync waiting runs", s.runner.SyncWaiting(ctx))
			if s.cfg.Webhook.Enabled {
				s.logMaintenance("webhook deliveries", s.reconcileDeliveries(ctx))
				s.logMaintenance("prune webhook deliveries", s.pruneDeliveries(ctx))
			}
package execx

import (
	"errors"
	"fmt"
	"os"
	"path/filepath"
	"strings"
)

// ValidateTrustedPath requires existing directories with trusted ownership and
// permissions along every ancestor, including unresolved symlink locations.
// Call again with the actual workspace and data roots when constructing a policy.
func ValidateTrustedPath(dirs []string, excluded ...string) error {
	if len(dirs) == 0 {
		return errors.New("at least one trusted directory is required")
	}
	for _, dir := range dirs {
		if !filepath.IsAbs(dir) || strings.ContainsAny(dir, "\x00"+string(filepath.ListSeparator)) {
			return errors.New("entries must be nonempty absolute directories without a PATH separator")
		}
		for _, part := range strings.Split(filepath.ToSlash(dir), "/") {
			if part == ".." {
				return errors.New("entries must not contain parent traversal")
			}
		}
		resolved, err := filepath.EvalSymlinks(dir)
		if err != nil {
			return fmt.Errorf("resolve trusted directory: %w", err)
		}
		for _, root := range excluded {
			if root == "" {
				continue
			}
			canonical, err := resolveFuturePath(root)
			if err != nil {
				return fmt.Errorf("resolve excluded root: %w", err)
			}
			if inside(canonical, resolved) || inside(filepath.Clean(root), filepath.Clean(dir)) {
				return errors.New("trusted directory is inside the data directory or workspace")
			}
		}
		if err := validateDirectoryChain(dir, excluded...); err != nil {
			return fmt.Errorf("trusted directory %q: %w", dir, err)
		}
	}
	return nil
}

// Walk each unresolved component before following symlinks. Checking only the
// final EvalSymlinks result misses replaceable links and intermediate targets.
func validateDirectoryChain(path string, excluded ...string) error {
	pending := strings.Split(filepath.Clean(path), string(filepath.Separator))
	current := string(filepath.Separator)
	links := 0
	for {
		if excludedExecutable(excluded, current) {
			return errors.New("trusted path crosses the data directory or workspace")
		}
		info, err := os.Lstat(current) // #nosec G703 -- operator-owned path being validated.
		if err != nil {
			return err
		}
		if info.Mode()&os.ModeSymlink != 0 {
			links++
			if links > 255 {
				return errors.New("too many symlinks")
			}
			if err := trustedOwner(info); err != nil {
				return err
			}
			target, err := os.Readlink(current)
			if err != nil {
				return err
			}
			if !filepath.IsAbs(target) {
				target = filepath.Dir(current) + string(filepath.Separator) + target
			}
			pending = append(strings.Split(target, string(filepath.Separator)), pending...)
			current = string(filepath.Separator)
			continue
		}
		if !info.IsDir() {
			return errors.New("every path component must be a directory")
		}
		if err := trustedDirectory(info); err != nil {
			return fmt.Errorf("%s: %w", current, err)
		}
		for len(pending) > 0 && pending[0] == "" {
			pending = pending[1:]
		}
		if len(pending) == 0 {
			return nil
		}
		part := pending[0]
		pending = pending[1:]
		if part == "." {
			continue
		}
		if part == ".." {
			current = filepath.Dir(current)
		} else {
			current = filepath.Join(current, part)
		}
	}
}

// Resolve the existing prefix too, so a not-yet-created data directory cannot
// hide beneath a symlink. EvalSymlinks alone cannot resolve such paths.
func resolveFuturePath(path string) (string, error) {
	abs, err := filepath.Abs(path)
	if err != nil {
		return "", err
	}
	resolved, err := filepath.EvalSymlinks(abs)
	if err == nil || !errors.Is(err, os.ErrNotExist) {
		return resolved, err
	}
	info, statErr := os.Lstat(abs)
	if statErr == nil && info.Mode()&os.ModeSymlink != 0 {
		target, err := os.Readlink(abs)
		if err != nil {
			return "", err
		}
		if !filepath.IsAbs(target) {
			target = filepath.Join(filepath.Dir(abs), target)
		}
		return resolveFuturePath(target)
	}
	if statErr != nil && !errors.Is(statErr, os.ErrNotExist) {
		return "", statErr
	}
	parent := filepath.Dir(abs)
	if parent == abs {
		return "", err
	}
	resolved, err = resolveFuturePath(parent)
	if err != nil {
		return "", err
	}
	return filepath.Join(resolved, filepath.Base(abs)), nil
}
# Security policy

**patchbot is not a sandbox. Repository commands run as your user.** They can
read your host files, use your network and create processes outside the tool
jail. Use only repositories, test commands and toolchain directories you trust.

## Threat model

The model, issue text, repository files, test output and upstream HTTP responses
may be wrong or hostile. The operator, configuration, local account and trusted
toolchain are trusted. The intended deployment is one operator on one machine.

The approval gate binds code access to the current spec version and hash, issue
content and expiry. Repo/command allowlists, an `os.Root` file jail, protected
paths, explicit child environments, output caps, process groups and guarded git
publication limit what model tools can do. Tokens are absent from test envs and
are passed to git only for remote operations (clone, fetch, ls-remote, push) as an
ephemeral host-scoped `http.extraheader` in `GIT_CONFIG_*`, never in argv, the
URL or `.git/config`; local git commands never receive them. Redaction runs at persistence and output
boundaries. Every CLI/server runner receives provider, GitHub and configured UI
credentials. Registered values shorter than eight characters cannot be substring
masked; `config check` and `doctor` warn without printing their values. Harness
phases, statuses and JSON/TOML keys are preserved during redaction. HTTP reads and
outbound deadlines are bounded. Adapter deadlines are retryable `unavailable`
errors; caller cancellation and deadlines stop retries.

Trusted PATH entries must exist and resolve to directories. Every directory
from `/` to the entry, including unresolved symlink locations, must be owned by
root or the current user and have no group/world write bits. Sticky directories
are rejected too. Data and workspace roots are excluded. Doctor validates config
before running anything and shares git resolution with production through the
configured trusted path. Its version checks use `execx` with process groups, a
five-second timeout, a 4 KiB output cap and WaitDelay.

Process-group cleanup observes leader exit without reaping. The zombie reserves
its PID/PGID until the final group signal, preventing cleanup from signaling a
reused group. Timeout/cancellation sends TERM, waits the full grace period, then
KILL; ordinary exits clean remaining members before Wait. Git shares this
lifecycle. Escaped descendants remain outside this guarantee.

The web server defaults to loopback. Other binds require `PATCHBOT_UI_TOKEN`.
Bearer auth protects data routes when enabled. Host validation, Go cross-origin
mutation checks, CSP, SRI and plain-text rendering protect the browser. Local
CLI decisions use a configured actor name.

With `[server.auth] mode = "cloudflare_access"` (M23) the UI/API no longer use
the bearer token. Every request except the three fixed static asset paths must
carry `Cf-Access-Jwt-Assertion`; patchbot verifies the RS256 signature against
the team JWKS (`https://<team_domain>/cdn-cgi/access/certs`, keys cached by
`kid`, one refresh per minute on an unknown `kid`), `iss`, `aud`, `exp`/`nbf`/
`iat` (60 s skew) and that the `email` claim is in `allowed_emails`. Only RS256
is accepted (`none` and HMAC tokens are rejected). Failures return a generic
401/403 and the token is never logged or echoed. The verified email is the
recorded actor on the ui channel. The Access JWT is the sole credential in this
mode: keep the listener on loopback behind the tunnel, and rely on the Access
policy to limit who can sign in (`allowed_emails` is a second check). The webhook path keeps its own
HMAC check and needs a Cloudflare Access bypass policy so GitHub can reach it.

GitHub approval identity: comments by the token owner (`/user`) are patchbot's
own and normally never count. With a single-user PAT the owner may also be an
approver ("shared identity"). Such a comment counts only if the login is a
configured approver and live collaborator, the comment is unedited, inside the
current waiting window, carries no `<!-- patchbot` marker, and its ID is not in
patchbot's `posted_comments` record. Every comment patchbot posts carries that
marker and its ID is recorded right after posting, so either check alone keeps
patchbot's own text (even a spec starting with `/approve`) from approving.

GitHub App mode (`[github] auth = "app"`): comments by the App bot
(`<slug>[bot]`) never count, so the shared-identity rule above applies only to
PAT mode. Each run's REST calls and every git network operation use an
installation token minted for that repository's immutable ID only, with
contents/issues/pull_requests write and metadata read, cached in memory, never
written to SQLite, logs, artifacts or the container environment, and registered
for redaction (with its git header form) before first use. App failures fail
closed; there is no fallback to a PAT.

Key custody on a shared host: the App private key is a long-lived credential
that can mint tokens for every repository the App is installed on. patchbot
keeps it in a file readable only by the service user (0600, owner checked,
symlinks refused, never inside the data directory, workspaces or backups) and
parses it once into memory. This is not a boundary against root, against other
processes running as the patchbot user, or against debuggers and core dumps of
the patchbot process. Install the App only on the repositories patchbot needs,
run repository code with the container executor so it does not run as a process
that can read the key, and rotate the key after any suspected host compromise
(outstanding installation tokens stay valid until they expire, at most 1 hour,
unless the installation is suspended).

Connect GitHub (App manifest flow, M28): `GET /setup/github` is a data-free
shell (like the other pages); the manifest and a 32-byte random `state` are
issued only by the bearer-protected `POST /api/github/setup/start`. The state
is kept as a SHA-256 digest in server memory, expires after 10 minutes, works
once, is compared in constant time, and is consumed even when the exchange fails.
Because GitHub redirects the browser to `/setup/github/callback`, which cannot
carry a bearer header, that one route is authenticated by the state alone; an
attacker who cannot obtain a state cannot make patchbot adopt their App. The
code exchange is a bounded (64 KiB), 20-second, no-redirect, unauthenticated
call; its response and the code are never logged or echoed, and errors are fixed
strings. The key is written atomically (exclusive temp file, `0600`, then a
hard link that fails if the path exists), owned by the service user, and an
existing file, symlink or dangling link is refused, so a key is never replaced.
The key directory must pre-exist; the check runs before the single-use code is
spent so a key cannot be lost after the App was created. The database stores
only the App ID and slug. `client_secret` and `webhook_secret` are discarded
(the App is created with the webhook inactive). The setup page relaxes only
`form-action` to `https://github.com`. Setup is disabled once connected, and a
public, unauthenticated visitor can learn only whether GitHub is connected.

The dashboard can add and edit allowlisted repositories (M24), which changes what
runs inside the sandbox: commands, test command, protected paths and image. This stays
argv-only (no shell), network-less and behind the owner-only login; every change is
validated like a config file, audited with the actor, and cannot remove the built-in
`.github/workflows` protection. Treat dashboard access as the ability to choose what
code runs on approved changes.

In scope: file-tool jail escapes, command-policy bypass, leaks through logs,
SSE, artifacts, errors or PR text, unsafe git publication, browser protection
bypass and code execution without valid spec approval. Prompt injection that
crosses these enforced boundaries is in scope.

Out of scope: containing arbitrary repository code, a compromised host or
operator account, malicious trusted binaries, intentional credential exfiltration
by tests, children that escape process groups, denial of service by host code,
multi-user authorization and secure public deployment. Redaction cannot identify
every secret or arbitrary encoding. The Unix binary starts
with umask 077. Git and tests inherit it, but trusted code can change modes.
Embedders must set their own mask. Workspace parents are private. Dry runs still execute
host code and may incur provider costs. Containers, CPU/memory isolation,
network isolation, TLS termination, webhooks and durable leases are future work.

See [architecture](docs/ARCHITECTURE.md) for the boundaries and known limits.

## Reporting

Do not open a public issue. Use this repository's GitHub **Security → Report a
vulnerability** feature. Include the version, platform and a minimal reproduction
with dummy credentials. Expect a reply within seven days. Never include live
keys in a report or test fixture.

## Supported versions

The latest release and `development` receive security fixes during early
development. Use Go 1.27 or newer and git 2.50.1 or newer. Review provider pricing
and credentials before enabling publication. Review every generated PR.

