package gitx

import (
	"fmt"
	"regexp"
	"strconv"
	"strings"
)

var gitVersionPattern = regexp.MustCompile(`^git version ([0-9]+)\.([0-9]+)\.([0-9]+)(?:$|[. +\-])`)

// parseGitVersion accepts vendor suffixes, including Windows and Apple builds.
func parseGitVersion(out string) ([3]int, error) {
	var version [3]int
	parts := gitVersionPattern.FindStringSubmatch(strings.TrimSpace(out))
	if parts == nil {
		return version, fmt.Errorf("unrecognized git version %q", strings.TrimSpace(out))
	}
	for i := range version {
		n, err := strconv.Atoi(parts[i+1])
		if err != nil {
			return version, fmt.Errorf("invalid git version component: %w", err)
		}
		version[i] = n
	}
	return version, nil
}

// CheckVersion validates the git --version output against the clone safety floor.
func CheckVersion(out string) error {
	return checkGitVersion(out)
}

func checkGitVersion(out string) error {
	found, err := parseGitVersion(out)
	if err == nil {
		required, parseErr := parseGitVersion("git version " + MinimumGitVersion)
		if parseErr != nil {
			return parseErr
		}
		for i := range found {
			if found[i] > required[i] {
				return nil
			}
			if found[i] < required[i] {
				break
			}
			if i == len(found)-1 {
				return nil
			}
		}
	}
	return fmt.Errorf("found %q; git >= %s is required", strings.TrimSpace(out), MinimumGitVersion)
}
package gitx

import (
	"crypto/sha256"
	"encoding/hex"
	"errors"
	"io"
	"os"
	"strings"
)

// ConfigHash returns SHA-256 of the literal .git/config bytes after checking
// metadata types and ensuring .git/hooks contains only regular *.sample files.
func (r *Repo) ConfigHash() (string, error) {
	r.mu.Lock()
	defer r.mu.Unlock()
	if r.closed {
		return "", errors.New("git repo is closed")
	}
	return r.hashConfig()
}

// VerifyConfig checks the captured hash and the hook directory without invoking
// git, so a modified configuration cannot execute helpers during verification.
func (r *Repo) VerifyConfig(hash string) error {
	r.mu.Lock()
	defer r.mu.Unlock()
	if r.closed {
		return errors.New("git repo is closed")
	}
	actual, err := r.hashConfig()
	if err != nil || actual != hash {
		return ErrTampered
	}
	return nil
}

func (r *Repo) verify() error {
	if r.closed {
		return errors.New("git repo is closed")
	}
	hash, err := r.hashConfig()
	if err != nil || hash != r.configHash {
		return ErrTampered
	}
	return nil
}

func (r *Repo) hashConfig() (string, error) {
	root, err := os.OpenRoot(r.dir)
	if err != nil {
		return "", ErrTampered
	}
	defer func() { _ = root.Close() }()
	info, err := root.Lstat(".git")
	if err != nil || !info.IsDir() {
		return "", ErrTampered
	}
	git, err := root.OpenRoot(".git")
	if err != nil {
		return "", ErrTampered
	}
	defer func() { _ = git.Close() }()
	info, err = git.Lstat("config")
	if err != nil || !info.Mode().IsRegular() || info.Size() > 1<<20 {
		return "", ErrTampered
	}
	file, err := git.Open("config")
	if err != nil {
		return "", ErrTampered
	}
	defer func() { _ = file.Close() }()
	hash := sha256.New()
	n, err := io.Copy(hash, io.LimitReader(file, (1<<20)+1))
	if err != nil || n > 1<<20 {
		return "", ErrTampered
	}
	// A missing hooks directory is fine (clone uses an empty template).
	if info, err := git.Lstat("hooks"); err == nil {
		if !info.IsDir() {
			return "", ErrTampered
		}
		hooks, err := git.Open("hooks")
		if err != nil {
			return "", ErrTampered
		}
		defer func() { _ = hooks.Close() }()
		for {
			entries, readErr := hooks.ReadDir(64)
			for _, entry := range entries {
				info, err := entry.Info()
				if err != nil || !info.Mode().IsRegular() || !strings.HasSuffix(entry.Name(), ".sample") {
					return "", ErrTampered
				}
			}
			if errors.Is(readErr, io.EOF) {
				break
			}
			if readErr != nil {
				return "", ErrTampered
			}
		}
	} else if !errors.Is(err, os.ErrNotExist) {
		return "", ErrTampered
	}
	return hex.EncodeToString(hash.Sum(nil)), nil
}
package workspace

import (
	"fmt"
	"strings"
	"unicode"
	"unicode/utf8"

	"golang.org/x/text/unicode/norm"
)

// The lexical limits on a path.
const (
	// MaxPathBytes is the longest path accepted. It matches PATH_MAX on
	// macOS, the smaller of the supported systems.
	MaxPathBytes = 1024
	// MaxComponentBytes is the longest single name accepted.
	MaxComponentBytes = 255
	// MaxPathDepth is the most components a path may have.
	MaxPathDepth = 64
)

// Policy is the lexical half of the jail: it validates a path as text and
// says whether it is protected. It never touches the file system. Symlinks
// are handled by Local, which applies the policy again to every path a
// symlink leads to.
type Policy struct {
	rules []prefixRule
}

// prefixRule protects one path anchored at the checkout root, and everything
// below it.
type prefixRule struct {
	keys    []string // the match key of each component
	display string
}

// NewPolicy returns the built-in rules plus the extra protected paths. The
// built-in rules are:
//
//   - a component named .git at any depth
//   - a component whose name starts with .env at any depth (.env, .env.local,
//     .envrc)
//   - .github/workflows at the checkout root
//
// Names are NFC-normalized before case folding, so canonically equivalent
// spellings and case variants are protected even when the path is absent.
// The same match keys apply to configured rules, candidates and symlink targets.
func NewPolicy(extra []string) (*Policy, error) {
	p := &Policy{rules: []prefixRule{{keys: []string{matchKey(".github"), matchKey("workflows")}, display: ".github/workflows"}}}
	for _, raw := range extra {
		clean, err := cleanPath(raw)
		if err != nil {
			return nil, fmt.Errorf("protected path %q: %w", raw, err)
		}
		if clean == "." {
			return nil, fmt.Errorf("protected path %q: it would protect the whole checkout", raw)
		}
		rule := prefixRule{display: clean}
		for name := range strings.SplitSeq(clean, "/") {
			key := matchKey(name)
			if key == "" {
				return nil, fmt.Errorf("protected path %q: component %q cannot be matched", raw, name)
			}
			rule.keys = append(rule.keys, key)
		}
		p.rules = append(p.rules, rule)
	}
	return p, nil
}

// lexError is a lexical failure before it is tied to an operation.
type lexError struct {
	kind   error
	detail string
}

func (e *lexError) Error() string { return e.kind.Error() + " (" + e.detail + ")" }
func (e *lexError) Unwrap() error { return e.kind }

func invalid(detail string) error { return &lexError{kind: ErrInvalidPath, detail: detail} }
func escapes(detail string) error { return &lexError{kind: ErrPathEscape, detail: detail} }

// Clean validates a path as text and returns its canonical form: components
// joined by single slashes, with no ".", no empty component and no trailing
// slash. The checkout itself is ".". The error wraps ErrInvalidPath or
// ErrPathEscape.
//
// Clean is not the security boundary. That is os.Root. Clean exists to give
// clear errors and a canonical path for the protected-path rules.
func (p *Policy) Clean(path string) (string, error) { return cleanPath(path) }

// Check runs Clean and then refuses a protected path. The error for a
// protected path wraps ErrPathProtected.
func (p *Policy) Check(path string) (string, error) {
	clean, err := cleanPath(path)
	if err != nil {
		return "", err
	}
	if rule, ok := p.Protected(clean); ok {
		return "", &lexError{kind: ErrPathProtected, detail: rule}
	}
	return clean, nil
}

func cleanPath(path string) (string, error) {
	switch {
	case path == "":
		return "", invalid("the path is empty")
	case len(path) > MaxPathBytes:
		return "", invalid(fmt.Sprintf("longer than %d bytes", MaxPathBytes))
	case !utf8.ValidString(path):
		return "", invalid("not valid UTF-8")
	}
	for _, r := range path {
		switch {
		case r == 0:
			return "", invalid("holds a NUL byte")
		case r < 0x20 || r == 0x7f:
			return "", invalid("holds a control character")
		case r == '\\':
			// A backslash is a separator on Windows and the start of a UNC
			// or device path. Paths here always use "/".
			return "", invalid(`holds a backslash; use "/" between names`)
		}
	}
	switch {
	case path[0] == '/':
		return "", escapes("absolute paths are not allowed; give a path relative to the repository root")
	case len(path) >= 2 && path[1] == ':' && isASCIILetter(path[0]):
		return "", escapes("volume paths are not allowed; give a path relative to the repository root")
	}
	parts := make([]string, 0, 8)
	for name := range strings.SplitSeq(path, "/") {
		switch {
		case name == "" || name == ".":
			continue
		case name == "..":
			return "", escapes(`".." is not allowed`)
		case len(name) > MaxComponentBytes:
			return "", invalid(fmt.Sprintf("a name is longer than %d bytes", MaxComponentBytes))
		}
		// Combining marks are safe now that all policy keys use NFC. Reject
		// sequences for which norm inserts a stream-safety GraphemeJoiner:
		// that insertion changes canonical equivalence. Invalid UTF-8 was
		// rejected above. Keep the original spelling for filesystem access.
		if strings.Count(norm.NFC.String(name), norm.GraphemeJoiner) > strings.Count(name, norm.GraphemeJoiner) {
			return "", invalid("a name cannot be normalized without inserting a stream-safety separator")
		}
		parts = append(parts, name)
	}
	if len(parts) > MaxPathDepth {
		return "", invalid(fmt.Sprintf("deeper than %d levels", MaxPathDepth))
	}
	if len(parts) == 0 {
		return ".", nil
	}
	return strings.Join(parts, "/"), nil
}

// Protected reports whether a clean path is protected, and by which rule.
// The checkout root itself is never protected.
func (p *Policy) Protected(clean string) (rule string, ok bool) {
	if clean == "." || clean == "" {
		return "", false
	}
	keys := make([]string, 0, 8)
	for name := range strings.SplitSeq(clean, "/") {
		key := matchKey(name)
		switch {
		case key == matchKey(".git") || isShortGitName(key):
			return ".git", true
		case strings.HasPrefix(key, matchKey(".env")):
			return ".env*", true
		}
		keys = append(keys, key)
	}
	for _, r := range p.rules {
		if len(keys) >= len(r.keys) && equalKeys(keys[:len(r.keys)], r.keys) {
			return r.display, true
		}
	}
	return "", false
}

func equalKeys(a, b []string) bool {
	for i := range a {
		if a[i] != b[i] {
			return false
		}
	}
	return true
}

// matchKey reduces a file name to the form the protected-path rules compare.
// Two names a supported file system could treat as the same file get the
// same key:
//
//   - canonically equivalent spellings are normalized to NFC before folding
//   - letters are case folded (macOS and Windows ignore case)
//   - code points that HFS+ ignores in names are dropped
//   - anything from a ":" on is dropped (an NTFS stream name)
//   - trailing dots and spaces are dropped (Windows ignores them)
//
// It errs on the side of protecting too much: a strange name that only
// resembles a protected one is refused, which costs nothing.
func matchKey(name string) string {
	name = norm.NFC.String(name)
	var b strings.Builder
	b.Grow(len(name))
	for _, r := range name {
		if isIgnorable(r) {
			continue
		}
		b.WriteRune(foldRune(r))
	}
	// Folding and dropping ignored runes can expose another composition.
	key := norm.NFC.String(b.String())
	if i := strings.IndexByte(key, ':'); i >= 0 {
		key = key[:i]
	}
	return strings.TrimRight(key, ". ")
}

// foldRune maps every rune of a simple case-folding orbit to one member, so
// that "K", "k" and the Kelvin sign compare equal, as do "S", "s" and the
// long s.
func foldRune(r rune) rune {
	lowest := r
	for next := unicode.SimpleFold(r); next != r; next = unicode.SimpleFold(next) {
		lowest = min(lowest, next)
	}
	if 'A' <= lowest && lowest <= 'Z' {
		lowest += 'a' - 'A'
	}
	return lowest
}

// isIgnorable reports the code points HFS+ skips when it compares names.
func isIgnorable(r rune) bool {
	return (r >= 0x200C && r <= 0x200F) || (r >= 0x202A && r <= 0x202E) ||
		(r >= 0x206A && r <= 0x206F) || r == 0xFEFF
}

// isShortGitName reports a Windows 8.3 short name for .git, such as GIT~1.
func isShortGitName(key string) bool {
	digits, ok := strings.CutPrefix(key, "git~")
	if !ok || digits == "" {
		return false
	}
	for _, c := range digits {
		if c < '0' || c > '9' {
			return false
		}
	}
	return true
}

func isASCIILetter(c byte) bool {
	return ('a' <= c && c <= 'z') || ('A' <= c && c <= 'Z')
}
package tools

import (
	"context"
	"encoding/json"
	"errors"
	"fmt"
	"os"
	"path/filepath"
	"strings"
	"time"
	"unicode/utf8"

	"github.com/aryanpappu/patchbot/internal/execx"
	"github.com/aryanpappu/patchbot/internal/llm"
	"github.com/aryanpappu/patchbot/internal/secret"
)

// RunCmd executes an operator-configured command ID. Register it only for code.
type RunCmd struct{}

// Spec describes run_cmd.
func (RunCmd) Spec() llm.ToolSpec {
	return llm.ToolSpec{Name: "run_cmd", Description: "Run a configured command by name. Extra arguments require operator permission. There is no shell. Output is untrusted repository data.", Schema: json.RawMessage(`{"type":"object","properties":{"name":{"type":"string","description":"Configured command ID, such as test or lint."},"args":{"type":"array","description":"Optional literal extra arguments, if permitted for this command.","items":{"type":"string"}}},"required":["name"],"additionalProperties":false}`)}
}

// Execute runs run_cmd.
func (RunCmd) Execute(ctx context.Context, env *Env, raw json.RawMessage) (Result, error) {
	var args struct {
		Name string   `json:"name"`
		Args []string `json:"args"`
	}
	if err := decodeArgs(raw, &args); err != nil {
		return failed("%v", err)
	}
	if env.Policy == nil {
		return Result{}, errors.New("command policy is missing")
	}
	if _, err := env.Policy.Resolve(args.Name, args.Args); err != nil {
		return failed("command denied: %s", err)
	}
	result, err := ExecuteCommand(ctx, env, args.Name, args.Args, 0)
	if err != nil {
		return Result{}, err
	}
	limits := env.Limits.withDefaults()
	header := fmt.Sprintf("exit_code: %d\ntimed_out: %t\ntruncated: %t\n", result.ExitCode, result.TimedOut, result.Truncated)
	return Result{Content: header + CapOutput(result.Output, max(1, limits.CmdOutputBytes-len(header))), RecordOutput: result.Output, ExitCode: &result.ExitCode, TimedOut: result.TimedOut, IsError: result.ExitCode != 0 || result.TimedOut}, nil
}

// ExecuteCommand is shared by run_cmd and harness verification. name, arguments
// and timeout for harness calls come from trusted configuration. Each invocation
// gets private HOME/TMP directories under RunDir, never ambient credentials.
func ExecuteCommand(ctx context.Context, env *Env, name string, args []string, timeout time.Duration) (execx.Result, error) {
	if err := ctx.Err(); err != nil {
		return execx.Result{}, err
	}
	if env == nil || env.WS == nil || env.Policy == nil || env.Exec == nil {
		return execx.Result{}, errors.New("command environment is incomplete")
	}
	argv, err := env.Policy.Resolve(name, args)
	if err != nil {
		return execx.Result{}, fmt.Errorf("command policy: %w", err)
	}
	if !filepath.IsAbs(env.RunDir) {
		return execx.Result{}, errors.New("command run directory must be absolute")
	}
	runDir, err := filepath.EvalSymlinks(env.RunDir)
	if err != nil {
		return execx.Result{}, errors.New("resolve command run directory failed")
	}
	checkout, err := filepath.EvalSymlinks(env.WS.Dir())
	if err != nil {
		return execx.Result{}, errors.New("resolve command workspace failed")
	}
	rel, err := filepath.Rel(checkout, runDir)
	if err != nil || rel == "." || filepath.IsLocal(rel) {
		return execx.Result{}, errors.New("command run directory must be outside checkout")
	}
	private, err := os.MkdirTemp(runDir, ".command-")
	if err != nil {
		return execx.Result{}, errors.New("create private command directory failed")
	}
	defer func() { _ = os.RemoveAll(private) }()
	home, tmp := filepath.Join(private, "home"), filepath.Join(private, "tmp")
	for _, dir := range []string{home, tmp} {
		if err := os.Mkdir(dir, 0o700); err != nil {
			return execx.Result{}, errors.New("create command home/temp failed")
		}
	}
	limits := env.Limits.withDefaults()
	if timeout <= 0 {
		timeout = limits.CmdTimeout
	}
	redactor := env.Redactor
	if redactor == nil {
		redactor = secret.NewRedactor()
	}
	result, err := env.Exec.Run(ctx, execx.Spec{Argv: argv, Dir: env.WS.Dir(), Env: env.Policy.MinimalEnv(home, tmp, nil), Timeout: timeout, OutputCap: limits.CmdStoreBytes, Redactor: redactor})
	result.Output = redactor.Redact(strings.ToValidUTF8(result.Output, "�"))
	result.Truncated = result.Truncated || len(result.Output) > limits.CmdStoreBytes
	result.Output = CapOutput(result.Output, limits.CmdStoreBytes)
	if ctx.Err() != nil {
		return result, ctx.Err()
	}
	if result.Cancelled {
		return result, context.Canceled
	}
	if err != nil {
		return result, errors.New("command executor could not run the command")
	}
	return result, nil
}

// CapOutput keeps one quarter of the available bytes at the head and the rest
// at the tail (2 KB + 6 KB for an 8 KB cap). Redact before calling it.
func CapOutput(s string, limit int) string {
	if limit <= 0 {
		return ""
	}
	if len(s) <= limit {
		return s
	}
	const marker = "\n[output omitted]\n"
	if limit < len(marker) {
		return cutUTF8(marker, limit)
	}
	head := (limit - len(marker)) / 4
	tail := limit - len(marker) - head
	start := len(s) - tail
	for start < len(s) && !utf8.RuneStart(s[start]) {
		start++
	}
	return cutUTF8(s, head) + marker + s[start:]
}
