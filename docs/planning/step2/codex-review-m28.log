package github

import (
	"crypto"
	"crypto/rand"
	"crypto/rsa"
	"crypto/sha256"
	"crypto/x509"
	"encoding/base64"
	"encoding/json"
	"encoding/pem"
	"errors"
	"io"
	"os"
	"path/filepath"
	"strconv"
	"strings"
	"time"
)

const (
	maxKeyFileBytes = 64 << 10
	minKeyBits      = 2048
	// jwtBackdate absorbs clock drift between this host and GitHub.
	jwtBackdate = 60 * time.Second
	// jwtLifetime keeps exp under GitHub's 10 minute maximum, measured from now.
	jwtLifetime = 9 * time.Minute
)

// LoadAppPrivateKey reads and parses a GitHub App private key file once. The
// file must be an absolute path to a regular file (no symlink), mode 0600 or
// stricter, owned by the current user, and not inside any excluded root (the
// data directory and its workspaces). Errors never contain key material.
func LoadAppPrivateKey(path string, excludedRoots ...string) (*rsa.PrivateKey, error) {
	if err := CheckAppKeyFile(path, excludedRoots...); err != nil {
		return nil, err
	}
	file, err := openNoFollow(path)
	if err != nil {
		return nil, errors.New("private_key_file: cannot open")
	}
	defer func() { _ = file.Close() }()
	opened, err := file.Stat()
	if err != nil {
		return nil, errors.New("private_key_file: cannot stat")
	}
	linked, err := os.Lstat(path)
	if err != nil || !os.SameFile(opened, linked) {
		return nil, errors.New("private_key_file: changed while opening")
	}
	if err := checkKeyInfo(opened); err != nil {
		return nil, err
	}
	data, err := io.ReadAll(io.LimitReader(file, maxKeyFileBytes+1))
	if err != nil || len(data) > maxKeyFileBytes {
		return nil, errors.New("private_key_file: cannot read or larger than 64 KiB")
	}
	defer clear(data)
	return ParseAppPrivateKey(data)
}

// CheckAppKeyFile reports whether the key file is safely placed without
// reading it. Doctor uses it; LoadAppPrivateKey repeats it on the open file.
func CheckAppKeyFile(path string, excludedRoots ...string) error {
	if path == "" || !filepath.IsAbs(path) || filepath.Clean(path) != path || strings.ContainsRune(path, 0) {
		return errors.New("private_key_file: must be a clean absolute path")
	}
	info, err := os.Lstat(path)
	if err != nil {
		return errors.New("private_key_file: not found or not accessible")
	}
	if err := checkKeyInfo(info); err != nil {
		return err
	}
	resolvedDir, err := filepath.EvalSymlinks(filepath.Dir(path))
	if err != nil {
		return errors.New("private_key_file: cannot resolve its directory")
	}
	resolved := filepath.Join(resolvedDir, filepath.Base(path))
	for _, root := range excludedRoots {
		if root == "" {
			continue
		}
		candidates := []string{filepath.Clean(root)}
		if resolvedRoot, err := filepath.EvalSymlinks(root); err == nil {
			candidates = append(candidates, resolvedRoot)
		}
		for _, candidate := range candidates {
			for _, p := range []string{path, resolved} {
				if within(candidate, p) {
					return errors.New("private_key_file: must not be inside the data directory or workspaces")
				}
			}
		}
	}
	return nil
}

func within(root, path string) bool {
	rel, err := filepath.Rel(root, path)
	return err == nil && rel != ".." && !strings.HasPrefix(rel, ".."+string(filepath.Separator)) && !filepath.IsAbs(rel)
}

func checkKeyInfo(info os.FileInfo) error {
	if !info.Mode().IsRegular() {
		return errors.New("private_key_file: must be a regular file, not a symlink or device")
	}
	if info.Mode().Perm()&0o077 != 0 {
		return errors.New("private_key_file: mode must be 0600 or stricter")
	}
	return keyOwner(info)
}

// ParseAppPrivateKey accepts a PKCS#1 ("RSA PRIVATE KEY") or PKCS#8
// ("PRIVATE KEY") PEM block holding an RSA key of at least 2048 bits.
func ParseAppPrivateKey(data []byte) (*rsa.PrivateKey, error) {
	block, _ := pem.Decode(data)
	if block == nil {
		return nil, errors.New("private_key_file: no PEM block")
	}
	defer clear(block.Bytes)
	var key *rsa.PrivateKey
	switch block.Type {
	case "RSA PRIVATE KEY":
		parsed, err := x509.ParsePKCS1PrivateKey(block.Bytes)
		if err != nil {
			return nil, errors.New("private_key_file: invalid PKCS#1 RSA key")
		}
		key = parsed
	case "PRIVATE KEY":
		parsed, err := x509.ParsePKCS8PrivateKey(block.Bytes)
		if err != nil {
			return nil, errors.New("private_key_file: invalid PKCS#8 key")
		}
		rsaKey, ok := parsed.(*rsa.PrivateKey)
		if !ok {
			return nil, errors.New("private_key_file: PKCS#8 key is not RSA")
		}
		key = rsaKey
	default:
		return nil, errors.New("private_key_file: unsupported PEM block type")
	}
	if key.N.BitLen() < minKeyBits {
		return nil, errors.New("private_key_file: RSA key must be at least 2048 bits")
	}
	if err := key.Validate(); err != nil {
		return nil, errors.New("private_key_file: RSA key failed validation")
	}
	return key, nil
}

// SignAppJWT builds a GitHub App JWT: RS256, iat = now-60s, exp = now+9m,
// iss = app ID. It uses only the standard library.
func SignAppJWT(key *rsa.PrivateKey, appID int64, now time.Time) (string, error) {
	if key == nil || appID <= 0 {
		return "", errors.New("app JWT requires a key and a positive app ID")
	}
	header, _ := json.Marshal(map[string]string{"alg": "RS256", "typ": "JWT"})
	claims, err := json.Marshal(struct {
		IAT int64  `json:"iat"`
		EXP int64  `json:"exp"`
		ISS string `json:"iss"`
	}{now.Add(-jwtBackdate).Unix(), now.Add(jwtLifetime).Unix(), strconv.FormatInt(appID, 10)})
	if err != nil {
		return "", errors.New("cannot encode app JWT claims")
	}
	enc := base64.RawURLEncoding
	signing := enc.EncodeToString(header) + "." + enc.EncodeToString(claims)
	digest := sha256.Sum256([]byte(signing))
	signature, err := rsa.SignPKCS1v15(rand.Reader, key, crypto.SHA256, digest[:])
	if err != nil {
		return "", errors.New("cannot sign app JWT")
	}
	return signing + "." + enc.EncodeToString(signature), nil
}
package store

import (
	"context"
	"crypto/sha256"
	"database/sql"
	"database/sql/driver"
	"embed"
	"errors"
	"fmt"
	"io/fs"
	"strconv"
	"strings"
	"time"
)

//go:embed migrations/*.sql
var migrationFiles embed.FS

type migration struct {
	version             int64
	name, checksum, sql string
}

func loadMigrations() ([]migration, error) {
	entries, err := fs.ReadDir(migrationFiles, "migrations")
	if err != nil {
		return nil, err
	}
	migrations := make([]migration, 0, len(entries))
	for _, entry := range entries {
		name := entry.Name()
		prefix, _, ok := strings.Cut(name, "_")
		version, parseErr := strconv.ParseInt(prefix, 10, 64)
		if !ok || parseErr != nil || version != int64(len(migrations)+1) {
			return nil, fmt.Errorf("invalid migration filename %q", name)
		}
		body, readErr := migrationFiles.ReadFile("migrations/" + name)
		if readErr != nil {
			return nil, readErr
		}
		migrations = append(migrations, migration{version, name, fmt.Sprintf("%x", sha256.Sum256(body)), string(body)})
	}
	return migrations, nil
}

func (s *SQLite) migrate(ctx context.Context) error {
	migrations, err := loadMigrations()
	if err != nil {
		return err
	}
	_, err = s.db.ExecContext(ctx, `CREATE TABLE IF NOT EXISTS schema_migrations (
		version INTEGER PRIMARY KEY CHECK (version > 0), name TEXT NOT NULL,
		checksum TEXT NOT NULL, applied_at INTEGER NOT NULL CHECK (applied_at >= 0)
	) STRICT`)
	if err != nil {
		return fmt.Errorf("create migration ledger: %w", err)
	}
	// Each transaction re-reads the ledger while holding the immediate write
	// lock, so separate processes can safely open the same fresh database.
	for _, m := range migrations {
		if err := s.applyMigration(ctx, m, int64(len(migrations))); err != nil {
			return err
		}
	}
	return nil
}

// foreignKeysOff marks a migration that rebuilds a referenced table. SQLite
// ignores PRAGMA foreign_keys inside a transaction and DROP TABLE would
// otherwise cascade into child rows, so the migrator switches enforcement off
// on its single connection, applies the migration in a transaction, verifies
// foreign_key_check before commit and always switches enforcement back on.
const foreignKeysOff = "-- patchbot:foreign_keys=off"

// needsForeignKeysOff reads the marker from the first line, tolerating a BOM,
// CR line endings and surrounding whitespace. A table rebuild without the
// marker would cascade deletes, so DROP TABLE without it is refused.
func needsForeignKeysOff(m migration) (bool, error) {
	first, _, _ := strings.Cut(strings.TrimPrefix(m.sql, "\uFEFF"), "\n")
	if strings.TrimSpace(first) == foreignKeysOff {
		return true, nil
	}
	if strings.Contains(strings.ToUpper(m.sql), "DROP TABLE") {
		return false, fmt.Errorf("migration %s drops a table without %s", m.name, foreignKeysOff)
	}
	return false, nil
}

func (s *SQLite) applyMigration(ctx context.Context, m migration, latest int64) error {
	off, err := needsForeignKeysOff(m)
	if err != nil {
		return err
	}
	if !off {
		return s.withTx(ctx, func(tx *eventTx) error { return applyMigrationTx(ctx, tx, m, latest, false) })
	}
	conn, err := s.db.Conn(ctx)
	if err != nil {
		return err
	}
	defer func() { _ = conn.Close() }()
	if _, err := conn.ExecContext(ctx, `PRAGMA foreign_keys=OFF`); err != nil {
		return err
	}
	applyErr := func() error {
		tx, err := conn.BeginTx(ctx, nil)
		if err != nil {
			return err
		}
		defer func() { _ = tx.Rollback() }()
		if err := applyMigrationTx(ctx, &eventTx{Tx: tx}, m, latest, true); err != nil {
			return mapError(err)
		}
		return tx.Commit()
	}()
	_, restoreErr := conn.ExecContext(context.WithoutCancel(ctx), `PRAGMA foreign_keys=ON`)
	if restoreErr != nil {
		// Never return a pooled connection without enforcement.
		_ = conn.Raw(func(any) error { return driver.ErrBadConn })
	}
	return errors.Join(applyErr, restoreErr)
}

func applyMigrationTx(ctx context.Context, tx *eventTx, m migration, latest int64, checkKeys bool) error {
	{
		var maxVersion int64
		if err := tx.QueryRowContext(ctx, `SELECT COALESCE(MAX(version),0) FROM schema_migrations`).Scan(&maxVersion); err != nil {
			return err
		}
		if maxVersion > latest {
			return fmt.Errorf("database migration %d is newer than supported version %d", maxVersion, latest)
		}
		var name, checksum string
		err := tx.QueryRowContext(ctx, `SELECT name, checksum FROM schema_migrations WHERE version=?`, m.version).Scan(&name, &checksum)
		if err == nil {
			if name != m.name || checksum != m.checksum {
				return fmt.Errorf("migration %d (%s) name or checksum changed", m.version, m.name)
			}
			return nil
		}
		if !errors.Is(err, sql.ErrNoRows) {
			return err
		}
		if maxVersion != m.version-1 {
			return fmt.Errorf("migration ledger has a gap before version %d", m.version)
		}
		if _, err := tx.ExecContext(ctx, m.sql); err != nil {
			return fmt.Errorf("apply migration %s: %w", m.name, err)
		}
		if checkKeys {
			rows, err := tx.QueryContext(ctx, `PRAGMA foreign_key_check`)
			if err != nil {
				return err
			}
			violation := rows.Next()
			if err := errors.Join(rows.Err(), rows.Close()); err != nil {
				return err
			}
			if violation {
				return fmt.Errorf("apply migration %s: foreign key check failed", m.name)
			}
		}
		_, err = tx.ExecContext(ctx, `INSERT INTO schema_migrations(version,name,checksum,applied_at) VALUES(?,?,?,?)`,
			m.version, m.name, m.checksum, time.Now().UTC().UnixMilli())
		return err
	}
}
package runner

import (
	"context"
	"errors"
	"net/http"
	"os"
	"path/filepath"

	"github.com/aryanpappu/patchbot/internal/config"
	"github.com/aryanpappu/patchbot/internal/github"
	"github.com/aryanpappu/patchbot/internal/gitx"
	"github.com/aryanpappu/patchbot/internal/secret"
)

// setupGitHub selects the per-repository credential source and the REST
// client. PAT mode keeps the old behaviour (one token for every repository).
// App mode loads the private key once, resolves the bot identity and commit
// author, and fails startup on any error: there is no fallback to a PAT.
func (r *Runner) setupGitHub(ctx context.Context) error {
	opts := &r.opts
	if opts.RepoTokens == nil && r.cfg.GitHub.App() && r.cfg.GitHub.AppID == 0 {
		// Setup mode: the App ID comes from the "Connect GitHub" flow. Without
		// one the server still starts, but every credential request fails closed
		// (never a PAT) and new runs are refused with ErrGitHubNotConnected.
		app, found, err := r.db.GitHubApp(ctx)
		if err != nil {
			return errors.New("could not read the connected GitHub App")
		}
		if found {
			r.cfg.GitHub.AppID = app.AppID
		} else {
			r.notConnected = true
			opts.RepoTokens = notConnectedTokens{}
		}
	}
	if opts.RepoTokens == nil && r.cfg.GitHub.App() {
		app, identity, err := NewGitHubApp(ctx, r.cfg, opts.GitHubAPI, opts.GitHubHTTP, r.registerToken)
		if err != nil {
			return err
		}
		opts.RepoTokens = app
		opts.BotLogin = identity.Login
		opts.CommitAuthor = gitx.Author{Name: identity.Login, Email: identity.CommitEmail()}
	}
	if opts.RepoTokens == nil {
		if opts.Tokens == nil {
			opts.Tokens = Token{Value: secret.New(os.Getenv("GITHUB_TOKEN"))}
		}
		if token, err := opts.Tokens.Token(ctx); err == nil {
			r.redactor.AddSecrets(secret.New(token))
			r.redactor.Add(github.GitHeaderForm(token))
		}
		opts.RepoTokens = github.StaticRepoTokens{Source: opts.Tokens}
	}
	r.tokens = opts.RepoTokens
	r.gh = opts.GitHub
	if r.gh == nil {
		var err error
		if r.cfg.GitHub.App() {
			r.gh, err = github.NewWithRepoTokens(opts.GitHubHTTP, opts.GitHubAPI, opts.RepoTokens, nil)
		} else {
			r.gh, err = github.New(opts.GitHubHTTP, opts.GitHubAPI, opts.Tokens)
		}
		if err != nil {
			return err
		}
	}
	return nil
}

// ErrGitHubNotConnected refuses new runs until the Connect GitHub flow ran.
var ErrGitHubNotConnected = errors.New("GitHub is not connected yet: open /setup/github in the dashboard and connect GitHub first")

// notConnectedTokens fails every credential request in setup mode.
type notConnectedTokens struct{}

func (notConnectedTokens) RepoToken(context.Context, github.RepoRef) (string, error) {
	return "", ErrGitHubNotConnected
}

// GitHubConnected reports whether the runner has GitHub credentials. It is
// false only in app mode before the Connect GitHub flow created the App.
func (r *Runner) GitHubConnected() bool { return !r.notConnected }

// registerToken masks a minted token, and its git header form, in every
// redactor that output can pass through: the runner's own and the caller's
// (CLI or server). It runs before the token is used anywhere.
func (r *Runner) registerToken(token string) {
	for _, redactor := range []*secret.Redactor{r.redactor, r.opts.Redactor} {
		if redactor != nil {
			redactor.Add(token, github.GitHeaderForm(token))
		}
	}
}

// NewGitHubApp builds the App token source from [github] and resolves the bot
// identity. onMint receives every minted token before it is used.
func NewGitHubApp(ctx context.Context, cfg *config.Config, baseURL string, client *http.Client, onMint func(string)) (*github.App, github.AppIdentity, error) {
	g := cfg.GitHub
	key, err := github.LoadAppPrivateKey(g.PrivateKeyFile, cfg.DataDir(), filepath.Join(cfg.DataDir(), "workspaces"))
	if err != nil {
		return nil, github.AppIdentity{}, err
	}
	app, err := github.NewApp(github.AppOptions{AppID: g.AppID, Key: key, InstallationID: g.InstallationID,
		BaseURL: baseURL, HTTPClient: client, OnMint: onMint})
	if err != nil {
		return nil, github.AppIdentity{}, err
	}
	identity, err := app.Identity(ctx)
	if err != nil {
		return nil, github.AppIdentity{}, errors.Join(errors.New("GitHub App identity check failed; refusing to start (no PAT fallback)"), err)
	}
	return app, identity, nil
}

// githubCredentialError never quotes a token source's error text.
func githubCredentialError(err error) error {
	var mint *github.MintError
	if errors.As(err, &mint) {
		return mint
	}
	if errors.Is(err, context.Canceled) || errors.Is(err, context.DeadlineExceeded) {
		return err
	}
	return errors.New("GitHub credential unavailable; check GITHUB_TOKEN or the [github] App settings")
}
